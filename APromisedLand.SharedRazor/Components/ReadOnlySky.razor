@namespace APromisedLand.SharedRazor.Components

<MudToggleIconButton @Toggled="@ReadOnly"
                     Icon="@Icons.Material.Filled.EditNote"
                     Color="@Color.Info"
                     ToggledIcon="@Icons.Material.Filled.EditOff"
                     ToggledColor="@Color.Default"
                     ToggledChanged="@HandleReadOnlyChanged" />

@code {
    [Parameter] public bool ReadOnly { get; set; } = true;
    [Parameter] public EventCallback<bool> ReadOnlyChanged { get; set; }

    [Parameter] public EventCallback<bool> ToggledChanged { get; set; }

    // 命名规范:原 handleReadOnlyChanged → PascalCase
    private void HandleReadOnlyChanged(bool value)
    {
        ReadOnly = !ReadOnly;

        _ = ReadOnlyChanged.InvokeAsync(ReadOnly);
        _ = ToggledChanged.InvokeAsync(ReadOnly);
    }
}
