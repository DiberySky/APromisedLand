@namespace APromisedLand.SharedRazor.Components

@inject ISnackbar Snackbar

<MudIconButton Disabled="@(_processing || Disabled)"
               Variant="@Variant" Color="@Color"
               Size="@Size" Class="@Class"
               OnClick="@ProcessSomething">
    @if (_processing)
    {
        <MudProgressCircular Size="@Size"
                             Indeterminate="true" Color="@ProgressColor" />
    }
    else
    {
        <MudIcon Icon="@Icon" />
    }
</MudIconButton>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Check;
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public Color ProgressColor { get; set; } = Color.Warning;
    [Parameter] public string? Class { get; set; }

    // 与 ButtonLoadingSky.OnClickFunc 统一命名
    [Parameter] public Func<Task>? OnClickFunc { get; set; }

    private bool _processing = false;

    private async Task ProcessSomething()
    {
        // 重入守卫:与 ButtonLoadingSky 行为对齐
        if (_processing) return;

        try
        {
            _processing = true;
            StateHasChanged();
            await Task.Yield();

            if (OnClickFunc is not null)
            {
                await OnClickFunc();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"操作失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }
}
