@namespace APromisedLand.SharedRazor.Components

@inject BlazorService BlazorService

<MudTextField T="string" Variant="@Variant" @bind-Value="@Password"
              Label="@Label" InputType="@_passwordInput" Class="@Class"
              Required=true RequiredError="请输入密码！" Clearable
              Validation="@(new Func<string, int, string?>(BlazorService.PasswordValidation))"
              Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon"
              OnAdornmentClick="OnAdornmentClickHandle" AdornmentAriaLabel="显示密码" />

@code {
    [Parameter] public string Label { get; set; } = "密码";
    [Parameter] public string? Class { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;

    // 命名规范:原 isShow / PasswordInput / PasswordInputIcon 改为 _camelCase 私有字段
    private bool _isShow;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    public string? Password { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
#if DEBUG
        Password = "Pa$$w0rd";
#endif
    }

    private void OnAdornmentClickHandle()
    {
        if (_isShow)
        {
            _isShow = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isShow = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }
}
