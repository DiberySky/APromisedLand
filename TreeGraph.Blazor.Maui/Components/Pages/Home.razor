@* Home.razor — 应用入口（PageSky 外壳 + 抽屉导航） *@
@page "/"
@layout SkyLayout

<PageTitle>首页</PageTitle>

@* 抽屉导航：承接原侧栏 NavMenu 的全部链接（Temporary 覆盖式，不挤压内容） *@
<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Start" Elevation="1"
           Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">TreeGraph</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudNavLink Href="" Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Outlined.Home">首页</MudNavLink>
        <MudNavLink Href="counter"
                    Icon="@Icons.Material.Outlined.PlusOne">Counter</MudNavLink>
        <MudNavLink Href="weather"
                    Icon="@Icons.Material.Outlined.List">Weather</MudNavLink>

        @* NodeEav 业务页面（RCL） *@
        <MudNavLink Href="inodes" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.AccountTree">iNode 列表</MudNavLink>
        <MudNavLink Href="entities"
                    Icon="@Icons.Material.Outlined.Category">选择实体</MudNavLink>
        <MudNavLink Href="attributes"
                    Icon="@Icons.Material.Outlined.FormatListBulleted">属性列表</MudNavLink>
        <MudNavLink Href="metadata/entity-types" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.Schema">元数据-实体类型</MudNavLink>

        @* TreeEavSky 树页面 *@
        <MudNavLink Href="category-tree"
                    Icon="@Icons.Material.Outlined.FolderShared">分类树</MudNavLink>
        <MudNavLink Href="unit-tree"
                    Icon="@Icons.Material.Outlined.Scale">单位树</MudNavLink>
    </MudNavMenu>
</MudDrawer>

<PageSky Title="首页"
         ArrowBackVisible="false"
         StartButtonVisible="true"
         OnStartClick="ToggleDrawer">
    <PageContent>
        <MudText Typo="Typo.h5">欢迎使用 TreeGraph</MudText>
        <MudText Typo="Typo.body1" Class="mt-4">
            请从左侧菜单选择功能模块。
        </MudText>
    </PageContent>
</PageSky>

@code {
    private bool _drawerOpen;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
