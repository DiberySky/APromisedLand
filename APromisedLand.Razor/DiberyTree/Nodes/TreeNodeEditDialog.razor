@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@using APromisedLand.Razor.Helper.Blazor

@implements IDisposable

@inject IDialogService DialogService

<DialogTreeSky TItem="@TItem"
               Item="@_node"
               Title="@_title"
               SubmitButtonVisible="true"
               OnSubmitClick="@SubmitAsync"
               OnCanceledClick="@Close">
    <ToolBarContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_node.Text()</MudText>
        <MudSpacer/>
        <MudButton Variant="Variant.Text"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@OpenAddDialog">
            添加设置属性
        </MudButton>
    </ToolBarContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4">
            <MudForm @ref="_form" Model="@_node">
                @if (NodeTemplate.EditTemplate is null)
                {
                    <MudStack Spacing="3">
                    </MudStack>
                }
                else
                {
                    @NodeTemplate.EditTemplate(_node)
                }

                <NodeAttributeItemsSky @ref="@_itemsSky" 
                                       NodeId="@_node.Id" 
                                       @bind-DefItemDtos="@AttributeItems"
                                       ReadOnly="@false"/>

            </MudForm>
        </MudContainer>
    </DialogContent>

</DialogTreeSky>

@code {
    NodeAttributeItemsSky _itemsSky = null!;
    
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }

    private MudForm _form = null!;

    private List<AttributeItemDto> AttributeItems { get; set; } = new();
    
    private TItem _node = null!;

    private string _title = null!;

    protected override void OnInitialized()
    {
        _node = NodeTemplate.Node.Value!;

        _title = "设置修改";

        base.OnInitialized();
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        await _itemsSky.SubmitUpdateNodeAttributesAsync();
        
        MudDialog?.Close(DialogResult.Ok(_node));
    }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    private async Task OpenAddDialog()
    {
        var result = await DialogService.ShowAttributeDefinitionListDialogAsync();
     
        if (result == null) return;
        
        await OpenEditDialog(result);
    }

    private async Task OpenEditDialog(AttributeDefinition definition)
    {
        var dialogParams = new DialogParameters<AddAttributeValueDialog>
        {
            { x => x.NodeId, _node.Id },
            { x => x.Definition, definition },
        };
        var dialog = await DialogService.ShowAsync<AddAttributeValueDialog>("添加属性", dialogParams);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await _itemsSky.LoadAttributes();
        }
    }
    
    public void Dispose()
    {
    }

}
