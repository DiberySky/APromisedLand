    /// <summary>
    /// 将 TreeNodeDto 转换为 TreeItemData
    /// </summary>
    private TreeItemData<CategoryTree> ConvertToTreeItem(TreeNodeDto<CategoryTree> dto)
    {
        return new TreeItemData<CategoryTree>
        {
            Value = dto.Value,
            Text = dto.Text,
            Icon = dto.Icon,
            Expanded = dto.Expanded,
            // 子节点由懒加载动态填充，初始为空
            Children = [],
            // 如果 HasChildren 为 true，则显示展开图标
            // 但 Children 必须非空才能展开，所以我们设置 CanExpand = HasChildren
            // 但 TreeItemData 没有 CanExpand 属性，MudTreeView 根据 Children 是否有内容判断
            // 因此我们在加载子节点时才填充 Children
        };
    }

    /// <summary>
    /// 刷新树
    /// </summary>
    private async Task RefreshTree()
    {
        if (_treeSky != null)
            await _treeSky.RefreshAsync();
        _selectedCategory = null;
    }

    /// <summary>
    /// 添加根节点
    /// </summary>
    private async Task AddRootNode()
    {
        var dialog = await DialogService.ShowAsync<AddNodeDialog>("添加根分类",
            new DialogParameters { ["Title"] = "新建根分类" });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            var newNode = new TreeNodeDto<CategoryTree>
            {
                Id = Guid.NewGuid().ToString(),
                Text = name,
                ParentId = null,
                HasChildren = false,
                Icon = "folder",
                // Value 需要构造 CategoryTree 实例，但实际创建由服务端处理，这里可留空
                // 服务端会忽略 Value，只使用 Text, ParentId 等
            };
            await TreeClient.CreateNodeAsync(newNode);
            await RefreshTree();
            Snackbar.Add($"根分类“{name}”已创建", Severity.Success);
        }
    }

    /// <summary>
    /// 添加子节点（当前选中节点作为父节点）
    /// </summary>
    private async Task AddChildNode(CategoryTree parent)
    {
        var dialog = await DialogService.ShowAsync<AddNodeDialog>("添加子分类",
            new DialogParameters { ["Title"] = $"添加子分类到“{parent.Text()}”" });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string name } && !string.IsNullOrWhiteSpace(name))
        {
            var newNode = new TreeNodeDto<CategoryTree>
            {
                Id = Guid.NewGuid().ToString(),
                Text = name,
                ParentId = parent.Id,
                HasChildren = false,
                Icon = "insert_drive_file"
            };
            await TreeClient.CreateNodeAsync(newNode);
            await RefreshTree();
            Snackbar.Add($"子分类“{name}”已添加", Severity.Success);
        }
    }

    /// <summary>
    /// 删除节点（含确认）
    /// </summary>
    private async Task DeleteNode(CategoryTree node)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定要删除分类“{node.Text()}”及其所有子分类吗？",
            "删除",
            "取消");
        if (confirm == true)
        {
            await TreeClient.DeleteNodeAsync(node.Id);
            await RefreshTree();
            Snackbar.Add($"分类“{node.Text()}”已删除", Severity.Success);
        }
    }

