@page "/category-tree"
@page "/category-tree/{RootId}"
@using APromisedLand.MauiBlazor.DiberyTree.Services
@inject DiberyTreeApiClient<CategoryTree> TreeClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageSky Title="Weather" BottomBarVisibled>
    <PageContent>
        <MudMainContent>
            <ChildContent>
                <MudContainer MaxWidth="MaxWidth.Small">

                    <MudText Typo="Typo.h4" Class="mb-4">📂 分类树管理</MudText>

                    <MudStack Row="true" Spacing="2" Class="mb-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@AddRootNode">
                            添加根分类
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="@RefreshTree">
                            刷新
                        </MudButton>
                    </MudStack>

                    <MudPaper Class="pa-4" Elevation="2">
                        <TreeSky TItem="CategoryTree"
                                 @ref="_treeSky"
                                 FunLoadInitialData="@LoadInitialDataAsync"
                                 FunLoadServerData="@LoadChildrenAsync"
                                 @bind-SelectedValue="_selectedCategory"/>
                    </MudPaper>

                </MudContainer>
            </ChildContent>
        </MudMainContent>
    </PageContent>
</PageSky>

@code {
    [Parameter] public string? RootId { get; set; }
    
    private TreeSky<CategoryTree>? _treeSky;
    private CategoryTree? _selectedCategory;
    private List<TreeItemData<CategoryTree>> InitialTreeItems { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private async Task<IReadOnlyList<TreeNodeDto<CategoryTree>>> LoadInitialDataAsync()
    {
        var items = await TreeClient.GetRootNodesAsync(RootId);

        // var InitialTreeItems = items.Select(i => i.ToTreeItemData<CategoryTree>()).ToList();
        
        return items;
    }

    // private async Task<IReadOnlyCollection<TreeItemData<CategoryTree>>> LoadInitialDataAsync(CategoryTree? parent)
    // {
    //     var items = await TreeClient.GetRootNodesAsync();
    //
    //     InitialTreeItems = items.Select(i => i.ToTreeItemData<CategoryTree>()).ToList();
    //     
    //     return InitialTreeItems;
    // }

    /// <summary>
    /// 懒加载子节点
    /// </summary>
    private async Task<IReadOnlyList<TreeNodeDto<CategoryTree>>> LoadChildrenAsync(CategoryTree? parent)
    {
        if (parent == null)
        {
            // 加载根节点
            var roots = await TreeClient.GetRootNodesAsync();
            return roots;
            //return roots.Select(dto => ConvertToTreeItem(dto)).ToList();
        }
        else
        {
            // 加载指定节点的子节点
            var children = await TreeClient.GetChildrenAsync(parent.Id);
            return children;
            // return children.Select(dto => ConvertToTreeItem(dto)).ToList();
        }
    }
    
