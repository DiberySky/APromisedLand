@page "/category-tree"
@page "/category-tree/root"
@page "/category-tree/rootId/{RootId}"
@page "/category-tree/ClickNodeId/{ClickNodeId}"
@page "/category-tree/rootId/{RootId}/ClickNodeId/{ClickNodeId}"

@{
    RenderFragment<CategoryTree> actionTemplate = (context) =>
        @<div class="node-detail">
            <MudTextField T="string"
                          Value="@context.Text()"
                          Label="名称"
                          Variant="Variant.Outlined"
                          ReadOnly="true"/>

            <MudTextField T="string"
                          Value="@context.Description"
                          Label="描述"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Lines="3"/>

            <MudChip T="string"
                     Color="@((context.IsActive ? Color.Success : Color.Error))"
                     Size="Size.Small">
                @(context.IsActive ? "已启用" : "已禁用")
            </MudChip>
        </div>;
}

@{
    RenderFragment<CategoryTree> editTemplate = (context) =>
        @<div class="node-detail">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              @bind-Value="context.Name"
                              Label="名称"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="名称不能为空"
                              MaxLength="100"
                              Counter="100"
                              Immediate="true"/>

                <MudTextField T="string"
                              @bind-Value="context.Description"
                              Label="描述"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="500"
                              Counter="500"
                              Immediate="true"/>

                <MudSwitch T="bool"
                           @bind-Value="context.IsActive"
                           Label="启用状态"
                           Color="Color.Primary"/>

            </MudStack>
        </div>;
}

<TreePageSky TItem="CategoryTree"
             TitleToolBar="分类树"
             RootId="@RootId"
             @bind-SelectedValue="@_selectedCategory"
             NewPageOpenVisible="true"
             @bind-NewPageOpen="@NewPageOpen"
             ClickNodeId="@ClickNodeId"
             LoadInitialDataFunc="@LoadInitialDataAsync"
             LoadServerDataFunc="@LoadChildrenAsync"
             GetAncestorPathFunc="@GetAncestorPathFromApiAsync"
             ActionTemplate="@actionTemplate"
             EditTemplate="@editTemplate"
             BackPage="@SolutionService.StartPage">
    <ToolBarRightContent>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshTreeAsync">刷新
        </MudIconButton>
    </ToolBarRightContent>
</TreePageSky>

@code
{
    public bool NewPageOpen { get; set; }
}

