
<MudDatePicker Date="@_date"
               DateChanged="@(OnDateChanged)"
               Label="@DefItemDto?.Def?.Name"
               DateFormat="yyyy-MM-dd"
               Variant="Variant.Outlined"
               ReadOnly="@ReadOnly"/>

@code {
    [Parameter] public AttributeItemDto? DefItemDto { get; set; }
    [Parameter] public EventCallback<AttributeItemDto?> DefItemDtoChanged { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    DateTime? _date;

    protected override void OnInitialized()
    {
        _date = DefItemDto?.DateTimeValue?.ToLocalTime().DateTime;
        
        StateHasChanged();
    }

    private void OnDateChanged(DateTime? value)
    {
        DefItemDto?.DateValue = value.HasValue
            ? new DateTimeOffset(value.Value, TimeSpan.Zero)
            : null;

        _ = DefItemDtoChanged.InvokeAsync(DefItemDto);
    }
}