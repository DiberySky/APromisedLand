@* *@
@* <MudStack Class="d-flex flex-grow-1" Spacing="0"> *@
@*     @if (ReadOnly) *@
@*     { *@
@*         $1$ 只读模式：显示文件链接 #1# *@
@*         if (!string.IsNullOrEmpty(Value)) *@
@*         { *@
@*             <MudLink Href="@Value" Target="_blank" Typo="Typo.body2">查看文件</MudLink> *@
@*         } *@
@*         else *@
@*         { *@
@*             <MudText Typo="Typo.body2" Color="Color.Tertiary">无文件</MudText> *@
@*         } *@
@*     } *@
@*     else *@
@*     { *@
@*         $1$ 编辑模式：文件上传控件 #1# *@
@*         <MudFileUpload T="IBrowserFile" *@
@*                        FilesChanged="@OnFilesChanged" *@
@*                        Accept="@AcceptedFileTypes"/> *@
@* *@
@*         $1$ 显示当前文件路径（若已存在） #1# *@
@*         if (!string.IsNullOrEmpty(Value)) *@
@*         { *@
@*             <MudText Typo="Typo.caption" Color="Color.Secondary"> *@
@*                 当前文件： *@
@*                 <MudLink Href="@Value" Target="_blank">@Value</MudLink> *@
@*             </MudText> *@
@*         } *@
@*     } *@
@* *@
@*     $1$ 属性信息与折叠按钮（与 TextValue 保持一致） #1# *@
@*     <MudStack Row="true"> *@
@*         @if (_infoVisible) *@
@*         { *@
@*             <MudText Typo="Typo.caption" Color="Color.Tertiary"> *@
@*                 类型：@DefinitionDto!.TypeName， *@
@*                 最大大小：@(DefinitionDto?.MaxLength is null or 0 ? "无限制" : $"{DefinitionDto?.MaxLength} 字节") *@
@*             </MudText> *@
@*         } *@
@*         <MudSpacer/> *@
@*         <MudIconButton Size="Size.Small" Color="Color.Info" Class="ma-0 pa-0" *@
@*                        Icon="@(_infoVisible *@
@*                                  ? Icons.Material.Outlined.KeyboardDoubleArrowRight *@
@*                                  : Icons.Material.Outlined.KeyboardDoubleArrowLeft)" *@
@*                        OnClick="@(() => _infoVisible = !_infoVisible)"/> *@
@*     </MudStack> *@
@* </MudStack> *@

@code {
    [Parameter] public required string? NodeId { get; set; }

    [Parameter] public AttributeItemDto? DefItemDto { get; set; }
    [Parameter] public EventCallback<AttributeItemDto?> DefItemDtoChanged { get; set; }

