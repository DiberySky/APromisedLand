@using APromisedLand.Razor.DiberyTree.Attributes.Locations
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@* @inject TreeNodeDialogService<TItem> TreeNodeDialogService *@
@inject IDialogService DialogService

<AttributeValueSky NodeId="@NodeId"
                   ValueId="@ValueId"
                   @bind-JsonValue="@JsonValue"
                   DefinitionDto="@DefinitionDto"
                   ReadOnly="@ReadOnly"
                   OnSaveClick="@(e => OnSaveClick.InvokeAsync(e))" 
                   OnDeleteClick="@(e => OnDeleteClick.InvokeAsync(e))"
                   OnEditChanged="@(e => OnEditChanged.InvokeAsync(e))">
    <ValueContent>
        @if (ReadOnly)
        {
            <MudTextField T="string"
                          Value="@Value"
                          Label="地点位置名称"
                          Variant="Variant.Outlined"
                          ReadOnly="@ReadOnly"
                          Adornment="Adornment.End"
                          AdornmentColor="Color.Success"
                          AdornmentIcon="@Icons.Material.Outlined.EditNote"
                          OnAdornmentClick="@(HandleAdornmentClick)"/>
        }
        else
        {
            <MudTextField T="string"
                          Value="@Value"
                          Label="地点位置名称"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="地点位置名称不能为空"
                          MaxLength="50"
                          Counter="50"
                          ReadOnly="@ReadOnly"
                          ValueChanged="@(HandleValueChanged)"/>
        }
    </ValueContent>
</AttributeValueSky>

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinitionDto? DefinitionDto { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<AttributeDefinitionDto?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnEditChanged { get; set; }
    
    private JsonElement? JsonValue { get; set; }

    protected override void OnInitialized()
    {
        Value ??= DefinitionDto?.Name;

        JsonValue = JsonSerializer.SerializeToElement(Value);

        base.OnInitialized();
    }

    private void HandleValueChanged(string? value)
    {
        Value = value;
        _ = ValueChanged.InvokeAsync(Value);

        JsonValue = value is not null ? JsonSerializer.SerializeToElement(value) : null;
    }
    
    private async Task HandleAdornmentClick()
    {
        await ShowAttributeLocationEditDialogAsync(NodeId!, ValueId!, DefinitionDto);
    }
    
     public async Task ShowAttributeLocationEditDialogAsync(string nodeId, object locationId,
        AttributeDefinitionDto? definitionDto,
        DialogConfig? config = null)
    {
        var parameters = new DialogParameters<AttributeLocationEditDialog>
        {
            { x => x.NodeId, nodeId },
            { x => x.LocationId, locationId },
            { x => x.DefinitionDto, definitionDto },
        };

        var options = (config ?? new DialogConfig
        {
            Position = DialogPosition.Center
        }).ToDialogOptions();

        var dialog = await DialogService.ShowAsync<AttributeLocationEditDialog>(
            "位置编辑器", parameters, options);

        var result = await dialog.Result;
    }
}