@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@switch (_typeEnum)
{
    case AttributeTypeEnum.文本:
        var textValue = AttributeJsonValueDto.Value.GetValue<string>();

        <TextValue NodeId="@ParentId"
                   ValueId="@AttributeJsonValueDto.Id"
                   DefinitionDto="@AttributeJsonValueDto.Definition"
                   Value="@textValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.整数:
        var integerValue = AttributeJsonValueDto.Value.GetValue<long>();

        <IntegerValue NodeId="@ParentId"
                      ValueId="@AttributeJsonValueDto.Id"
                      DefinitionDto="@AttributeJsonValueDto.Definition"
                      Value="@integerValue"
                      ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.小数:
        var decimalValue = AttributeJsonValueDto.Value.GetValue<decimal>();

        <DecimalValue NodeId="@ParentId"
                      ValueId="@AttributeJsonValueDto.Id"
                      DefinitionDto="@AttributeJsonValueDto.Definition"
                      Value="@decimalValue"
                      ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.日期:
        var dateValue = AttributeJsonValueDto.Value.GetValue<DateTimeOffset>();

        <DateValue NodeId="@ParentId"
                   ValueId="@AttributeJsonValueDto.Id"
                   DefinitionDto="@AttributeJsonValueDto.Definition"
                   Value="@dateValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.时间:
        var timeValue = AttributeJsonValueDto.Value.GetValue<TimeSpan>();

        <TimeValue NodeId="@ParentId"
                   ValueId="@AttributeJsonValueDto.Id"
                   DefinitionDto="@AttributeJsonValueDto.Definition"
                   Value="@timeValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.日期时间:
        var dateTimeValue = AttributeJsonValueDto.Value.GetValue<DateTimeOffset>();

        <DateTimeValue NodeId="@ParentId"
                       ValueId="@AttributeJsonValueDto.Id"
                       DefinitionDto="@AttributeJsonValueDto.Definition"
                       Value="@dateTimeValue"
                       ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.文件:
        var fileValue = AttributeJsonValueDto.Value.GetValue<string>();

        <FileValue NodeId="@ParentId"
                   ValueId="@AttributeJsonValueDto.Id"
                   DefinitionDto="@AttributeJsonValueDto.Definition"
                   Value="@fileValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.定位:
        var locLat = AttributeJsonValueDto.Value.TryGetProperty("Latitude", out var latP) ? latP.GetDouble()
                    : AttributeJsonValueDto.Value.TryGetProperty("latitude", out var latL) ? latL.GetDouble() : 0;
        var locLon = AttributeJsonValueDto.Value.TryGetProperty("Longitude", out var lonP) ? lonP.GetDouble()
                    : AttributeJsonValueDto.Value.TryGetProperty("longitude", out var lonL) ? lonL.GetDouble() : 0;

        <LocationValue NodeId="@ParentId"
                       ValueId="@AttributeJsonValueDto.Id"
                       DefinitionDto="@AttributeJsonValueDto.Definition"
                       Latitude="@locLat"
                       Longitude="@locLon"
                       ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.表格:
        break;
    default:
        throw new ArgumentOutOfRangeException();
}


@code {
    [Parameter] public required string? ParentId { get; set; }
    
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public required AttributeJsonValueDto AttributeJsonValueDto  { get; set; }
    
    private AttributeTypeEnum? _typeEnum;

    protected override void OnInitialized()
    {
        _typeEnum = AttributeJsonValueDto.Definition.AttributeTypeId.ToAttributeTypeEnum();
    }
}