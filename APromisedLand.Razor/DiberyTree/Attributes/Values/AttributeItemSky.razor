@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@switch (_typeEnum)
{
    case AttributeTypeEnum.文本:
        var textValue = AttributeDto.Value.GetValue<string>();

        <TextValue TItem="@TItem"
                   NodeId="@ParentId"
                   ValueId="@AttributeDto.Id"
                   DefinitionDto="@AttributeDto.Definition?.ToDto()"
                   Value="@textValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.整数:
        var integerValue = AttributeDto.Value.GetValue<long>();

        <IntegerValue TItem="@TItem"
                      NodeId="@ParentId"
                      ValueId="@AttributeDto.Id"
                      DefinitionDto="@AttributeDto.Definition?.ToDto()"
                      Value="@integerValue"
                      ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.小数:
        var decimalValue = AttributeDto.Value.GetValue<decimal>();

        <DecimalValue TItem="@TItem"
                      NodeId="@ParentId"
                      ValueId="@AttributeDto.Id"
                      DefinitionDto="@AttributeDto.Definition?.ToDto()"
                      Value="@decimalValue"
                      ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.日期:
        var dateValue = AttributeDto.Value.GetValue<DateTimeOffset>();

        <DateValue TItem="@TItem"
                   NodeId="@ParentId"
                   ValueId="@AttributeDto.Id"
                   DefinitionDto="@AttributeDto.Definition?.ToDto()"
                   Value="@dateValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.时间:
        var timeValue = AttributeDto.Value.GetValue<TimeSpan>();

        <TimeValue TItem="@TItem"
                   NodeId="@ParentId"
                   ValueId="@AttributeDto.Id"
                   DefinitionDto="@AttributeDto.Definition?.ToDto()"
                   Value="@timeValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.日期时间:
        var dateTimeValue = AttributeDto.Value.GetValue<DateTimeOffset>();

        <DateTimeValue TItem="@TItem"
                       NodeId="@ParentId"
                       ValueId="@AttributeDto.Id"
                       DefinitionDto="@AttributeDto.Definition?.ToDto()"
                       Value="@dateTimeValue"
                       ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.文件:
        var fileValue = AttributeDto.Value.GetValue<string>();

        <FileValue TItem="@TItem"
                   NodeId="@ParentId"
                   ValueId="@AttributeDto.Id"
                   DefinitionDto="@AttributeDto.Definition?.ToDto()"
                   Value="@fileValue"
                   ReadOnly="@ReadOnly"/>
        break;
    case AttributeTypeEnum.定位:
        break;
    case AttributeTypeEnum.表格:
        break;
    default:
        throw new ArgumentOutOfRangeException();
}


@code {
    [Parameter] public required string? ParentId { get; set; }
    
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public required AttributeDto AttributeDto  { get; set; }
    
    private AttributeTypeEnum? _typeEnum;

    protected override void OnInitialized()
    {
        _typeEnum = AttributeDto.Definition.AttributeTypeId.ToAttributeTypeEnum();
    }
}