<MudNumericField T="decimal?"
                 Value="@Value"
                 ValueChanged="@OnValueChanged"
                 Label="@Definition?.Name"
                 Variant="Variant.Outlined"
                 Format="@($"N{Definition?.Scale ?? 2}")"
                 Min="0"
                 FullWidth="true"
                 Margin="Margin.Normal"
                 Adornment="Adornment.End"
                 AdornmentText="@Definition?.Unit?.Name" />

<MudText Typo="Typo.caption" Color="Color.Tertiary">
    类型：@Definition?.AttributeType.Name, 整数位数：@(Definition?.Precision - Definition?.Scale), 小数位数：@Definition?.Scale
    @if (!string.IsNullOrEmpty(Definition?.Unit?.Abbreviation))
    {
        <span>，单位：@Definition.Unit?.Abbreviation</span>
    }
</MudText>

@code {
    [Parameter] public AttributeDefinitionDto? Definition { get; set; }
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }

    private async Task OnValueChanged(decimal? newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

}