@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

<AttributeValueSky NodeId="@NodeId"
                   ValueId="@ValueId"
                   @bind-JsonValue="@JsonValue"
                   DefinitionDto="@DefinitionDto"
                   ReadOnly="@ReadOnly"
                   OnSaveClick="@(e => OnSaveClick.InvokeAsync(e))"
                   OnDeleteClick="@(e => OnDeleteClick.InvokeAsync(e))"
                   OnEditChanged="@(e => OnEditChanged.InvokeAsync(e))">
    <ValueContent>
        <MudStack Class="d-flex flex-grow-1" Spacing="0">
            <MudNumericField T="decimal?"
                             Value="@Value"
                             ValueChanged="@OnValueChanged"
                             Label="@DefinitionDto?.Name"
                             Variant="Variant.Outlined"
                             Format="@($"N{DefinitionDto?.Scale ?? 2}")"
                             HideSpinButtons="true"
                             Min="0"
                             FullWidth="true"
                             Margin="Margin.Normal"
                             Adornment="Adornment.End"
                             AdornmentText="@DefinitionDto?.Unit?.Name"
                             ReadOnly="@ReadOnly"/>

            <MudStack Row="true">
                @if (_infoVisible)
                {
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        类型：@DefinitionDto!.AttributeType.ToName(), 整数位数：@(DefinitionDto?.Precision - DefinitionDto?.Scale),
                        小数位数：@DefinitionDto?.Scale
                        @if (!string.IsNullOrEmpty(DefinitionDto?.Unit?.Abbreviation))
                        {
                            <span>，单位：@DefinitionDto.Unit?.Abbreviation</span>
                        }
                    </MudText>
                }

                <MudSpacer/>

                <MudIconButton size="Size.Small" Color="Color.Info" Class="ma-0 pa-0"
                               Icon="@(_infoVisible
                                         ? Icons.Material.Outlined.KeyboardDoubleArrowRight
                                         : Icons.Material.Outlined.KeyboardDoubleArrowLeft)"
                               OnClick="@(() => _infoVisible = !_infoVisible)"/>
            </MudStack>

        </MudStack>
    </ValueContent>
</AttributeValueSky>

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinitionDto? DefinitionDto { get; set; }
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<AttributeDefinitionDto?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnEditChanged { get; set; }
    
    bool _infoVisible;
    private JsonElement? JsonValue { get; set; }
    
    protected override void OnInitialized()
    {
        JsonValue = Value is not null ? JsonSerializer.SerializeToElement(Value) : null;
        base.OnInitialized();
    }
    
    private async Task OnValueChanged(decimal? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        
        JsonValue = value is not null ? JsonSerializer.SerializeToElement(value) : null;
    }

}