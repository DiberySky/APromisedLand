
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

<AttributeValueSky NodeId="@NodeId"
                   ValueId="@ValueId"
                   @bind-JsonValue="@JsonValue"
                   Definition="@DefinitionDto"
                   ReadOnly="@ReadOnly"
                   SubmitVisible="@SubmitVisible"
                   OnSaveClick="@(e => OnSaveClick.InvokeAsync(e))"
                   OnDeleteClick="@(e => OnDeleteClick.InvokeAsync(e))"
                   OnEditChanged="@(e => OnEditChanged.InvokeAsync(e))">
    <ValueContent>
        <MudStack Class="d-flex flex-grow-1" Spacing="0">
            <MudDatePicker Date="@_date"
                           DateChanged="@(OnDateChanged)"
                           Label="@DefinitionDto?.Name"
                           DateFormat="yyyy-MM-dd"
                           Variant="Variant.Outlined"
                           ReadOnly="@ReadOnly"/>

        </MudStack>
    </ValueContent>
</AttributeValueSky>

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinition? DefinitionDto { get; set; }
    [Parameter] public DateTimeOffset? Value { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    
    [Parameter] public bool SubmitVisible { get; set; } = true;

    [Parameter] public EventCallback<AttributeDefinition?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnEditChanged { get; set; }
    
    DateTime? _date;
    private JsonElement? JsonValue { get; set; }

    protected override void OnInitialized()
    {
        _date = Value?.ToLocalTime().DateTime;
        JsonValue = Value is not null ? JsonSerializer.SerializeToElement(Value) : null;
        StateHasChanged();
    }

    private void OnDateChanged(DateTime? value)
    {
        Value = value.HasValue
            ? new DateTimeOffset(value.Value, TimeSpan.Zero)
            : null;

        _ = ValueChanged.InvokeAsync(Value);

        JsonValue = value is not null ? JsonSerializer.SerializeToElement(value) : null;

    }
}