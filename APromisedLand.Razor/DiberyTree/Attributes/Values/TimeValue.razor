@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

<AttributeValueSky NodeId="@NodeId"
                   ValueId="@ValueId"
                   @bind-JsonValue="@JsonValue"
                   DefinitionDto="@DefinitionDto"
                   ReadOnly="@ReadOnly"
                   OnSaveClick="@(e => OnSaveClick.InvokeAsync(e))"
                   OnDeleteClick="@(e => OnDeleteClick.InvokeAsync(e))"
                   OnEditChanged="@(e => OnEditChanged.InvokeAsync(e))">
    <ValueContent>
        <MudStack Class="d-flex flex-grow-1" Spacing="0">
            <MudTimePicker @bind-Time="@Value"
                           Label="@DefinitionDto?.Name"
                           PickerVariant="PickerVariant.Inline"
                           AmPm="false"
                           Variant="Variant.Outlined"
                           TimeFormat="HH:mm"
                           ReadOnly="@ReadOnly"
                           TextChanged="@(OnTimeTextChanged)"/>

        </MudStack>
    </ValueContent>
</AttributeValueSky>

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinitionDto? DefinitionDto { get; set; }
    [Parameter] public TimeSpan? Value { get; set; }
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<AttributeDefinitionDto?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnEditChanged { get; set; }
    
    private JsonElement? JsonValue { get; set; }

    protected override void OnInitialized()
    {
        // 如果父组件未传入值，则初始化为当前本地时间
        if (!Value.HasValue)
        {
            Value = DateTime.Now.TimeOfDay;
            // 通知父组件更新绑定值
            _ = ValueChanged.InvokeAsync(Value);

            JsonValue = Value is not null ? JsonSerializer.SerializeToElement(Value) : null;
        }
    }

    private void OnTimeTextChanged(string? value)
    {
        Value = value != null ? TimeSpan.Parse(value) : null;
        
        _ = ValueChanged.InvokeAsync(Value);

        JsonValue = value is not null ? JsonSerializer.SerializeToElement(Value) : null;
    }
}