@using APromisedLand.Razor.Helper.Blazor
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject DiberyTreeApiClient<TItem> ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MessageService Message

<MudStack Row="true" Class="d-flex flex-grow-1" Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center">
    @if (ValueContent is not null)
    {
        @ValueContent
    }

    @if (!ReadOnly)
    {
        <MudStack Row="true" Spacing="0">
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="@(DeleteClick)"/>
            <MudIconButton Icon="@Icons.Material.Outlined.Save" Color="Color.Success"
                           Size="Size.Small"
                           OnClick="@(SaveClick)"/>
        </MudStack>
    }
</MudStack>


@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinitionDto? DefinitionDto { get; set; }
    [Parameter] public JsonElement? JsonValue { get; set; }
    [Parameter] public EventCallback<JsonElement?> JsonValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public RenderFragment? ValueContent { get; set; }

    [Parameter] public EventCallback<AttributeDto?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDto?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDto?> EditChanged { get; set; }

    protected override void OnInitialized()
    {
        _ = JsonValueChanged.InvokeAsync(JsonValue);
        base.OnInitialized();
    }

    private async Task SaveClick()
    {
        if (ValueId is null || JsonValue is null) return;

        try
        {
            await ApiClient.UpdateValueAsync(NodeId!, ValueId, 
                new UpdateValueDto { Value = JsonValue.Value });
            Snackbar.Add($"属性“{DefinitionDto?.Name}”已更新", Severity.Success);
        }
        catch (Exception ex)
        {
            Message.Details("更新失败。", ex.Message);
        }
    }

    private async Task DeleteClick()
    {
        if (DefinitionDto is null || JsonValue is null) return;

        bool? confirm = await Message.DeleteBoxAsync($"确定要删除属性“{DefinitionDto?.Name}”吗？");
        if (confirm == true)
        {
            if (ValueId is null || NodeId is null) return;

            try
            {
                await ApiClient.DeleteValueAsync(NodeId, ValueId);
                // await LoadAttributes();
                Snackbar.Add($"属性“{DefinitionDto?.Name}”已删除", Severity.Success);
            }
            catch (Exception ex)
            {
                Message.Details("删除失败。", ex.Message);
            }
        }
    }
}