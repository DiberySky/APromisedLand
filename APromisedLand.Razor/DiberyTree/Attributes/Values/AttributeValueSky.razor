
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@inject AttributeApiClient AttributeApiClient
@inject MessageService Message

<MudStack Row="true" Class="d-flex flex-grow-1" Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center">
    @if (ValueContent is not null)
    {
        @ValueContent
    }

    @if (!ReadOnly && Definition?.TypeEnum != AttributeTypeEnum.表格 && SubmitVisible)
    {
        <MudStack Row="true" Spacing="0">
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="@(DeleteClick)"/>
            <MudIconButton Icon="@Icons.Material.Outlined.Save" Color="Color.Success"
                           Size="Size.Small"
                           OnClick="@(SaveClick)"/>
        </MudStack>
    }
</MudStack>


@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinition? Definition { get; set; }
    [Parameter] public JsonElement? JsonValue { get; set; }
    [Parameter] public EventCallback<JsonElement?> JsonValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool SubmitVisible { get; set; } = true;

    [Parameter] public RenderFragment? ValueContent { get; set; }

    [Parameter] public EventCallback<AttributeDefinition?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnEditChanged { get; set; }


    protected override void OnInitialized()
    {
        _ = JsonValueChanged.InvokeAsync(JsonValue);
        base.OnInitialized();
    }

    private async Task SaveClick()
    {
        if (ValueId is null || JsonValue is null) return;

        try
        {
            await AttributeApiClient.UpdateValueAsync(NodeId!, ValueId, 
                new UpdateValueDto { Value = JsonValue.Value });
            Message.Success($"属性“{Definition?.Name}”已更新");
            
            await OnSaveClick.InvokeAsync(Definition);
            await OnEditChanged.InvokeAsync(Definition);
        }
        catch (Exception ex)
        {
            Message.Details("更新失败。", ex.Message);
        }
    }

    private async Task DeleteClick()
    {
        if (Definition is null || JsonValue is null) return;

        bool? confirm = await Message.DeleteBoxAsync($"确定要删除属性“{Definition?.Name}”吗？");
        if (confirm == true)
        {
            if (ValueId is null || NodeId is null) return;

            try
            {
                await AttributeApiClient.DeleteValueAsync(NodeId, ValueId);
                // await LoadAttributes();
                Message.Success($"属性“{Definition?.Name}”已删除");
                
                await OnDeleteClick.InvokeAsync(Definition);
                await OnEditChanged.InvokeAsync(Definition);
            }
            catch (Exception ex)
            {
                Message.Details("删除失败。", ex.Message);
            }
        }
    }
}