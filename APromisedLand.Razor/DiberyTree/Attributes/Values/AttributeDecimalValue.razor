
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@


<MudStack Class="d-flex flex-grow-1" Spacing="0">
    <MudNumericField T="decimal?"
                     Value="@Value"
                     ValueChanged="@OnValueChanged"
                     Label="@Definition?.Name"
                     Variant="Variant.Outlined"
                     Format="@($"N{Definition?.Scale ?? 2}")"
                     HideSpinButtons="true"
                     Min="0"
                     FullWidth="true"
                     Margin="Margin.Normal"
                     Adornment="Adornment.End"
                     AdornmentText="@Definition?.Unit?.Name"
                     ReadOnly="@ReadOnly"/>

    <MudStack Row="true">
        @if (_infoVisible)
        {
            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                类型：@Definition?.TypeName,
                整数位数：@(Definition?.Precision - Definition?.Scale),
                小数位数：@Definition?.Scale
                @if (!string.IsNullOrEmpty(Definition?.Unit?.Abbreviation))
                {
                    <span>，单位：@Definition.Unit?.Abbreviation</span>
                }
            </MudText>
        }

        <MudSpacer/>

        <MudIconButton size="Size.Small" Color="Color.Info" Class="ma-0 pa-0"
                       Icon="@(_infoVisible
                                 ? Icons.Material.Outlined.KeyboardDoubleArrowRight
                                 : Icons.Material.Outlined.KeyboardDoubleArrowLeft)"
                       OnClick="@(() => _infoVisible = !_infoVisible)"/>
    </MudStack>

</MudStack>

@code {
    [Parameter] public required string? NodeId { get; set; }
    
    [Parameter] public Shared.DiberyTree.Attributes.Models.AttributeDefinition? Definition { get; set; }
    
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }

    [Parameter] public JsonElement? JsonValue { get; set; }
    [Parameter] public EventCallback<JsonElement?> JsonValueChanged { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool SubmitVisible { get; set; } = true;

    [Parameter] public EventCallback<AttributeDefinition?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnEditChanged { get; set; }

    bool _infoVisible;
    private JsonElement? _jsonValue;

    protected override void OnInitialized()
    {
        if (Definition is null)
        {
            Definition = new Shared.DiberyTree.Attributes.Models.AttributeDefinition(AttributeTypeEnum.小数);
        }
        
        if (JsonValue != null)
        {
            Value = JsonValue.Value.GetValue<decimal>();
        }

        // _jsonValue = Value is not null ? JsonSerializer.SerializeToElement(Value) : default;
        // _ = JsonValueChanged.InvokeAsync(_jsonValue);

        base.OnInitialized();
    }

    private void OnValueChanged(decimal? value)
    {
        Value = value;
        // _ = ValueChanged.InvokeAsync(value);

        _jsonValue = JsonSerializer.SerializeToElement(value);
        // AttributeJsonValue = _jsonValue.Value;
        // _ = AttributeJsonValueChanged.InvokeAsync(AttributeJsonValue);
    }

}