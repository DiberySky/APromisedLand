
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@if (ReadOnly)
{
    <MudDatePicker Date="@_date"
                   DateChanged="@(OnDateChanged)"
                   Label="@DefinitionDto?.Name"
                   DateFormat="yyyy-MM-dd HH:mm"
                   Variant="Variant.Outlined"
                   ReadOnly="@ReadOnly"/>
}
else
{
    <AttributeValueSky NodeId="@NodeId"
                       ValueId="@ValueId"
                       @bind-JsonValue="@JsonValue"
                       Definition="@DefinitionDto"
                       ReadOnly="@ReadOnly"
                       SubmitVisible="@SubmitVisible"
                       OnSaveClick="@(e => OnSaveClick.InvokeAsync(e))"
                       OnDeleteClick="@(e => OnDeleteClick.InvokeAsync(e))"
                       OnEditChanged="@(e => OnEditChanged.InvokeAsync(e))">
        <ValueContent>
            <MudStack Class="d-flex flex-grow-1" Row="true" Spacing="0">
                <MudDatePicker Date="@_date"
                               DateChanged="@(OnDateChanged)"
                               Label="@DefinitionDto?.Name"
                               DateFormat="yyyy-MM-dd"
                               Variant="Variant.Outlined"
                               ReadOnly="@ReadOnly"/>

                <MudTimePicker @bind-Time="_selectedTime"
                               Label="选择时间"
                               Variant="Variant.Outlined"
                               TimeFormat="HH:mm"
                               ReadOnly="@ReadOnly"
                               TextChanged="@(OnTimeTextChanged)"/>
            </MudStack>
        </ValueContent>
    </AttributeValueSky>
}

@* TimeChanged="@(OnTimeChanged)" *@

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public string? ValueId { get; set; }
    [Parameter] public AttributeDefinition? DefinitionDto { get; set; }
    [Parameter] public DateTimeOffset? Value { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    
    [Parameter] public bool SubmitVisible { get; set; } = true;

    [Parameter] public EventCallback<AttributeDefinition?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinition?> OnEditChanged { get; set; }
    
    DateTime? _date;
    TimeSpan? _selectedTime;

    private JsonElement? JsonValue { get; set; }
    
    protected override void OnInitialized()
    {
        _date = Value?.ToLocalTime().DateTime;
        _selectedTime = Value?.ToLocalTime().TimeOfDay;

        JsonValue = Value is not null ? JsonSerializer.SerializeToElement(Value) : null;
        
        StateHasChanged();
    }

    private DateTimeOffset? Combine(DateTime? date, TimeSpan? time)
    {
        if (date.HasValue && time.HasValue)
        {
            var datePart = date.Value.Date;
            var combinedDateTime = datePart + time.Value;
            // 使用当前系统的本地时区偏移
            var localOffset = TimeZoneInfo.Local.GetUtcOffset(combinedDateTime);
            return new DateTimeOffset(combinedDateTime, localOffset);
        }
        else if (date.HasValue && !time.HasValue)
        {
            var localOffset = TimeZoneInfo.Local.GetUtcOffset(date.Value);
            return new DateTimeOffset(date.Value, localOffset);
        }
        else
        {
            return null;
        }
    }

    private void OnDateChanged(DateTime? value)
    {
        _date = value;

        Value = Combine(value, _selectedTime);

        _ = ValueChanged.InvokeAsync(Value);
        
        JsonValue = value is not null ? JsonSerializer.SerializeToElement(Value) : null;
    }

    private void OnTimeTextChanged(string? value)
    {
        _selectedTime = value != null ? TimeSpan.Parse(value) : null;

        Value = Combine(_date, _selectedTime);

        _ = ValueChanged.InvokeAsync(Value);
        
        JsonValue = value is not null ? JsonSerializer.SerializeToElement(Value) : null;
    }
}