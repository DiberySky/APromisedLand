@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject IDialogService DialogService
@inject DiberyTreeApiClient<TItem> ApiClient
@inject ISnackbar Snackbar
@inject TreeNodeDialogService<TItem> TreeNodeDialogService

<DialogSky Title="添加属性"
           CancelButtonVisible="true"
           SubmitButtonVisible="true"
           OnSubmitClick="@SubmitAsync"
           OnCanceledClick="@(() => MudDialog?.Close(DialogResult.Cancel()))">
    <DialogContent>
        <MudGrid Class="pa-4">
            <MudItem xs="12">
                <AttributeTypeField TItem="TItem" AttributeDefinitionDto="@_attributeDefinition"
                                  AttributeDefinitionChanged="@(e => _attributeDefinition = e)"/>
            </MudItem>
            @* <MudItem xs="12"> *@
            @*     <MudTextField @bind-Value="@_attributeDefinition?.Name" Label="@_attributeDefinition?.Name" *@
            @*                   Variant="Variant.Outlined" ReadOnly="true" *@
            @*                   InputType="@InputType.Text" Adornment="Adornment.End" *@
            @*                   AdornmentIcon="@Icons.Material.Outlined.EditNote" *@
            @*                   AdornmentColor="Color.Info" *@
            @*                   OnAdornmentClick="@EditClick" *@
            @*                   AdornmentAriaLabel=""/> *@
            @* </MudItem> *@
            @* <MudItem xs="10"> *@
            @*     <MudSelect T="AttributeDefinitionDto" Label="选择属性定义" *@
            @*                @bind-Value="_attributeDefinition" *@
            @*                For="@(() => _attributeDefinition)" *@
            @*                AnchorOrigin="Origin.BottomLeft" *@
            @*                Variant="Variant.Outlined" *@
            @*                Margin="Margin.Dense"> *@
            @*         @foreach (var def in _definitions) *@
            @*         { *@
            @*             <MudSelectItem Value="@def">@def.Name</MudSelectItem> *@
            @*         } *@
            @*     </MudSelect> *@
            @* </MudItem> *@
            @* <MudItem xs="2"> *@
            @*     <MudIconButton Icon="@Icons.Material.Outlined.EditNote" *@
            @*                    Color="Color.Info"/> *@
            @* </MudItem> *@
            <MudItem xs="12">
                <MudTextField Label="属性值" @bind-Value="_value"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"/>
                @if (!string.IsNullOrEmpty(_attributeDefinition?.AttributeType?.Name))
                {
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        类型：@_attributeDefinition.AttributeType.Name
                        @if (!string.IsNullOrEmpty(_attributeDefinition.Unit?.Abbreviation))
                        {
                            <span>，单位：@_attributeDefinition.Unit?.Abbreviation</span>
                        }
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public required string NodeId { get; set; }

    private List<AttributeDefinitionDto> _definitions = new();
    private AttributeDefinitionDto? _attributeDefinition;
    private string _value = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var defs = await ApiClient.GetAllDefinitionsAsync();
            _definitions = defs.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性定义失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task SubmitAsync()
    {
        if (_attributeDefinition == null)
        {
            Snackbar.Add("请选择属性定义", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_value))
        {
            Snackbar.Add("请输入属性值", Severity.Warning);
            return;
        }

        try
        {
            // 注意：AddValueDto 的 AttributeDefinitionId 为 string，但后端期望 int，需统一
            var dto = new AddValueDto(
                AttributeDefinitionId: _attributeDefinition.Id.ToString(),
                Value: _value
            );
            // await ApiClient.AddValueAsync(NodeId, dto);
            Snackbar.Add("属性添加成功", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"添加失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditClick()
    {
        var dialogParams = new DialogParameters<AttributeDefinitionListDialog<TItem>>
        {
            // { x => x.NodeId, NodeId }
        };
        var result = await TreeNodeDialogService.ShowAttributeDefinitionListDialogAsync();
        // var result = await dialog;
        // if (!result.Canceled)
        // {
        //     // await LoadAttributes(); // 刷新列表
        // }
    }

    private void AttributeDefinitionChanged(AttributeDefinitionDto dto)
    {
        _attributeDefinition = dto;
        
        StateHasChanged();
    }

}