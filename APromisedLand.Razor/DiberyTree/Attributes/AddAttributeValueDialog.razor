@using System.Text.Json
@using APromisedLand.Razor.DiberyTree.Attributes.Values
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject IDialogService DialogService
@inject DiberyTreeApiClient<TItem> ApiClient
@inject ISnackbar Snackbar
@inject TreeNodeDialogService<TItem> TreeNodeDialogService

<DialogSky Title="添加属性"
           CancelButtonVisible="true"
           SubmitButtonVisible="true"
           OnSubmitClick="@SubmitAsync"
           OnCanceledClick="@(() => MudDialog?.Close(DialogResult.Cancel()))">
    <DialogContent>
        <MudGrid Class="pa-4">
            <MudItem xs="12">
                <AttributeTypeField TItem="TItem" AttributeDefinitionDto="@_definition"
                                    AttributeDefinitionChanged="@(e => _definition = e)"/>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="@_definition?.Name" Label="属性名称"
                              Variant="Variant.Outlined"
                              InputType="@InputType.Text" />
            </MudItem>
            @switch (_definition?.AttributeType.SystemType)
            {
                case AttributeTypeEnum.文本:
                    <MudItem xs="12">
                        <TextValue @bind-Value="@_textValue"
                                   Definition="@_definition"
                        />
                    </MudItem>
                    break;
                case AttributeTypeEnum.整数:
                    <MudItem xs="12">
                        <IntegerValue @bind-Value="@_integerValue"
                                      Definition="@_definition"
                        />
                    </MudItem>
                    break;
                case AttributeTypeEnum.小数:
                    <MudItem xs="12">
                        <DecimalValue @bind-Value="@_decimalValue"
                                      Definition="@_definition"
                        />
                    </MudItem>
                    break;
                case AttributeTypeEnum.日期:
                    <MudItem xs="12">
                        <MudText>日期类型输入控件待实现</MudText>
                        @* 此处可添加 DateValue 组件 *@
                    </MudItem>
                    break;
                case AttributeTypeEnum.时间:
                    <MudItem xs="12">
                        <MudText>时间类型输入控件待实现</MudText>
                    </MudItem>
                    break;
                case AttributeTypeEnum.日期时间:
                    <MudItem xs="12">
                        <MudText>日期时间类型输入控件待实现</MudText>
                    </MudItem>
                    break;
                case AttributeTypeEnum.文件:
                    <MudItem xs="12">
                        <MudText>文件类型输入控件待实现</MudText>
                    </MudItem>
                    break;
                case AttributeTypeEnum.定位:
                    <MudItem xs="12">
                        <MudText>定位类型输入控件待实现</MudText>
                    </MudItem>
                    break;
                case null:
                    break;
                default:
                    throw new ArgumentOutOfRangeException();
            }
        </MudGrid>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public required string NodeId { get; set; }

    private AttributeDefinitionDto? _definition;

    // 各类型值字段
    private string? _textValue;
    private long? _integerValue;
    private decimal? _decimalValue;
    private DateTimeOffset? _dateValue;
    private TimeSpan? _timeValue;
    private DateTimeOffset? _dateTimeValue;
    private string? _fileUrl;
    private double? _latitude;
    private double? _longitude;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // var defs = await ApiClient.GetAllDefinitionsAsync();
            // _definitions = defs.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性定义失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task SubmitAsync()
    {
        if (_definition == null)
        {
            Snackbar.Add("请选择属性定义", Severity.Warning);
            return;
        }

        // 根据类型检查对应的值是否填写
        switch (_definition.AttributeType.SystemType)
        {
            case AttributeTypeEnum.文本:
                if (string.IsNullOrWhiteSpace(_textValue))
                {
                    Snackbar.Add("请输入文本值", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.整数:
                if (!_integerValue.HasValue)
                {
                    Snackbar.Add("请输入整数值", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.小数:
                if (!_decimalValue.HasValue)
                {
                    Snackbar.Add("请输入小数值", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.日期:
                if (!_dateValue.HasValue)
                {
                    Snackbar.Add("请选择日期", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.时间:
                if (!_timeValue.HasValue)
                {
                    Snackbar.Add("请选择时间", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.日期时间:
                if (!_dateTimeValue.HasValue)
                {
                    Snackbar.Add("请选择日期时间", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.文件:
                if (string.IsNullOrWhiteSpace(_fileUrl))
                {
                    Snackbar.Add("请上传文件", Severity.Warning);
                    return;
                }
                break;
            case AttributeTypeEnum.定位:
                if (!_latitude.HasValue || !_longitude.HasValue)
                {
                    Snackbar.Add("请输入经纬度", Severity.Warning);
                    return;
                }
                break;
            default:
                Snackbar.Add("不支持的属性类型", Severity.Warning);
                return;
        }

        try
        {
            JsonElement valueElement;
            switch (_definition.AttributeType.SystemType)
            {
                case AttributeTypeEnum.文本:
                    valueElement = JsonSerializer.SerializeToElement(_textValue);
                    break;
                case AttributeTypeEnum.整数:
                    valueElement = JsonSerializer.SerializeToElement(_integerValue);
                    break;
                case AttributeTypeEnum.小数:
                    valueElement = JsonSerializer.SerializeToElement(_decimalValue);
                    break;
                case AttributeTypeEnum.日期:
                    valueElement = JsonSerializer.SerializeToElement(_dateValue!.Value.ToString("yyyy-MM-dd"));
                    break;
                case AttributeTypeEnum.时间:
                    valueElement = JsonSerializer.SerializeToElement(_timeValue!.Value.ToString(@"hh\:mm\:ss"));
                    break;
                case AttributeTypeEnum.日期时间:
                    valueElement = JsonSerializer.SerializeToElement(_dateTimeValue!.Value.ToString("O"));
                    break;
                case AttributeTypeEnum.文件:
                    valueElement = JsonSerializer.SerializeToElement(_fileUrl);
                    break;
                case AttributeTypeEnum.定位:
                    valueElement = JsonSerializer.SerializeToElement(new { latitude = _latitude!.Value, longitude = _longitude!.Value });
                    break;
                default:
                    throw new NotSupportedException($"不支持的类型 {_definition.AttributeType.SystemType}");
            }

            var dto = new AddValueDto(_definition.Id, valueElement);
            await ApiClient.AddValueAsync(NodeId, dto);

            Snackbar.Add("属性添加成功", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"添加失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task EditClick()
    {
        var dialogParams = new DialogParameters<AttributeDefinitionListDialog<TItem>>
        {
            // { x => x.NodeId, NodeId }
        };
        var result = await TreeNodeDialogService.ShowAttributeDefinitionListDialogAsync();
        // var result = await dialog;
        // if (!result.Canceled)
        // {
        //     // await LoadAttributes(); // 刷新列表
        // }
    }

    private void AttributeDefinitionChanged(AttributeDefinitionDto dto)
    {
        _definition = dto;
        // 切换定义时清空之前的值，防止类型混淆
        _textValue = null;
        _integerValue = null;
        _decimalValue = null;
        _dateValue = null;
        _timeValue = null;
        _dateTimeValue = null;
        _fileUrl = null;
        _latitude = null;
        _longitude = null;
        StateHasChanged();
    }
}