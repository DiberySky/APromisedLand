@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@inject AttributeApiClient AttributeApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">属性列表</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenAddDialog">
                添加属性
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_loading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_attributes == null || !_attributes.Any())
        {
            <MudText>此节点暂无属性</MudText>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var attr in _attributes)
                {
                    var typeEnum = attr.Def?.AttributeTypeId.ToAttributeTypeEnum() ?? default;
                    var unit = attr.Def?.Unit?.Abbreviation ?? attr.Def?.Unit?.Name;
                    var lines = attr.Def?.Lines ?? 1;
                    var maxLength = attr.Def?.MaxLength;
                    var label = attr.Def?.Name ?? "未命名属性";

                    <MudGrid Class="align-center">
                        <MudItem xs="12" sm="9">
                            @if (IsNumericType(typeEnum))
                            {
                                <MudNumericField T="decimal?"
                                                 Value="@(attr.Value.GetValue<decimal?>())"
                                                 ValueChanged="@((decimal? v) => { attr.Value = JsonSerializer.SerializeToElement(v); StateHasChanged(); })"
                                                 Label="@label"
                                                 Variant="Variant.Outlined"
                                                 Format="@($"N{GetScale(typeEnum)}")"
                                                 Min="@GetMinValue(typeEnum)"
                                                 FullWidth="true"
                                                 Margin="Margin.Normal"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="@unit"
                                                 OnBlur="@(() => SaveValue(attr))" />
                            }
                            else
                            {
                                <MudTextField T="string"
                                              Value="@(attr.Value.GetValue<string>())"
                                              ValueChanged="@((string v) => { attr.Value = JsonSerializer.SerializeToElement(v); StateHasChanged(); })"
                                              Label="@label"
                                              Variant="Variant.Outlined"
                                              Lines="@lines"
                                              MaxLength="@(maxLength ?? 30)"
                                              FullWidth="true"
                                              Margin="Margin.Normal"
                                              Immediate="true"
                                              OnBlur="@(() => SaveValue(attr))" />
                            }
                        </MudItem>
                        <MudItem xs="12" sm="3" Class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Success"
                                           OnClick="@(() => SaveValue(attr))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           OnClick="@(() => DeleteValue(attr))" />
                        </MudItem>
                    </MudGrid>
                }
            </MudStack>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public required string NodeId { get; set; }

    private List<AttributeJsonValueDto>? _attributes;
    private bool _loading;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAttributes();
    }

    private async Task LoadAttributes()
    {
        if (string.IsNullOrEmpty(NodeId)) return;
        _loading = true;
        try
        {
            var result = await AttributeApiClient.GetAllValuesAsync(NodeId);
            _attributes = result?.AttributeJsonValueDtos ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddDialog()
    {
        var dialogParams = new DialogParameters
        {
            { nameof(AddAttributeValueDialog.NodeId), NodeId }
        };
        var dialog = await DialogService.ShowAsync<AddAttributeValueDialog>("添加属性", dialogParams);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await LoadAttributes();
        }
    }

    private async Task DeleteValue(AttributeJsonValueDto attr)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定要删除属性“{attr.Def?.Name ?? "未命名"}”吗？",
            "删除", "取消");
        if (confirm == true)
        {
            try
            {
                await AttributeApiClient.DeleteValueAsync(NodeId, attr.Id);
                await LoadAttributes();
                Snackbar.Add($"属性“{attr.Def?.Name}”已删除", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task SaveValue(AttributeJsonValueDto attr)
    {
        try
        {
            await AttributeApiClient.UpdateValueAsync(NodeId, attr.Id, new UpdateValueDto { Value = attr.Value });
            Snackbar.Add($"属性“{attr.Def?.Name}”已更新", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"更新失败: {ex.Message}", Severity.Error);
        }
    }

    // ---------- 辅助方法 ----------
    private bool IsNumericType(AttributeTypeEnum type)
        => type == AttributeTypeEnum.整数 || type == AttributeTypeEnum.小数;

    private int GetScale(AttributeTypeEnum type)
        => type == AttributeTypeEnum.小数 ? 2 : 0;

    private decimal? GetMinValue(AttributeTypeEnum type) => 0;
}