@using APromisedLand.Razor.Helper.Blazor
@using System.Text.Json
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject AttributeApiClient AttributeApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject MessageService Message

<DialogSky Title="位置坐标"
           SubmitButtonVisible="true"
           CancelButtonVisible="true"
           OnSubmitClick="HandleSubmitAsync"
           OnCanceledClick="HandleCancel">
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudContainer class="my-4">
                <MudStack Class="d-flex flex-grow-1" Spacing="0">
                    <MudGrid Class="ma-0 pa-0">
                        <MudItem xs="12" sm="6" Class="pa-1">
                            <MudNumericField T="double" Value="@Latitude"
                                             Label="纬度 (Latitude)"
                                             Variant="Variant.Outlined"
                                             Min="-90" Max="90"
                                             FullWidth="true"
                                             Immediate="true"
                                             ValueChanged="OnLatitudeChanged"
                                             ReadOnly="@ReadOnly"/>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="pa-1">
                            <MudNumericField T="double" Value="@Longitude"
                                             Label="经度 (Longitude)"
                                             Variant="Variant.Outlined"
                                             Min="-180" Max="180"
                                             FullWidth="true"
                                             Immediate="true"
                                             ValueChanged="OnLongitudeChanged"
                                             ReadOnly="@ReadOnly"/>
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true">
                        @if (_infoVisible)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                类型：@DefinitionDto!.AttributeType.ToName()，
                                纬度范围 [-90, 90]，经度范围 [-180, 180]
                            </MudText>
                        }
                        <MudSpacer/>
                        <MudIconButton Size="Size.Small" Color="Color.Info" Class="ma-0 pa-0"
                                       Icon="@(_infoVisible
                                                 ? Icons.Material.Outlined.KeyboardDoubleArrowRight
                                                 : Icons.Material.Outlined.KeyboardDoubleArrowLeft)"
                                       OnClick="@(() => _infoVisible = !_infoVisible)"/>
                    </MudStack>
                </MudStack>
            </MudContainer>
        </MudForm>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public required string? LocationId { get; set; }
    [Parameter] public AttributeDefinitionDto? DefinitionDto { get; set; }
    
    [Parameter] public double Latitude { get; set; }
    [Parameter] public EventCallback<double> LatitudeChanged { get; set; }
    [Parameter] public double Longitude { get; set; }
    [Parameter] public EventCallback<double> LongitudeChanged { get; set; }
    
    [Parameter] public bool ReadOnly { get; set; }

    private bool _infoVisible;
    private JsonElement? JsonValue { get; set; }
    private MudForm? _form;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        JsonValue = JsonSerializer.SerializeToElement(new { latitude = Latitude, longitude = Longitude });
        base.OnInitialized();
    }

    private void OnLatitudeChanged(double value)
    {
        Latitude = value;
        _ = LatitudeChanged.InvokeAsync(value);
        UpdateJsonValue();
    }

    private void OnLongitudeChanged(double value)
    {
        Longitude = value;
        _ = LongitudeChanged.InvokeAsync(value);
        UpdateJsonValue();
    }

    private void UpdateJsonValue()
    {
        JsonValue = JsonSerializer.SerializeToElement(new { latitude = Latitude, longitude = Longitude });
    }

    private async Task HandleSubmitAsync()
    {
        // 提交锁：防止连续点击/事件重入导致多次调用
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (_form == null) return;
            await _form.ValidateAsync();
            if (!_form.IsValid) return;

            // 校验必填
            try
            {
                await AttributeApiClient.UpdateValueAsync(NodeId!, LocationId, 
                    new UpdateValueDto { Value = JsonValue.Value });
                Message.Success($"属性“{DefinitionDto?.Name}”已更新");
                
                Message.Success("保存成功");
                MudDialog?.Close(DialogResult.Ok(true));
            }
            catch (ArgumentException ex)
            {
                Message.Details("保存失败.", ex.Message);
            }
            catch (Exception ex)
            {
                Message.Details("保存失败.", ex.Message);
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
    }
}
