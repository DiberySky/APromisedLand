@using APromisedLand.Razor.DiberyTree.Attributes.Tables
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@inject AttributeApiClient AttributeApiClient
@inject ISnackbar Snackbar
@* @inject TreeNodeDialogService<TItem> TreeNodeDialogService *@
@inject IDialogService DialogService
@inject MessageService Message

<DialogSky Title="添加修改属性"
           CancelButtonVisible="true"
           SubmitButtonVisible="false"
           OnCanceledClick="@(() => MudDialog?.Close(DialogResult.Cancel()))">
    <ToolBarContent>
        <MudText Color="Color.Inherit">附加属性</MudText>
        <MudSpacer/>
        <MudSwitch T="bool"
                   @bind-Value="@ReadOnly"
                   Label="仅查看" Color="Color.Info"/>
    </ToolBarContent>
    <DialogContent>
        <MudContainer>
            <MudTable T="AttributeDefinitionDto"
                      Items="_definitions"
                      @ref="_tableRef"
                      GroupBy="@_groupDefinition"
                      GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                      Dense="true"
                      Hover="true"
                      Striped="false"
                      Loading="_loading"
                      LoadingProgressColor="Color.Primary"
                      Breakpoint="Breakpoint.Sm"
                      SelectedItemChanged="@SelectedItemChanged">
                <GroupHeaderTemplate>
                    <MudTh Class="mud-table-cell-custom-group" colspan="7">
                        @($"{context.GroupName} => {context.Key?.ToString()!.ToAttributeTypeName()}")
                    </MudTh>
                </GroupHeaderTemplate>
                <HeaderContent>
                    <MudTh>属性名称</MudTh>
                    <MudTh>类型</MudTh>
                    <MudTh Style="text-align:right">
                        <!-- 新增：展开/折叠所有分组按钮 -->
                        @if (_expand)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowUp"
                                           Size="Size.Small"
                                           OnClick="@(() =>
                                                    {
                                                        _expand = !_expand;
                                                        _tableRef?.CollapseAllGroups();
                                                    })"/>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowDown"
                                           Size="Size.Small"
                                           OnClick="@(() =>
                                                    {
                                                        _expand = !_expand;
                                                        _tableRef?.ExpandAllGroups();
                                                    })"/>
                        }
                        @if (!ReadOnly)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDialogAsync())"/>
                        }
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="属性名称">
                        <MudText Typo="Typo.body1" Color="Color.Success">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="类型">
                        <MudText Typo="Typo.body1" Color="Color.Info">@context.Definition().AttributeTypeId.ToAttributeTypeName()?.ToLowerInvariant()</MudText>
                    </MudTd>
                    @if (!ReadOnly)
                    {
                        <MudTd Style="text-align:right">
                            @if (_deleteable)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteAsync(context))"/>
                            }
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDialogAsync(context))"/>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Outlined.MoreHoriz"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="() => OpenDialogAsync(context)"/>
                            <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           OnClick="() => SelectedItemChanged(context)"/>
                        </MudTd>
                    }
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="py-8">暂无属性定义数据</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @if (!ReadOnly)
        {
            <MudSwitch T="bool" @bind-Value="@_deleteable"
                       Size="Size.Small"
                       Label="允许删除" Color="Color.Error"/>
        }
    </DialogLeftActions>
</DialogSky>

<style>
    .mud-table-cell-custom-group {
        font-weight: 500;
    }
</style>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    private List<AttributeDefinitionDto> _definitions = new();
    private List<AttributeTypeEnum> _attributeTypes = new();
    private List<UnitTree> _units = new(); // 保留未使用，可后续扩展
    private bool _loading;
    private bool _deleteable;
    private bool _expand;

    // 新增：表格引用，用于控制分组展开/折叠
    private MudTable<AttributeDefinitionDto>? _tableRef;

    // 新增：分组定义（默认折叠，可展开）
    private TableGroupDefinition<AttributeDefinitionDto> _groupDefinition = new()
    {
        GroupName = "属性类型",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = false,
        Selector = (e) => e.Definition().AttributeTypeId
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var defsTask = await AttributeApiClient.GetAllDefinitionsAsync();
            _definitions = [.. defsTask];

            // 按属性类型枚举排序（升序）
            _definitions = _definitions.OrderBy(d => d.Definition().AttributeTypeId.ToAttributeTypeEnum()).ToList();

            _attributeTypes = AttributeTypeMapping.All;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载数据失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDialogAsync(AttributeDefinitionDto? item = null)
    {
        if (item == null)
        {
            await OpenDefinitionDialogAsync(item);
            return;
        }
        
        switch (item.Definition().AttributeTypeId.ToAttributeTypeEnum())
        {
            case AttributeTypeEnum.表格:
                await OpenTableDialogAsync(item);
                break;
            case AttributeTypeEnum.文本:
            case AttributeTypeEnum.整数:
            case AttributeTypeEnum.日期:
            case AttributeTypeEnum.时间:
                await OpenDefinitionDialogAsync(item);
                break;
            default:
                throw new NotImplementedException($"不支持的属性类型: {item.Definition().AttributeTypeId}");
        }
    }

    private async Task OpenDefinitionDialogAsync(AttributeDefinitionDto? item)
    {
        var result = await DialogService.ShowAttributeDefinitionDialogAsync(item);
        // 如果子对话框返回了 true（表示成功创建/修改），刷新列表
        if (result == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenTableDialogAsync(AttributeDefinitionDto? item)
    {
        if (item == null) return;

        var result = await ShowAttributeTableDefinitionDialogAsync(item);
        // 如果子对话框返回了 true（表示成功创建/修改），刷新列表
        if (result == true)
        {
            await LoadDataAsync();
        }
    }
    
    public async Task<bool> ShowAttributeTableDefinitionDialogAsync(
        AttributeDefinitionDto item, 
        // List<AttributeTypeEnum> attributeTypes,
        DialogConfig? config = null)
    {
        var parameters = new DialogParameters<AttributeTableDefinitionDialog>
        {
            { x => x.TableDefinitionDto, item },
        };

        var options = (config ?? new DialogConfig
        {
        }).ToDialogOptions();

        var dialog = await DialogService.ShowAsync<AttributeTableDefinitionDialog>(
            "表格属性定义", parameters, options);

        var result = await dialog.Result;
        // 只要不是取消就返回 true（表示可能已修改）
        return result is not { Canceled: true };
    }
    
    private async Task DeleteAsync(AttributeDefinitionDto item)
    {
        var confirmed = await Message.DeleteBoxAsync(
            $"确定要删除属性定义【{item.Name}】吗？如果已被节点引用将无法删除。");

        if (!confirmed) return;

        try
        {
            var success = await AttributeApiClient.DeleteDefinitionAsync(item.Id);
            if (success)
            {
                Snackbar.Add("删除成功", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("删除失败，属性定义不存在", Severity.Warning);
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private void Modifiable(bool modify)
    {
        ReadOnly = modify;

        _deleteable = !ReadOnly;

        StateHasChanged();
    }

    private void Deletable(bool delete)
    {
        _deleteable = delete;
        StateHasChanged();
    }

    private void SelectedItemChanged(AttributeDefinitionDto selectedItem)
    {
        MudDialog?.Close(DialogResult.Ok(selectedItem));
    }

}