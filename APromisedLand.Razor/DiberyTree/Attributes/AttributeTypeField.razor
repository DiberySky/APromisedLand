
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@inject IDialogService DialogService

<MudTextField @bind-Value="@AttributeDefinitionDto?.Name"
              Label="属性默认名称"
              Variant="Variant.Outlined" ReadOnly="true"
              InputType="@InputType.Text" Adornment="Adornment.End"
              AdornmentIcon="@Icons.Material.Outlined.EditNote"
              AdornmentColor="Color.Info"
              OnAdornmentClick="@EditClick"
              AdornmentAriaLabel=""/>

@code {
    [Parameter] public AttributeDefinition? AttributeDefinitionDto { get; set; }
    [Parameter] public EventCallback<AttributeDefinition> AttributeDefinitionChanged { get; set; }

    private async Task EditClick()
    {
        var result = await DialogService.ShowAttributeDefinitionListDialogAsync();
     
        if (result == null) return;
        
        AttributeDefinitionDto = result;
        
        StateHasChanged();
        
        await AttributeDefinitionChanged.InvokeAsync(result);
    }

}