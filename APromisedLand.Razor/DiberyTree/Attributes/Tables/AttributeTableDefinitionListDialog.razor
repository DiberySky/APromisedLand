@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject AttributeApiClient AttributeApiClient
@inject ISnackbar Snackbar
@inject DialogService DialogService
@inject MessageService Message

<DialogSky Title="动态表管理"
           CancelButtonVisible="true"
           SubmitButtonVisible="false"
           OnCanceledClick="@(() => MudDialog?.Close(DialogResult.Cancel()))">
    <ToolBarContent>
        <MudText Color="Color.Inherit">表定义</MudText>
        <MudSpacer/>
        <MudButton Variant="Variant.Text" Color="Color.Warning"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   OnClick="LoadDataAsync" Class="ml-2">
            刷新
        </MudButton>
    </ToolBarContent>
    <DialogContent>
        <MudContainer>
            <MudTable T="AttributeDefinitionDto"
                      Items="_tables"
                      Dense="true"
                      Hover="true"
                      Loading="_loading"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>表名</MudTh>
                    <MudTh Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                       Color="Color.Info" Size="Size.Small"
                                       OnClick="() => OpenTableDialogAsync(null)"/>
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="表名">
                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="@(() => OpenColumnsAsync(context))">
                            @context.Name
                        </MudButton>
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Outlined.TableRows" Color="Color.Info"
                                       Size="Size.Small" Title="行数据"
                                       OnClick="@(() => OpenRowsAsync(context))"/>
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary"
                                       Size="Size.Small" Title="编辑表"
                                       OnClick="@(() => OpenTableDialogAsync(context))"/>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Warning"
                                       Size="Size.Small" Title="删除表"
                                       OnClick="@(() => DeleteTableAsync(context))"/>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="py-8">暂无表定义</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudContainer>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private List<AttributeDefinitionDto> _tables = new();
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            // 新 API：服务端过滤表定义（ParentId=null 且 AttributeType=表格）+ 按名称排序
            var list = await AttributeApiClient.ListTablesAsync();
            _tables = [.. list];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task OpenTableDialogAsync(AttributeDefinitionDto? item)
    {
        var parameters = new DialogParameters<AttributeTableDefinitionDialog<TItem>>
        {
            { x => x.Table, item }
        };
        var dialog = await DialogService.ShowAsync<AttributeTableDefinitionDialog<TItem>>(
            item == null ? "新建表" : "编辑表", parameters);
        var result = await dialog.Result;
        if (!result.Canceled) await LoadDataAsync();
    }

    private async Task OpenColumnsAsync(AttributeDefinitionDto table)
    {
        var parameters = new DialogParameters<AttributeTableColumnsDialog<TItem>> { { x => x.Table, table } };
        await (await DialogService.ShowAsync<AttributeTableColumnsDialog<TItem>>($"列管理 - {table.Name}", parameters)).Result;
        await LoadDataAsync();
    }

    private async Task OpenRowsAsync(AttributeDefinitionDto table)
    {
        var parameters = new DialogParameters<AttributeTableRowsPanelDialog<TItem>> { { x => x.TableDefinitionDto, table } };
        await (await DialogService.ShowAsync<AttributeTableRowsPanelDialog<TItem>>($"行数据 - {table.Name}", parameters)).Result;
    }

    private async Task DeleteTableAsync(AttributeDefinitionDto table)
    {
        var confirmed = await Message.DeleteBoxAsync(
            $"确定删除表【{table.Name}】？其下所有列定义将一并删除。");
        if (!confirmed) return;
        try
        {
            var ok = await AttributeApiClient.DeleteDefinitionAsync(table.Id);
            if (ok) { Snackbar.Add("删除成功", Severity.Success); await LoadDataAsync(); }
            else Snackbar.Add("表不存在", Severity.Warning);
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add($"删除失败: {ex.Message}", Severity.Error); }
    }
}
