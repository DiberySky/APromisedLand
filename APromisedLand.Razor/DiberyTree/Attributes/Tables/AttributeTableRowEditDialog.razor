@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@inject AttributeApiClient AttributeApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject MessageService Message

<DialogSky Title="@TableDefDto.Name"
           SubmitButtonVisible="@(!ReadOnly)"
           CancelButtonVisible="true"
           OnSubmitClick="HandleSubmitAsync"
           OnCanceledClick="HandleCancel">
    <DialogContent>
        <MudForm @ref="_form" ValidationDelay="0">
            <MudContainer class="my-4">
                <MudGrid>
                    @if (TableDefDto.HasDate)
                    {
                        <MudItem xs="12">
                            <DateValue @bind-Value="@_dateOffset"
                                       DefinitionDto="@_dateDef"
                                       ReadOnly="@ReadOnly"
                                       NodeId="@NodeId"/>
                        </MudItem>
                    }

                    @if (TableDefDto.HasTime)
                    {
                        <MudItem xs="12">
                            <TimeValue @bind-Value="@_timeSpan"
                                       DefinitionDto="@_timeDef"
                                       ReadOnly="@ReadOnly"
                                       NodeId="@NodeId"/>
                        </MudItem>
                    }

                    @foreach (var col in ColumnDefDtos)
                    {
                        <MudItem xs="12">
                            @switch (col.AttributeTypeId.ToAttributeTypeEnum())
                            {
                                @*                 case AttributeTypeEnum.文本: *@
                                @*                     $1$ <MudTextField Label="@col.Name" Variant="Variant.Outlined" #1# *@
                                @*                     $1$               @bind-Value="_values[col.Id].Text" #1# *@
                                @*                     $1$               Required="@col.IsRequired" #1# *@
                                @*                     $1$               RequiredError="@($"{col.Name}不能为空")"/> #1# *@
                                @*                     <TextValue @bind-Value="@_values[col.Id].Text" *@
                                @*                                DefinitionDto="@TableDefinitionDto" *@
                                @*                                ReadOnly="@ReadOnly" *@
                                @*                                NodeId="@NodeId"/> *@
                                @*                     break; *@
                                @*                 case AttributeTypeEnum.整数: *@
                                @*                     $1$ <MudNumericField T="int?" Label="@col.Name" Variant="Variant.Outlined" #1# *@
                                @*                     $1$                  @bind-Value="_values[col.Id].Integer" #1# *@
                                @*                     $1$                  Required="@col.IsRequired"/> #1# *@
                                @*                     <IntegerValue @bind-Value="@_values[col.Id].Integer" *@
                                @*                                   DefinitionDto="@TableDefinitionDto" *@
                                @*                                   ReadOnly="@ReadOnly" *@
                                @*                                   NodeId="@NodeId"/> *@
                                @*                     break; *@
                                case AttributeTypeEnum.小数:
                                    <MudNumericField T="decimal?" Label="@col.Name"
                                                     Variant="Variant.Outlined"
                                                     HideSpinButtons="true"
                                                     @bind-Value="_values[col.Id].Decimal"
                                                     Required="@col.IsRequired"/>
                                    <AttributeDecimalValue
                                        @bind-Value="@_values[col.Id].Decimal"
                                        Definition="@col"
                                        ReadOnly="@ReadOnly"
                                        NodeId="@NodeId"/>

                                    break;
                                @*                 case AttributeTypeEnum.日期: *@
                                @*                     <MudDatePicker Label="@col.Name" Variant="Variant.Outlined" *@
                                @*                                    @bind-Value="_values[col.Id].Date" *@
                                @*                                    Required="@col.IsRequired"/> *@
                                @*                     break; *@
                                @*                 case AttributeTypeEnum.时间: *@
                                @*                     <MudTimePicker Label="@col.Name" Variant="Variant.Outlined" *@
                                @*                                    @bind-Value="_values[col.Id].Time" *@
                                @*                                    Required="@col.IsRequired"/> *@
                                @*                     break; *@
                                @*                 case AttributeTypeEnum.日期时间: *@
                                @*                     <MudDatePicker Label="@col.Name" Variant="Variant.Outlined" *@
                                @*                                    @bind-Value="_values[col.Id].DateTime" *@
                                @*                                    Required="@col.IsRequired"/> *@
                                @*                     break; *@
                                @*                 case AttributeTypeEnum.定位: *@
                                @*                     <MudTextField Label="@col.Name" Variant="Variant.Outlined" *@
                                @*                                   Placeholder="lat,lng" *@
                                @*                                   @bind-Value="_values[col.Id].Text" *@
                                @*                                   Required="@col.IsRequired"/> *@
                                @*                     break; *@
                                @*                 default: *@
                                @*                     <MudTextField Label="@col.Name" Variant="Variant.Outlined" *@
                                @*                                   @bind-Value="_values[col.Id].Text" *@
                                @*                                   Required="@col.IsRequired"/> *@
                                @*                     break; *@
                            }
                        </MudItem>
                    }
                </MudGrid>

                @* <TableColumnsSky TableId="@TableId" *@
                @*                  Columns="@Columns" *@
                @*                  TableDefinitionDto="@TableDefinitionDto" *@
                @*                  EditRow="@EditRow" *@
                @*                  ReadOnly="@ReadOnly"/> *@
            </MudContainer>
        </MudForm>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string NodeId { get; set; }
    [Parameter] public required string TableId { get; set; }
    [Parameter] public required AttributeDefinition TableDefDto { get; set; }
    [Parameter] public required List<AttributeDefinition> ColumnDefDtos { get; set; }
    [Parameter] public TableRowDto? EditRow { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private MudForm? _form;
    private Dictionary<string, CellValue> _values = new();
    private bool _isSubmitting;
    private bool IsEdit => EditRow != null;
    private DateTimeOffset? _dateOffset;
    private TimeSpan? _timeSpan;
    private AttributeDefinition? _dateDef;
    private AttributeDefinition? _timeDef;

    protected override void OnInitialized()
    {
        _dateDef = new AttributeDefinition()
        {
            AttributeTypeId = AttributeTypeEnum.日期.ToAttributeTypeId(),
            Name = "日期",
        };

        _timeDef = new AttributeDefinition
        {
            AttributeTypeId = AttributeTypeEnum.时间.ToAttributeTypeId(),
            Name = "时间",
        };

        _dateOffset = EditRow?.CreatedAt.LocalDateTime.Date ?? DateTimeOffset.UtcNow;
        _timeSpan = EditRow?.CreatedAt.LocalDateTime.TimeOfDay ?? TimeSpan.Zero;

        foreach (var col in ColumnDefDtos)
            _values[col.Id] = new CellValue();

        _values = ColumnDefDtos.ToDictionary(
            col => col.Id,
            col =>
            {
                var cv = new CellValue();
                cv.SetType(col.TypeEnum); // 关键：设置类型
                cv.Definition = col; // 关键：设置定义DTO
                return cv;
            }
        );

        if (IsEdit && EditRow != null)
        {
            foreach (var cell in EditRow.Values)
            {
                if (!_values.TryGetValue(cell.ColumnId, out var v)) continue;
                var typeEnum = ColumnDefDtos.FirstOrDefault(c => c.Id == cell.ColumnId)?.TypeEnum;
                v.SetFrom(cell.Value, typeEnum);
            }
        }
    }

    private async Task HandleSubmitAsync()
    {
        // 提交锁：防止连续点击/事件重入导致多次调用
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (_form == null) return;
            await _form.ValidateAsync();
            if (!_form.IsValid) return;

            // 校验必填
            foreach (var col in ColumnDefDtos)
            {
                if (col.IsRequired && _values[col.Id].IsEmpty())
                {
                    Snackbar.Add($"{col.Name}不能为空", Severity.Warning);
                    return;
                }
            }

            var dict = _values.ToDictionary(kv => kv.Key, kv => kv.Value.ToJsonElement());

            try
            {
                DateTimeOffset result = _dateOffset.HasValue && _timeSpan.HasValue
                    ? new DateTimeOffset(
                        _dateOffset.Value.Date + _timeSpan.Value, // 日期部分 + 时刻部分
                        _dateOffset.Value.Offset) // 保留原时区
                    : DateTimeOffset.UtcNow;

                if (IsEdit)
                {
                    // DateTime combinedDateTime = _dateOffset.Value + _timeSpan.Value;


                    var updateDto = new UpdateTableRowDto
                    {
                        NodeId = NodeId,
                        DefinitionId = TableDefDto.Id,
                        TableId = TableId,
                        RowId = EditRow!.RowId,
                        CreatedAt = result.LocalDateTime,
                        Values = dict
                    };

                    await AttributeApiClient.UpdateRowAsync(updateDto);
                }
                else
                {
                    var addDto = new AddTableRowDto
                    {
                        NodeId = NodeId,
                        DefinitionId = TableDefDto.Id,
                        TableId = TableId,
                        CreatedAt = result.LocalDateTime,
                        Values = dict
                    };

                    await AttributeApiClient.AddRowAsync(addDto);
                }

                Snackbar.Add("保存成功", Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
            catch (ArgumentException ex)
            {
                Message.Details("保存失败.", ex.Message);
            }
            catch (Exception ex)
            {
                Message.Details("保存失败.", ex.Message);
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
    }

