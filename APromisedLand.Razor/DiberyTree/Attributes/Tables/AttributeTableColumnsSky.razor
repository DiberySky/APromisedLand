    private async Task DeleteColumnAsync(AttributeDefinitionDto col)
    {
        var confirmed = await BlazorService.DeleteBoxAsync($"确定删除列【{col.Name}】？");
        if (!confirmed) return;
        try
        {
            var ok = await AttributeApiClient.DeleteDefinitionAsync(col.Id);
            if (ok)
            {
                Snackbar.Add("删除成功", Severity.Success);
                await LoadColumnsAsync();
                NewColumn();
            }
            else Snackbar.Add("列不存在", Severity.Warning);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private class ColumnFormModel
