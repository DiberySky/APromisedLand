

@inject AttributeApiClient AttributeApiClient
@inject IDialogService DialogService
@inject MessageService Message

<DialogSky Title="@TableName"
           CancelButtonVisible="true"
           SubmitButtonVisible="false"
           OnCanceledClick="@(() => MudDialog?.Close(DialogResult.Cancel()))">
    <ToolBarContent>
        <MudText Class="text-info">行数据</MudText>
        <MudSpacer/>
        @* <MudButton Variant="Variant.Text" Color="Color.Warning" *@
        @*            StartIcon="@Icons.Material.Outlined.Refresh" *@
        @*            OnClick="LoadRowsAsync" Class="ml-2"> *@
        @*     刷新 *@
        @* </MudButton> *@
        <MudSwitch T="bool"
                   @bind-Value="@ReadOnly"
                   Label="只读模式" Color="Color.Info"/>
    </ToolBarContent>
    <DialogContent>
        <MudContainer>
            <MudTable T="TableRowDto"
                      Items="_rows"
                      Dense="true" Hover="true"
                      Loading="_loading"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    @if (TableDefinitionDto.HasRowNo)
                    {
                        <MudTh>行号</MudTh>
                    }
                    @if (TableDefinitionDto.HasDate)
                    {
                        <MudTh>日期</MudTh>
                    }
                    @if (TableDefinitionDto.HasTime)
                    {
                        <MudTh>时间</MudTh>
                    }
                    @foreach (var col in Columns)
                    {
                        <MudTh>@col.Name</MudTh>
                    }
                    <MudTh Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                       Color="Color.Info" Size="Size.Small"
                                       OnClick="AddRowAsync"/>
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    @if (TableDefinitionDto.HasRowNo)
                    {
                        <MudTd DataLabel="行号" Class="text-info">@context.RowNo</MudTd>
                    }

                    @if (TableDefinitionDto.HasDate)
                    {
                        <MudTd DataLabel="日期" Class="text-info">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
                    }

                    @if (TableDefinitionDto.HasTime)
                    {
                        <MudTd DataLabel="时间" Class="text-info">@context.CreatedAt.ToLocalTime().ToString("HH:mm")</MudTd>
                    }

                    @foreach (var col in Columns)
                    {
                        <MudTd DataLabel="@col.Name" Class="text-info">
                            @(FormatCell(context, col.Id))
                        </MudTd>
                    }
                    <MudTd Style="text-align:right">
                        @if (!ReadOnly)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => EditRowAsync(context))"/>
                            @if (_deleteable)
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Color="Color.Warning" Size="Size.Small"
                                               OnClick="@(() => DeleteRowAsync(context))"/>
                            }
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.MoreHoriz"
                                           Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => EditRowAsync(context))"/>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="py-8">暂无行数据</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @if (!ReadOnly)
        {
            <MudSwitch T="bool" @bind-Value="@_deleteable"
                       Size="Size.Small"
                       Label="删除模式" Color="Color.Error"/>
        }
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    
    [Parameter] public required string NodeId { get; set; }
    [Parameter] public required string TableId { get; set; }
    [Parameter] public required string TableName { get; set; }
    [Parameter] public required AttributeDefinition TableDefinitionDto { get; set; }
    [Parameter] public required List<AttributeDefinition> Columns { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    
    private List<TableRowDto> _rows = new();
    // private List<AttributeDefinitionDto> _columns = new();
    private bool _loading;
    private bool _deleteable;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        _loading = true;
        try
        {
            _rows = [.. await AttributeApiClient.ListRowsAsync(TableDefinitionDto!.Id)];
        }
        catch (Exception ex)
        {
            Message.Details($"加载行失败", ex.Message);
        }
        finally { _loading = false; }
    }

    private async Task AddRowAsync()
    {
        var row = new TableRowDto();
        await ShowAttributeTableRowEditDialogAsync(NodeId, TableId!, TableDefinitionDto, Columns, row, ReadOnly);
        
        await LoadRowsAsync();
    }

    private async Task EditRowAsync(TableRowDto row)
    {
        await ShowAttributeTableRowEditDialogAsync(NodeId, TableId!, TableDefinitionDto, Columns, row, ReadOnly);
        
        await LoadRowsAsync();
    }

    private async Task DeleteRowAsync(TableRowDto row)
    {
        var confirmed = await Message.DeleteBoxAsync($"确定删除第 {row.RowNo} 行？");
        if (!confirmed) return;
        try
        {
            var ok = await AttributeApiClient.DeleteRowAsync(row.RowId);
            if (ok)
            {
                Message.Success("删除成功");
                await LoadRowsAsync();
            }
            else Message.Info("行不存在");
        }
        catch (Exception ex)
        {
            Message.Details($"删除失败", ex.Message); 
        }
    }

    private static string FormatCell(TableRowDto row, string columnId)
    {
        var cell = row.Values.FirstOrDefault(c => c.ColumnId == columnId);
        return cell?.Value switch
        {
            null => "-",
            System.Text.Json.JsonElement je => je.ToString(),
            _ => cell.Value.ToString() ?? "-"
        };
    }
    
    public async Task ShowAttributeTableRowEditDialogAsync(
        string nodeId,
        string tableId,
        AttributeDefinition definitionDto, 
        List<AttributeDefinition> columns,
        TableRowDto? editRow = null,
        bool readOnly = false,
        DialogConfig? config = null)
    {
        var parameters = new DialogParameters<AttributeTableRowEditDialog>
        {
            { x => x.NodeId, nodeId },
            { x => x.TableId, tableId },
            { x => x.TableDefDto, definitionDto },
            { x => x.ColumnDefDtos, columns },
            { x => x.EditRow, editRow },
            { x => x.ReadOnly, readOnly },
        };

        var options = (config ?? new DialogConfig
        {
        }).ToDialogOptions();

        var dialog = await DialogService.ShowAsync<AttributeTableRowEditDialog>(
            "表格编辑器", parameters, options);

        var result = await dialog.Result;
        // 只要不是取消就返回 true（表示可能已修改）
        // return result is not { Canceled: true };
    }

}
