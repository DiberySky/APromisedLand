
@* @typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new() *@

@inject AttributeApiClient AttributeApiClient

@inject ISnackbar Snackbar

<DialogSky Title="@(IsEdit ? "编辑表格定义" : "新建表格定义")"
           SubmitButtonVisible="true"
           CancelButtonVisible="true"
           OnSubmitClick="HandleSubmitAsync"
           OnCanceledClick="HandleCancel">
    <DialogContent>
        <MudForm @ref="_form" Model="_model" ValidationDelay="0">
            <MudContainer class="my-4">

                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="表格类型名称"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="表格类型名称不能为空"
                                  MaxLength="50"
                                  Counter="50"/>

                    <MudSelect T="string"
                               @bind-Value="stringValue" Label="日期时间列" Dense
                               Variant="Variant.Outlined"
                               Placeholder="请选择日期时间列"
                               SelectedValuesChanged="HandleSelectedValuesChanged">
                        <MudSelectItem Value="@("无")">无</MudSelectItem>
                        <MudSelectItem Value="@("日期")">日期</MudSelectItem>
                        <MudSelectItem Value="@("日期时间")">日期时间</MudSelectItem>
                    </MudSelect>

                    @* <BoolFieldSky @bind-Value="_model.HasDate" *@
                    @*               Label="包涵日期列" *@
                    @*               TrueLabel="是" *@
                    @*               FalseLabel="否"/> *@
                    @* <BoolFieldSky @bind-Value="_model.HasTime" *@
                    @*               Label="包涵时间列" *@
                    @*               TrueLabel="是" *@
                    @*               FalseLabel="否"/> *@
                    <BoolFieldSky @bind-Value="_model.HasRowNo"
                                  Label="行号列"
                                  TrueLabel="有"
                                  FalseLabel="没有"/>

                    <AttributeTableColumnsSky TableId="@TableDefinitionDto!.Id"
                                              @bind-Deletable="@_deletable"/>

                </MudStack>
            </MudContainer>
        </MudForm>
    </DialogContent>
    <DialogLeftActions>
        <MudSwitch T="bool" @bind-Value="@_deletable"
                   Size="Size.Small"
                   Label="允许删除" Color="Color.Error"/>
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string NodeId { get; set; }
    [Parameter] public required string TableId { get; set; }
    [Parameter] public AttributeDefinition? TableDefinitionDto { get; set; }

    private MudForm? _form;
    private FormModel _model = new();
    private AttributeTypeEnum _tableType;
    private bool _deletable;

    private string stringValue { get; set; }

    private bool IsEdit => TableDefinitionDto != null;

    protected override void OnInitialized()
    {
        // var types = await AttributeApiClient.GetAttributeTypesAsync();
        // _tableType = types.FirstOrDefault(t => t.SystemType == AttributeTypeEnum.表格);

        _tableType = TableDefinitionDto?.TypeEnum ?? AttributeTypeEnum.表格;

        _model.Name = TableDefinitionDto?.Name ?? string.Empty;
        _model.HasDate = TableDefinitionDto?.HasDate ?? false;
        _model.HasTime = TableDefinitionDto?.HasTime ?? false;
        _model.HasRowNo = TableDefinitionDto?.HasRowNo ?? false;
        
        stringValue = _model.HasTime ? "日期时间" : _model.HasDate ? "日期" : "无";
    }

    private async Task HandleSubmitAsync()
    {
        if (_form == null) return;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        if (_tableType == default)
        {
            Snackbar.Add("未找到「表格」类型定义", Severity.Error);
            return;
        }

        try
        {
            if (IsEdit)
            {
                await AttributeApiClient.UpdateDefinitionAsync(TableDefinitionDto!.Id,
                    new AttributeDefinitionUpdateDto
                    {
                        Name = _model.Name,
                        HasDate = _model.HasDate,
                        HasTime = _model.HasTime,
                        HasRowNo = _model.HasRowNo
                    });
                Snackbar.Add("表更新成功", Severity.Success);
            }
            else
            {
                await AttributeApiClient.CreateDefinitionAsync(new AttributeDefinitionCreateDto
                {
                    Name = _model.Name,
                    AttributeType = _tableType,
                    ParentId = null
                });
                Snackbar.Add("表创建成功", Severity.Success);
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"操作失败: {ex.Message}", Severity.Error);
        }
    }

    private void HandleCancel()
    {
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public bool HasDate { get; set; } = false;
        public bool HasTime { get; set; } = false;
        public bool HasRowNo { get; set; } = false;
    }

    private void HandleSelectedValuesChanged(IReadOnlyCollection<string?>? values)
    {
        var value = values?.FirstOrDefault();
        
        if (value == "日期时间")
        {
            _model.HasDate = false;
            _model.HasTime = true;
            stringValue = "日期时间";
        }
        else if (value == "日期")
        {
            _model.HasDate = true;
            _model.HasTime = false;
            stringValue = "日期";
        }
        else
        {
            _model.HasDate = false;
            _model.HasTime = false;
            stringValue = "无";
        }
        
        StateHasChanged();
    }

}
