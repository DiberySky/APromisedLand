@using System.Text.Json
@using APromisedLand.Razor.DiberyTree.Attributes.Values
@using APromisedLand.Shared.Helper
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject DiberyTreeApiClient<TItem> ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TreeNodeDialogService<TItem> TreeNodeDialogService
@inject BlazorService BlazorService

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_attributes == null || !_attributes.Any())
{
}
else
{
    <MudStack Spacing="0">
        @foreach (var attr in _attributes)
        {
            var typeEnum = attr.GetTypeEnum();
            
            <MudGrid Class="align-center">
                <MudItem sm="@(ReadOnly ? 12 : 10)">
                    @switch (typeEnum)
                    {
                        case AttributeTypeEnum.文本:
                            var textValue = attr.Value.GetValue<string>();

                            <TextValue DefinitionDto="@attr.Definition?.ToDto()"
                                       Value="@textValue"
                                       ReadOnly="@ReadOnly"/>

                            _definition = attr.Definition;
                            _valueElement = JsonSerializer.SerializeToElement(textValue);
                            break;
                        case AttributeTypeEnum.整数:
                            var integerValue = attr.Value.GetValue<long>();

                            <IntegerValue Definition="@attr.Definition?.ToDto()"
                                          Value="@integerValue"
                                          ReadOnly="@ReadOnly"/>

                            _definition = attr.Definition;
                            _valueElement = JsonSerializer.SerializeToElement(integerValue);
                            break;
                        case AttributeTypeEnum.小数:
                            var decimalValue = attr.Value.GetValue<decimal>();

                            <DecimalValue Definition="@attr.Definition?.ToDto()"
                                          Value="@decimalValue"
                                          ReadOnly="@ReadOnly"/>
                            
                            _definition = attr.Definition;
                            _valueElement = JsonSerializer.SerializeToElement(decimalValue);
                            break;
                        case AttributeTypeEnum.日期:
                            var dateValue = attr.Value.GetValue<DateTimeOffset>();

                            <DateValue Definition="@attr.Definition?.ToDto()"
                                       Value="@dateValue"
                                       ReadOnly="@ReadOnly"/>

                            _definition = attr.Definition;
                            _valueElement = JsonSerializer.SerializeToElement(dateValue);
                            break;
                        case AttributeTypeEnum.时间:
                            var timeValue = attr.Value.GetValue<TimeSpan>();

                            <TimeValue Definition="@attr.Definition?.ToDto()"
                                       Value="@timeValue"
                                       ReadOnly="@ReadOnly"/>

                            _definition = attr.Definition;
                            _valueElement = JsonSerializer.SerializeToElement(timeValue);
                            break;
                        case AttributeTypeEnum.日期时间:
                            var dateTimeValue = attr.Value.GetValue<DateTimeOffset>();

                            <DateTimeValue Definition="@attr.Definition?.ToDto()"
                                           Value="@dateTimeValue"
                                           ReadOnly="@ReadOnly"/>

                            _definition = attr.Definition;
                            _valueElement = JsonSerializer.SerializeToElement(dateTimeValue);
                            break;
                        case AttributeTypeEnum.文件:
                            break;
                        case AttributeTypeEnum.定位:
                            break;
                        default:
                            throw new ArgumentOutOfRangeException();
                    }
                </MudItem>
                @if (!ReadOnly)
                {
                    <MudItem xs="6" sm="1"/>
                    <MudItem xs="6" sm="1" Class="d-flex justify-end">
                        <MudIconButton Icon="@Icons.Material.Outlined.Save" Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="@(() => SaveValue(attr))"/>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteValue(attr))"/>
                        <MudIconButton Icon="@Icons.Material.Outlined.EditNote" Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(_definition, _valueElement))"/>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
}

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private List<AttributeDto>? _attributes;
    private bool _loading;
    
    private AttributeDefinition? _definition;
    private JsonElement _valueElement;

    protected override async Task OnInitializedAsync()
    {
        await LoadAttributes();
    }

    private async Task LoadAttributes()
    {
        if (string.IsNullOrEmpty(NodeId)) return;
        _loading = true;
        try
        {
            var result = await ApiClient.GetAllValuesAsync(NodeId);
            _attributes = result?.Attributes ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteValue(AttributeDto attr)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定要删除属性“{attr.Definition?.Name ?? "未命名"}”吗？",
            "删除", "取消");
        if (confirm == true)
        {
            try
            {
                await ApiClient.DeleteValueAsync(NodeId, attr.Id);
                await LoadAttributes();
                Snackbar.Add($"属性“{attr.Definition?.Name}”已删除", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task SaveValue(AttributeDto attr)
    {
        try
        {
            // var dto = new AddValueDto(_definition.Id, valueElement);
            // await ApiClient.AddValueAsync(NodeId, dto);

            // Snackbar.Add("属性添加成功", Severity.Success);
            // MudDialog?.Close(DialogResult.Ok(true)); 
            
            attr.Value = _valueElement;
            await ApiClient.UpdateValueAsync(NodeId!, attr.Id, attr.Value);
            Snackbar.Add($"属性“{attr.Definition?.Name}”已更新", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"更新失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEditDialog(AttributeDefinition? _definition, JsonElement valueElement)
    {
        var dialogParams = new DialogParameters<AddAttributeValueDialog<TItem>>
        {
            { x => x.NodeId, NodeId },
            { x => x.DefinitionDto, _definition!.ToDto() },
            { x => x.ValueElement, valueElement }
        };
        
        var dialog = await DialogService.ShowAsync<AddAttributeValueDialog<TItem>>("编辑属性", dialogParams);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await LoadAttributes();
        }
    }
    
    // ---------- 辅助方法 ----------
    private bool IsNumericType(AttributeTypeEnum type)
        => type == AttributeTypeEnum.整数 || type == AttributeTypeEnum.小数;

    private int GetScale(AttributeTypeEnum type)
        => type == AttributeTypeEnum.小数 ? 2 : 0;

    private decimal? GetMinValue(AttributeTypeEnum type) => 0;
}