@using System.Text.Json
@using APromisedLand.Razor.DiberyTree.Attributes.Values
@using APromisedLand.Shared.Helper
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject DiberyTreeApiClient<TItem> ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_attributes == null || !_attributes.Any())
{
}
else
{
    <MudStack Spacing="0">
        @foreach (var attr in _attributes)
        {
            var typeEnum = attr.GetTypeEnum();
            // var label = attr.Definition?.Name ?? "未命名属性";
            // var unit = attr.Definition?.Unit?.Name ?? attr.Definition?.Unit?.Abbreviation;
            // var lines = attr.Definition?.Lines ?? 1;
            // var maxLength = attr.Definition?.MaxLength ?? 0; // 0 表示不限制
            // var scale = attr.Definition?.Scale ?? 2; // 默认保留2位小数
            // var minValue = 0m; // 可根据需要扩展，例如 attr.Definition?.MinValue
            
            var textValue = attr.Value.GetValue<string>();
            var integerValue = attr.Value.GetValue<long>();
            var decimalValue = attr.Value.GetValue<decimal>();
            
            <MudGrid Class="align-center">
                <MudItem xs="12" sm="9">
                    @switch (typeEnum)
                    {
                        case AttributeTypeEnum.文本:
                            <TextValue Definition="@attr.Definition?.ToDto()"
                                       Value="@textValue"
                                       ReadOnly="@ReadOnly" />  
                            
                            @* <MudTextField T="string" *@
                            @*               Value="@(attr.Value.GetValue<string>())" *@
                            @*               ValueChanged="@((string v) => { attr.Value = JsonSerializer.SerializeToElement(v); StateHasChanged(); })" *@
                            @*               Label="@label" *@
                            @*               Variant="Variant.Outlined" *@
                            @*               Lines="@lines" *@
                            @*               MaxLength="@maxLength" *@
                            @*               FullWidth="true" *@
                            @*               Margin="Margin.Normal" *@
                            @*               Immediate="true" *@
                            @*               OnBlur="@(() => SaveValue(attr))" />                           *@
                            break;
                        case AttributeTypeEnum.整数:
                            <IntegerValue Definition="@attr.Definition?.ToDto()"
                                          Value="@integerValue"
                                          ReadOnly="@ReadOnly" />  
                            
                            @* <MudNumericField T="decimal?" *@
                            @*                  Value="@(attr.Value.GetValue<decimal?>())" *@
                            @*                  ValueChanged="@((decimal? v) => { attr.Value = JsonSerializer.SerializeToElement(v); StateHasChanged(); })" *@
                            @*                  Label="@label" *@
                            @*                  Variant="Variant.Outlined" *@
                            @*                  Format="@($"N{scale}")" *@
                            @*                  Min="@minValue" *@
                            @*                  FullWidth="true" *@
                            @*                  Margin="Margin.Normal" *@
                            @*                  Adornment="Adornment.End" *@
                            @*                  AdornmentText="@unit" *@
                            @*                  OnBlur="@(() => SaveValue(attr))" /> *@
                            break;
                        case AttributeTypeEnum.小数:
                            <DecimalValue Definition="@attr.Definition?.ToDto()"
                                          Value="@decimalValue"
                                          ReadOnly="@ReadOnly" />  

                            @* <MudNumericField T="decimal?" *@
                            @*                  Value="@(attr.Value.GetValue<decimal?>())" *@
                            @*                  ValueChanged="@((decimal? v) => { attr.Value = JsonSerializer.SerializeToElement(v); StateHasChanged(); })" *@
                            @*                  Label="@label" *@
                            @*                  HideSpinButtons="true" *@
                            @*                  Variant="Variant.Outlined" *@
                            @*                  Format="@($"N{scale}")" *@
                            @*                  Min="@minValue" *@
                            @*                  FullWidth="true" *@
                            @*                  Margin="Margin.Normal" *@
                            @*                  Adornment="Adornment.End" *@
                            @*                  AdornmentText="@unit" *@
                            @*                  OnBlur="@(() => SaveValue(attr))" /> *@
                            break;
                        case AttributeTypeEnum.日期:
                            break;
                        case AttributeTypeEnum.时间:
                            break;
                        case AttributeTypeEnum.日期时间:
                            break;
                        case AttributeTypeEnum.文件:
                            break;
                        case AttributeTypeEnum.定位:
                            break;
                        default:
                            throw new ArgumentOutOfRangeException();
                    }
                    @if (IsNumericType(typeEnum))
                    {

                    }
                    else
                    {

                    }
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex justify-end">
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Success"
                                   OnClick="@(() => SaveValue(attr))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => DeleteValue(attr))"/>
                </MudItem>
            </MudGrid>
        }
    </MudStack>
}

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private List<AttributeDto>? _attributes;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadAttributes();
    }

    private async Task LoadAttributes()
    {
        if (string.IsNullOrEmpty(NodeId)) return;
        _loading = true;
        try
        {
            var result = await ApiClient.GetAllValuesAsync(NodeId);
            _attributes = result?.Attributes ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddDialog()
    {
        var dialogParams = new DialogParameters
        {
            { nameof(AddAttributeValueDialog<TItem>.NodeId), NodeId }
        };
        var dialog = await DialogService.ShowAsync<AddAttributeValueDialog<TItem>>("添加属性", dialogParams);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await LoadAttributes();
        }
    }

    private async Task DeleteValue(AttributeDto attr)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定要删除属性“{attr.Definition?.Name ?? "未命名"}”吗？",
            "删除", "取消");
        if (confirm == true)
        {
            try
            {
                await ApiClient.DeleteValueAsync(NodeId, attr.Id);
                await LoadAttributes();
                Snackbar.Add($"属性“{attr.Definition?.Name}”已删除", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task SaveValue(AttributeDto attr)
    {
        try
        {
            await ApiClient.UpdateValueAsync(NodeId, attr.Id, attr.Value);
            Snackbar.Add($"属性“{attr.Definition?.Name}”已更新", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"更新失败: {ex.Message}", Severity.Error);
        }
    }

    // ---------- 辅助方法 ----------
    private bool IsNumericType(AttributeTypeEnum type)
        => type == AttributeTypeEnum.整数 || type == AttributeTypeEnum.小数;

    private int GetScale(AttributeTypeEnum type)
        => type == AttributeTypeEnum.小数 ? 2 : 0;

    private decimal? GetMinValue(AttributeTypeEnum type) => 0;
}