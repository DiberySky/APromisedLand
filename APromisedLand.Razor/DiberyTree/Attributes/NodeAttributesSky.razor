@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject AttributeApiClient AttributeApiClient
@inject ISnackbar Snackbar


@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_attributeDtos == null || !_attributeDtos.Any())
{
}
else
{
    <MudStack Spacing="0">
        @foreach (var attr in _attributeDtos)
        {
            var typeEnum = attr.Definition.AttributeTypeId.ToAttributeTypeEnum();

            <MudGrid Class="align-center">
                <MudItem sm="12">
                    @switch (typeEnum)
                    {
                        case AttributeTypeEnum.文本:
                            var textValue = attr.Value.GetValue<string>();

                            <TextValue NodeId="@NodeId"
                                       ValueId="@attr.Id"
                                       DefinitionDto="@attr.Definition?.ToDto()"
                                       Value="@textValue"
                                       ReadOnly="@ReadOnly"
                                       OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.整数:
                            var integerValue = attr.Value.GetValue<long>();

                            <IntegerValue NodeId="@NodeId"
                                          ValueId="@attr.Id"
                                          DefinitionDto="@attr.Definition?.ToDto()"
                                          Value="@integerValue"
                                          ReadOnly="@ReadOnly"
                                          OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.小数:
                            var decimalValue = attr.Value.GetValue<decimal>();

                            <DecimalValue NodeId="@NodeId"
                                          ValueId="@attr.Id"
                                          DefinitionDto="@attr.Definition?.ToDto()"
                                          Value="@decimalValue"
                                          ReadOnly="@ReadOnly"
                                          OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.日期:
                            var dateValue = attr.Value.GetValue<DateTimeOffset>();

                            <DateValue NodeId="@NodeId"
                                       ValueId="@attr.Id"
                                       DefinitionDto="@attr.Definition?.ToDto()"
                                       Value="@dateValue"
                                       ReadOnly="@ReadOnly"
                                       OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.时间:
                            var timeValue = attr.Value.GetValue<TimeSpan>();

                            <TimeValue NodeId="@NodeId"
                                       ValueId="@attr.Id"
                                       DefinitionDto="@attr.Definition?.ToDto()"
                                       Value="@timeValue"
                                       ReadOnly="@ReadOnly"
                                       OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.日期时间:
                            var dateTimeValue = attr.Value.GetValue<DateTimeOffset>();

                            <DateTimeValue NodeId="@NodeId"
                                           ValueId="@attr.Id"
                                           DefinitionDto="@attr.Definition?.ToDto()"
                                           Value="@dateTimeValue"
                                           ReadOnly="@ReadOnly"
                                           OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.文件:
                            var fileValue = attr.Value.GetValue<string>();

                            <FileValue NodeId="@NodeId"
                                       ValueId="@attr.Id"
                                       DefinitionDto="@attr.Definition?.ToDto()"
                                       Value="@fileValue"
                                       ReadOnly="@ReadOnly"
                                       OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.定位:
                            var locationDefValue = attr.Value.GetValue<string>();

                            <LocationDefValue NodeId="@NodeId"
                                              ValueId="@attr.Id"
                                              DefinitionDto="@attr.Definition?.ToDto()"
                                              Value="@locationDefValue"          
                                              ReadOnly="@ReadOnly"
                                              OnEditChanged="@ValueEditChanged"/>
                            break;
                        case AttributeTypeEnum.表格:
                            var tableDefValue = attr.Value.GetValue<string>();

                            <TableDefValue NodeId="@NodeId"
                                       ValueId="@attr.Id"
                                       DefinitionDto="@attr.Definition?.ToDto()"
                                       Value="@tableDefValue"          
                                       ReadOnly="@ReadOnly"
                                       OnEditChanged="@ValueEditChanged"/>
                            break;
                        default:
                            throw new ArgumentOutOfRangeException();
                    }
                </MudItem>
            </MudGrid>
        }
    </MudStack>
}

@code {
    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<AttributeDefinitionDto?> OnSaveClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnDeleteClick { get; set; }
    [Parameter] public EventCallback<AttributeDefinitionDto?> OnEditChanged { get; set; }
    
    private List<AttributeDto>? _attributeDtos;
    private bool _loading;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadAttributes();
    }

    public async Task LoadAttributes()
    {
        if (string.IsNullOrEmpty(NodeId)) return;
        try
        {
            _loading = true;
            StateHasChanged();
            
            var result = await AttributeApiClient.GetAllValuesAsync(NodeId);
            _attributeDtos = result?.AttributeDtos ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ValueEditChanged(AttributeDefinitionDto? definition)
    {
        await LoadAttributes();
        
        await OnEditChanged.InvokeAsync(definition);
        await OnDeleteClick.InvokeAsync(definition);
        await OnSaveClick.InvokeAsync(definition);
    }
}