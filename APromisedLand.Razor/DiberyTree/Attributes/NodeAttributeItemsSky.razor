@using System.Text.Json.Nodes
@using APromisedLand.Razor.DiberyTree.Attributes.Items

@inject AttributeApiClient AttributeApiClient
@inject MessageService Message

<MudForm @ref="_form" Model="@DefItemDtos" Class="mt-4">
    <MudGrid Class="align-center" Spacing="2">

        @if (_tableDef is { HasTime: true })
        {
            <MudItem xs="12">
                <AttributeDateTimeItem @bind-DefItemDto="@_defDateTimeItemDto"
                                       ReadOnly="@ReadOnly"/>
            </MudItem>
        }
        else
        {
            @if (_tableDef is { HasDate: true })
            {
                <MudItem xs="12">
                    <AttributeDateItem @bind-DefItemDto="@_defDateItemDto"
                                       ReadOnly="@ReadOnly"/>
                </MudItem>
            }
        }

        @for (int i = 0; i < DefItemDtos.Count; i++)
        {
            var index = i;

            <MudItem sm="12">
                @switch (DefItemDtos[index].Def?.TypeEnum)
                {
                    case AttributeTypeEnum.文本:
                        <AttributeTextItem @bind-DefItemDto="@DefItemDtos[index]"
                                           NodeId="@NodeId"
                                           ReadOnly="@ReadOnly"/>
                        break;
                    case AttributeTypeEnum.整数:
                        <AttributeIntegerItem @bind-DefItemDto="@DefItemDtos[index]"
                                              NodeId="@NodeId"
                                              ReadOnly="@ReadOnly"/>
                        break;
                    case AttributeTypeEnum.小数:
                        <AttributeDecimalItem @bind-DefItemDto="@DefItemDtos[index]"
                                              NodeId="@NodeId"
                                              ReadOnly="@ReadOnly"/>
                        break;
                    case AttributeTypeEnum.日期:
                        <AttributeDateItem @bind-DefItemDto="@DefItemDtos[index]"
                                           NodeId="@NodeId"
                                           ReadOnly="@ReadOnly"/>
                        break;
                    case AttributeTypeEnum.时间:
                        <AttributeTimeItem @bind-DefItemDto="@DefItemDtos[index]"
                                           NodeId="@NodeId"
                                           ReadOnly="@ReadOnly"/>
                        break;
                    case AttributeTypeEnum.日期时间:
                        <AttributeDateTimeItem @bind-DefItemDto="@DefItemDtos[index]"
                                               NodeId="@NodeId"
                                               ReadOnly="@ReadOnly"/>
                        break;
                    @* case AttributeTypeEnum.文件: *@
                    @*     var fileValue = item.Value.GetValue<string>(); *@
                    @* *@
                    @*     <FileValue NodeId="@NodeId" *@
                    @*                ValueId="@item.Id" *@
                    @*                DefinitionDto="@item.Definition" *@
                    @*                Value="@fileValue" *@
                    @*                ReadOnly="@ReadOnly" *@
                    @*                OnEditChanged="@ValueEditChanged"/> *@
                    @*     break; *@
                    case AttributeTypeEnum.定位:
                        <AttributeLocationDefItem @bind-DefItemDto="@DefItemDtos[index]"
                                                  NodeId="@NodeId"
                                                  ReadOnly="@ReadOnly"/>
                        break;
                    case AttributeTypeEnum.表格:
                        <AttributeTableDefItem @bind-DefItemDto="@DefItemDtos[index]"
                                               NodeId="@NodeId"
                                               ReadOnly="@ReadOnly"/>
                        break;
                    default:
                        throw new ArgumentOutOfRangeException();
                }
            </MudItem>
        }
    </MudGrid>
</MudForm>

@code {
    MudForm _form = null!;

    [Parameter] public required string? NodeId { get; set; }
    [Parameter] public required string? ParentId { get; set; }

    [Parameter] public List<AttributeItemDto> DefItemDtos { get; set; } = [];
    [Parameter] public EventCallback<List<AttributeItemDto>> DefItemDtosChanged { get; set; }

    [Parameter] public AttributeDefinition? CreateDefinition { get; set; }
    [Parameter] public string? RowId { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public Func<Task> SubmitTableAsyncFunc { get; set; }

    private List<AttributeJsonValueDto>? _attributeDtos;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (ParentId == null)
        {
            await LoadAttributes();
        }
        else
        {
            await LoadTableAsync();
        }

        StateHasChanged();
    }

}