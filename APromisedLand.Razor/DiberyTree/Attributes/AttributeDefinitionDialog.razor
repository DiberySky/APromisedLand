
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject ISnackbar Snackbar
@inject AttributeApiClient AttributeApiClient
@inject TreeNodeDialogService<TItem> TreeNodeDialogService

<DialogSky Title="@(IsEdit ? "编辑属性定义" : "新建属性定义")"
           SubmitButtonVisible="true"
           CancelButtonVisible="true"
           OnSubmitClick="HandleSubmitAsync"
           OnCanceledClick="HandleCancel">
    <DialogContent>
        <MudForm @ref="_form" Model="_model" ValidationDelay="0">
            <MudContainer class="my-4">
                <MudGrid>
                    <MudItem xs="12">
                        <MudSelect T="AttributeTypeEnum"
                                   @bind-Value="@_selectedType"
                                   Label="属性类型"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomLeft"
                                   Clearable="false"
                                   ReadOnly="@(EditItem != null)"
                                   SelectedValuesChanged="@SelectedValuesChanged">
                            @foreach (var type in Enum.GetValues<AttributeTypeEnum>())
                            {
                                <MudSelectItem Value="type">@type.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Name"
                                      Label="属性名称"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="属性名称不能为空"
                                      MaxLength="256"
                                      Counter="256"/>
                    </MudItem>

                    @switch (_selectedType)
                    {
                        case AttributeTypeEnum.文本:
                            <MudItem xs="12">
                                <MudNumericField @bind-Value="_model.MaxLength"
                                                 Label="最大长度"
                                                 Variant="Variant.Outlined"
                                                 Min="1"/>
                            </MudItem>
                            <MudItem xs="12">
                                <MudNumericField @bind-Value="_model.Lines"
                                                 Label="文本显示行数"
                                                 Variant="Variant.Outlined"
                                                 Min="1"
                                                 Max="20"/>
                            </MudItem>
                            break;
                        case AttributeTypeEnum.整数:
                            <MudItem xs="12">
                                <UintTreeField @bind-Unit="@_unit"/>
                            </MudItem>
                            break;
                        case AttributeTypeEnum.小数:
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_model.Precision"
                                                 Label="整数位数(精度)"
                                                 Variant="Variant.Outlined"
                                                 Min="1"
                                                 Max="38"/>
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_model.Scale"
                                                 Label="小数位数(精度)"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Max="10"/>
                            </MudItem>
                            <MudItem xs="12">
                                <UintTreeField @bind-Unit="@_unit"/>
                            </MudItem>
                            break;
                        case AttributeTypeEnum.日期:
                            break;
                        case AttributeTypeEnum.时间:
                            break;
                        case AttributeTypeEnum.日期时间:
                            break;
                        case AttributeTypeEnum.文件:
                            break;
                        case AttributeTypeEnum.定位:
                            break;
                        case AttributeTypeEnum.表格:

                            break;
                        default:
                            throw new ArgumentOutOfRangeException();
                    }
                </MudGrid>
            </MudContainer>
        </MudForm>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public string? TableId { get; set; }
    [Parameter] public AttributeDefinitionDto? EditItem { get; set; }

    // private AttributeType _attributeType = new();
    private UnitTree? _unit;

    private MudForm? _form;
    private FormModel _model = new();
    private AttributeTypeEnum _selectedType = AttributeTypeEnum.文本;

    private bool IsEdit => EditItem != null;

    protected override void OnInitialized()
    {
        // _attributeType = EditItem?.AttributeType ?? new();
        _unit = EditItem?.Unit;

        if (IsEdit && EditItem != null)
        {
            _model = new FormModel
            {
                Name = EditItem.Name,
                AttributeType = EditItem.AttributeType,
                MaxLength = EditItem.MaxLength,
                Lines = EditItem.Lines,
                Precision = EditItem.Precision,
                Scale = EditItem.Scale,
                UnitId = EditItem.Unit?.Id
            };
        }
        else
        {
            _model = new FormModel
            {
                Name = string.Empty,
                AttributeType = AttributeTypeEnum.文本,
                MaxLength = 0,
                Lines = 1,
                Precision = 7,
                Scale = 3,
                UnitId = null
            };
        }

        _selectedType = _model.AttributeType ?? AttributeTypeEnum.文本;
    }

    private async Task SelectedValuesChanged(IReadOnlyCollection<AttributeTypeEnum>? value)
    {
        if (value == null) return;
        
        // _selectedType = value.FirstOrDefault();

        switch (value.FirstOrDefault())
        {
            case AttributeTypeEnum.表格:
                await OpenTableDialogAsync();
                break;
            default:
                break;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (_form == null || _model.AttributeType == null) return;
        
        await _form.ValidateAsync();

        if (!_form.IsValid) return;

        try
        {
            _model.AttributeType = _selectedType;
            
            _model.UnitId = _unit?.Id;
            
            if (TableId == null)
            {
                if (IsEdit)
                {
                    var updateDto = new AttributeDefinitionUpdateDto
                    {
                        Name = _model.Name,
                        Lines = _model.Lines,
                        Precision = _model.Precision,
                        Scale = _model.Scale,
                        UnitId = _model.UnitId
                    };

                    await AttributeApiClient.UpdateDefinitionAsync(EditItem!.Id, updateDto);

                    Snackbar.Add("属性定义更新成功", Severity.Success);
                }
                else
                {
                    if (_model.AttributeType == null) return;

                    var createDto = new AttributeDefinitionCreateDto
                    {
                        Name = _model.Name,
                        AttributeType = _model.AttributeType.Value,
                        MaxLength = _model.MaxLength,
                        Lines = _model.Lines,
                        Precision = _model.Precision,
                        Scale = _model.Scale,
                        UnitId = _model.UnitId
                    };

                    await AttributeApiClient.CreateDefinitionAsync(createDto);

                    Snackbar.Add("属性定义创建成功", Severity.Success);
                }
            }
            else
            {
                if (IsEdit)
                {
                    await AttributeApiClient.UpdateDefinitionAsync(EditItem!.Id, 
                        new AttributeDefinitionUpdateDto
                    {
                        Name = _model.Name,
                        MaxLength = _model.MaxLength,
                        Lines = _model.Lines,
                        Precision = _model.Precision,
                        Scale = _model.Scale,
                        UnitId = _model.UnitId
                    });
                    Snackbar.Add("列更新成功", Severity.Success);
                }
                else
                {
                    // 新 API：ParentId 由路由 tableId 确定，body 不传（后端强制注入 + 校验列≠表格类型）
                    await AttributeApiClient.CreateTableColumnAsync(TableId, 
                        new AttributeDefinitionCreateDto
                    {
                        Name = _model.Name,
                        AttributeType = _model.AttributeType.Value,
                        MaxLength = _model.MaxLength,
                        Lines = _model.Lines,
                        Precision = _model.Precision,
                        Scale = _model.Scale,
                        UnitId = _model.UnitId,
                        ParentId = TableId
                    });
                    Snackbar.Add("列创建成功", Severity.Success);
                }
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"操作失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenTableDialogAsync()
    {
        var result = await TreeNodeDialogService.ShowAttributeTableDefinitionListDialogAsync();
        // 如果子对话框返回了 true（表示成功创建/修改），刷新列表
        if (result == true)
        {
            // await LoadDataAsync();
        }
    }

    private void HandleCancel()
    {
        // DialogSky 内部已处理 MudDialog.Close，此处仅做额外清理
    }

    private void AttributeDefinitionChanged(AttributeDefinitionDto dto)
    {
        EditItem = dto;

        _model.Name = dto.Name;
        _model.AttributeType = dto.AttributeType;
        _model.MaxLength = dto.MaxLength;
        _model.Lines = dto.Lines;
        _model.Precision = dto.Precision;
        _model.Scale = dto.Scale;
        // _model.UnitId = dto.UnitId;

        StateHasChanged();
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public AttributeTypeEnum? AttributeType { get; set; }
        public int? MaxLength { get; set; }
        public int? Lines { get; set; }
        public int? Precision { get; set; }
        public int? Scale { get; set; }
        public string? UnitId { get; set; }
    }

}