@* AttributeDefinitionList.razor *@
@page "/attribute-definitions"
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject DiberyTreeApiClient<CategoryTree> ApiClient

<PageSky Title="属性定义管理" BackPage="@SolutionService.StartPage">
    <PageContent>

        <MudPaper Elevation="0" Class="pa-4">
            <MudToolBar Dense Class="mb-4">
                <MudText Typo="Typo.h6" Color="Color.Primary">属性定义管理</MudText>
                <MudSpacer/>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="() => OpenDialogAsync(null)">
                    新建属性
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadDataAsync"
                           Class="ml-2">
                    刷新
                </MudButton>
            </MudToolBar>

            <MudTable Items="_definitions"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Loading="_loading"
                      LoadingProgressColor="Color.Primary"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>属性名称</MudTh>
                    <MudTh>类型</MudTh>
                    <MudTh>单位</MudTh>
                    <MudTh>文本行数</MudTh>
                    <MudTh>精度/小数位</MudTh>
                    <MudTh Style="text-align:right">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="属性名称">
                        <MudText Typo="Typo.body1">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="类型">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                            @context.AttributeTypeName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="单位">
                        @if (!string.IsNullOrEmpty(context.UnitOfMeasureName))
                        {
                            <MudText Typo="Typo.caption">@context.UnitOfMeasureName</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="文本行数">
                        @(context.Lines?.ToString() ?? "-")
                    </MudTd>
                    <MudTd DataLabel="精度/小数位">
                        @if (context.Precision.HasValue || context.Scale.HasValue)
                        {
                            <MudText Typo="Typo.caption">@context.Precision / @context.Scale</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="() => OpenDialogAsync(context)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => DeleteAsync(context)"/>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="py-8">暂无属性定义数据</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </PageContent>
</PageSky>

@code {
    private List<AttributeDefinitionDto> _definitions = new();
    private List<AttributeType> _attributeTypes = new();
    private List<UnitOfMeasure> _unitsOfMeasure = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            // 并行加载数据
            var defsTask = await ApiClient.GetAllDefinitionsAsync();
            
            // 注意：如果 API Client 没有提供获取 AttributeTypes 和 UnitsOfMeasure 的方法，
            // 需要额外注入对应的服务或从其他接口获取
            _definitions = [.. defsTask];

            // 这里假设你有获取类型和单位的方法，如果没有可以从 DbContext 或其他服务获取
            var types = await ApiClient.GetAttributeTypesAsync();
            _attributeTypes = [.. types];
            // _unitsOfMeasure = ...
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载数据失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDialogAsync(AttributeDefinitionDto? item)
    {
        
        var parameters = new DialogParameters<AttributeDefinitionDialog>
        {
            { x => x.EditItem, item },
            { x => x.AttributeTypes, _attributeTypes },
            { x => x.UnitsOfMeasure, _unitsOfMeasure }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AttributeDefinitionDialog>(
            item == null ? "新建属性定义" : "编辑属性定义",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task DeleteAsync(AttributeDefinitionDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定要删除属性定义 \"{item.Name}\" 吗？如果已被节点引用将无法删除。",
            yesText: "删除",
            cancelText: "取消");

        if (confirmed != true) return;

        try
        {
            // var success = await ApiClient.DeleteDefinitionAsync(item.Id);
            // if (success)
            // {
            //     Snackbar.Add("删除成功", Severity.Success);
            //     await LoadDataAsync();
            // }
            // else
            // {
            //     Snackbar.Add("删除失败，属性定义不存在", Severity.Warning);
            // }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

}