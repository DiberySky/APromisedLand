@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@implements IDisposable

@inject TreeNodeDialogService<TItem> TreeNodeDialogService

<DialogTreeSky TItem="@TItem"
               Item="@_node"
               Title="@_title"
               SubmitButtonVisible="true"
               OnMoveClick="@ParentSelectAsync"
               OnSubmitClick="@SubmitAsync"
               OnCanceledClick="@Close">
    <DialogContent>
        <MudContainer Class="py-8">
            <MudForm @ref="_form" Model="@_node">
                @if (NodeTemplate.EditTemplate is null)
                {
                    <MudStack Spacing="3">
                        @* <MudTextField T="string" *@
                        @*               @bind-Value="_model.Name" *@
                        @*               Label="名称" *@
                        @*               Variant="Variant.Outlined" *@
                        @*               Required="true" *@
                        @*               RequiredError="名称不能为空" *@
                        @*               MaxLength="100" *@
                        @*               Counter="100" *@
                        @*               Immediate="true"/> *@
                        @* *@
                        @* <MudTextField T="string" *@
                        @*               @bind-Value="_model.Description" *@
                        @*               Label="描述" *@
                        @*               Variant="Variant.Outlined" *@
                        @*               Lines="3" *@
                        @*               MaxLength="500" *@
                        @*               Counter="500" *@
                        @*               Immediate="true"/> *@
                        @* *@
                        @* <MudNumericField T="int" *@
                        @*                  @bind-Value="_model.SortOrder" *@
                        @*                  Label="排序" *@
                        @*                  Variant="Variant.Outlined" *@
                        @*                  Min="0" *@
                        @*                  Max="9999"/> *@
                        @* *@
                        @* <MudSwitch T="bool" *@
                        @*            @bind-Value="_model.IsActive" *@
                        @*            Label="启用状态" *@
                        @*            Color="Color.Primary"/> *@
                    </MudStack>
                }
                else
                {
                    @NodeTemplate.EditTemplate(_node)
                }
            </MudForm>
        </MudContainer>
    </DialogContent>

</DialogTreeSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    // [Parameter] public TItem? Node { get; set; }
    // [Parameter] public TItem? ParentNode { get; set; }
    [Parameter] public bool IsCreate { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }

    private MudForm _form = null!;

    // private TreeNodeFormModel _model = new();
    // private bool _isSubmitting = false;
    private TItem _node = null!;

    private string _title = null!; //=> IsCreate ? "创建节点" : "编辑节点";

    protected override void OnInitialized()
    {
        _node = NodeTemplate.Node.Value!;

        // if (!IsCreate)
        // {
        //     _model = new TreeNodeFormModel
        //     {
        //         Name = _node.Text(),
        //         Description = _node.Description,
        //         SortOrder = _node.SortOrder,
        //         IsActive = _node.IsActive
        //     };
        // }

        _title = IsCreate ? $"创建【{_node.Parent!.Text()}】子节点" : _node.Text();

        base.OnInitialized();
    }

    private async Task ParentSelectAsync()
    {
        var parent = await TreeNodeDialogService.ShowParentSelectDialogAsync();
    }
    
    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        // _isSubmitting = true;
        MudDialog?.Close(DialogResult.Ok(_node));
    }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    public void Dispose()
    {
    }

}
