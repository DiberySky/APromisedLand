@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }
    [Parameter] public TItem? Node { get; set; }
    [Parameter] public TItem? ParentNode { get; set; }
    [Parameter] public bool IsCreate { get; set; }

    private MudForm _form = null!;
    private TreeNodeFormModel _model = new();
    private bool _isSubmitting = false;

    private string TitleText => IsCreate ? "创建节点" : "编辑节点";

    protected override void OnInitialized()
    {
        if (Node != null && !IsCreate)
        {
            _model = new TreeNodeFormModel
            {
                Name = Node.Text(),
                Description = Node.Description,
                SortOrder = Node.SortOrder,
                IsActive = Node.IsActive
            };
        }

        base.OnInitialized();
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isSubmitting = true;
        try
        {
            MudDialog?.Close(DialogResult.Ok(_model));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    public void Dispose()
    {
    }

}
