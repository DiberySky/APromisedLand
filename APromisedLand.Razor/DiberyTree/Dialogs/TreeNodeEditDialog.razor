@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@using APromisedLand.Razor.Helper.Blazor
@implements IDisposable

@inject IDialogService DialogService

<DialogTreeSky TItem="@TItem"
               Item="@_node"
               Title="@_title"
               SubmitButtonVisible="true"
               OnSubmitClick="@SubmitAsync"
               OnCanceledClick="@Close">
    <ToolBarContent>
        <MudButton Variant="Variant.Text"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@OpenAddDialog">
            添加设置属性
        </MudButton>
    </ToolBarContent>
    <DialogContent>
        <MudContainer Class="py-8">
            <MudForm @ref="_form" Model="@_node">
                @if (NodeTemplate.EditTemplate is null)
                {
                    <MudStack Spacing="3">
                        @* <MudTextField T="string" *@
                        @*               @bind-Value="_model.Name" *@
                        @*               Label="名称" *@
                        @*               Variant="Variant.Outlined" *@
                        @*               Required="true" *@
                        @*               RequiredError="名称不能为空" *@
                        @*               MaxLength="100" *@
                        @*               Counter="100" *@
                        @*               Immediate="true"/> *@
                        @* *@
                        @* <MudTextField T="string" *@
                        @*               @bind-Value="_model.Description" *@
                        @*               Label="描述" *@
                        @*               Variant="Variant.Outlined" *@
                        @*               Lines="3" *@
                        @*               MaxLength="500" *@
                        @*               Counter="500" *@
                        @*               Immediate="true"/> *@
                        @* *@
                        @* <MudNumericField T="int" *@
                        @*                  @bind-Value="_model.SortOrder" *@
                        @*                  Label="排序" *@
                        @*                  Variant="Variant.Outlined" *@
                        @*                  Min="0" *@
                        @*                  Max="9999"/> *@
                        @* *@
                        @* <MudSwitch T="bool" *@
                        @*            @bind-Value="_model.IsActive" *@
                        @*            Label="启用状态" *@
                        @*            Color="Color.Primary"/> *@
                    </MudStack>
                }
                else
                {
                    @NodeTemplate.EditTemplate(_node)
                }

                <NodeAttributesSky @ref="_nodeAttributesSky" TItem="@TItem" NodeId="@_node.Id"/>

            </MudForm>
        </MudContainer>
    </DialogContent>

</DialogTreeSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    
    [Parameter] public bool IsCreate { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }

    private NodeAttributesSky<TItem> _nodeAttributesSky = null!;
    private MudForm _form = null!;

    // private TreeNodeFormModel _model = new();
    // private bool _isSubmitting = false;
    private TItem _node = null!;

    private string _title = null!; //=> IsCreate ? "创建节点" : "编辑节点";

    protected override void OnInitialized()
    {
        _node = NodeTemplate.Node.Value!;

        _title = IsCreate ? $"创建【{_node.Parent!.Text()}】子节点" : _node.Text();

        base.OnInitialized();
    }

    // private async Task ParentSelectAsync()
    // {
    //     var parent = await TreeNodeDialogService.ShowParentSelectDialogAsync();
    // }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        // _isSubmitting = true;
        MudDialog?.Close(DialogResult.Ok(_node));
    }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    private async Task OpenAddDialog()
    {
        var result = await DialogService.ShowAttributeDefinitionListDialogAsync();
     
        if (result == null) return;
        
        await OpenEditDialog(result);
    }

    private async Task OpenEditDialog(AttributeDefinitionDto definition)
    {
        var dialogParams = new DialogParameters<AddAttributeValueDialog>
        {
            { x => x.NodeId, _node.Id },
            { x => x.DefinitionDto, definition },
        };
        var dialog = await DialogService.ShowAsync<AddAttributeValueDialog>("添加属性", dialogParams);
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await _nodeAttributesSky.LoadAttributes();
        }
    }

    private async Task ValueChanged(AttributeDefinitionDto? definition)
    {
        await _nodeAttributesSky.LoadAttributes();
    }
    
    public void Dispose()
    {
    }

}
