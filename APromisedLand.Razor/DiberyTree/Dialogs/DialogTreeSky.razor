@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject TreeNodeDialogService<TItem> TreeNodeDialogService

<DialogSky Title="@Title"
           CancelButtonVisible="@CancelButtonVisible"
           SubmitButtonVisible="@SubmitButtonVisible"
           OnCanceledClick="e => OnCanceledClick.InvokeAsync()"
           OnSubmitClick="e => OnSubmitClick.InvokeAsync()">
    <ToolBarContent>
        <MudIconButton Icon="@Icons.Material.Outlined.PhotoCamera"
                       Color="Color.Primary"
                       OnClick="@(e => ImageClick(Item))"/>
        <MudIconButton Icon="@Icons.Material.Outlined.Videocam"
                       Color="Color.Primary"
                       OnClick="@(e => VideoClick(Item))"/>
        <MudIconButton Icon="@Icons.Material.Outlined.FilePresent"
                       Color="Color.Primary"
                       OnClick="@(e => FileClick(Item))"/>
        <MudIconButton Icon="@Icons.Material.Outlined.LocationOn"
                       Color="Color.Primary"
                       OnClick="@(e => LocationClick(Item))"/>

        <MudSpacer/>
        
        @if(ToolBarContent !=null)
        {
            @ToolBarContent
        }
    </ToolBarContent>
    <DialogContent>

        @if (DialogContent != null)
        {
            @DialogContent
        }
    </DialogContent>
    <DialogRightActions>
        @if (DialogActions != null)
        {
            @DialogActions
        }
    </DialogRightActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string Title { get; set; }
    [Parameter] public required TItem Item { get; set; }

    [Parameter] public bool CancelButtonVisible { get; set; } = true;
    [Parameter] public bool SubmitButtonVisible { get; set; }

    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? ToolBarContent { get; set; }
    [Parameter] public RenderFragment? DialogContent { get; set; }
    [Parameter] public RenderFragment? DialogActions { get; set; }

    [Parameter] public EventCallback OnCanceledClick { get; set; }
    [Parameter] public EventCallback OnSubmitClick { get; set; }

    // [Parameter] public EventCallback OnImageClick { get; set; }
    // [Parameter] public EventCallback OnFileClick { get; set; }
    // [Parameter] public EventCallback OnVideoClick { get; set; }
    // [Parameter] public EventCallback OnLocationClick { get; set; }
    
    private async Task ImageClick(TItem? item)
    {
        await TreeNodeDialogService.ShowTreeImageDialogAsync();
    }
    
    private async Task VideoClick(TItem? item)
    {
        await TreeNodeDialogService.ShowTreeVideoDialogAsync();
    }

    private async Task FileClick(TItem? item)
    {
        await TreeNodeDialogService.ShowTreeFileDialogAsync();
    }

    private async Task LocationClick(TItem? item)
    {
        await TreeNodeDialogService.ShowTreeLocationDialogAsync();
    }
}