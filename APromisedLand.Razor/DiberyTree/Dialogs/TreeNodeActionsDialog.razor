@typeparam TItem where TItem : class, ITreeNodeBase, new()

@implements IDisposable

@* Title="@TitleText" *@
<DialogSky Title="节点操作">
    <DialogContent>
        <MudContainer Class="py-4" MaxWidth="MaxWidth.Medium">
            <MudStack Spacing="2">
                @if (NodeTemplate.ActionTemplate is null)
                {
                    <MudTextField T="string"
                                  Value="NodeTemplate.Node.Value!.Id"
                                  Label="ID"
                                  Variant="Variant.Text"
                                  ReadOnly="true"/>

                    <MudTextField T="string"
                                  Value="NodeTemplate.Node.Value!.Text()"
                                  Label="名称"
                                  Variant="Variant.Outlined"
                                  ReadOnly="true"/>

                    <MudTextField T="string"
                                  Value="NodeTemplate.Node.Value!.Description"
                                  Label="描述"
                                  Variant="Variant.Outlined"
                                  ReadOnly="true"
                                  Lines="2"/>

                    <MudTextField T="string"
                                  Value="ParentName"
                                  Label="父分类"
                                  Variant="Variant.Text"
                                  ReadOnly="true"/>

                    <MudSwitch T="bool"
                               Value="NodeTemplate.Node.Value!.IsActive"
                               Label="状态"
                               Color="Color.Primary"
                               ReadOnly="true"/>
                }
                else
                {
                    @NodeTemplate.ActionTemplate(NodeTemplate.Node.Value!)
                }
            </MudStack>
        </MudContainer>
    </DialogContent>
    <DialogActions>
            <MudButton OnClick="@OnAddChild"
                       Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Add">
                创建子项
            </MudButton>

            <MudButton OnClick="OnEdit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit">
                修改
            </MudButton>

            @if (IsLeaf)
            {
                <MudButton OnClick="OnDelete"
                           Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete">
                    删除
                </MudButton>
            }

        @* </MudStack> *@
    </DialogActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }
    [Parameter] public TItem? ParentNode { get; set; }
    [Parameter] public bool IsLeaf { get; set; }

    private string TitleText => $"节点: {NodeTemplate.Node.Value!.Text()}";
    private string ParentName => ParentNode?.Text() ?? "根分类";

    private void OnAddChild()
    {
        CloseWithAction(NodeAction.AddChild);
    }

    private void OnEdit()
    {
        CloseWithAction(NodeAction.Edit);
    }

    private void OnDelete()
    {
        CloseWithAction(NodeAction.Delete);
    }

    private void CloseWithAction(NodeAction action)
    {
        MudDialog?.Close(DialogResult.Ok(new NodeActionResult<TItem>
        {
            Action = action,
            Node = NodeTemplate.Node.Value!
        }));
    }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    public void Dispose()
    {
    }

}
