@page "/TreePage"
@page "/tree"
@using APromisedLand.MauiBlazor.DiberyTree.Services
@using APromisedLand.Shared.DTOs

@namespace APromisedLand.Razor.DiberyTree

@inject DiberyTreeApiClient<CategoryTree> DiberyTreeApiClient;

<PageSky Title="Weather" BottomBarVisibled>
    <PageContent>
        <MudMainContent>
            <ChildContent>
                <MudContainer MaxWidth="MaxWidth.Small">
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               OnClick="async () => await GetCategoryTree()">CategoryTree</MudButton>
                   
                    @* <TreeSky TItem="CategoryTree" InitialTreeItems="@InitialTreeItems"  *@
                    @*          LoadServerData="@LoadDataAsync"/> *@
                </MudContainer>
            </ChildContent>
        </MudMainContent>
    </PageContent>
</PageSky>

@code {

    private List<TreeItemData<CategoryTree>> InitialTreeItems { get; set; } = new();
    private int _idCounter = 1; // <- the counter makes sure the generated items are unique

    protected override async Task OnInitializedAsync()
    {
        var items = await DiberyTreeApiClient.GetRootNodesAsync();
        
         InitialTreeItems = items.Select(i => i.ToTreeItemData<CategoryTree>()).ToList();
    }

    private async Task<IReadOnlyCollection<TreeItemData<CategoryTree>>> LoadDataAsync(CategoryTree? parentValue)
    {
        // return await DiberyTreeApiClient.LoadServerData(parentValue);
        
        // wait 500ms to simulate a server load
        await Task.Delay(500);
        // normally you would use the parentValue to query your server for the children of the given parent
        // but for the sake of this example we will just return some hardcoded children
        return
        [
            new TreeItemData<CategoryTree> { Value = new CategoryTree { Name = $"More Spam ({_idCounter++})" }, Icon = Icons.Material.Filled.Group, },
            new TreeItemData<CategoryTree> { Value = new CategoryTree { Name = $"L.E.D Door Mats ({_idCounter++})" }, Icon = Icons.Material.Outlined.Lightbulb, Expandable = false },
            new TreeItemData<CategoryTree> { Value = new CategoryTree { Name = $"Car Beauty Salon ({_idCounter++})" }, Icon = Icons.Material.Filled.CarRepair, Expandable = false },
            new TreeItemData<CategoryTree> { Value = new CategoryTree { Name = $"Fakedoors.com ({_idCounter++})" }, Icon = Icons.Material.Outlined.DoorFront, Expandable = false },
            new TreeItemData<CategoryTree> { Value =  new CategoryTree { Name = $"Bluetooth Toilet ({_idCounter++})" }, Icon = Icons.Material.Filled.Wc, Expandable = false }
        ];
    }

    private async Task GetCategoryTree()
    {
        var items = await DiberyTreeApiClient.GetRootNodesAsync();
        
        InitialTreeItems = items.Select(i => i.ToTreeItemData<CategoryTree>()).ToList();
    }
}