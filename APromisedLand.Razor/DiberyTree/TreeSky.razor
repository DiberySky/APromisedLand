@typeparam TItem where TItem : class, ITreeNode

<MudTreeView T="TItem" ServerData="@LoadServerData" Items="@InitialTreeItems">
    <ItemTemplate>
        <MudTreeViewItem T="TItem" 
            Text="@context.Value?.Text()"
            Value="@context.Value"
            @bind-Items="context.Children"
            @bind-Expanded="@context.Expanded"
            CanExpand="@context.Expandable"
            Icon="@context.Icon"
            LoadingIconColor="Color.Info"/>
    </ItemTemplate>
</MudTreeView>

@code {
    [Parameter] public Func<TItem?, Task<IReadOnlyCollection<TreeItemData<TItem>>>>? 
        LoadServerData { get; set; } 
    [Parameter] public List<TreeItemData<TItem>> InitialTreeItems { get; set; } = [];
    
