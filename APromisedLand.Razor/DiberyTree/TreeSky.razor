@using APromisedLand.Razor.DiberyTree.Models
@using APromisedLand.Razor.DiberyTree.Navigation

@typeparam TItem where TItem : class, ITreeNode, new()

@inject ITreeNavigationHistoryService History
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageSky Title="Category Tree" BottomBarVisibled
         ArrowBackVisibled=@(History.Peek() != null)
         OnStartClick="e => StartClick()"
         OnBackClick="e => ClickBack()">
    <PageContent>
        @if (_isLoading)
        {
            <div style="display: flex; justify-content: center; align-items: center; height: 300px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else
        {
            <MudTreeView T="TItem" ServerData="@LoadChildrenAsync" Items="@_items"
                         @bind-SelectedValue="SelectedValue"
                         SelectionMode="@SelectionMode.ToggleSelection">
                <ItemTemplate>
                    <MudTreeViewItem T="TItem"
                        Text="@context.Text"
                        Value="@context.Value"
                        @bind-Items="context.Children"
                        @bind-Expanded="@context.Expanded"
                        CanExpand="@context.Expandable"
                        Icon="@context.Icon"
                        LoadingIconColor="Color.Info"
                        OnClick="@(() => ClickItem(context))">
                        <BodyContent Context="node">
                            <MudContainer class="d-flex justify-space-between mx-0 px-0">
                                <MudText>
                                    <MudHighlighter Text="@(context.Text)"
                                                    HighlightedText="@HighlightedText"
                                                    Class="mud-theme-primary"/>
                                </MudText>

                                <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => ShowNodeActionsAsync(context))"/>
                            </MudContainer>
                        </BodyContent>
                    </MudTreeViewItem>
                </ItemTemplate>
            </MudTreeView>
        }
    </PageContent>
</PageSky>

@code {
    [Parameter] public RenderFragment<TItem>? ActionTemplate { get; set; }

    [Parameter] public RenderFragment<TItem>? EditTemplate { get; set; }
}