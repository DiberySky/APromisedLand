
<DialogSky Title="@Title"
           TitleClass="mud-theme-primary"
           SubmitButtonVisible="false"
           CancelButtonText="关闭">
    <DialogContent>
        <MudContainer class="my-4">
            <MudText Typo="Typo.body1" Style="word-wrap: break-word; overflow-wrap: break-word;">@Message</MudText>
        </MudContainer>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string Title { get; set; }
    [Parameter] public required string Message { get; set; }
}