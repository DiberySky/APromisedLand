@page "/StartPage"
@using APromisedLand.Razor.Dialogs
@using APromisedLand.Razor.Helper.Dialog
@using APromisedLand.Shared.Interfaces
@using APromisedLand.Shared.Models
@using APromisedLand.Shared.Services.Solution
@using BlazorHelper = APromisedLand.Razor.Helper.Blazor.BlazorHelper

@inject IAuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthProvider
@inject BlazorService BlazorService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageSky Title="导航" 
         ArrowBackVisible="@(SolutionService.Authorized == false)"
         StartButtonVisible="true"
         BottomBarVisible
         BackPage="/">
    <PageContent>
        <MudContainer MaxWidth="MaxWidth.ExtraSmall">
            <MudExpansionPanels Class="my-4">
                <MudStack Spacing="0">
                    @foreach (var panel in ExpansionPanels)
                    {
                        <MudExpansionPanel Text=@panel.Title Expanded=@panel.Expanded
                                           HeaderClass="mud-theme-dark" Class="my-0">
                            <MudStack Spacing="2" Class="my-2">
                                @foreach (var pageInfo in panel.PageInfos)
                                {
                                    @if (pageInfo.Authorized)
                                    {
                                        if (SolutionService.GroupMember(pageInfo.Group))
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       FullWidth Color="Color.Primary"
                                                       OnClick="e => Navigate(pageInfo)">@pageInfo.Title</MudButton>
                                        }
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   FullWidth Color="Color.Success"
                                                   OnClick="e => Navigate(pageInfo)">@pageInfo.Title</MudButton>
                                    }
                                }
                            </MudStack>
                        </MudExpansionPanel>
                    }
                </MudStack>
            </MudExpansionPanels>
            <MudButton Class="mt-4" Variant="Variant.Filled"
                       FullWidth Color="Color.Info"
                       OnClick="e => AboutAsync()">关于</MudButton>

            <MudButton Color="Color.Warning" Variant="Variant.Filled"
                       FullWidth Size="Size.Small"
                       OnClick="@TestClick"> 测试</MudButton>
            </MudContainer>
    </PageContent>
</PageSky>

@code {
    
    [Parameter] public List<ExpansionPanel> ExpansionPanels { get; set; } = BlazorHelper.ExpansionPanels;
    
    private async Task Navigate(PageInfo pageInfo)
    {
        if (pageInfo.IsDialog)
        {
            await DialogAsync(pageInfo);
        }
        else
        {
            NavigationManager.NavigateTo(pageInfo.Name);
        }
    }

    private async Task DialogAsync(PageInfo pageInfo)
    {
        await BlazorService.ShowDialogAsync(pageInfo);
    }

    private async Task AboutAsync()
        => await BlazorService.ShowAboutDialogAsync();
    
    private void TestClick()
    {
        BlazorService.ShowError("测试", "测试参数");
        BlazorService.ShowSuccess("测试成功");
    }
}
