@namespace APromisedLand.Razor.Components
@using APromisedLand.Razor.Helper.Blazor
@using APromisedLand.Shared.Interfaces
@using APromisedLand.Shared.Services.Solution
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@inject IAuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigator

<PageSky Title="@Title" ArrowBackVisible="false"
         BottomBarVisible="true"
         StartButtonVisible="true"
         OnStartClick=@(() => Navigator.NavigateTo("StartPage"))>
    <PageContent>
        <MudMainContent>
            <MudContainer Class="align-content-center" MaxWidth="MaxWidth.Small">
                <MudCard Outlined="true">
                    <MudCardHeader Class="mud-theme-success">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">登录</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Login"
                                           Color="Color.Warning"/>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudForm @ref="_form">
                            <MudStack Spacing="2" Class="px-12">
                                <MudTextField T="string" @bind-Value="@_user" Required
                                              Variant="Variant.Outlined" Label="用户"/>

                                <PasswordSky @ref="_passwordField" Variant="Variant.Outlined"/>
                            </MudStack>
                        </MudForm>
                    </MudCardContent>
                    <MudCardActions>
                        <MudSpacer/>
                        <ButtonLoadingSky Text="登录" Color="Color.Primary" Size="Size.Small"
                                          Class="mr-12 mb-2"
                                          Variant="Variant.Filled"
                                          OnClickFunc="OnSubmitClick"/>
                    </MudCardActions>
                </MudCard>
            </MudContainer>
        </MudMainContent>
    </PageContent>
</PageSky>

@code {
    MudForm? _form;
    PasswordSky? _passwordField;
    string? _user;

    [Parameter] public required string Title { get; set; }
    // [Parameter] public EventCallback<SignInUser> OnSignInClick { get; set; }

    // [Parameter] public EventCallback OnStartClick { get; set; }
    [Parameter] public EventCallback OnBackClick { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
#if DEBUG
        _user = "tian";
#endif
    }
    
    private async Task OnSubmitClick()
    {
        if (_form == null || _passwordField == null
                          || string.IsNullOrEmpty(_user) || string.IsNullOrEmpty(_passwordField.Password))
        {
            return;
        }

        try
        {
            await _form.ValidateAsync();

            if (_form.IsValid == false) return;

            var logonUser = new SignInUser { UserName = _user, Password = _passwordField.Password };

            // await OnSignInClick.InvokeAsync(logonUser);
            
            await SignInClick(logonUser);
        }
        catch (Exception e)
        {
            Snackbar.Details("登录失败。", e.Message, DialogService);
        }
    }

    private async Task SignInClick(SignInUser user)
    {
        try
        {
            // var size = PlatformServer.CurrentWindow();
            SolutionService.Authorized = false;

            var success = await AuthenticationService.LoginAsync(user.UserName, user.Password);
            if (success)
            {
                var authState = await AuthProvider.GetAuthenticationStateAsync();
                var userlogin = authState.User;

                SolutionService.GetClaimValue(userlogin.Claims);

                StateHasChanged();

                SolutionService.Authorized = true;

                Snackbar.Success($"登录成功: {SolutionService.UserName}");

                Navigator.NavigateTo(SolutionService.StartPage);
            }
            else
            {
                Snackbar.Error("登录失败，请检查用户名或密码。");
            }
        }
        catch (Exception e)
        {
            Snackbar.Details("登录失败。", e.Message, DialogService);
        }
        finally
        {
            
        }
    }
}
