{
  "id": "apromisedland",
  "realm": "apromisedland",
  "displayName": "A promised land",
  "loginTheme": "treegraph",
  "internationalizationEnabled": true,
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN"],
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "defaultGroups": ["/diberysky"],
  "roles": {
    "realm": [
      {
        "id": "20000000-0000-4000-8000-000000000001",
        "name": "app-superuser",
        "description": "超级用户",
        "composite": false
      },
      {
        "id": "20000000-0000-4000-8000-000000000002",
        "name": "app-admin",
        "description": "管理员",
        "composite": false
      },
      {
        "id": "20000000-0000-4000-8000-000000000003",
        "name": "app-editor",
        "description": "编辑用户",
        "composite": false
      },
      {
        "id": "20000000-0000-4000-8000-000000000004",
        "name": "app-viewer",
        "description": "普通用户",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "id": "10000000-0000-4000-8000-000000000001",
      "clientId": "treegraph-web",
      "name": "TreeGraph Web",
      "description": "Blazor Server 管理台登录客户端",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TREEGRAPH_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "http://localhost:5783",
      "baseUrl": "http://localhost:5783",
      "redirectUris": ["http://localhost:5783/signin-oidc"],
      "webOrigins": ["http://localhost:5783"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5783/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "realm roles to roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups to groups claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "treegraph-web audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "treegraph-web",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "id": "10000000-0000-4000-8000-000000000002",
      "clientId": "treegraph-maui",
      "name": "TreeGraph MAUI",
      "description": "MAUI 客户端登录（公共客户端 + PKCE）",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["treegraph://callback"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "realm roles to roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups to groups claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "id": "10000000-0000-4000-8000-000000000003",
      "clientId": "treegraph-wasm",
      "name": "TreeGraph WebAssembly",
      "description": "纯 WASM 管理台公共客户端（Authorization Code + PKCE S256）",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "https://localhost:5787",
      "baseUrl": "https://localhost:5787",
      "redirectUris": ["https://localhost:5787/authentication/login-callback"],
      "webOrigins": ["https://localhost:5787"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:5787/"
      },
      "protocolMappers": [
        {
          "name": "realm roles to roles claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups to groups claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "treegraph-wasm audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "treegraph-wasm",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "id": "10000000-0000-4000-8000-000000000004",
      "clientId": "treegraph-admin",
      "name": "TreeGraph Admin API",
      "description": "管理调用 service account（client_credentials）",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TREEGRAPH_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "groups": [
    {
      "id": "30000000-0000-4000-8000-000000000001",
      "name": "Admin",
      "path": "/Admin",
      "attributes": {
        "description": ["管理员"]
      },
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    },
    {
      "id": "30000000-0000-4000-8000-000000000002",
      "name": "diberysky",
      "path": "/diberysky",
      "attributes": {
        "description": ["成员"]
      },
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    },
    {
      "id": "30000000-0000-4000-8000-000000000003",
      "name": "spaces",
      "path": "/spaces",
      "attributes": {
        "description": ["空间成员组容器"]
      },
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    }
  ],
  "users": [
    {
      "username": "service-account-treegraph-admin",
      "enabled": true,
      "serviceAccountClientId": "treegraph-admin",
      "realmRoles": [],
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "manage-realm",
          "view-users",
          "query-users",
          "manage-users",
          "view-clients",
          "manage-clients",
          "view-identity-providers",
          "manage-identity-providers",
          "view-events",
          "manage-events",
          "query-groups"
        ]
      }
    }
  ]
}
