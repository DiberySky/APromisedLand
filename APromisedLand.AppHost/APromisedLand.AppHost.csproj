        <ProjectReference Include="..\MafRagTreeGraph\MafRagTreeGraph.csproj" />
        <ProjectReference Include="..\MafStatefulApi.Client\MafStatefulApi.Client.csproj" />
        <ProjectReference Include="..\MafAIService\MafAIService.csproj" />
        <ProjectReference Include="..\MafStatefulApi.Web\MafStatefulApi.Web.csproj" />
