        <PackageReference Include="Aspire.Hosting.Maui" Version="17.0.0-preview.1.26567.5" />
        <PackageReference Include="Aspire.Hosting.Nats" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Python" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Qdrant" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Yarp" Version="17.0.0" />
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="17.0.0" />
        <PackageReference Include="Microsoft.AI.Foundry.Local.Core.WinML" Version="1.2.4" />
    </ItemGroup>

    <ItemGroup>
