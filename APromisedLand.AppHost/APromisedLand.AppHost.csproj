<Project Sdk="Aspire.AppHost.Sdk/17.0.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>023ca44c-b24a-4776-82f6-1c5c6d30ef4f</UserSecretsId>
        <!-- Foundry Local WinML 传递包强制注入 RID（$(NETCoreSdkRuntimeIdentifier)），必须显式对齐，否则 restore/build 资产不一致 -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <!-- 不使用 Aspire CLI bundle 特性（ aspire publish 等），按官方诊断指引抑制 ASPIRE010；
             AppHost.cs 中保留多套未启用的编排模板函数（按需切换调用），抑制 CS8321 -->
        <NoWarn>$(NoWarn);ASPIRE010;CS8321</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Blazor" Version="17.0.0-preview.1.26567.5" />
        <PackageReference Include="Aspire.Hosting.Docker" Version="17.0.0" />
        <PackageReference Include="Aspire.Hosting.Elasticsearch" Version="13.3.0" />
        <PackageReference Include="Aspire.Hosting.Foundry" Version="17.0.0-preview.1.26567.5" />
