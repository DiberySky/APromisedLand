@page "/admin/identity-providers"
@attribute [Authorize(Policy = IdentityConstants.AdminOnlyPolicy)]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using TreeGraph.Shared.Identity
@using TreeGraph.Shared.Identity.Admin
@inject IIdentityProvidersAdminService IdpService
@inject IAdminActorAccessor ActorAccessor
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>身份提供方</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">身份提供方（Identity Providers）</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenCreateAsync">新建</MudButton>
</MudStack>

<MudTable T="IdentityProviderSummary" Items="_providers" Dense="true" Hover="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Alias</MudTh>
        <MudTh>Provider</MudTh>
        <MudTh>显示名称</MudTh>
        <MudTh>状态</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><a href="/admin/identity-providers/@context.Alias" class="text-primary">@context.Alias</a></MudTd>
        <MudTd>@context.ProviderId</MudTd>
        <MudTd>@(context.DisplayName ?? "—")</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Error)" Variant="Variant.Filled">
                @(context.Enabled ? "启用" : "禁用")
            </MudChip>
        </MudTd>
        <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" OnClick='() => ConfirmDeleteAsync(context)' /></MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Typo="Typo.body2">暂无身份提供方。</MudText></NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<IdentityProviderSummary> _providers = [];
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _providers = await IdpService.ListAsync(); }
        catch (Exception ex) { Snackbar.Add($"加载失败：{ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateIdentityProviderDialog>("新建身份提供方");
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadAsync();
    }

    private async Task ConfirmDeleteAsync(IdentityProviderSummary idp)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除", $"确定删除身份提供方「{idp.Alias}」？",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true) return;

        var result = await IdpService.DeleteAsync(ActorAccessor.GetRequiredActor(), idp.Alias);
        if (result.Success) { Snackbar.Add("已删除", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(result.Error ?? "删除失败", Severity.Error);
    }
}
