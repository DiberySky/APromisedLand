@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity.Admin
@inject IRolesAdminService RolesService
@inject IAdminActorAccessor ActorAccessor
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">新建角色</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name"
                      Label="角色名"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true" />
        <MudTextField @bind-Value="_description"
                      Label="描述"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <MudCheckBox @bind-Value="_composite"
                     Label="复合角色"
                     Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_submitting" OnClick="CreateAsync">
            @(_submitting ? "创建中..." : "创建")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = string.Empty;
    private string? _description;
    private bool _composite;
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("请填写角色名", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var result = await RolesService.CreateAsync(
                ActorAccessor.GetRequiredActor(),
                new CreateRoleRequest(_name.Trim(), _description, _composite));
            if (result.Success)
            {
                Snackbar.Add($"角色已创建：{_name}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error ?? "创建失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
