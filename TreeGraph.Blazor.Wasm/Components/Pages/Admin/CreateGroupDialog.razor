@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity.Admin
@inject IGroupsAdminService GroupsService
@inject IAdminActorAccessor ActorAccessor
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(ParentName) ? "新建顶层组" : $"在「{ParentName}」下新建子组")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name"
                      Label="组名"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true" />
        <MudTextField @bind-Value="_description"
                      Label="描述"
                      Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_submitting" OnClick="CreateAsync">
            @(_submitting ? "创建中..." : "创建")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? ParentId { get; set; }
    [Parameter] public string ParentName { get; set; } = string.Empty;

    private string _name = string.Empty;
    private string? _description;
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("请填写组名", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var result = await GroupsService.CreateAsync(
                ActorAccessor.GetRequiredActor(),
                new CreateGroupRequest(_name.Trim(), ParentId, _description));
            if (result.Success)
            {
                Snackbar.Add($"组已创建：{_name}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error ?? "创建失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
