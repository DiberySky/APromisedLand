@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity.Admin
@inject IUsersAdminService UsersService
@inject IAdminActorAccessor ActorAccessor
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">重置密码</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">为用户「@Username」设置新密码。</MudText>
        <MudTextField @bind-Value="_password"
                      Label="新密码"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      InputType="InputType.Password" />
        <MudTextField @bind-Value="_confirm"
                      Label="确认密码"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      InputType="InputType.Password" />
        <MudCheckBox @bind-Value="_temporary"
                     Label="临时密码（用户下次登录需修改）"
                     Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@_submitting"
                   OnClick="ResetAsync">
            @(_submitting ? "提交中..." : "重置")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public string Username { get; set; } = string.Empty;

    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private bool _temporary = true;
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task ResetAsync()
    {
        if (string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("请填写新密码", Severity.Warning);
            return;
        }
        if (_password != _confirm)
        {
            Snackbar.Add("两次输入的密码不一致", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var actor = ActorAccessor.GetRequiredActor();
            var result = await UsersService.ResetPasswordAsync(
                actor, UserId, new ResetPasswordRequest(_password, _temporary));
            if (result.Success)
            {
                Snackbar.Add("密码已重置", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error ?? "重置失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"重置失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
