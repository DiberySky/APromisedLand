@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity
@using TreeGraph.Shared.Identity.Admin
@inject IUsersAdminService UsersService
@inject IAdminActorAccessor ActorAccessor
@inject ISnackbar Snackbar

<DialogSky Title="新建用户"
           MaxWidth="MaxWidth.Small"
           FullWidth="true"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
           SubmitButtonColor="Color.Primary"
           SubmitButtonDisabled="@_submitting"
           OnSubmitClick="CreateAsync">
    <DialogContent>
        @if (_isSuperuser)
        {
            <MudSelect T="string"
                       @bind-Value="_accountRole"
                       Label="账号类型"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                <MudSelectItem T="string" Value="@IdentityRoles.Viewer">普通用户</MudSelectItem>
                <MudSelectItem T="string" Value="@IdentityRoles.Admin">管理员</MudSelectItem>
            </MudSelect>
        }
        <MudTextField @bind-Value="_username"
                      Label="@(_accountRole == IdentityRoles.Admin ? "用户名" : "手机号")"
                      HelperText="@(_accountRole == IdentityRoles.Admin ? "3-64 位字母、数字、点、下划线或短横线，以字母开头" : "中国大陆 11 位手机号，同时作为登录名")"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true" />
        <MudTextField @bind-Value="_realName"
                      Label="真实姓名"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true" />
        <MudTextField @bind-Value="_temporaryPassword"
                      Label="初始密码"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      InputType="InputType.Password"
                      Required="true" />
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            首次登录必须修改密码。普通用户默认授予「普通用户」角色；管理员同时具有业务写权限。
        </MudAlert>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _username = string.Empty;
    private string _realName = string.Empty;
    private string _temporaryPassword = string.Empty;
    private string _accountRole = IdentityRoles.Viewer;
    private bool _isSuperuser;
    private bool _submitting;

    protected override void OnInitialized()
        => _isSuperuser = ActorAccessor.GetRequiredActor().IsSuperuser;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_realName)
            || string.IsNullOrWhiteSpace(_temporaryPassword))
        {
            Snackbar.Add("请填写登录名、真实姓名和初始密码", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var actor = ActorAccessor.GetRequiredActor();
            var isAdmin = _isSuperuser && _accountRole == IdentityRoles.Admin;
            var request = new CreateUserRequest(
                Username: _username.Trim(),
                RealName: _realName.Trim(),
                TemporaryPassword: _temporaryPassword,
                RealmRoles: isAdmin
                    ? [IdentityRoles.Admin, IdentityRoles.Editor]
                    : [IdentityRoles.Viewer],
                RequirePasswordChange: true);

            var result = await UsersService.CreateAsync(actor, request);
            if (result.Success)
            {
                Snackbar.Add($"用户已创建：{_username}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(result.Value));
            }
            else
            {
                Snackbar.Add(result.Error ?? "创建失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
