@page "/admin/identity-providers/{Alias}"
@attribute [Authorize(Policy = IdentityConstants.AdminOnlyPolicy)]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Text.Json
@using System.Text.Json.Nodes
@using TreeGraph.Shared.Identity
@using TreeGraph.Shared.Identity.Admin
@inject IIdentityProvidersAdminService IdpService
@inject IAdminActorAccessor ActorAccessor
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>身份提供方详情</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">未找到身份提供方。</MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick='() => Nav.NavigateTo("/admin/identity-providers")'>返回列表</MudButton>
}
else if (_detail is null)
{
    <MudText>加载中...</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">@(_detail.DisplayName ?? _detail.Alias)</MudText>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack" OnClick='() => Nav.NavigateTo("/admin/identity-providers")'>返回列表</MudButton>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mb-3">Alias：<b>@_detail.Alias</b> ｜ Provider：<b>@_detail.ProviderId</b></MudText>

    <MudTabs Elevation="0" Rounded="true">
        <MudTabPanel Text="设置">
            <MudStack Class="mt-3" Style="max-width: 760px">
                <MudTextField @bind-Value="_displayName" Label="显示名称" Variant="Variant.Outlined" Class="mb-2" />
                <MudCheckBox @bind-Value="_enabled" Label="启用" Color="Color.Primary" />
                <MudCheckBox @bind-Value="_trustEmail" Label="信任邮箱（Trust Email）" Color="Color.Primary" />
                <MudCheckBox @bind-Value="_storeToken" Label="存储令牌（Store Token）" Color="Color.Primary" />
                <MudCheckBox @bind-Value="_linkOnly" Label="仅链接（Link Only）" Color="Color.Primary" />
                <MudTextField @bind-Value="_configJson" Label="Config（JSON；敏感字段的占位符表示保持不变）" Variant="Variant.Outlined" Lines="10" Class="mt-2" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-2" Disabled="@_saving" OnClick="SaveAsync">
                    @(_saving ? "保存中..." : "保存")
                </MudButton>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Mappers">
            <div class="mt-3">
                <MudPaper Class="pa-3 mb-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">添加 Mapper</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-2">
                        <MudTextField @bind-Value="_mapperName" Label="名称" Variant="Variant.Outlined" Required="true" Style="width: 220px" />
                        <MudSelect T="string" @bind-Value="_mapperType" Label="Mapper 类型" Variant="Variant.Outlined" Style="width: 320px">
                            @foreach (var t in MapperPresets)
                            {
                                <MudSelectItem Value="@(t)">@t</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_creatingMapper" OnClick="CreateMapperAsync">
                            @(_creatingMapper ? "创建中..." : "创建")
                        </MudButton>
                    </MudStack>
                    <MudTextField @bind-Value="_mapperConfigJson" Label="Config（JSON）" Variant="Variant.Outlined" Lines="4" Style="max-width: 640px" />
                </MudPaper>

                <MudTable T="IdentityProviderMapperInfo" Items="_mappers" Dense="true" Hover="true" Loading="_loadingMappers">
                    <HeaderContent>
                        <MudTh>名称</MudTh>
                        <MudTh>类型</MudTh>
                        <MudTh>Config</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd><MudText Typo="Typo.caption">@context.IdentityProviderMapper</MudText></MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption">@(context.Config.Count == 0 ? "—" : string.Join("; ", context.Config.Take(4).Select(kv => $"{kv.Key}={kv.Value}")))</MudText>
                        </MudTd>
                        <MudTd><MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" OnClick='() => DeleteMapperAsync(context)' /></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText Typo="Typo.body2">暂无 mapper。</MudText></NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string Alias { get; set; } = string.Empty;

    private static readonly string[] MapperPresets =
    {
        "oidc-username-idp-mapper",
        "oidc-user-attribute-idp-mapper",
        "oidc-role-idp-mapper",
        "oidc-group-idp-mapper",
        "oidc-hardcoded-role-idp-mapper",
        "oidc-hardcoded-attribute-idp-mapper",
        "saml-user-attribute-idp-mapper",
        "saml-username-idp-mapper"
    };

    private IdentityProviderDetail? _detail;
    private bool _notFound;
    private bool _saving;

    private string? _displayName;
    private bool _enabled, _trustEmail, _storeToken, _linkOnly;
    private string _configJson = string.Empty;

    private IReadOnlyList<IdentityProviderMapperInfo> _mappers = [];
    private bool _loadingMappers;
    private string _mapperName = string.Empty;
    private string _mapperType = "oidc-username-idp-mapper";
    private string? _mapperConfigJson;
    private bool _creatingMapper;

    protected override async Task OnInitializedAsync()
    {
        _detail = await IdpService.GetAsync(Alias);
        if (_detail is null) { _notFound = true; return; }
        _displayName = _detail.DisplayName;
        _enabled = _detail.Enabled;
        _trustEmail = _detail.TrustEmail;
        _storeToken = _detail.StoreToken;
        _linkOnly = _detail.LinkOnly;
        _configJson = JsonSerializer.Serialize(_detail.Config, new JsonSerializerOptions { WriteIndented = true });
        await LoadMappersAsync();
    }

    private static IReadOnlyDictionary<string, string> ParseConfig(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new Dictionary<string, string>();
        var node = JsonNode.Parse(json);
        return node is JsonObject obj
            ? obj.ToDictionary(p => p.Key, p => p.Value?.ToString() ?? string.Empty)
            : new Dictionary<string, string>();
    }

    private async Task SaveAsync()
    {
        IReadOnlyDictionary<string, string> config;
        try { config = ParseConfig(_configJson); }
        catch (Exception ex) { Snackbar.Add($"Config JSON 解析失败：{ex.Message}", Severity.Error); return; }

        _saving = true;
        try
        {
            var result = await IdpService.UpdateAsync(
                ActorAccessor.GetRequiredActor(), Alias,
                new SaveIdentityProviderRequest(Alias, _detail!.ProviderId, _displayName, _enabled,
                    _trustEmail, _storeToken, _linkOnly, config));
            if (result.Success)
            {
                Snackbar.Add("已保存", Severity.Success);
                _detail = await IdpService.GetAsync(Alias);
                if (_detail is not null)
                    _configJson = JsonSerializer.Serialize(_detail.Config, new JsonSerializerOptions { WriteIndented = true });
            }
            else Snackbar.Add(result.Error ?? "保存失败", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"保存失败：{ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }

    private async Task LoadMappersAsync()
    {
        _loadingMappers = true;
        try { _mappers = await IdpService.ListMappersAsync(Alias); }
        catch (Exception ex) { Snackbar.Add($"加载 mapper 失败：{ex.Message}", Severity.Error); }
        finally { _loadingMappers = false; }
    }

    private async Task CreateMapperAsync()
    {
        if (string.IsNullOrWhiteSpace(_mapperName)) { Snackbar.Add("请填写名称", Severity.Warning); return; }
        IReadOnlyDictionary<string, string> config;
        try { config = ParseConfig(_mapperConfigJson); }
        catch (Exception ex) { Snackbar.Add($"Config JSON 解析失败：{ex.Message}", Severity.Error); return; }

        _creatingMapper = true;
        try
        {
            var mapper = new IdentityProviderMapperInfo(string.Empty, _mapperName.Trim(), Alias, _mapperType, config);
            var result = await IdpService.CreateMapperAsync(ActorAccessor.GetRequiredActor(), Alias, mapper);
            if (result.Success)
            {
                Snackbar.Add("Mapper 已创建", Severity.Success);
                _mapperName = string.Empty;
                _mapperConfigJson = null;
                await LoadMappersAsync();
            }
            else Snackbar.Add(result.Error ?? "创建失败", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"创建失败：{ex.Message}", Severity.Error); }
        finally { _creatingMapper = false; }
    }

    private async Task DeleteMapperAsync(IdentityProviderMapperInfo mapper)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("确认删除", $"删除 mapper「{mapper.Name}」？",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true) return;
        var result = await IdpService.DeleteMapperAsync(ActorAccessor.GetRequiredActor(), Alias, mapper.Id);
        if (result.Success) { Snackbar.Add("已删除", Severity.Success); await LoadMappersAsync(); }
        else Snackbar.Add(result.Error ?? "删除失败", Severity.Error);
    }
}
