@page "/admin/users/{Id}"
@attribute [Authorize(Policy = IdentityConstants.AdminOnlyPolicy)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity
@using TreeGraph.Shared.Identity.Admin
@inject IUsersAdminService UsersService
@inject IGroupsAdminService GroupsService
@inject IRolesAdminService RolesService
@inject ISessionsAdminService SessionsService
@inject IAdminActorAccessor ActorAccessor
@inject StepUpGuard StepUp
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>用户详情</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" OnClick='() => Nav.NavigateTo("/admin/users")' />
    <MudText Typo="Typo.h4">用户详情</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_user is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
        用户不存在或无法读取。<MudButton OnClick='() => Nav.NavigateTo("/admin/users")' Class="ml-2">返回列表</MudButton>
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@_user.Username</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_user.Id · @($"{_user.FirstName} {_user.LastName}".Trim())
                </MudText>
            </div>
            <MudStack Row="true">
                @if (_user.Enabled)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">启用</MudChip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Block" OnClick="ConfirmDisableAsync">禁用用户</MudButton>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled">禁用</MudChip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Outlined.CheckCircle" OnClick="ConfirmEnableAsync">启用用户</MudButton>
                }
            </MudStack>
        </MudStack>
        @if (_disableRetryable)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-3">
                禁用已生效，但会话吊销失败。可点击重试吊销全部会话。
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Class="ml-2" OnClick="RetryLogoutAsync">重试吊销会话</MudButton>
            </MudAlert>
        }
    </MudPaper>

    <MudTabs>
        <MudTabPanel Text="资料">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editEmail" Label="邮箱" Variant="Variant.Outlined" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_editEmailVerified" Label="邮箱已验证" Color="Color.Primary" Class="mt-4" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_editFirstName" Label="名" Variant="Variant.Outlined" Class="mb-3" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_editLastName" Label="姓" Variant="Variant.Outlined" Class="mb-3" />
                </MudItem>
            </MudGrid>
            <MudStack Row="true">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveProfileAsync">保存资料</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.Password" OnClick="OpenResetPasswordAsync">重置密码</MudButton>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="组">
            <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.End">
                <MudSelect T="string" @bind-Value="_selectedGroupId" Label="选择组" Variant="Variant.Outlined" Style="width:340px">
                    @foreach (var g in _availableGroups)
                    {
                        <MudSelectItem T="string" Value="@g.Id">@g.Path</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrEmpty(_selectedGroupId)" OnClick="AddGroupAsync" Class="ml-3">加入组</MudButton>
            </MudStack>
            @if (_user.Groups.Count == 0)
            {
                <MudText Typo="Typo.body2">该用户未加入任何组。</MudText>
            }
            else
            {
                @foreach (var path in _user.Groups)
                {
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Class="ma-1"
                             OnClose="() => RemoveGroupAsync(path)">
                        @path
                    </MudChip>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="角色">
            <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.End">
                <MudSelect T="string" @bind-Value="_selectedRoleName" Label="选择角色" Variant="Variant.Outlined" Style="width:260px">
                    @foreach (var r in _availableRoles)
                    {
                        <MudSelectItem T="string" Value="@r.Name">@r.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrEmpty(_selectedRoleName)" OnClick="AddRoleAsync" Class="ml-3">分配角色</MudButton>
            </MudStack>
            @if (_user.Roles.Count == 0)
            {
                <MudText Typo="Typo.body2">该用户未分配任何 realm 角色。</MudText>
            }
            else
            {
                @foreach (var role in _user.Roles)
                {
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Class="ma-1"
                             OnClose="() => RemoveRoleAsync(role)">
                        @role
                    </MudChip>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="会话">
            <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1">活跃会话（@_sessions.Count）</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Logout" Disabled="@(_sessions.Count == 0)" OnClick="LogoutAllAsync">全部下线</MudButton>
            </MudStack>
            <MudTable T="IdentitySession" Items="_sessions" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>客户端</MudTh>
                    <MudTh>IP</MudTh>
                    <MudTh>开始时间</MudTh>
                    <MudTh>最后访问</MudTh>
                    <MudTh>类型</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@string.Join(", ", context.Clients)</MudTd>
                    <MudTd>@(context.IpAddress ?? "—")</MudTd>
                    <MudTd>@FormatTime(context.Start)</MudTd>
                    <MudTd>@FormatTime(context.LastAccess)</MudTd>
                    <MudTd>@(context.Offline ? "Offline" : "Online")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Outlined.Logout" Color="Color.Error" Size="Size.Small" OnClick="() => LogoutSessionAsync(context.Id)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">无活跃会话。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _saving;
    private bool _disableRetryable;
    private IdentityUserDetail? _user;
    private IReadOnlyList<IdentityGroup> _groupTree = [];
    private IReadOnlyList<IdentityRole> _allRoles = [];
    private IReadOnlyList<IdentitySession> _sessions = [];
    private Dictionary<string, string> _groupPathToId = new();

    private string? _editEmail;
    private bool _editEmailVerified;
    private string? _editFirstName;
    private string? _editLastName;
    private string? _selectedGroupId;
    private string? _selectedRoleName;

    private List<(string Id, string Path)> _allGroups => Flatten(_groupTree);

    private IEnumerable<(string Id, string Path)> _availableGroups
        => _allGroups.Where(g => _user is not null && !_user.Groups.Contains(g.Path, StringComparer.Ordinal));

    private IEnumerable<IdentityRole> _availableRoles
        => _allRoles.Where(r => _user is not null && !_user.Roles.Contains(r.Name, StringComparer.Ordinal));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _user = await UsersService.GetAsync(Id);
            if (_user is not null)
            {
                _editEmail = _user.Email;
                _editEmailVerified = _user.EmailVerified;
                _editFirstName = _user.FirstName;
                _editLastName = _user.LastName;

                _groupTree = await GroupsService.GetTreeAsync();
                _allRoles = await RolesService.ListAsync();
                _groupPathToId = _allGroups.ToDictionary(g => g.Path, g => g.Id, StringComparer.Ordinal);
                _sessions = await SessionsService.ListUserSessionsAsync(Id);
                _disableRetryable = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用户详情失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<(string Id, string Path)> Flatten(IEnumerable<IdentityGroup> groups, List<(string Id, string Path)>? acc = null)
    {
        acc ??= [];
        foreach (var g in groups)
        {
            acc.Add((g.Id, g.Path));
            if (g.Children.Count > 0)
                Flatten(g.Children, acc);
        }
        return acc;
    }

    private static string FormatTime(long? ms)
        => ms.HasValue
            ? DateTimeOffset.FromUnixTimeMilliseconds(ms.Value).LocalDateTime.ToString("yyyy-MM-dd HH:mm")
            : "—";

    private AdminActor Actor() => ActorAccessor.GetRequiredActor();

    private async Task SaveProfileAsync()
    {
        if (_user is null) return;
        _saving = true;
        try
        {
            var result = await UsersService.UpdateAsync(Actor(), Id, new UpdateUserRequest(
                Email: _editEmail,
                FirstName: _editFirstName,
                LastName: _editLastName,
                EmailVerified: _editEmailVerified));
            if (result.Success)
            {
                Snackbar.Add("资料已保存", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "保存失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenResetPasswordAsync()
    {
        if (!await StepUp.EnsureFreshAsync("user.reset-password", $"/admin/users/{Id}")) return;

        if (_user is null) return;
        var parameters = new DialogParameters
        {
            { nameof(ResetPasswordDialog.UserId), Id },
            { nameof(ResetPasswordDialog.Username), _user.Username }
        };
        await DialogService.ShowAsync<ResetPasswordDialog>("重置密码", parameters);
    }

    private async Task ConfirmDisableAsync()
    {
        if (!await StepUp.EnsureFreshAsync("user.disable", $"/admin/users/{Id}")) return;

        if (_user is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认禁用",
            $"确定禁用用户「{_user.Username}」？该用户将被立即登出，且无法再登录。",
            yesText: "禁用", cancelText: "取消");
        if (confirmed != true) return;

        try
        {
            var result = await UsersService.DisableAsync(Actor(), Id);
            if (result.Success && result.Value is { } v)
            {
                if (v.SessionsRevoked && v.RevocationMarked)
                    Snackbar.Add("用户已禁用，会话已吊销", Severity.Success);
                else
                {
                    Snackbar.Add("用户已禁用，但部分后续操作失败（可重试）", Severity.Warning);
                    _disableRetryable = v.Retryable;
                }
            }
            else
            {
                Snackbar.Add(result.Error ?? "禁用失败", Severity.Error);
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"禁用失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmEnableAsync()
    {
        if (_user is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认启用",
            $"确定启用用户「{_user.Username}」？撤销标记将被清除，用户需重新登录。",
            yesText: "启用", cancelText: "取消");
        if (confirmed != true) return;

        try
        {
            var result = await UsersService.EnableAsync(Actor(), Id);
            if (result.Success)
                Snackbar.Add("用户已启用", Severity.Success);
            else
                Snackbar.Add(result.Error ?? "启用失败", Severity.Error);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"启用失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task RetryLogoutAsync()
    {
        try
        {
            var result = await UsersService.LogoutSessionsAsync(Actor(), Id);
            if (result.Success)
            {
                Snackbar.Add("会话已吊销", Severity.Success);
                _disableRetryable = false;
            }
            else
            {
                Snackbar.Add(result.Error ?? "吊销失败", Severity.Error);
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"吊销失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task AddGroupAsync()
    {
        if (string.IsNullOrEmpty(_selectedGroupId)) return;
        try
        {
            var result = await GroupsService.AddMemberAsync(Actor(), _selectedGroupId, Id);
            if (result.Success)
            {
                Snackbar.Add("已加入组", Severity.Success);
                _selectedGroupId = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "加入失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加入失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveGroupAsync(string path)
    {
        if (!_groupPathToId.TryGetValue(path, out var groupId))
        {
            Snackbar.Add("无法定位该组", Severity.Warning);
            return;
        }
        try
        {
            var result = await GroupsService.RemoveMemberAsync(Actor(), groupId, Id);
            if (result.Success)
            {
                Snackbar.Add("已移出组", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "移出失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"移出失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task AddRoleAsync()
    {
        if (string.IsNullOrEmpty(_selectedRoleName)) return;
        try
        {
            var result = await RolesService.AddMemberAsync(Actor(), _selectedRoleName, Id);
            if (result.Success)
            {
                Snackbar.Add("已分配角色", Severity.Success);
                _selectedRoleName = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "分配失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"分配失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveRoleAsync(string roleName)
    {
        try
        {
            var result = await RolesService.RemoveMemberAsync(Actor(), roleName, Id);
            if (result.Success)
            {
                Snackbar.Add("已移除角色", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(result.Error ?? "移除失败", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"移除失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task LogoutSessionAsync(string sessionId)
    {
        try
        {
            var result = await SessionsService.LogoutSessionAsync(Actor(), sessionId);
            if (result.Success)
                Snackbar.Add("会话已下线", Severity.Success);
            else
                Snackbar.Add(result.Error ?? "下线失败", Severity.Error);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"下线失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task LogoutAllAsync()
    {
        try
        {
            var result = await SessionsService.LogoutAllUserSessionsAsync(Actor(), Id);
            if (result.Success)
                Snackbar.Add("全部会话已下线", Severity.Success);
            else
                Snackbar.Add(result.Error ?? "下线失败", Severity.Error);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"下线失败：{ex.Message}", Severity.Error);
        }
    }
}
