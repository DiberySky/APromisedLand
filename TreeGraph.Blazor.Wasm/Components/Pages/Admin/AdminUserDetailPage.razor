@page "/admin/users/{Id}"
@attribute [Authorize(Policy = IdentityConstants.AdminOnlyPolicy)]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject NavigationManager Nav

<PageTitle>用户详情</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-8">
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
        此页面已迁移。用户资料、组、角色、会话管理均已整合到
        <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/admin/users"))">用户管理列表</MudButton>
        的行展开二级列表中。
    </MudAlert>
</MudContainer>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
}
