@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity.Admin
@inject IRealmKeysAdminService KeysService
@inject IAdminActorAccessor ActorAccessor
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">生成新签名密钥</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
            生成后由 Keycloak 按优先级自动切换活动密钥；旧密钥保持 PASSIVE，确认客户端已刷新 JWKS 后再删除。
        </MudAlert>
        <MudSelect T="string" @bind-Value="_algorithm" Label="算法" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var a in Algorithms) { <MudSelectItem Value="@(a)">@a</MudSelectItem> }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_keySize" Label="密钥长度" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_priority" Label="优先级（高于现有密钥）" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_submitting" OnClick="GenerateAsync">
            @(_submitting ? "生成中..." : "生成")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private static readonly string[] Algorithms = { "RS256", "RS384", "RS512", "ES256", "ES384", "ES512" };

    private string _algorithm = "RS256";
    private int _keySize = 2048;
    private int _priority = 100;
    private bool _submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task GenerateAsync()
    {
        _submitting = true;
        try
        {
            var result = await KeysService.GenerateAsync(
                ActorAccessor.GetRequiredActor(),
                new GenerateRealmKeyRequest(
                    ProviderId: _algorithm.StartsWith("ES", StringComparison.Ordinal) ? "ecdsa-generated" : "rsa-generated",
                    Algorithm: _algorithm,
                    KeySize: _keySize,
                    Priority: _priority));

            if (result.Success)
            {
                Snackbar.Add("新密钥已生成", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else Snackbar.Add(result.Error ?? "生成失败", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"生成失败：{ex.Message}", Severity.Error); }
        finally { _submitting = false; }
    }
}
