@page "/admin/users"
@attribute [Authorize(Policy = IdentityConstants.AdminOnlyPolicy)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using TreeGraph.Shared.Identity
@using TreeGraph.Shared.Identity.Admin
@using TreeGraph.Blazor.Shared.Common
@inject IUsersAdminService UsersService
@inject IAdminActorAccessor ActorAccessor
@inject StepUpGuard StepUp
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>用户管理</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">用户管理</MudText>

<MudTable T="IdentityUserSummary"
          ServerData="LoadUsers"
          @ref="_table"
          RowsPerPage="25"
          Hover="true"
          Dense="true"
          Loading="_loading"
          LoadingProgressColor="Color.Primary">
    <ToolBarContent>
        <MudTextField @bind-Value="_search"
                      Placeholder="搜索手机号/用户名"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Immediate="true"
                      Class="mr-3"
                      Style="width:280px" />
        <MudSelect T="string"
                   @bind-Value="_statusFilter"
                   @bind-Value:after="ReloadAsync"
                   Label="状态"
                   Variant="Variant.Outlined"
                   Class="mr-3"
                   Style="width:140px">
            <MudSelectItem T="string" Value="@("all")">全部</MudSelectItem>
            <MudSelectItem T="string" Value="@("enabled")">已启用</MudSelectItem>
            <MudSelectItem T="string" Value="@("disabled")">已禁用</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   OnClick="ReloadAsync">刷新</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>登录名</MudTh>
        <MudTh>真实姓名</MudTh>
        <MudTh>手机号</MudTh>
        <MudTh>状态</MudTh>
        <MudTh>创建时间</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.PersonAdd"
                       Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateAsync">
                新建用户
            </MudButton>
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudText Typo="Typo.body2">@context.Username</MudText>
        </MudTd>
        <MudTd>@(context.RealName ?? "—")</MudTd>
        <MudTd>@(context.PhoneNumber ?? "—")</MudTd>
        <MudTd>
            @if (context.Enabled)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">启用</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">禁用</MudChip>
            }
        </MudTd>
        <MudTd>
            @(context.CreatedTimestamp.HasValue
                ? DateTimeOffset.FromUnixTimeMilliseconds(context.CreatedTimestamp.Value).LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                : "—")
        </MudTd>
        <MudTd Style="white-space: nowrap; text-align: right;">
            @* 展开/收起二级列表 *@
            <MudIconButton Icon="@(_expandedIds.Contains(context.Id)
                                    ? Icons.Material.Outlined.ExpandLess
                                    : Icons.Material.Outlined.ExpandMore)"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="@(() => ToggleExpand(context.Id))"
                           title="资料、组、角色、会话、密码、状态" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (_expandedIds.Contains(context.Id))
        {
            <MudTr>
                <td colspan="6" style="padding: 0 32px; background-color: #000;">
                    <MudSimpleTable Dense="true" Hover="true" Style="background-color: #000;">
                        <tbody>
                            <tr>
                                <td>资料</td>
                                <td style="white-space: nowrap; text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Person"
                                                   Color="Color.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(async () => await OpenProfileAsync(context))"
                                                   title="编辑资料" />
                                </td>
                            </tr>
                            <tr>
                                <td>角色</td>
                                <td style="white-space: nowrap; text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Badge"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(async () => await OpenRolesAsync(context))"
                                                   title="角色分配" />
                                </td>
                            </tr>
                            <tr>
                                <td>重置密码</td>
                                <td style="white-space: nowrap; text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Password"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   OnClick="@(async () => await OpenResetPasswordAsync(context))"
                                                   title="重置密码" />
                                </td>
                            </tr>
                            <tr>
                                <td>组</td>
                                <td style="white-space: nowrap; text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Groups"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   OnClick="@(async () => await OpenGroupsAsync(context))"
                                                   title="组管理" />
                                </td>
                            </tr>
                            <tr>
                                <td>会话</td>
                                <td style="white-space: nowrap; text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Devices"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   OnClick="@(async () => await OpenSessionsAsync(context))"
                                                   title="活跃会话" />
                                </td>
                            </tr>
                            @if (context.Username != IdentityConstants.SuperuserUsername)
                            {
                                <tr>
                                    <td>状态</td>
                                    <td style="white-space: nowrap; text-align: right;">
                                        @if (context.Enabled)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Outlined.Block"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(async () => await ConfirmDisableAsync(context))"
                                                           title="禁用用户" />
                                        }
                                        else
                                        {
                                            <MudIconButton Icon="@Icons.Material.Outlined.CheckCircle"
                                                           Color="Color.Success"
                                                           Size="Size.Small"
                                                           OnClick="@(async () => await ConfirmEnableAsync(context))"
                                                           title="启用用户" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">暂无用户。</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private MudTable<IdentityUserSummary> _table = default!;
    private bool _loading;
    private string? _search;
    private string _statusFilter = "all";

    /// <summary>已展开二级列表的用户 Id。</summary>
    private readonly HashSet<string> _expandedIds = [];

    private async Task<TableData<IdentityUserSummary>> LoadUsers(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            bool? enabled = _statusFilter switch
            {
                "enabled" => true,
                "disabled" => false,
                _ => null
            };

            var request = new AdminPageRequest(
                Search: _search,
                Page: state.Page + 1,
                PageSize: state.PageSize,
                Enabled: enabled);

            var result = await UsersService.SearchAsync(request, ct);
            return new TableData<IdentityUserSummary>
            {
                Items = result.Items,
                TotalItems = result.Total
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用户失败：{ex.Message}", Severity.Error);
            return new TableData<IdentityUserSummary> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync() => _table!.ReloadServerData();

    private void ToggleExpand(string userId)
    {
        if (!_expandedIds.Remove(userId))
            _expandedIds.Add(userId);
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateUserDialog>("新建用户");
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await ReloadAsync();
        }
    }

    private async Task OpenResetPasswordAsync(IdentityUserSummary user)
    {
        if (!await StepUp.EnsureFreshAsync("user.reset-password", $"/admin/users")) return;

        var parameters = new DialogParameters
        {
            { nameof(ResetPasswordDialog.UserId), user.Id },
            { nameof(ResetPasswordDialog.Username), user.Username }
        };
        await DialogService.ShowAsync<ResetPasswordDialog>(string.Empty, parameters);
    }

    private async Task ConfirmDisableAsync(IdentityUserSummary user)
    {
        if (!await StepUp.EnsureFreshAsync("user.disable", $"/admin/users")) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认禁用",
            $"确定禁用用户「{user.Username}」？该用户将被立即登出，且无法再登录。",
            yesText: "禁用", cancelText: "取消");
        if (confirmed != true) return;

        try
        {
            var actor = ActorAccessor.GetRequiredActor();
            var result = await UsersService.DisableAsync(actor, user.Id);
            if (result.Success && result.Value is { } v)
            {
                if (v.SessionsRevoked && v.RevocationMarked)
                    Snackbar.Add("用户已禁用，会话已吊销", Severity.Success);
                else
                    Snackbar.Add("用户已禁用，但部分后续操作失败（可重试）", Severity.Warning);
            }
            else
            {
                Snackbar.Add(result.Error ?? "禁用失败", Severity.Error);
            }
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"禁用失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmEnableAsync(IdentityUserSummary user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认启用",
            $"确定启用用户「{user.Username}」？撤销标记将被清除，用户需重新登录。",
            yesText: "启用", cancelText: "取消");
        if (confirmed != true) return;

        try
        {
            var actor = ActorAccessor.GetRequiredActor();
            var result = await UsersService.EnableAsync(actor, user.Id);
            if (result.Success)
                Snackbar.Add("用户已启用", Severity.Success);
            else
                Snackbar.Add(result.Error ?? "启用失败", Severity.Error);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"启用失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task OpenProfileAsync(IdentityUserSummary user)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserProfileDialog.UserId), user.Id },
            { nameof(UserProfileDialog.Username), user.Username }
        };
        var options = new DialogOptions
        {
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<UserProfileDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await ReloadAsync();
    }

    private async Task OpenGroupsAsync(IdentityUserSummary user)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserGroupsDialog.UserId), user.Id },
            { nameof(UserGroupsDialog.Username), user.Username }
        };
        var options = new DialogOptions
        {
            FullWidth = true
        };
        await DialogService.ShowAsync<UserGroupsDialog>(string.Empty, parameters, options);
    }

    private async Task OpenRolesAsync(IdentityUserSummary user)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserRolesDialog.UserId), user.Id },
            { nameof(UserRolesDialog.Username), user.Username }
        };
        var options = new DialogOptions
        {
            FullWidth = true
        };
        await DialogService.ShowAsync<UserRolesDialog>(string.Empty, parameters, options);
    }

    private async Task OpenSessionsAsync(IdentityUserSummary user)
    {
        var parameters = new DialogParameters
        {
            { nameof(UserSessionsDialog.UserId), user.Id },
            { nameof(UserSessionsDialog.Username), user.Username }
        };
        var options = new DialogOptions
        {
            FullWidth = true
        };
        await DialogService.ShowAsync<UserSessionsDialog>(string.Empty, parameters, options);
    }
}
