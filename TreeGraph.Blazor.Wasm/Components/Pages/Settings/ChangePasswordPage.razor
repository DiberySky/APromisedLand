@page "/settings/change-password"
@attribute [Authorize]
@using TreeGraph.Blazor.Configuration
@inject WasmOidcSession Session
@inject IHttpClientFactory HttpClientFactory
@inject WasmRuntimeConfig Config
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudText Typo="Typo.h5" Class="mb-4">修改密码</MudText>
    <MudTextField @bind-Value="_currentPassword"
                  Label="当前密码"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  Class="mb-3" />
    <MudTextField @bind-Value="_newPassword"
                  Label="新密码"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  Class="mb-3" />
    <MudTextField @bind-Value="_confirmPassword"
                  Label="确认新密码"
                  Variant="Variant.Outlined"
                  InputType="InputType.Password"
                  Class="mb-3" />
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               Disabled="@_submitting"
               OnClick="SubmitAsync">
        @(_submitting ? "提交中..." : "保存")
    </MudButton>
</MudContainer>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _submitting;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            Snackbar.Add("请输入当前密码", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add("请输入新密码", Severity.Warning);
            return;
        }
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            Snackbar.Add("两次输入的新密码不一致", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            // 用当前登录用户的 access token 调 Keycloak Account REST API（用户自助改密，需验证旧密码）
            var token = await Session.GetAccessTokenAsync();
            var client = HttpClientFactory.CreateClient("oidc");
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var endpoint = Config.Keycloak.Authority.TrimEnd('/') + "/account/credentials/password";
            using var resp = await client.PutAsJsonAsync(
                endpoint,
                new { currentPassword = _currentPassword, newPassword = _newPassword });

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("密码已修改", Severity.Success);
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
            }
            else
            {
                var detail = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"修改失败（{(int)resp.StatusCode}）：{detail}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"修改失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
