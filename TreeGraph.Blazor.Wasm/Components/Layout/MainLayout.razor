@inherits LayoutComponentBase
@inject TreeGraph.Blazor.Shared.Platform.IPlatformContext Platform
@inject IJSRuntime JS
@inject WasmOidcSession Session
@inject TreeGraph.Blazor.Shared.NodeEavSky.Services.EntityTypeDisplayService EntityTypeDisplay
<MudThemeProvider IsDarkMode DefaultScrollbar />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
  <MudAppBar Elevation="1" Color="Color.Primary">
    <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start"
                   OnClick="@(() => _drawerOpen = !_drawerOpen)" Size="Size.Small" />
    <MudText Typo="Typo.h6" Class="ml-2">TreeGraph 管理台（WASM）</MudText>
    <MudSpacer />
    <AuthorizeView>
      <Authorized>
        <MudText Class="mr-3">@context.User.Identity?.Name</MudText>
      </Authorized>
    </AuthorizeView>
    <MudButton Color="Color.Inherit" @onclick="SignOutAsync">退出</MudButton>
  </MudAppBar>
  <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always">
    <NavMenu />
  </MudDrawer>
  <MudMainContent Class="page-padded">@Body</MudMainContent>
</MudLayout>
@code {
    private bool _drawerOpen = true;
    private bool _entityTypesLoaded;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Platform.RefreshAsync();
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("treeGraphPlatform.registerResize", _dotNetRef);
        }
        if (Session.IsAuthenticated && !_entityTypesLoaded)
        {
            await EntityTypeDisplay.EnsureLoadedAsync();
            _entityTypesLoaded = true;
            StateHasChanged();
        }
    }
    [JSInvokable]
    public Task OnWindowResize() => Platform.RefreshAsync();
    private Task SignOutAsync() => Session.SignOutAsync();
    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        await JS.InvokeVoidAsync("treeGraphPlatform.unregisterResize");
    }
}
