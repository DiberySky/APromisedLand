    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TreeGraph.Blazor.Shared\TreeGraph.Blazor.Shared.csproj" />
    <ProjectReference Include="..\TreeGraph.Shared\TreeGraph.Shared.csproj" />
  </ItemGroup>
</Project>
