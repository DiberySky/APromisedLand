    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TreeGraph.Blazor</RootNamespace>
    <AssemblyName>TreeGraph.Blazor.Wasm</AssemblyName>
