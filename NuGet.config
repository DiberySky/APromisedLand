<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 私有预览包源：这些包未发布到 nuget.org，仅存于 local-feed 目录，
       用于保证换机器 / CI 环境下 restore 可复现。详见 local-feed/ 内的包清单。 -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-feed" value="local-feed" />
  </packageSources>
</configuration>
