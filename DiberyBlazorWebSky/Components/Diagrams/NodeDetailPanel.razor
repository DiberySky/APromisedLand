@using DiberyBlazorWebSky.Models.Graph

<div class="detail-panel @(IsOpen ? "open" : "")"
     style="position: absolute; top: 0; right: 0; width: 360px; height: 100%;
            background: #fff; border-left: 1px solid #e2e8f0;
            box-shadow: -4px 0 12px rgba(0,0,0,0.06);
            transform: translateX(@(IsOpen ? "0" : "100%"));
            transition: transform 0.25s ease;
            display: flex; flex-direction: column; z-index: 10;
            overflow-y: auto;">
    <div class="detail-header">
        <h3>节点详情</h3>
        <button class="btn-close" @onclick="OnClose">✕</button>
    </div>

    @if (Node is null)
    {
        <p class="detail-empty">请点击一个节点查看详情</p>
    }
    else
    {
        <div class="detail-body">
            <div class="detail-field">
                <label>名称</label>
                <span>@Node.Name</span>
            </div>
            <div class="detail-field">
                <label>GUID</label>
                <code class="detail-code">@Node.Guid</code>
            </div>
            <div class="detail-field">
                <label>标签</label>
                @if (Node.Labels is { Count: > 0 })
                {
                    <div class="detail-tags">
                        @foreach (var l in Node.Labels)
                        {
                            <span class="pill">@l</span>
                        }
                    </div>
                }
                else
                {
                    <span class="muted">—</span>
                }
            </div>
            <div class="detail-field">
                <label>创建时间</label>
                <span>@Node.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="detail-field">
                <label>最后更新</label>
                <span>@Node.LastUpdateUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>

            @if (Node.Tags is { Count: > 0 })
            {
                <div class="detail-field">
                    <label>Tags</label>
                    <div class="detail-tags">
                        @foreach (var kv in Node.Tags)
                        {
                            <span class="tag-item">@kv.Key = @kv.Value</span>
                        }
                    </div>
                </div>
            }

            @if (Node.Data is { Count: > 0 })
            {
                <div class="detail-field">
                    <label>Data</label>
                    <pre class="detail-json">@FormatJson(Node.Data)</pre>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public NodeDto? Node { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static string FormatJson(Dictionary<string, object?>? data)
    {
        if (data is null || data.Count == 0) return "{}";
        return System.Text.Json.JsonSerializer.Serialize(
            data,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }
}