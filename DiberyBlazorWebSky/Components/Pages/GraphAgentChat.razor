@page "/graph-agent-chat"
@using DiberyBlazorWebSky.Services
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer

<PageTitle>图 Agent 对话</PageTitle>

<div class="chat-container">
    <div class="chat-header">
        <h1>🤖 图 Agent 对话（Function Calling）</h1>
        <p class="page-subtitle">
            由 LLM 自主决定调用哪个图工具查询 —— 支持任意复杂问题
        </p>
        <div class="session-controls">
            <input type="text"
                   class="session-search"
                   placeholder="🔍 搜索会话..."
                   @bind="_sessionFilter"
                   @bind:event="oninput"
                   disabled="@_isSending" />

            <select class="session-selector"
                    value="@_selectedSessionId"
                    @onchange="OnSessionChangedAsync"
                    disabled="@_isSending">
                <option value="">New Conversation</option>
                @foreach (var s in FilteredSessions)
                {
                    <option value="@s.Id">@GetSessionLabel(s)</option>
                }
            </select>
            <button class="btn-refresh"
                    @onclick="LoadSessionsAsync"
                    disabled="@(_isSending || _isLoadingSessions)">
                🔄 Refresh
            </button>
            @if (!string.IsNullOrEmpty(_selectedSessionId))
            {
                <button class="btn-rename"
                        @onclick="OpenRenameDialog"
                        disabled="@_isSending"
                        title="重命名当前会话">
                    ✏️ 重命名
                </button>
                <button class="btn-reset"
                        @onclick="ResetSessionAsync"
                        disabled="@_isSending">
                    🗑️ Reset
                </button>
            }
            @if (_messages.Count > 0)
            {
                <button class="btn-copy-all"
                        @onclick="CopyAllMessagesAsync"
                        disabled="@_isSending"
                        title="复制整段对话为 Markdown 格式">
                    @if (_allCopied)
                    {
                        <text>✓ 已复制</text>
                    }
                    else
                    {
                        <text>📋 复制全部</text>
                    }
                </button>
                <button class="btn-export"
                        @onclick="ExportConversationAsync"
                        disabled="@_isSending"
                        title="下载对话为 Markdown 文件">
                    ⬇️ 导出
                </button>
            }
            <label class="stream-toggle">
                <input type="checkbox" @bind="_useStreaming" />
                <span>⚡ 流式</span>
            </label>
        </div>
    </div>

    <div class="chat-messages" @ref="_messagesContainer">
        @if (_messages.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🤖</div>
                <h2>Start a conversation</h2>
                <p>LLM 会自动调用合适的图工具来回答</p>
                <div class="example-questions">
                    <p>试试这些问题：</p>
                    <ul>
                        <li>TestGraph 根节点C 有哪些邻居？</li>
                        <li>TestGraph 从 Transformer 出发 2 跳能到哪些节点？</li>
                        <li>TestGraph PostgreSQL 的出边有哪些？</li>
                        <li>TestGraph 有没有和 docker 相关的节点？</li>
                    </ul>
                    <p class="tip">💡 建议在问题开头加上图名（如 "TestGraph"），让 LLM 知道查哪个图。</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var m in _messages)
            {
                <div class="message @m.Role">
                    <div class="message-avatar">
                        <span>@GetAvatar(m.Role, m.AgentName)</span>
                    </div>
                    <div class="message-content">
                        @if (!string.IsNullOrEmpty(m.AgentName) && m.Role == "assistant")
                        {
                            <div class="agent-name">@m.AgentName</div>
                        }

                        @* ★ 新增：图片展示 *@
                        @if (!string.IsNullOrEmpty(m.ImageDataUrl))
                        {
                            <div class="message-image">
                                <img src="@m.ImageDataUrl" alt="用户上传的图片" />
                                <div class="image-hint">📷 图片仅本地展示，不参与 AI 分析</div>
                            </div>
                        }

                        @* Assistant 消息用 Markdown 渲染；User / Error 消息保持纯文本 *@
                        @if (m.Role == "assistant" && !string.IsNullOrEmpty(m.Text))
                        {
                            <div class="message-text markdown-body">
                                @((MarkupString)MarkdownRenderer.ToHtml(m.Text))
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(m.Text))
                        {
                            <div class="message-text">@m.Text</div>
                        }

                        @* 工具调用详情：可展开 *@
                        @if (m.ToolCallDetails.Count > 0)
                        {
                            <details class="tool-details">
                                <summary class="tools-badge">
                                    🔧 @string.Join(" → ", m.ToolCallDetails.Select(d => d.ToolName))
                                </summary>
                                <div class="tool-details-body">
                                    @foreach (var detail in m.ToolCallDetails)
                                    {
                                        <div class="tool-detail-item">
                                            <div class="tool-detail-header">
                                                <span class="tool-name">🔧 @detail.ToolName</span>
                                                <span class="tool-meta">
                                                    @if (detail.FromCache)
                                                    {
                                                        <span class="tool-cached">⚡ 缓存</span>
                                                    }
                                                    else
                                                    {
                                                        @detail.ElapsedMs
                                                        <text>ms</text>
                                                    }
                                                    @if (!detail.Success)
                                                    {
                                                        <span class="tool-failed">失败</span>
                                                    }
                                                </span>
                                            </div>
                                            <div class="tool-detail-section">
                                                <span class="tool-detail-label">参数：</span>
                                                <code class="tool-detail-code">@detail.Arguments</code>
                                            </div>
                                            @if (!string.IsNullOrEmpty(detail.Result))
                                            {
                                                <div class="tool-detail-section">
                                                    <span class="tool-detail-label">结果：</span>
                                                    <pre class="tool-detail-result">@detail.Result</pre>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </details>
                        }

                        <div class="message-footer">
                            <button class="btn-copy"
                                    @onclick="() => CopyMessageAsync(m)"
                                    title="复制消息内容">
                                @if (_lastCopiedMessageId == m.Id)
                                {
                                    <text>✓ 已复制</text>
                                }
                                else
                                {
                                    <text>📋 复制</text>
                                }
                            </button>
                            <div class="message-time">@m.Timestamp.ToString("HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
            }
        }

        @if (_isSending)
        {
            <div class="message assistant">
                <div class="message-avatar"><span>🤖</span></div>
                <div class="message-content">
                    <div class="typing-indicator">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="elapsed">
                        @(_elapsedSeconds <= 5
                            ? $"LLM 正在思考... {_elapsedSeconds}s"
                            : $"正在调用工具或推理... 已等待 {_elapsedSeconds}s")
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="chat-input-wrapper">
        @* ★ 新增：待发送图片预览 *@
        @if (!string.IsNullOrEmpty(_pendingImageDataUrl))
        {
            <div class="pending-image-preview">
                <img src="@_pendingImageDataUrl" alt="待发送图片" />
                <div class="pending-image-info">
                    <div class="pending-image-name">@_pendingImageName</div>
                    <div class="pending-image-hint">📷 图片仅本地展示，不参与 AI 分析</div>
                </div>
                <button class="pending-image-remove"
                        @onclick="ClearPendingImage"
                        title="移除图片">
                    ✕
                </button>
            </div>
        }

        <div class="chat-input-row">
            <label class="btn-attach" title="上传图片（仅展示）">
                📎
                <InputFile OnChange="OnImageSelected"
                           accept="image/png,image/jpeg,image/gif,image/webp"
                           style="display:none;" />
            </label>

            <textarea class="chat-input"
                      @bind="_userMessage"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="输入问题... (Enter 发送, Shift+Enter 换行)"
                      rows="3"
                      disabled="@_isSending"></textarea>

            @if (_isSending)
            {
                <button class="btn-cancel" @onclick="CancelAsync">Cancel ✋</button>
            }
            else
            {
                <button class="btn-send"
                        @onclick="SendMessageAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_userMessage) && string.IsNullOrEmpty(_pendingImageDataUrl))">
                    Send 📨
                </button>
            }
        </div>
    </div>
    @* ══════════════════════════════════════════════════════ *@
    @* ★ 会话重命名弹窗                                    *@
    @* ══════════════════════════════════════════════════════ *@
    @if (_showRenameDialog)
    {
        <div class="modal-overlay" @onclick="CloseRenameDialog">
            <div class="rename-dialog" @onclick:stopPropagation="true">
                <div class="rename-header">
                    <strong>✏️ 重命名会话</strong>
                    <button class="btn-close" @onclick="CloseRenameDialog">✕</button>
                </div>

                <div class="rename-body">
                    <label class="rename-label">显示名（最长 200 字符）</label>
                    <input type="text"
                           @bind="_renamingSessionName"
                           @bind:event="oninput"
                           maxlength="200"
                           class="rename-input"
                           placeholder="例如：图数据探索 - 9月22日"
                           @onkeydown="HandleRenameKeyDown" />

                    <p class="rename-hint">
                        💡 留空则恢复为默认的 GUID 显示
                    </p>
                </div>

                <div class="rename-footer">
                    <button class="btn-secondary"
                            @onclick="CloseRenameDialog"
                            disabled="@_isRenamingSession">
                        取消
                    </button>
                    <button class="btn-primary"
                            @onclick="ConfirmRenameSessionAsync"
                            disabled="@_isRenamingSession">
                        @(_isRenamingSession ? "保存中..." : "保存")
                    </button>
                </div>
            </div>
        </div>
    }
</div>