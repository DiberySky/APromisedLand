@page "/mcp-chat"
@using System.Linq
@using System.Text.Json
@using System.Text.Encodings.Web
@using LiteGraph.Sdk
@inject LiteGraphSdk LiteGraph
@inject ILogger<McpChat> Logger
@rendermode InteractiveServer

<PageTitle>LiteGraph 数据浏览器</PageTitle>

<div class="chat-container">
    <div class="chat-header">
        <h1>📊 LiteGraph 数据浏览器</h1>
        <p class="page-subtitle">通过官方 SDK 查询 PostgreSQL 中的图数据</p>
    </div>

    <div class="mcp-toolbar">
        <button class="btn-refresh" @onclick="LoadGraphsAsync" disabled="@isLoading">
            @(isLoading ? "加载中..." : "🔄 加载图列表")
        </button>
    </div>

    @if (graphs.Any())
    {
        <div class="graph-list">
            @foreach (var graph in graphs)
            {
                <div class="graph-item">
                    <div class="graph-info">
                        <strong>@graph.Name</strong>
                        <span class="graph-guid">@graph.GUID</span>
                    </div>
                    <button class="btn-node" @onclick="() => LoadGraphDataAsync(graph.GUID)">
                        查看节点
                    </button>
                </div>
            }
        </div>
    }

    @if (nodes.Any())
    {
        <div class="response-box">
            <strong>节点列表（@nodes.Count 个）：</strong>
            <pre>@JsonSerializer.Serialize(nodes, PrettyJson)</pre>
        </div>
    }

    @if (!string.IsNullOrEmpty(responseText))
    {
        <div class="response-box error">
            <pre>@responseText</pre>
        </div>
    }
</div>

@code {
    private List<Graph> graphs = new();
    private List<Node> nodes = new();
    private string responseText = "";
    private bool isLoading = false;

    private static readonly Guid DefaultTenant = Guid.Empty;

    // ★ 共享的 JSON 序列化配置：缩进 + 不转义中文
    private static readonly JsonSerializerOptions PrettyJson = new()
    {
        WriteIndented = true,
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadGraphsAsync();
    }

    private async Task LoadGraphsAsync()
    {
        if (isLoading) return;

        isLoading = true;
        responseText = "";
        StateHasChanged();

        try
        {
            var result = await LiteGraph.Graph.ReadMany(DefaultTenant);
            graphs = result.Objects ?? new List<Graph>();

            Logger.LogInformation(
                "从 PostgreSQL 加载了 {Count} 个图（总数 {Total}）",
                graphs.Count, result.TotalRecords);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载图列表失败");
            responseText = $"加载图列表失败：{ex.Message}\n\n" +
                          $"请确认 LiteGraph REST Server (http://localhost:8701) 正在运行。";
            graphs = new List<Graph>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadGraphDataAsync(Guid graphGuid)
    {
        try
        {
            responseText = "";
            StateHasChanged();

            var result = await LiteGraph.Node.ReadMany(DefaultTenant, graphGuid);
            nodes = result.Objects ?? new List<Node>();

            Logger.LogInformation(
                "图 {GraphGuid} 有 {Count} 个节点（总数 {Total}）",
                graphGuid, nodes.Count, result.TotalRecords);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载节点失败");
            responseText = $"加载节点失败：{ex.Message}";
            nodes = new List<Node>();
        }
        finally
        {
            StateHasChanged();
        }
    }
}