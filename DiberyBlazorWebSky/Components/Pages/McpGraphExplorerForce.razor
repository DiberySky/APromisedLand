@page "/graph-explorer-force"
@namespace DiberyBlazorWebSky.Components.Pages
@using DiberyBlazorWebSky.Components.Pages.GraphExplorerForce.Shared
@rendermode InteractiveServer

<PageTitle>图数据查询（力导向）</PageTitle>

<div class="explorer-container">
    <div class="explorer-header">
        <h1>🌐 MCP 图数据 Explorer（力导向）</h1>
        <p class="page-subtitle">节点 / 边 CRUD + 向量语义搜索 + 力导向拓扑 + 导入导出 —— 基于 LiteGraph SDK</p>
    </div>

    <GraphSelectorBar />

    <div class="nav-cards">
        <NavLink class="nav-card" href="graph-explorer-force/nodes">
            <div class="nav-card-icon">📦</div>
            <div class="nav-card-title">节点管理</div>
            <div class="nav-card-desc">对当前图的节点进行增删改查</div>
        </NavLink>

        <NavLink class="nav-card" href="graph-explorer-force/edges">
            <div class="nav-card-icon">🔗</div>
            <div class="nav-card-title">边管理</div>
            <div class="nav-card-desc">创建、编辑、删除图中的边</div>
        </NavLink>

        <NavLink class="nav-card" href="graph-explorer-force/vector">
            <div class="nav-card-icon">🧠</div>
            <div class="nav-card-title">向量语义搜索</div>
            <div class="nav-card-desc">基于向量的一站式语义搜索</div>
        </NavLink>

        <NavLink class="nav-card" href="graph-explorer-force/topology">
            <div class="nav-card-icon">🌐</div>
            <div class="nav-card-title">拓扑图</div>
            <div class="nav-card-desc">力导向 / 圆形布局可视化</div>
        </NavLink>

        <NavLink class="nav-card" href="graph-explorer-force/import-export">
            <div class="nav-card-icon">💾</div>
            <div class="nav-card-title">导入 / 导出</div>
            <div class="nav-card-desc">JSON / CSV 格式导入导出</div>
        </NavLink>
    </div>

    @if (string.IsNullOrEmpty(Context.SelectedGraphGuid))
    {
        <p class="hint">💡 请先在上方选择一个图，然后进入对应功能页面。</p>
    }
    else
    {
        <p class="hint">✅ 已选择图，可进入上方任意功能页面。</p>
    }
</div>
