@page "/graph-explorer-force"
@using System.Linq
@using System.Text.Json
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Components.Forms
@using LiteGraph.Sdk
@inject LiteGraphSdk LiteGraph
@inject ILogger<McpGraphExplorerForce> Logger
@rendermode InteractiveServer

<PageTitle>图数据查询（力导向）</PageTitle>

<div class="explorer-container">
    <div class="explorer-header">
        <h1>🌐 MCP 图数据 Explorer（力导向）</h1>
        <p class="page-subtitle">节点 / 边 CRUD + 向量语义搜索 + 力导向拓扑 + 导入导出 —— 基于 LiteGraph SDK</p>
    </div>

    <!-- 图选择 -->
    <div class="toolbar">
        <select @bind="_selectedGraphGuid" @bind:after="OnGraphChangedAsync" class="graph-selector">
            <option value="">-- 选择图 --</option>
            @foreach (var g in _graphs)
            {
                <option value="@g.GUID">@g.Name</option>
            }
        </select>
        <button class="btn-refresh" @onclick="LoadGraphsAsync" disabled="@_isLoading">🔄 刷新图列表</button>
        <button class="btn-manage" @onclick="OpenManageDialog" disabled="@_isLoading">⚙️ 图管理</button>
    </div>

    @if (!string.IsNullOrEmpty(_selectedGraphGuid))
    {
        <div class="tab-bar">
            <button class="tab @(_activeTab == "nodes" ? "active" : "")" @onclick='() => SwitchTabAsync("nodes")'>📦 节点 (@_nodeTotal)</button>
            <button class="tab @(_activeTab == "edges" ? "active" : "")" @onclick='() => SwitchTabAsync("edges")'>🔗 边 (@_edgeTotal)</button>
            <button class="tab @(_activeTab == "vector" ? "active" : "")" @onclick='() => SwitchTabAsync("vector")'>🧠 向量搜索</button>
            <button class="tab @(_activeTab == "topology" ? "active" : "")" @onclick='() => SwitchTabAsync("topology")'>🌐 拓扑图</button>
            <button class="tab @(_activeTab == "import-export" ? "active" : "")" @onclick='() => SwitchTabAsync("import-export")'>💾 导入/导出</button>
        </div>

        <!-- 节点面板（不变） -->
        @if (_activeTab == "nodes")
        {
            <div class="panel">
                <div class="crud-bar">
                    <input type="text" @bind="_newNodeName" placeholder="新节点名称" class="input-sm" />
                    <button class="btn-primary" @onclick="CreateNodeAsync" disabled="@_isBusy">+ 新建节点</button>
                    <button class="btn-danger" @onclick="DeleteSelectedNodesAsync" disabled="@(_selectedNodeGuids.Count == 0 || _isBusy)">
                        🗑️ 删除选中 (@_selectedNodeGuids.Count)
                    </button>
                </div>

                <div class="list-container">
                    @foreach (var node in _nodes)
                    {
                        <div class="list-item @(_selectedNodeGuids.Contains(node.GUID) ? "selected" : "")">
                            @if (_editingNodeGuid == node.GUID)
                            {
                                <input type="text" @bind="_editingNodeName" @bind:event="oninput"
                                       class="inline-edit-input"
                                       @onkeydown="e => HandleEditKeyDown(e, () => SaveNodeNameAsync(node))" />
                                <div class="item-actions">
                                    <button class="btn-sm btn-primary" @onclick="() => SaveNodeNameAsync(node)" disabled="@_isBusy">✓</button>
                                    <button class="btn-sm" @onclick="CancelEditNode" disabled="@_isBusy">✕</button>
                                </div>
                            }
                            else
                            {
                                <input type="checkbox" checked="@_selectedNodeGuids.Contains(node.GUID)"
                                       @onchange="(e) => ToggleNodeSelection(node.GUID, (bool)e.Value!)" />
                                <div class="item-info">
                                    <strong>@node.Name</strong>
                                    <span class="guid">@node.GUID.ToString("N")[..8]</span>
                                </div>
                                <div class="item-actions">
                                    <button class="btn-icon" @onclick="() => ShowNodeJson(node)">👁️</button>
                                    <button class="btn-icon" @onclick="() => StartEditNode(node)">✏️</button>
                                    <button class="btn-icon danger" @onclick="() => DeleteNodeAsync(node.GUID)" disabled="@_isBusy">🗑️</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="pagination">
                    <button class="btn-page" @onclick="PrevNodePageAsync" disabled="@(!_nodeHasPrev || _isBusy)">⬅️ 上一页</button>
                    <span class="page-info">已加载 @_nodes.Count / 共 @_nodeTotal 条</span>
                    <button class="btn-page" @onclick="NextNodePageAsync" disabled="@(!_nodeHasNext || _isBusy)">下一页 ➡️</button>
                </div>
            </div>
        }

        <!-- 边面板（不变） -->
        @if (_activeTab == "edges")
        {
            <div class="panel">
                <div class="crud-bar">
                    <select @bind="_newEdgeFrom" class="input-sm">
                        <option value="">起点</option>
                        @foreach (var n in _nodes) { <option value="@n.GUID">@n.Name</option> }
                    </select>
                    <select @bind="_newEdgeTo" class="input-sm">
                        <option value="">终点</option>
                        @foreach (var n in _nodes) { <option value="@n.GUID">@n.Name</option> }
                    </select>
                    <input type="text" @bind="_newEdgeName" placeholder="边名称 (如 PARENT_OF)" class="input-sm" />
                    <button class="btn-primary" @onclick="CreateEdgeAsync" disabled="@_isBusy">+ 新建边</button>
                </div>

                <div class="list-container">
                    @foreach (var edge in _edges)
                    {
                        <div class="list-item">
                            @if (_editingEdgeGuid == edge.GUID)
                            {
                                <input type="text" @bind="_editingEdgeName" @bind:event="oninput"
                                       class="inline-edit-input"
                                       @onkeydown="e => HandleEditKeyDown(e, () => SaveEdgeNameAsync(edge))" />
                                <div class="item-actions">
                                    <button class="btn-sm btn-primary" @onclick="() => SaveEdgeNameAsync(edge)" disabled="@_isBusy">✓</button>
                                    <button class="btn-sm" @onclick="CancelEditEdge" disabled="@_isBusy">✕</button>
                                </div>
                            }
                            else
                            {
                                <div class="item-info">
                                    <strong>@edge.Name</strong>
                                    <span class="guid">@edge.From.ToString("N")[..8] → @edge.To.ToString("N")[..8]</span>
                                </div>
                                <div class="item-actions">
                                    <button class="btn-icon" @onclick="() => ShowEdgeJson(edge)">👁️</button>
                                    <button class="btn-icon" @onclick="() => StartEditEdge(edge)">✏️</button>
                                    <button class="btn-icon danger" @onclick="() => DeleteEdgeAsync(edge.GUID)" disabled="@_isBusy">🗑️</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="pagination">
                    <button class="btn-page" @onclick="PrevEdgePageAsync" disabled="@(!_edgeHasPrev || _isBusy)">⬅️ 上一页</button>
                    <span class="page-info">已加载 @_edges.Count / 共 @_edgeTotal 条</span>
                    <button class="btn-page" @onclick="NextEdgePageAsync" disabled="@(!_edgeHasNext || _isBusy)">下一页 ➡️</button>
                </div>
            </div>
        }

        <!-- ══════════════════════════════════════════════════ -->
        <!-- ★ 向量搜索（改造：一站式语义搜索 + 意图显示）    -->
        <!-- ══════════════════════════════════════════════════ -->
        @if (_activeTab == "vector")
        {
            <div class="panel">
                <div class="crud-bar">
                    <input type="text" @bind="_vectorQueryText"
                           placeholder="输入语义查询 (如: 根节点B的父亲 / 深度学习用到的框架)"
                           class="input-lg"
                           @onkeydown="HandleSearchKeyDown" />
                    <button class="btn-primary"
                            @onclick="SearchVectorAsync"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_vectorQueryText))">
                        🧠 语义搜索
                    </button>
                    <button class="btn-secondary"
                            @onclick="GenerateAllVectorsAsync"
                            disabled="@_isBusy">
                        ⚡ 重建所有向量
                    </button>
                </div>

                @* ★ 意图横幅 *@
                @if (_lastIntent is not null && _lastIntent.Strategy != "none")
                {
                    <div class="intent-banner">
                        <span class="intent-icon">🧠</span>
                        <span class="intent-label">识别意图：</span>
                        @if (!string.IsNullOrEmpty(_lastIntent.Relation))
                        {
                            <span class="intent-chip relation">@_lastIntent.Relation</span>
                            <span class="intent-chip direction">
                                @(_lastIntent.Direction == "in" ? "↓ 入边/找父" : "↑ 出边/找子")
                            </span>
                        }
                        else
                        {
                            <span class="intent-chip unknown">按节点名搜索</span>
                        }
                        @if (!string.IsNullOrEmpty(_lastIntent.SubjectName))
                        {
                            <span class="intent-chip subject">主体: @_lastIntent.SubjectName</span>
                        }
                        <span class="intent-confidence">@_lastIntent.Confidence.ToString("P0")</span>
                        <span class="intent-strategy">[@_lastIntent.Strategy]</span>
                    </div>
                }

                @if (_vectorResults.Any())
                {
                    <div class="list-container">
                        @foreach (var r in _vectorResults)
                        {
                            <div class="list-item">
                                <div class="item-info">
                                    <strong>@r.NodeName</strong>
                                    <span class="guid">
                                        综合: @r.Score.ToString("F4")
                                        @if (r.VectorScore.HasValue && r.Bm25Score.HasValue)
                                        {
                                            <span class="component-scores">
                                                （向量 @r.VectorScore.Value.ToString("F4")
                                                · BM25 @r.Bm25Score.Value.ToString("F4")）
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(r.ViaEdge))
                                        {
                                            <span class="via-edge">· 通过 <b>@r.ViaEdge</b></span>
                                        }
                                    </span>
                                    @if (!string.IsNullOrEmpty(r.MatchedContent))
                                    {
                                        <div class="content-snippet">@r.MatchedContent</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_isBusy)
                {
                    <p class="hint">处理中... @_vectorProgress</p>
                }
                else
                {
                    <p class="hint">
                        输入自然语言进行语义搜索。<br />
                        首次使用请点"⚡ 重建所有向量"（生成节点向量 + 边向量）。
                    </p>
                }
            </div>
        }

        <!-- 拓扑图（不变） -->
        @if (_activeTab == "topology")
        {
            <div class="panel">
                <div class="crud-bar">
                    <button class="btn-primary" @onclick="LoadTopologyAsync" disabled="@_isBusy">🔄 重新加载拓扑</button>
                    <button class="btn-secondary" @onclick='() => SwitchLayout("force")' disabled="@(_isBusy || _layoutMode == "force")">🌐 力导向</button>
                    <button class="btn-secondary" @onclick='() => SwitchLayout("circular")' disabled="@(_isBusy || _layoutMode == "circular")">⭕ 圆形</button>
                    <button class="btn-secondary" @onclick="ShuffleLayout" disabled="@_isBusy">🎲 重新布局</button>
                    @if (_selectedTopologyNode != null)
                    {
                        <span class="topology-selected">🎯 已选：<strong>@_selectedTopologyNode.Name</strong></span>
                    }
                </div>

                @if (_isBusy)
                {
                    <p class="hint">加载中...</p>
                }
                else if (_topologyNodes.Count == 0)
                {
                    <p class="hint">点击"重新加载拓扑"以渲染当前图的节点关系图。</p>
                }
                else
                {
                    <div class="svg-wrap">
                        <svg viewBox="0 0 800 600" class="graph-svg">
                            @foreach (var edge in _topologyEdges)
                            {
                                var fromPos = GetPosition(edge.From);
                                var toPos = GetPosition(edge.To);
                                @if (fromPos.HasValue && toPos.HasValue)
                                {
                                    var midX = (fromPos.Value.X + toPos.Value.X) / 2;
                                    var midY = (fromPos.Value.Y + toPos.Value.Y) / 2;
                                    <line x1="@fromPos.Value.X" y1="@fromPos.Value.Y"
                                          x2="@toPos.Value.X" y2="@toPos.Value.Y"
                                          stroke="#94a3b8" stroke-width="1.5" />
                                    <svg:text x="@midX" y="@midY" class="edge-label">@edge.Name</svg:text>
                                }
                            }
                            @foreach (var node in _topologyNodes)
                            {
                                var pos = GetPosition(node.GUID);
                                @if (pos.HasValue)
                                {
                                    var isSelected = _selectedTopologyNode?.GUID == node.GUID;
                                    <g class="node-group" @onclick="() => SelectTopologyNode(node)">
                                        <circle cx="@pos.Value.X" cy="@pos.Value.Y" r="28"
                                                fill="@(isSelected ? "#f59e0b" : "#4a90e2")"
                                                stroke="#fff" stroke-width="2"
                                                class="node-circle" />
                                        <svg:text x="@pos.Value.X" y="@pos.Value.Y" text-anchor="middle" dy="5" class="node-label">@node.Name</svg:text>
                                    </g>
                                }
                            }
                        </svg>
                    </div>
                }
            </div>
        }

        <!-- 导入 / 导出（不变） -->
        @if (_activeTab == "import-export")
        {
            <div class="panel">
                <div class="crud-bar">
                    <strong>📤 导出当前图</strong>
                    <button class="btn-primary" @onclick="ExportJsonAsync" disabled="@(_isBusy || string.IsNullOrEmpty(_selectedGraphGuid))">📥 导出 JSON</button>
                    <button class="btn-secondary" @onclick="ExportNodesCsvAsync" disabled="@(_isBusy || string.IsNullOrEmpty(_selectedGraphGuid))">📥 导出节点 CSV</button>
                    <button class="btn-secondary" @onclick="ExportEdgesCsvAsync" disabled="@(_isBusy || string.IsNullOrEmpty(_selectedGraphGuid))">📥 导出边 CSV</button>
                </div>

                <div class="crud-bar">
                    <strong>📥 导入 JSON</strong>
                    <InputFile OnChange="OnJsonFileSelected" accept=".json" class="file-input" />
                    <span class="file-status">@_selectedJsonFileName</span>
                </div>

                <div class="crud-bar">
                    <strong>📥 从 CSV 导入</strong>
                    <InputFile OnChange="OnNodesCsvSelected" accept=".csv" class="file-input" />
                    <span class="file-status">@_selectedNodesCsvName</span>
                    <InputFile OnChange="OnEdgesCsvSelected" accept=".csv" class="file-input" />
                    <span class="file-status">@_selectedEdgesCsvName</span>
                </div>

                <div class="crud-bar">
                    <label class="import-option">
                        <input type="checkbox" @bind="_clearBeforeImport" />
                        <span>导入前清空图中所有节点和边（⚠️ 不可撤销）</span>
                    </label>
                    <button class="btn-primary" @onclick="StartImportAsync" disabled="@(_isBusy || !HasAnyImportFile)">🚀 开始导入</button>
                    <button class="btn-danger" @onclick="ResetImportState" disabled="@_isBusy">✕ 清空选择</button>
                </div>

                @if (_isBusy) { <p class="hint">处理中... @_vectorProgress</p> }

                @if (_importResult != null)
                {
                    <div class="response-box">
                        <strong>导入结果：</strong>
                        <ul style="margin: 8px 0 0 0;">
                            <li>✅ 新增节点：@_importResult.NodesCreated</li>
                            <li>⏭️ 跳过重复节点：@_importResult.NodesSkipped</li>
                            <li>✅ 新增边：@_importResult.EdgesCreated</li>
                            <li>⏭️ 跳过边：@_importResult.EdgesSkipped</li>
                        </ul>
                        @if (_importResult.Errors.Count > 0)
                        {
                            <div style="margin-top: 12px;">
                                <strong>⚠️ 错误清单（前 20 条）：</strong>
                                <ul style="margin: 6px 0 0 0; color: #991b1b;">
                                    @foreach (var err in _importResult.Errors.Take(20)) { <li>@err</li> }
                                </ul>
                            </div>
                        }
                    </div>
                }

                @if (_importResult == null && !_isBusy)
                {
                    <p class="hint">
                        💡 支持 JSON（含 Nodes + Edges）或 CSV（Nodes + Edges 分开）导入。<br />
                        导出的 JSON 可直接用于其他环境的导入，节点以名称引用，跨环境安全。
                    </p>
                }
            </div>
        }
    }

    <!-- JSON 详情弹窗 -->
    @if (_detailJson != null)
    {
        <div class="modal-overlay" @onclick="CloseDetailModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <strong>详情</strong>
                    <button class="btn-close" @onclick="CloseDetailModal">✕</button>
                </div>
                <pre>@_detailJson</pre>
            </div>
        </div>
    }

    <!-- 图管理弹窗 -->
    @if (_showManageDialog)
    {
        <div class="modal-overlay" @onclick="CloseManageDialog">
            <div class="manage-dialog" @onclick:stopPropagation="true">
                <div class="manage-header">
                    <strong>⚙️ 图管理</strong>
                    <button class="btn-close" @onclick="CloseManageDialog">✕</button>
                </div>

                <div class="manage-body">
                    <div class="create-section">
                        <div class="section-title">➕ 新建图</div>
                        <div class="create-row">
                            <input type="text" @bind="_newGraphName" @bind:event="oninput"
                                   placeholder="输入图名称..." class="create-input" />
                            <button class="btn-primary" @onclick="CreateGraphAsync"
                                    disabled="@(_isCreatingGraph || string.IsNullOrWhiteSpace(_newGraphName))">
                                @(_isCreatingGraph ? "创建中..." : "创建")
                            </button>
                        </div>
                    </div>

                    <div class="list-section">
                        <div class="section-title">📋 已有图（@_graphs.Count）</div>

                        @if (_graphs.Count == 0)
                        {
                            <p class="hint">暂无图。请先创建一个。</p>
                        }
                        else
                        {
                            <div class="graph-manage-list">
                                @foreach (var g in _graphs)
                                {
                                    <div class="graph-manage-item">
                                        @if (_renamingGraphGuid == g.GUID)
                                        {
                                            <input type="text" @bind="_renamingGraphName" @bind:event="oninput" class="rename-input" />
                                            <div class="item-actions">
                                                <button class="btn-sm btn-primary" @onclick="ConfirmRenameAsync" disabled="@_isManaging">✓</button>
                                                <button class="btn-sm" @onclick="CancelRename" disabled="@_isManaging">✕</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="item-info">
                                                <div class="item-name">@g.Name</div>
                                                <div class="item-guid">@g.GUID</div>
                                            </div>
                                            <div class="item-actions">
                                                <button class="btn-sm" @onclick="() => StartRename(g)" disabled="@_isManaging">✏️</button>
                                                <button class="btn-sm btn-danger" @onclick="() => DeleteGraphAsync(g)" disabled="@_isManaging">🗑️</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-bar">@_errorMessage</div>
    }
</div>