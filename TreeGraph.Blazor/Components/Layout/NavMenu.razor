@* NavMenu.razor *@
@using TreeGraph.Shared.NodeEavSky.Dtos
@using TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@inject EavApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@* NavMenu.razor *@
<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home">
        首页
    </MudNavLink>

    @* ★ iNode 入口 *@
    @* <MudNavLink Href="/inodes" *@
    @*             Icon="@Icons.Material.Filled.Hub" *@
    @*             Match="NavLinkMatch.Prefix"> *@
    @*     iNode 列表 *@
    @* </MudNavLink> *@

    @* ★ 选择实体（两步式：选类型 → 选实体） *@
    @* <MudNavLink Href="/entities" *@
    @*             Icon="@Icons.Material.Filled.TouchApp" *@
    @*             Match="NavLinkMatch.All"> *@
    @*     选择实体 *@
    @* </MudNavLink> *@

    @* ★ 属性列表（跨实体类型总览） *@
    @* <MudNavLink Href="/attributes" *@
    @*             Icon="@Icons.Material.Filled.ListAlt" *@
    @*             Match="NavLinkMatch.All"> *@
    @*     属性列表 *@
    @* </MudNavLink> *@

    @* ★ 树页面 *@
    <MudNavGroup Title="树"
                 Icon="@Icons.Material.Filled.Forest">
        <MudNavLink Href="/tree-eav-sky"
                    Icon="@Icons.Material.Filled.Forest"
                    Match="NavLinkMatch.All">
            TreeEavSky 演示
        </MudNavLink>
        <MudNavLink Href="/unit-tree"
                    Icon="@Icons.Material.Filled.Straighten"
                    Match="NavLinkMatch.All">
            单位树
        </MudNavLink>
        <MudNavLink Href="/category-tree"
                    Icon="@Icons.Material.Filled.Category"
                    Match="NavLinkMatch.All">
            分类树
        </MudNavLink>
        <MudNavLink Href="/space-tree"
                    Icon="@Icons.Material.Filled.MeetingRoom"
                    Match="NavLinkMatch.All">
            空间树
        </MudNavLink>
    </MudNavGroup>

    @* ★ 空间（Space CRUD） *@
    <MudNavLink Href="/spaces"
                Icon="@Icons.Material.Filled.Workspaces"
                Match="NavLinkMatch.All">
        空间
    </MudNavLink>

    @* ★ 动态实体数据菜单 *@
    @* <MudNavGroup Title="实体数据" *@
    @*              Icon="@Icons.Material.Filled.Storage" *@
    @*              Expanded="_entityGroupExpanded" *@
    @*              ExpandedChanged="@(v => _entityGroupExpanded = v)"> *@
    @*     @if (_entityTypes is null) *@
    @*     { *@
    @*         <MudNavLink Disabled="true"> *@
    @*             <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> *@
    @*         </MudNavLink> *@
    @*     } *@
    @*     else if (_entityTypes.Count == 0) *@
    @*     { *@
    @*         <MudNavLink Disabled="true">（暂无实体类型）</MudNavLink> *@
    @*     } *@
    @*     else *@
    @*     { *@
    @*         @foreach (var et in _entityTypes) *@
    @*         { *@
    @*             var display = EntityTypeDisplayService.GetDisplayName(et); *@
    @*             <MudNavLink Href="@($"/entities/{et.EntityType}")" *@
    @*                         Icon="@Icons.Material.Filled.List" *@
    @*                         Match="NavLinkMatch.Prefix"> *@
    @*                 @display *@
    @*                 <MudChip T="string" Size="Size.Small" Class="ml-2"> *@
    @*                     @et.AttributeCount *@
    @*                 </MudChip> *@
    @*             </MudNavLink> *@
    @*         } *@
    @*     } *@
    @* </MudNavGroup> *@

    @* 元数据管理 *@
    <MudNavGroup Title="元数据管理"
                 Icon="@Icons.Material.Filled.Settings">
        @* 实体类型（最优先入口） *@
        <MudNavLink Href="/metadata/entity-types"
                    Icon="@Icons.Material.Filled.Category"
                    Match="NavLinkMatch.Prefix">
            实体类型
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.EditAttributes"
                    OnClick="OpenAttributesManage">
            属性定义
        </MudNavLink>
        <MudNavLink Href="/metadata/composite-types"
                    Icon="@Icons.Material.Filled.AccountTree"
                    Match="NavLinkMatch.Prefix">
            组合类型
        </MudNavLink>
        <MudNavLink Href="/metadata/custom-tables"
                    Icon="@Icons.Material.Filled.TableChart"
                    Match="NavLinkMatch.Prefix">
            自定义表
        </MudNavLink>
        <MudNavLink Href="/metadata/option-sets"
                    Icon="@Icons.Material.Filled.Checklist"
                    Match="NavLinkMatch.Prefix">
            选项集
        </MudNavLink>
        @* 边类型（EdgeSky：对齐 Nebula 顶级实体） *@
        <MudNavLink Href="/metadata/edge-types"
                    Icon="@Icons.Material.Filled.Hub"
                    Match="NavLinkMatch.Prefix">
            边类型
        </MudNavLink>
    </MudNavGroup>

    @* ★ 智能体工作流（MafWfSky） *@
    <MudNavGroup Title="智能体工作流"
                 Icon="@Icons.Material.Filled.AutoAwesome">
        <MudNavLink Href="/maf-wf/graph-agent"
                    Icon="@Icons.Material.Filled.Forum"
                    Match="NavLinkMatch.All">
            Graph Agent 对话
        </MudNavLink>
        <MudNavLink Href="/search"
                    Icon="@Icons.Material.Filled.ManageSearch"
                    Match="NavLinkMatch.All">
            语义搜索
        </MudNavLink>
        <MudNavLink Href="/semantic-search-direct"
                    Icon="@Icons.Material.Filled.TravelExplore"
                    Match="NavLinkMatch.All">
            语义搜索（直连）
        </MudNavLink>
        <MudNavLink Href="/maf-wf/writer-critic"
                    Icon="@Icons.Material.Filled.EditNote"
                    Match="NavLinkMatch.All">
            Writer-Critic
        </MudNavLink>
    </MudNavGroup>

    @* ★ 控件演示 *@
    <MudNavLink Href="/number-field-demo"
                Icon="@Icons.Material.Filled.Pin"
                Match="NavLinkMatch.All">
        数字控件 Demo
    </MudNavLink>
</MudNavMenu>

@code {
    private IReadOnlyList<EntityTypeSummaryDto>? _entityTypes;
    private bool _entityGroupExpanded = true;
    private bool _initialized;

    /// <summary>打开属性定义管理对话框（通用模式，可在对话框内切换实体类型）。</summary>
    private async Task OpenAttributesManage()
    {
        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            MaximizeButton = true
        };

        await DialogService.ShowExAsync<AttributesManageDialog>(
            string.Empty, new DialogParameters<AttributesManageDialog>(), options);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        _entityTypes = await Api.ListEntityTypesAsync();

        // ★ P1-3：加载失败提示用户，而不是静默显示空菜单
        if (_entityTypes is null)
        {
            Snackbar.Add("实体类型加载失败，请检查后端服务是否可达", Severity.Warning);
        }

        StateHasChanged();
    }
}
