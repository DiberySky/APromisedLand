@using TreeGraph.StringTree.Contracts
@using TreeGraph.Blazor.Shared.StringTreeSky.Services
@using TreeGraph.Blazor.Shared.StringTreeSky
@inject ISpaceClient SpaceClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<div class="space-list-page">
    <div class="space-list-page__appbar">
        <div class="space-list-page__appbar-title">
            <MudIcon Icon="@Icons.Material.Filled.Layers" />
            <span>空间</span>
        </div>
        <div class="d-flex align-center">
            @* ★ 新增：管理入口 *@
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Size="Size.Large"
                           Title="空间管理"
                           OnClick="GoToAdmin" />

            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Title="新建空间"
                           OnClick="OpenCreateDialogAsync" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="space-list-page__center">
            <MudProgressCircular Indeterminate="true" />
        </div>
    }
    else if (_spaces.Count == 0)
    {
        <div class="space-list-page__empty">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen"
                     Style="font-size:64px;color:#bbb" />
            <MudText Typo="Typo.h6" Class="text-grey mt-3">尚无空间</MudText>
            <MudButton Class="mt-4"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialogAsync">
                创建第一个空间
            </MudButton>
        </div>
    }
    else
    {
        <div class="space-list-page__list">
            @foreach (var space in _spaces)
            {
                <div class="space-card" @onclick="() => OpenSpace(space)">
                    <div class="space-card__icon">
                        <MudIcon Icon="@Icons.Material.Filled.Folder"
                                 Size="Size.Large"
                                 Color="Color.Primary" />
                    </div>
                    <div class="space-card__body">
                        <div class="space-card__name">@space.Name</div>
                        @if (!string.IsNullOrEmpty(space.Description))
                        {
                            <div class="space-card__desc">@space.Description</div>
                        }
                    </div>
                    <div class="space-card__actions" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                                       Size="Size.Medium"
                                       OnClick="() => OpenMenuAsync(space)" />
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<SpaceDto> _spaces = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _spaces = await SpaceClient.ListSpacesAsync(); }
        catch (Exception ex) { Snackbar.Add($"加载失败：{ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private void OpenSpace(SpaceDto space)
        => Nav.NavigateTo($"/spaces/{Uri.EscapeDataString(space.Id)}");

    private void GoToAdmin() => Nav.NavigateTo("/spaces/admin");

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters
        {
            { nameof(SpaceEditDialog.Space), new SpaceDto() },
            { nameof(SpaceEditDialog.IsNew), true }
        };
        var dialog = await DialogService.ShowAsync<SpaceEditDialog>("新建空间", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await ReloadAsync();
    }

    private async Task OpenMenuAsync(SpaceDto space)
    {
        var action = await DialogService.ShowMessageBoxAsync(
            space.Name, "请选择操作",
            yesText: "编辑", noText: "删除", cancelText: "取消");
        if (action == true) await OpenEditDialogAsync(space);
        else if (action == false) await ConfirmDeleteAsync(space);
    }

    private async Task OpenEditDialogAsync(SpaceDto space)
    {
        var copy = new SpaceDto { Id = space.Id, Name = space.Name, Description = space.Description };
        var parameters = new DialogParameters
        {
            { nameof(SpaceEditDialog.Space), copy },
            { nameof(SpaceEditDialog.IsNew), false }
        };
        var dialog = await DialogService.ShowAsync<SpaceEditDialog>("编辑空间", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await ReloadAsync();
    }

    private async Task ConfirmDeleteAsync(SpaceDto space)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "删除空间", $"确定删除「{space.Name}」及其下所有子节点？",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true) return;

        var ok = await SpaceClient.DeleteSpaceAsync(space.Id);
        if (ok) { Snackbar.Add("已删除", Severity.Success); await ReloadAsync(); }
        else Snackbar.Add("删除失败", Severity.Error);
    }
}

<style>
    /* 样式与上一轮一致，此处省略以节省篇幅 */
    .space-list-page { display: flex; flex-direction: column; height: 100%; background: #f5f5f5; }
    .space-list-page__appbar { display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 8px 0 16px; background: #fff; border-bottom: 1px solid #e0e0e0; }
    .space-list-page__appbar-title { display: flex; align-items: center; gap: 8px; font-size: 18px; font-weight: 600; }
    .space-list-page__center { flex: 1; display: flex; align-items: center; justify-content: center; }
    .space-list-page__empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; }
    .space-list-page__list { flex: 1; overflow-y: auto; padding: 8px; -webkit-overflow-scrolling: touch; }
    .space-card { display: flex; align-items: center; gap: 12px; padding: 14px 8px 14px 16px; margin-bottom: 8px; background: #fff; border-radius: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); cursor: pointer; min-height: 64px; }
    .space-card:active { background: #f0f0f0; }
    .space-card__icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 8px; background: #e3f2fd; }
    .space-card__body { flex: 1; min-width: 0; }
    .space-card__name { font-size: 16px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .space-card__desc { margin-top: 2px; font-size: 13px; color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
