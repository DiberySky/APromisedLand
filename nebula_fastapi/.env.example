# FastAPI Settings
APP_NAME=NebulaGraph API Service
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# NebulaGraph Settings
NEBULA_HOSTS=127.0.0.1:9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=basketballplayer

# Connection Pool Settings
NEBULA_MIN_CONN_POOL_SIZE=1
NEBULA_MAX_CONN_POOL_SIZE=10
NEBULA_TIMEOUT=0
NEBULA_IDLE_TIME=0
NEBULA_INTERVAL_CHECK=-1

# CORS Settings
CORS_ORIGINS=["*"]
