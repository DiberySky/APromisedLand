{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "https://localhost:8323/realms/apromisedland",
    "Audience": "treegraph-web",
    "AdditionalAudiences": [ "treegraph-wasm" ],
    "RequireHttpsMetadata": false
  },
  "SeaweedFS": {
    "Endpoint": "http://localhost:8333",
    "AccessKey": "admin",
    "SecretKey": "admin",
    "Bucket": "documents",
    "ForcePathStyle": true,
    "UseHttp": true,
    "Region": "us-east-1"
  },
  "UploadCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "StartupDelayMinutes": 5,
    "StaleMergingMinutes": 60,
    "StalePendingMinutes": 120,
    "CompletedRetentionMinutes": 10080,
    "BatchSize": 500,
    "OrphanDeleteConcurrency": 4
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5325"
    ],
    "WasmOrigins": [ "https://localhost:5787" ]
  }
}