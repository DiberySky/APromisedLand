@namespace TreeGraph.Blazor.Shared.StringTreeSky
@using TreeGraph.Shared.StringTreeSky.Contracts
@using TreeGraph.Blazor.Shared.StringTreeSky.Services
@using TreeGraph.Blazor.Shared.NodeEav.Services
@using TreeGraph.Shared.NodeEav.Dtos
@inject ISpaceClient SpaceClient
@inject EavApiClient EavApi
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "新建空间" : "编辑空间")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            <MudTextField T="string"
                          @bind-Value="Space.Name"
                          Label="名称"
                          Required="true"
                          MaxLength="256" />

            <MudTextField T="string"
                          @bind-Value="Space.Description"
                          Label="描述"
                          Lines="3"
                          MaxLength="1024" />

            @if (IsNew)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">属性集</MudText>

                <MudRadioGroup T="string" @bind-Value="_mode">
                    <MudRadio Value="@("independent")" Color="Color.Primary">
                        <div>
                            <div><b>独立属性集</b>（推荐）</div>
                            <div class="text-caption text-grey">
                                该空间拥有专属属性定义。
                            </div>
                        </div>
                    </MudRadio>
                    <MudRadio Value="@("shared")" Color="Color.Primary">
                        <div>
                            <div><b>共享默认属性集</b></div>
                            <div class="text-caption text-grey">
                                与所有"共享"空间共用一套属性定义。
                            </div>
                        </div>
                    </MudRadio>
                </MudRadioGroup>

                @* ★ 独立模式时可选模板 *@
                @if (_mode == "independent")
                {
                    <MudSelect T="string?"
                               @bind-Value="_templateEntityType"
                               Label="从模板复制属性（可选）"
                               Clearable="true"
                               Placeholder="不复制，从空白开始"
                               Disabled="_templatesLoading">
                        @foreach (var t in _templates)
                        {
                            <MudSelectItem Value="@t.EntityType">
                                @t.DisplayName
                                <span class="text-caption text-grey ml-2">
                                    (@ShortType(t.EntityType))
                                </span>
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (_templatesLoading)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(_saving || string.IsNullOrWhiteSpace(Space.Name))"
                   OnClick="SaveAsync">
            @(_saving ? "保存中…" : "保存")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public SpaceDto Space { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private bool _saving;
    private string _mode = "independent";

    // ★ 模板相关
    private string? _templateEntityType;
    private List<EntityTypeSummaryDto> _templates = new();
    private bool _templatesLoading;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
            await LoadTemplatesAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        _templatesLoading = true;
        try
        {
            var list = await EavApi.ListEntityTypesAsync() ?? new List<EntityTypeSummaryDto>();

            // 过滤掉当前空间自己（新建时不会出现，但保险）
            _templates = list
                .Where(t => t.EntityType != Space.EntityType)
                .OrderBy(t => t.DisplayName)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载模板列表失败：{ex.Message}", Severity.Warning);
        }
        finally
        {
            _templatesLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Space.Name)) return;

        _saving = true;
        try
        {
            if (IsNew)
            {
                Space.EntityType = _mode == "shared"
                    ? StringTreeEntityTypes.Node
                    : "auto";

                // ★ 独立模式才传模板
                Space.TemplateEntityType = (_mode == "independent" && !string.IsNullOrWhiteSpace(_templateEntityType))
                    ? _templateEntityType
                    : null;

                var created = await SpaceClient.CreateSpaceAsync(Space);
                Snackbar.Add($"空间「{created.Name}」已创建", Severity.Success);
            }
            else
            {
                var updated = await SpaceClient.UpdateSpaceAsync(Space);
                if (updated is null)
                {
                    Snackbar.Add("空间不存在", Severity.Warning);
                    return;
                }
                Snackbar.Add("空间已更新", Severity.Success);
            }
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private static string ShortType(string entityType)
    {
        if (string.IsNullOrEmpty(entityType)) return "";
        // "StringTreeNode:abc-def..." → "abc-def…"
        var idx = entityType.IndexOf(':');
        if (idx < 0) return entityType;
        var suffix = entityType[(idx + 1)..];
        return suffix.Length <= 8 ? suffix : suffix[..8] + "…";
    }
}
