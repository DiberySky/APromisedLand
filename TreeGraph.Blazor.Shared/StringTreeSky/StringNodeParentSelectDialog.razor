@* StringNodeParentSelectDialog.razor
   选择父节点对话框（克隆 TreeSky TreeNodeParentSelectDialog）：
   树形展示已加载节点，禁用自身及后代，支持搜索，确认回传选中父节点 Id（null = 根）。 *@
@namespace TreeGraph.Blazor.Shared.StringTreeSky
@using TreeGraph.Shared.StringTreeSky.Contracts

<PageDialogSky Title="选择父节点" TitleClass="mud-theme-success px-0 pa-0">
    <DialogContent>
        <MudContainer Class="py-2" Style="min-height: 300px; max-height: 500px; overflow-y: auto;">
            <MudAlert Severity="Severity.Info"
                      Dense="true"
                      Class="mb-2"
                      ShowCloseIcon="false">
                当前选中: <strong>@SelectedName</strong>
                @if (_selectedId is null)
                {
                    <MudText Inline="true" Color="Color.Secondary">(根节点)</MudText>
                }
            </MudAlert>

            <MudTextField T="string"
                          @bind-Value="_searchText"
                          Label="搜索节点"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mb-2"
                          Clearable="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="OnSearch" />

            @if (_visibleRoots.Count == 0 && !string.IsNullOrEmpty(_searchText))
            {
                <MudText Align="Align.Center" Color="Color.Secondary" Class="my-4">
                    未找到匹配的节点
                </MudText>
            }
            else
            {
                <MudTreeView T="string"
                     SelectionMode="SelectionMode.SingleSelection"
                     ExpandOnClick="true">
                    @RenderNodes(_visibleRoots)
                </MudTreeView>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close"
                   Variant="Variant.Text"
                   Color="Color.Default">
            取消
        </MudButton>
        <MudButton OnClick="ConfirmSelection"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            确认选择
        </MudButton>
    </DialogActions>
</PageDialogSky>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>候选节点全集（已加载节点）。</summary>
    [Parameter] public required List<StringNodeDto> Nodes { get; set; }
    /// <summary>待移动节点 Id（自身及后代禁用）。</summary>
    [Parameter] public string CurrentNodeId { get; set; } = string.Empty;
    /// <summary>当前父节点 Id（初始选中）。</summary>
    [Parameter] public string? CurrentParentId { get; set; }

    private string _searchText = string.Empty;
    private string? _selectedId;
    private HashSet<string>? _searchVisible;

    private Dictionary<string, List<StringNodeDto>> _childrenOf = new();
    private Dictionary<string, StringNodeDto> _byId = new();

    private string SelectedName =>
        _selectedId is not null && _byId.TryGetValue(_selectedId, out var n) ? n.Name : "根节点";

    private List<StringNodeDto> _visibleRoots =>
        Roots().Where(n => _searchVisible is null || _searchVisible.Contains(n.Id)).ToList();

    protected override void OnInitialized()
    {
        _byId = Nodes.ToDictionary(n => n.Id);
        _childrenOf = Nodes
            .Where(n => n.ParentId is not null)
            .GroupBy(n => n.ParentId!)
            .ToDictionary(g => g.Key, g => g.OrderBy(n => n.SortOrder).ThenBy(n => n.Id).ToList());
        _selectedId = CurrentParentId;
    }

    private IEnumerable<StringNodeDto> Roots() =>
        Nodes.Where(n => n.ParentId is null || !_byId.ContainsKey(n.ParentId))
             .OrderBy(n => n.SortOrder).ThenBy(n => n.Id);

    private List<StringNodeDto> ChildrenOf(string id) =>
        _childrenOf.TryGetValue(id, out var list) ? list : new List<StringNodeDto>();

    private RenderFragment RenderNodes(IEnumerable<StringNodeDto> nodes) => builder =>
    {
        foreach (var node in nodes)
        {
            var children = ChildrenOf(node.Id)
                .Where(c => _searchVisible is null || _searchVisible.Contains(c.Id))
                .ToList();

            builder.OpenComponent<MudTreeViewItem<string>>(0);
            builder.AddAttribute(1, "Value", node.Id);
            builder.AddAttribute(2, "Text", node.Name);
            builder.AddAttribute(3, "Icon", GetNodeIcon(node));
            builder.AddAttribute(4, "IconColor", GetNodeColor(node));
            builder.AddAttribute(5, "Disabled", IsDisabled(node));
            builder.AddAttribute(6, "OnClick",
                EventCallback.Factory.Create(this, () => OnNodeClick(node)));
            if (children.Count > 0)
            {
                builder.AddAttribute(7, "ChildContent", RenderNodes(children));
            }
            builder.CloseComponent();
        }
    };

    private void OnNodeClick(StringNodeDto node)
    {
        if (IsDisabled(node)) return;
        _selectedId = node.Id;
    }

    private bool IsDisabled(StringNodeDto node)
        => IsDescendantOrSelf(node.Id, CurrentNodeId);

    /// <summary>candidate 是否为 target 自身或 target 的后代。</summary>
    private bool IsDescendantOrSelf(string candidateId, string targetId)
    {
        if (candidateId == targetId) return true;
        foreach (var child in ChildrenOf(candidateId))
        {
            if (IsDescendantOrSelf(child.Id, targetId)) return true;
        }
        return false;
    }

    private string GetNodeIcon(StringNodeDto node)
    {
        if (node.Id == _selectedId) return Icons.Material.Filled.CheckCircle;
        if (ChildrenOf(node.Id).Count > 0 || node.HasChildren) return Icons.Material.Filled.Folder;
        return Icons.Material.Filled.InsertDriveFile;
    }

    private Color GetNodeColor(StringNodeDto node)
    {
        if (node.Id == _selectedId) return Color.Primary;
        if (IsDisabled(node)) return Color.Default;
        return Color.Inherit;
    }

    private void OnSearch(string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            _searchVisible = null;
            return;
        }

        var lower = keyword.ToLowerInvariant();
        var visible = new HashSet<string>();
        foreach (var node in Nodes.Where(n => n.Name.ToLowerInvariant().Contains(lower)))
        {
            AddWithAncestors(node.Id, visible);
        }
        _searchVisible = visible;
    }

    private void AddWithAncestors(string nodeId, HashSet<string> result)
    {
        if (!result.Add(nodeId)) return;
        if (_byId.TryGetValue(nodeId, out var node) && node.ParentId is not null)
        {
            AddWithAncestors(node.ParentId, result);
        }
    }

    private void ConfirmSelection()
        => MudDialog.Close(DialogResult.Ok(_selectedId));

    private void Close() => MudDialog.Close(DialogResult.Cancel());
}
