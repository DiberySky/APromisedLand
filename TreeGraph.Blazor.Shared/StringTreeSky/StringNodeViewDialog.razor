@* StringNodeViewDialog.razor
   节点详情对话框（克隆 TreeSky TreeNodeViewDialog）。 *@
@namespace TreeGraph.Blazor.Shared.StringTreeSky
@using TreeGraph.Shared.StringTreeSky.Contracts

<PageDialogSky Title="节点详情" TitleClass="mud-theme-success px-0 pa-0">
    <DialogContent>
        <MudContainer Class="py-4" MaxWidth="MaxWidth.Small">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudField Label="ID" Variant="Variant.Text">@Node.Id</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="名称" Variant="Variant.Outlined">@Node.Name</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="描述" Variant="Variant.Outlined">
                        @(Node.Description ?? "-")
                    </MudField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudField Label="父分类" Variant="Variant.Text">@ParentName</MudField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudField Label="状态" Variant="Variant.Text">
                        <MudChip T="string"
                                 Color="@(Node.HasChildren ? Color.Success : Color.Default)"
                                 Size="Size.Small">
                            @(Node.HasChildren ? "含子项" : "叶子")
                        </MudChip>
                    </MudField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudField Label="排序" Variant="Variant.Text">@Node.SortOrder</MudField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudField Label="实体类型" Variant="Variant.Text">@Node.EntityType</MudField>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            确定
        </MudButton>
    </DialogActions>
</PageDialogSky>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public required StringNodeDto Node { get; set; }
    [Parameter] public string? ParentName { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
