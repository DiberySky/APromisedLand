@* StringNodeNameDialog.razor
   节点名称编辑对话框（重命名），回车保存、Esc 取消。 *@
@namespace TreeGraph.Blazor.Shared.StringTreeSky

<MudDialog Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string"
                      Value="@_name"
                      ValueChanged="@(v => _name = v)"
                      ValueSupplied
                      Immediate="true"
                      Label="节点名称"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Check"
                      AdornmentColor="Color.Success"
                      OnAdornmentClick="Save"
                      OnKeyDown="OnKeyDown"
                      Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>对话框标题（创建节点/创建子项/设置修改）。</summary>
    [Parameter] public string Title { get; set; } = "设置修改";

    /// <summary>初始名称（由宿主传入）。</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    private string _name = string.Empty;

    protected override void OnInitialized() => _name = Name;

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Save();
        else if (e.Key == "Escape") Cancel();
        await Task.CompletedTask;
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        MudDialog.Close(DialogResult.Ok(_name.Trim()));
    }

    private void Cancel() => MudDialog.Cancel();
}
