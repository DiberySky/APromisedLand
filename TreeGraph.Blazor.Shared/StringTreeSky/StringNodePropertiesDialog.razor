@* StringNodePropertiesDialog.razor *@
@namespace TreeGraph.Blazor.Shared.StringTreeSky
@using System.Text.Json
@using TreeGraph.StringTree.Contracts
@using TreeGraph.Shared.Eav.Dtos
@using TreeGraph.Blazor.Shared.NodeEav.Components
@using TreeGraph.Blazor.Shared.NodeEav.Services
@using TreeGraph.Blazor.Shared.StringTreeSky.Services
@inject EavApiClient Api
@inject NodeSchemaCache SchemaCache
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">节点属性 · @NodeName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else if (_schema.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                当前节点未定义动态属性。请先在 EAV 元数据页为
                <code>@EntityType</code> 配置属性定义。
            </MudAlert>
        }
        else
        {
            <DynamicForm @ref="_form"
                         EntityType="@EntityType"
                         EntityId="@NodeId"
                         Schema="_schema"
                         CompactLayout="true"
                         OnSubmit="HandleSubmitAsync" />
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public string NodeId { get; set; } = string.Empty;
    [Parameter] public string NodeName { get; set; } = string.Empty;

    /// <summary>
    /// EAV 实体类型。默认 "StringTreeNode"；
    /// 多棵树场景由宿主传入 "StringTreeNode:{treeKey}"。
    /// </summary>
    [Parameter] public string EntityType { get; set; } = StringTreeEntityTypes.Node;

    private IReadOnlyList<AttributeSchemaDto> _schema = Array.Empty<AttributeSchemaDto>();
    private Dictionary<string, JsonElement> _props = new();
    private DynamicForm? _form;
    private bool _loading = true;
    private bool _valuesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // ★ 按 EntityType 走缓存
            _schema = await SchemaCache.GetAsync(EntityType);

            if (_schema.Count > 0)
            {
                // EntityId ≡ NodeId（约束保证）
                var entity = await Api.GetEntityAsync(EntityType, NodeId);
                if (entity is not null)
                    _props = new Dictionary<string, JsonElement>(entity.Properties);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载属性失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_valuesLoaded && _form is not null)
        {
            if (_props.Count > 0) _form.LoadFrom(_props);
            _valuesLoaded = true;
        }
    }

    private async Task HandleSubmitAsync(Dictionary<string, object?> values)
    {
        var (ok, error, _) = await Api.SaveEntityAsync(
            EntityType, NodeId, values);

        if (ok)
        {
            Snackbar.Add("属性已保存", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add($"保存失败：{error ?? "未知错误"}", Severity.Error);
        }
    }
}
