@* EdgeRelationPanel.razor — 可复用的「节点关系」面板
   出边 / 入边表格 + 关系类型过滤 + 创建关系 + 删除关系。
   供树节点「操作」对话框与线路节点「关系」对话框共用。
   R4：关系类型是裸字符串，类型选项从已加载的边中汇总，不再请求元数据。 *@
@namespace TreeGraph.Blazor.Shared.EdgeSky.Components
@using TreeGraph.Shared.EdgeSky.Dtos
@using TreeGraph.Blazor.Shared.EdgeSky.Services
@using TreeGraph.Blazor.Shared.EdgeSky.Components.Dialogs
@inject EdgeApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* 顶部：关系类型过滤器 + 创建按钮 *@
<div class="d-flex mb-3 align-center">
    <MudSelect T="string"
               Value="_filterTypeName"
               ValueChanged="OnFilterChanged"
               Label="关系类型（可选过滤）"
               Variant="Variant.Outlined"
               Class="flex-grow-1 mr-3"
               Clearable="true"
               Dense="true">
        <MudSelectItem T="string" Value="@("")">全部类型</MudSelectItem>
        @foreach (var typeName in _typeNames)
        {
            <MudSelectItem T="string" Value="@typeName">
                @typeName
            </MudSelectItem>
        }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Success"
               StartIcon="@Icons.Material.Filled.Add"
               Size="Size.Small"
               OnClick="@OpenCreateEdgeAsync">
        创建关系
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_outgoing.Count == 0 && _incoming.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">
        当前节点没有关系。点击「创建关系」建立第一条边。
    </MudAlert>
}
else
{
    @* 出边 *@
    @if (_outgoing.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            出边（@_outgoing.Count）
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                     Class="ml-1" Size="Size.Small" />
        </MudText>
        <MudTable Items="_outgoing" Dense="true" Bordered="true"
                  Hover="true" Breakpoint="Breakpoint.Sm"
                  Class="mb-3">
            <HeaderContent>
                <MudTh>类型</MudTh>
                <MudTh>终点节点</MudTh>
                <MudTh>方向</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="类型">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                        @context.TypeName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="终点">
                    @if (string.IsNullOrEmpty(context.ToNodeText))
                    {
                        <code>@context.ToNodeId</code>
                    }
                    else
                    {
                        <span title="@context.ToNodeId">@context.ToNodeText</span>
                    }
                </MudTd>
                <MudTd DataLabel="方向">@(context.IsDirected ? "有向" : "无向")</MudTd>
                <MudTd DataLabel="操作">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(async () => await DeleteEdgeAsync(context))"
                                   title="删除" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* 入边 *@
    @if (_incoming.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            入边（@_incoming.Count）
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack"
                     Class="ml-1" Size="Size.Small" />
        </MudText>
        <MudTable Items="_incoming" Dense="true" Bordered="true"
                  Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>类型</MudTh>
                <MudTh>起点节点</MudTh>
                <MudTh>方向</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="类型">
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                        @context.TypeName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="起点">
                    @if (string.IsNullOrEmpty(context.FromNodeText))
                    {
                        <code>@context.FromNodeId</code>
                    }
                    else
                    {
                        <span title="@context.FromNodeId">@context.FromNodeText</span>
                    }
                </MudTd>
                <MudTd DataLabel="方向">@(context.IsDirected ? "有向" : "无向")</MudTd>
                <MudTd DataLabel="操作">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(async () => await DeleteEdgeAsync(context))"
                                   title="删除" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    /// <summary>当前节点 ID（边的任一端来自/指向该节点）。</summary>
    [Parameter, EditorRequired] public string NodeId { get; set; } = "";

    /// <summary>当前节点显示名（仅用于建边时预填）。</summary>
    [Parameter] public string? NodeName { get; set; }

    /// <summary>出边/入边数量变化回调（父组件据此更新选项卡标题）。</summary>
    [Parameter] public EventCallback<(int Outgoing, int Incoming)> OnSummaryChanged { get; set; }

    private IReadOnlyList<string> _typeNames = [];
    private string _filterTypeName = "";
    private bool _loading;
    private List<EdgeInstanceDto> _outgoing = [];
    private List<EdgeInstanceDto> _incoming = [];
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadAsync();
            StateHasChanged();
        }
    }

    /// <summary>外部数据变更后主动刷新（父组件调用）。</summary>
    public Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var typeName = string.IsNullOrEmpty(_filterTypeName) ? null : _filterTypeName;

            _outgoing = (await Api.FindOutgoingEdgesAsync(typeName, NodeId) ?? []).ToList();
            _incoming = (await Api.FindIncomingEdgesAsync(typeName, NodeId) ?? []).ToList();

            // 类型选项：无过滤时从当前节点的全部边中汇总，避免额外的元数据请求
            if (typeName is null)
            {
                _typeNames = _outgoing.Concat(_incoming)
                    .Select(e => e.TypeName)
                    .Distinct(StringComparer.Ordinal)
                    .OrderBy(n => n, StringComparer.Ordinal)
                    .ToList();
            }
        }
        finally
        {
            _loading = false;
        }

        await OnSummaryChanged.InvokeAsync((_outgoing.Count, _incoming.Count));
    }

    private Task OnFilterChanged(string? typeName)
    {
        _filterTypeName = typeName ?? "";
        _ = LoadAsync();
        return Task.CompletedTask;
    }

    private async Task OpenCreateEdgeAsync()
    {
        var parameters = new DialogParameters
        {
            { "PreFillFromNodeId", NodeId },
            { "PreFillFromNodeName", NodeName ?? NodeId },
            { "PreFillTypeName", string.IsNullOrEmpty(_filterTypeName) ? null : _filterTypeName }
        };

        var options = new DialogConfig { MaxWidth = MaxWidth.Medium }.ToDialogOptions();
        var dialog = await DialogService.ShowExAsync<EdgeDialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteEdgeAsync(EdgeInstanceDto edge)
    {
        var from = string.IsNullOrEmpty(edge.FromNodeText) ? edge.FromNodeId : edge.FromNodeText;
        var to = string.IsNullOrEmpty(edge.ToNodeText) ? edge.ToNodeId : edge.ToNodeText;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除这条关系吗？\n\n类型：{edge.TypeName}\n从 {from} → {to}",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteEdgeAsync(edge.EdgeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知"}", Severity.Error);
        }
    }
}
