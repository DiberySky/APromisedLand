@* EdgeRelationPanel.razor — 可复用的「节点关系」面板
   出边 / 入边表格 + 边类型过滤 + 创建关系 + 删除关系。
   供树节点「操作」对话框与线路节点「关系」对话框共用。 *@
@namespace TreeGraph.Blazor.Shared.EdgeSky.Components
@using TreeGraph.Shared.EdgeSky.Dtos
@using TreeGraph.Blazor.Shared.EdgeSky.Services
@using TreeGraph.Blazor.Shared.EdgeSky.Components.Dialogs
@inject EdgeApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* 顶部：边类型过滤器 + 创建按钮 *@
<div class="d-flex mb-3 align-center">
    <MudSelect T="string"
               Value="_filterEdgeTypeId"
               ValueChanged="OnFilterChanged"
               Label="边类型（可选过滤）"
               Variant="Variant.Outlined"
               Class="flex-grow-1 mr-3"
               Clearable="true"
               Dense="true">
        <MudSelectItem T="string" Value="@("")">全部类型</MudSelectItem>
        @foreach (var et in _edgeTypes)
        {
            <MudSelectItem T="string" Value="@et.EdgeTypeId">
                @et.DisplayName
            </MudSelectItem>
        }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Success"
               StartIcon="@Icons.Material.Filled.Add"
               Size="Size.Small"
               OnClick="@OpenCreateEdgeAsync">
        创建关系
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_outgoing.Count == 0 && _incoming.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">
        当前节点没有关系。点击「创建关系」建立第一条边。
    </MudAlert>
}
else
{
    @* 出边 *@
    @if (_outgoing.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            出边（@_outgoing.Count）
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                     Class="ml-1" Size="Size.Small" />
        </MudText>
        <MudTable Items="_outgoing" Dense="true" Bordered="true"
                  Hover="true" Breakpoint="Breakpoint.Sm"
                  Class="mb-3">
            <HeaderContent>
                <MudTh>类型</MudTh>
                <MudTh>终点节点</MudTh>
                <MudTh>权重</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="类型">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                        @context.EdgeTypeDisplayName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="终点">
                    @if (string.IsNullOrEmpty(context.ToNodeText))
                    {
                        <code>@context.ToNodeId</code>
                    }
                    else
                    {
                        <span title="@context.ToNodeId">@context.ToNodeText</span>
                    }
                </MudTd>
                <MudTd DataLabel="权重">
                    @(context.Weight.HasValue ? context.Weight.Value.ToString("0.####") : "—")
                </MudTd>
                <MudTd DataLabel="操作">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(async () => await DeleteEdgeAsync(context))"
                                   title="删除" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* 入边 *@
    @if (_incoming.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            入边（@_incoming.Count）
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack"
                     Class="ml-1" Size="Size.Small" />
        </MudText>
        <MudTable Items="_incoming" Dense="true" Bordered="true"
                  Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>类型</MudTh>
                <MudTh>起点节点</MudTh>
                <MudTh>权重</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="类型">
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                        @context.EdgeTypeDisplayName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="起点">
                    @if (string.IsNullOrEmpty(context.FromNodeText))
                    {
                        <code>@context.FromNodeId</code>
                    }
                    else
                    {
                        <span title="@context.FromNodeId">@context.FromNodeText</span>
                    }
                </MudTd>
                <MudTd DataLabel="权重">
                    @(context.Weight.HasValue ? context.Weight.Value.ToString("0.####") : "—")
                </MudTd>
                <MudTd DataLabel="操作">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(async () => await DeleteEdgeAsync(context))"
                                   title="删除" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    /// <summary>当前节点 ID（边的任一端来自/指向该节点）。</summary>
    [Parameter, EditorRequired] public string NodeId { get; set; } = "";

    /// <summary>当前节点显示名（仅用于建边时预填）。</summary>
    [Parameter] public string? NodeName { get; set; }

    /// <summary>出边/入边数量变化回调（父组件据此更新选项卡标题）。</summary>
    [Parameter] public EventCallback<(int Outgoing, int Incoming)> OnSummaryChanged { get; set; }

    private IReadOnlyList<EdgeTypeDto> _edgeTypes = [];
    private string _filterEdgeTypeId = "";
    private bool _loading;
    private List<EdgeInstanceDto> _outgoing = [];
    private List<EdgeInstanceDto> _incoming = [];
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await LoadAsync();
            StateHasChanged();
        }
    }

    /// <summary>外部数据变更后主动刷新（父组件调用）。</summary>
    public Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (string.IsNullOrEmpty(_filterEdgeTypeId))
            {
                _edgeTypes = await Api.ListEdgeTypesAsync() ?? [];
                var allOut = new List<EdgeInstanceDto>();
                var allIn = new List<EdgeInstanceDto>();

                foreach (var et in _edgeTypes)
                {
                    var o = await Api.FindOutgoingEdgesAsync(et.EdgeTypeId, NodeId);
                    var i = await Api.FindIncomingEdgesAsync(et.EdgeTypeId, NodeId);
                    if (o != null) allOut.AddRange(o);
                    if (i != null) allIn.AddRange(i);
                }

                _outgoing = allOut;
                _incoming = allIn;
            }
            else
            {
                var o = await Api.FindOutgoingEdgesAsync(_filterEdgeTypeId, NodeId);
                var i = await Api.FindIncomingEdgesAsync(_filterEdgeTypeId, NodeId);
                _outgoing = (o ?? []).ToList();
                _incoming = (i ?? []).ToList();
            }
        }
        finally
        {
            _loading = false;
        }

        await OnSummaryChanged.InvokeAsync((_outgoing.Count, _incoming.Count));
    }

    private Task OnFilterChanged(string? edgeTypeId)
    {
        _filterEdgeTypeId = edgeTypeId ?? "";
        _ = LoadAsync();
        return Task.CompletedTask;
    }

    private async Task OpenCreateEdgeAsync()
    {
        var parameters = new DialogParameters
        {
            { "PreFillFromNodeId", NodeId },
            { "PreFillFromNodeName", NodeName ?? NodeId },
            { "PreFillEdgeTypeId", string.IsNullOrEmpty(_filterEdgeTypeId) ? null : _filterEdgeTypeId }
        };

        var options = new DialogConfig { MaxWidth = MaxWidth.Medium }.ToDialogOptions();
        var dialog = await DialogService.ShowExAsync<EdgeDialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteEdgeAsync(EdgeInstanceDto edge)
    {
        var from = string.IsNullOrEmpty(edge.FromNodeText) ? edge.FromNodeId : edge.FromNodeText;
        var to = string.IsNullOrEmpty(edge.ToNodeText) ? edge.ToNodeId : edge.ToNodeText;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除这条关系吗？\n\n类型：{edge.EdgeTypeDisplayName}\n从 {from} → {to}",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteEdgeAsync(edge.EdgeTypeId, edge.EdgeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知"}", Severity.Error);
        }
    }
}
