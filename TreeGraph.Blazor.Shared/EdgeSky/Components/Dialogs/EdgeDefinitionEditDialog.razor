@* EdgeDefinitionEditDialog.razor — 编辑边类型 *@
@inject EavApiClient EavApi
@inject EdgeApiClient EdgeApi
@inject ISnackbar Snackbar

<DialogSky Title="编辑边类型"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
           SubmitButtonDisabled="@_submitting"
           ActionsMaxWidth="MaxWidth.False"
           OnSubmitClick="UpdateAsync">
    <DialogContent>
        <MudTextField T="string" Value="@Type.TypeName" Label="类型名"
                      Variant="Variant.Outlined" ReadOnly="true" Class="mb-3" />

        <MudTextField @bind-Value="_form.DisplayName"
                      Label="显示名" Variant="Variant.Outlined" Class="mb-3" />

        <div Class="d-flex mb-3">
            <MudSelect T="string"
                       Value="_form.FromNodeType"
                       ValueChanged="v => _form.FromNodeType = v"
                       Label="起点节点类型"
                       Variant="Variant.Outlined" Class="flex-grow-1 mr-3" Clearable="true">
                <MudSelectItem T="string" Value="@("")">不限</MudSelectItem>
                @foreach (var et in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@et.EntityType">
                        @(string.IsNullOrWhiteSpace(et.DisplayName)
                            ? et.EntityType
                            : $"{et.DisplayName}（{et.EntityType}）")
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string"
                       Value="_form.ToNodeType"
                       ValueChanged="v => _form.ToNodeType = v"
                       Label="终点节点类型"
                       Variant="Variant.Outlined" Class="flex-grow-1" Clearable="true">
                <MudSelectItem T="string" Value="@("")">不限</MudSelectItem>
                @foreach (var et in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@et.EntityType">
                        @(string.IsNullOrWhiteSpace(et.DisplayName)
                            ? et.EntityType
                            : $"{et.DisplayName}（{et.EntityType}）")
                    </MudSelectItem>
                }
            </MudSelect>
        </div>

        <div Class="d-flex align-center mb-3 gap-4">
            <BoolFieldSky Label="全局共享" @bind-Value="_form.IsGlobal" />
            <BoolFieldSky Label="有向" @bind-Value="_form.IsDirected" />
        </div>

        <MudTextField @bind-Value="_form.Description"
                      Label="描述" Variant="Variant.Outlined"
                      Lines="3" TextArea="@true" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public EdgeTypeDto Type { get; set; } = null!;

    private FormModel _form = new();
    private bool _submitting;
    private IReadOnlyList<EntityTypeSummaryDto> _entityTypes = [];

    protected override void OnParametersSet()
    {
        _form = new FormModel
        {
            DisplayName = Type.DisplayName,
            FromNodeType = Type.FromNodeType ?? "",
            ToNodeType = Type.ToNodeType ?? "",
            IsGlobal = Type.IsGlobal,
            IsDirected = Type.IsDirected,
            Description = Type.Description ?? ""
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try { _entityTypes = await EavApi.ListEntityTypesAsync(sharedOnly: true) ?? []; }
        catch { _entityTypes = []; }
    }

    private async Task UpdateAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.DisplayName))
        {
            Snackbar.Add("显示名必填", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var req = new UpdateEdgeTypeRequest
            {
                DisplayName = _form.DisplayName,
                FromNodeType = string.IsNullOrEmpty(_form.FromNodeType)
                    ? null : _form.FromNodeType,
                ToNodeType = string.IsNullOrEmpty(_form.ToNodeType)
                    ? null : _form.ToNodeType,
                IsGlobal = _form.IsGlobal,
                IsDirected = _form.IsDirected,
                Description = string.IsNullOrEmpty(_form.Description)
                    ? null : _form.Description
            };

            var (ok, error) = await EdgeApi.UpdateEdgeTypeAsync(Type.EdgeTypeId, req);
            if (ok)
            {
                Snackbar.Add("保存成功", Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"保存失败：{error ?? "未知"}", Severity.Error);
            }
        }
        finally { _submitting = false; }
    }

    private class FormModel
    {
        public string DisplayName { get; set; } = "";
        public string FromNodeType { get; set; } = "";
        public string ToNodeType { get; set; } = "";
        public bool IsGlobal { get; set; } = true;
        public bool IsDirected { get; set; } = true;
        public string Description { get; set; } = "";
    }
}
