@* EdgeDialog.razor — 创建 / 编辑边实例
   创建有两种入口：
     1) 宿主节点发起（TreeNodeActionsDialog / EdgeRelationPanel 传 PreFillFromNodeId）——起点固定只读；
     2) 边管理独立页发起（不传 PreFillFromNodeId）——起点与终点均可用语义搜索选择。 *@
@using System.Text.Json
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@using TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@inject EavApiClient EavApi
@inject EdgeApiClient EdgeApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="@(IsEdit ? "编辑边" : "创建边")"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
           SubmitButtonDisabled="@_submitting"
           ActionsMaxWidth="MaxWidth.False"
           OnSubmitClick="SaveAsync">
    <DialogContent>
        @if (!IsEdit)
        {
            @* 创建模式：选类型 *@
            <MudSelect T="string"
                       Value="_form.EdgeTypeId"
                       ValueChanged="OnEdgeTypeChanged"
                       Label="边类型"
                       Variant="Variant.Outlined"
                       Class="mb-3"
                       Clearable="false">
                <MudSelectItem T="string" Value="@("")">请选择边类型</MudSelectItem>
                @foreach (var et in _edgeTypes)
                {
                    <MudSelectItem T="string" Value="@et.EdgeTypeId">
                        @et.DisplayName（@et.TypeName）
                        @if (!et.IsGlobal)
                        {
                            <MudText Typo="Typo.caption" Class="ml-1" Color="Color.Secondary">
                                [@et.FromNodeType → @et.ToNodeType]
                            </MudText>
                        }
                    </MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            @* 编辑模式：展示类型名（只读） *@
            <MudTextField T="string"
                          Value="@_form.EdgeTypeDisplayName"
                          Label="边类型"
                          Variant="Variant.Outlined"
                          ReadOnly="true"
                          Class="mb-3" />
        }

        @* 节点对 + 权重（字段显示节点显示名，GUID 置于辅助文本） *@
        <div Class="d-flex mb-3">
            <MudTextField Value="@(_fromNodeName ?? _form.FromNodeId)"
                          Label="起点节点"
                          Variant="Variant.Outlined"
                          Class="flex-grow-1 mr-3"
                          Placeholder="@(FromLocked ? "" : "点击右侧按钮选择宿主节点")"
                          HelperText="@(FromLocked
                              ? $"来自宿主节点，不可修改（ID：{_form.FromNodeId}）"
                              : (_fromNodeName is not null
                                  ? $"ID：{_form.FromNodeId}"
                                  : "点击右侧按钮选择宿主节点"))"
                          ReadOnly="true" />
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                     Class="d-flex align-center mr-3"
                     Color="@(_currentEdgeType?.IsDirected == false
                         ? Color.Tertiary : Color.Primary)" />
            <MudTextField Value="@(_toNodeName ?? _form.ToNodeId)"
                          Label="终点节点"
                          Variant="Variant.Outlined"
                          Class="flex-grow-1"
                          Placeholder="点击右侧按钮选择宿主节点"
                          ReadOnly="true"
                          HelperText="@(_toNodeName is not null
                              ? $"ID：{_form.ToNodeId}"
                              : "点击右侧按钮选择宿主节点")" />
            @if (!IsEdit && !FromLocked)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Search"
                               Color="Color.Primary"
                               Class="ml-2"
                               Title="语义搜索选择起点节点"
                               OnClick="PickFromNodeAsync" />
            }
            @if (!IsEdit)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Search"
                               Color="Color.Primary"
                               Class="ml-2"
                               Title="语义搜索选择终点节点"
                               OnClick="PickToNodeAsync" />
            }
        </div>

        @* 权重 *@
        <NumberInputField T="decimal?"
                          @bind-Value="_form.Weight"
                          Label="权重（可选）"
                          Class="mb-3"
                          Step="0.0001M" />

        @* 显示名（边宿主向量文本来源） *@
        <MudTextField T="string?"
                      @bind-Value="_form.DisplayName"
                      Label="显示名（可选）"
                      Variant="Variant.Outlined"
                      Class="mb-3" />

        @* EAV 属性（DynamicForm） *@
        @if (_schema is { Count: > 0 })
        {
            <MudDivider Class="my-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    关系属性（复用 EAV 属性系统）
                </MudText>
            </MudDivider>

            <DynamicForm @ref="_formRef"
                         EntityType="@EdgeTypeName"
                         EntityId="@(IsEdit ? _form.EdgeId : "")"
                         Schema="@_schema"
                         CompactLayout="true"
                         ReadOnly="false"
                         OnSubmit="CaptureEavValues" />
        }
        else if (!string.IsNullOrEmpty(_form.EdgeTypeId))
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                当前边类型未定义属性。可到「边类型 → 属性定义」中为
                <code>@_currentEdgeType?.TypeName</code> 创建属性。
            </MudAlert>
        }

        @* 挂载属性（边作为 EAV 宿主，可关注类型并填写属性；仅编辑模式） *@
        @if (IsEdit && !string.IsNullOrEmpty(_form.EdgeId))
        {
            <MudDivider Class="my-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    挂载属性（边作为 EAV 宿主）
                </MudText>
            </MudDivider>
            <NodeAttributeItemsSky @ref="_attrItems"
                                   NodeId="@_form.EdgeId"
                                   ReadOnly="false"
                                   AllowManage="true" />
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public EdgeInstanceDto? Editing { get; set; }
    [Parameter] public string? PreFillFromNodeId { get; set; }
    /// <summary>起点宿主节点的显示名（可选；不传则字段回退显示 GUID）。</summary>
    [Parameter] public string? PreFillFromNodeName { get; set; }
    [Parameter] public string? PreFillToNodeId { get; set; }
    [Parameter] public string? PreFillEdgeTypeId { get; set; }

    private bool IsEdit => Editing is not null;

    /// <summary>起点是否由调用方固定（宿主节点发起创建时为 true）。</summary>
    private bool FromLocked => !string.IsNullOrEmpty(PreFillFromNodeId);

    private string EdgeTypeName => _currentEdgeType?.TypeName ?? "";

    private EdgeFormModel _form = new();
    private bool _submitting;

    private IReadOnlyList<EdgeTypeDto> _edgeTypes = [];
    private EdgeTypeDto? _currentEdgeType;
    private IReadOnlyList<AttributeSchemaDto>? _schema;

    private DynamicForm? _formRef;
    private Dictionary<string, object?> _eavValues = new();
    private NodeAttributeItemsSky? _attrItems;

    /// <summary>终点选中节点的显示名（选择器返回，仅用于展示）。</summary>
    private string? _toNodeName;

    /// <summary>起点宿主节点的显示名（创建时由调用方传入，仅用于展示）。</summary>
    private string? _fromNodeName;

    protected override async Task OnInitializedAsync()
    {
        _edgeTypes = await EdgeApi.ListEdgeTypesAsync() ?? [];

        if (IsEdit && Editing is not null)
        {
            var type = _edgeTypes.FirstOrDefault(t => t.EdgeTypeId == Editing.EdgeTypeId);
            _currentEdgeType = type;

            _form = new EdgeFormModel
            {
                EdgeId = Editing.EdgeId,
                EdgeTypeId = Editing.EdgeTypeId,
                EdgeTypeDisplayName = Editing.EdgeTypeDisplayName,
                FromNodeId = Editing.FromNodeId,
                ToNodeId = Editing.ToNodeId,
                Weight = Editing.Weight,
                DisplayName = Editing.DisplayName
            };

            // 两端均为 Inode：显示名取自后端回填的 FromNodeText/ToNodeText（空则回退显示 Id）
            _fromNodeName = string.IsNullOrEmpty(Editing.FromNodeText) ? null : Editing.FromNodeText;
            _toNodeName = string.IsNullOrEmpty(Editing.ToNodeText) ? null : Editing.ToNodeText;

            if (type is not null)
            {
                _schema = await EavApi.GetSchemaAsync(type.TypeName);
                if (_schema is { Count: > 0 } && Editing.Properties is not null)
                {
                    // DynamicForm.LoadFrom 接受 Dictionary<string, JsonElement>
                    _formRef?.LoadFrom(Editing.Properties);
                }
            }
        }
        else
        {
            _form = new EdgeFormModel
            {
                FromNodeId = PreFillFromNodeId ?? "",
                ToNodeId = PreFillToNodeId ?? "",
                EdgeTypeId = PreFillEdgeTypeId ?? ""
            };
            _fromNodeName = PreFillFromNodeName;

            if (!string.IsNullOrEmpty(PreFillEdgeTypeId))
                await OnEdgeTypeChanged(PreFillEdgeTypeId);
        }
    }

    private async Task OnEdgeTypeChanged(string? edgeTypeId)
    {
        _form.EdgeTypeId = edgeTypeId ?? "";
        _currentEdgeType = _edgeTypes.FirstOrDefault(t => t.EdgeTypeId == edgeTypeId);
        _eavValues.Clear();

        if (_currentEdgeType is not null)
        {
            _schema = await EavApi.GetSchemaAsync(_currentEdgeType.TypeName);
        }
        else
        {
            _schema = null;
        }
    }

    /// <summary>
    /// 打开宿主 inode 选择器（语义搜索包装）：非全局边类型按 FromNodeType 限定，
    /// 全局边类型不限类型。仅在「边管理」独立页创建时可用（无宿主预填）。
    /// </summary>
    private async Task PickFromNodeAsync()
    {
        var parameters = new DialogParameters<InodeSelectorDialog>
        {
            { x => x.NodeType, _currentEdgeType?.FromNodeType },
        };

        var options = new DialogConfig { MaxWidth = MaxWidth.Medium }.ToDialogOptions();

        var dialog = await DialogService.ShowExAsync<InodeSelectorDialog>(
            "选择起点节点", parameters, options);

        var result = await dialog.Result;

        if (result is { Canceled: false, Data: InodeSelectorDialog.InodeSelection selection })
        {
            _form.FromNodeId = selection.InodeId;
            _fromNodeName = selection.NodeName ?? selection.InodeId;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 打开宿主 inode 选择器（语义搜索包装）：非全局边类型按 ToNodeType 限定，
    /// 全局边类型不限类型。
    /// </summary>
    private async Task PickToNodeAsync()
    {
        var parameters = new DialogParameters<InodeSelectorDialog>
        {
            { x => x.NodeType, _currentEdgeType?.ToNodeType },
        };

        var options = new DialogConfig { MaxWidth = MaxWidth.Medium }.ToDialogOptions();

        var dialog = await DialogService.ShowExAsync<InodeSelectorDialog>(
            "选择宿主节点", parameters, options);

        var result = await dialog.Result;

        if (result is { Canceled: false, Data: InodeSelectorDialog.InodeSelection selection })
        {
            _form.ToNodeId = selection.InodeId;
            _toNodeName = selection.NodeName ?? selection.InodeId;
            StateHasChanged();
        }
    }

    private void CaptureEavValues(Dictionary<string, object?> values)
    {
        _eavValues = new Dictionary<string, object?>(values);
    }

    private async Task SaveAsync()
    {
        _submitting = true;
        try
        {
            // 1. 让 DynamicForm 先把值收集好
            if (_schema is { Count: > 0 } && _formRef is not null)
            {
                await _formRef.SubmitAsync();
                // SubmitAsync 内部调 OnSubmit → CaptureEavValues
                // 如果表单不合法会提前 return，但这里我们没简单办法知道
                // 保守策略：即便有验证失败也继续保存边实例本身
            }

            if (IsEdit)
                await UpdateEdgeAsync();
            else
                await CreateEdgeAsync();
        }
        finally { _submitting = false; }
    }

    private async Task CreateEdgeAsync()
    {
        if (string.IsNullOrEmpty(_form.EdgeTypeId))
        {
            Snackbar.Add("请选择边类型", Severity.Warning);
            return;
        }
        // 起点：宿主发起时已固定；独立页发起时需选择
        if (string.IsNullOrEmpty(_form.FromNodeId))
        {
            Snackbar.Add("请选择起点节点（点击右侧搜索按钮）", Severity.Warning);
            return;
        }
        if (string.IsNullOrEmpty(_form.ToNodeId))
        {
            Snackbar.Add("请选择终点节点（点击右侧按钮进行语义搜索选择）", Severity.Warning);
            return;
        }

        // 构造 CreateEdgeRequest（EAV 属性放 Properties）
        var request = new CreateEdgeRequest
        {
            FromNodeId = _form.FromNodeId,
            ToNodeId = _form.ToNodeId,
            Weight = _form.Weight,
            DisplayName = _form.DisplayName,
            Properties = _eavValues.Count > 0
                ? ToJsonElementDict(_eavValues)
                : null
        };

        var edgeId = await EdgeApi.CreateEdgeAsync(_form.EdgeTypeId, request);
        if (edgeId is null)
        {
            Snackbar.Add("创建失败（节点可能不存在，或该边已存在）", Severity.Error);
            return;
        }

        Snackbar.Add("创建成功", Severity.Success);
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private async Task UpdateEdgeAsync()
    {
        if (Editing is null || _currentEdgeType is null) return;

        // 2a. 更新边实例本身（Weight + DisplayName）
        var req = new UpdateEdgeRequest
        {
            Weight = _form.Weight,
            DisplayName = _form.DisplayName
        };
        var (ok, error) = await EdgeApi.UpdateEdgeAsync(
            Editing.EdgeTypeId, Editing.EdgeId, req);

        if (!ok)
        {
            Snackbar.Add($"更新失败：{error ?? "未知"}", Severity.Error);
            return;
        }

        // 2b. 更新 EAV 属性（如果有）
        if (_eavValues.Count > 0)
        {
            var (eavOk, eavError, _) = await EavApi.SaveEntityAsync(
                _currentEdgeType.TypeName, Editing.EdgeId, _eavValues);

            if (!eavOk)
            {
                Snackbar.Add($"边实例已更新，但属性保存失败：{eavError ?? ""}",
                    Severity.Warning);
                return;
            }
        }

        // 2c. 保存挂载属性（边作为 EAV 宿主；任一类型失败时不关闭对话框）
        if (_attrItems is not null && !await _attrItems.SubmitUpdateNodeAttributesAsync())
            return;

        Snackbar.Add("保存成功", Severity.Success);
        MudDialog?.Close(DialogResult.Ok(true));
    }

    /// <summary>object? → JsonElement（为 CreateEdgeRequest.Properties）。</summary>
    private static Dictionary<string, JsonElement>? ToJsonElementDict(
        Dictionary<string, object?> values)
    {
        var dict = new Dictionary<string, JsonElement>();
        foreach (var (k, v) in values)
        {
            try
            {
                dict[k] = JsonSerializer.SerializeToElement(v);
            }
            catch
            {
                dict[k] = JsonSerializer.SerializeToElement(v?.ToString());
            }
        }
        return dict;
    }

    private class EdgeFormModel
    {
        public string EdgeId { get; set; } = "";
        public string EdgeTypeId { get; set; } = "";
        public string EdgeTypeDisplayName { get; set; } = "";
        public string FromNodeId { get; set; } = "";
        public string ToNodeId { get; set; } = "";
        public decimal? Weight { get; set; }
        public string? DisplayName { get; set; }
    }
}
