@* EdgePropEditDialog.razor — 编辑边属性：中文显示名（立即 PATCH）+ 类型/可空/默认值
   （后三者暂存，随属性 Schema 对话框的「应用变更」汇总进 ALTER CHANGE；
   类型走 Nebula CHANGE 白名单，可空/默认值为 PG 元数据变更）。 *@
@inject ISnackbar Snackbar
@using System.Text.Json
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Shared.EdgeSky

<DialogSky Title="@($"编辑属性 - {PropName}")"
           SubmitButtonVisible="true"
           SubmitButtonText="保存"
           OnSubmitClick="Submit">
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_displayName" Label="中文显示名称" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true"
                          HelperText="留空 = 清除显示名（回退为英文属性名）"
                          Placeholder="段边展示名" />
            <MudSelect @bind-Value="_dataType" Label="类型" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Dense="true"
                       HelperText="变更将在「应用变更」时按 ALTER CHANGE 提交（白名单由服务端校验）">
                @foreach (var t in EdgePropDataTypes.All)
                {
                    <MudSelectItem Value="@t" Text="@EdgePropDataTypeLabels.Full(t)">
                        @EdgePropDataTypeLabels.Full(t)
                    </MudSelectItem>
                }
            </MudSelect>
            <div class="d-flex gap-3 align-center">
                <MudCheckBox @bind-Value="_nullable" Label="可空（NULL）" Dense="true" />
                <MudTextField @bind-Value="_defaultText" Label="默认值" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Style="flex: 1"
                              Placeholder="@(_nullable ? "留空 = 清除默认值" : "NOT NULL 必填")" />
            </div>
        </MudStack>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>属性名（只读展示）。</summary>
    [Parameter] public string PropName { get; set; } = string.Empty;

    /// <summary>当前中文显示名（可为 null）。</summary>
    [Parameter] public string? DisplayName { get; set; }

    /// <summary>当前数据类型（STRING/INT/…）。</summary>
    [Parameter] public string DataType { get; set; } = EdgePropDataTypes.String;

    /// <summary>当前可空性。</summary>
    [Parameter] public bool Nullable { get; set; } = true;

    /// <summary>当前默认值（可为 null）。</summary>
    [Parameter] public JsonElement? DefaultValue { get; set; }

    /// <summary>编辑结果：显示名 + 目标类型 + 可空 + 默认值。</summary>
    public sealed record Result(
        string? DisplayName, string NewDataType, bool NewNullable, JsonElement? NewDefaultValue);

    private string? _displayName;
    private string _dataType = EdgePropDataTypes.String;
    private bool _nullable = true;
    private string? _defaultText;

    protected override void OnInitialized()
    {
        _displayName = DisplayName;
        _dataType = DataType;
        _nullable = Nullable;
        _defaultText = DefaultValue is { } dv
            ? (dv.ValueKind == JsonValueKind.String ? dv.GetString() : dv.GetRawText())
            : null;
    }

    private void Submit()
    {
        JsonElement? defaultValue = null;
        if (!string.IsNullOrWhiteSpace(_defaultText))
        {
            if (!TryParseDefault(_dataType, _defaultText.Trim(), out var parsed))
            {
                Snackbar.Add($"默认值 '{_defaultText}' 不是合法的 {_dataType}", Severity.Warning);
                return;
            }
            defaultValue = parsed;
        }
        else if (!_nullable)
        {
            Snackbar.Add($"属性 '{PropName}' 为 NOT NULL，必须配置默认值", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(new Result(
            string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim(),
            _dataType, _nullable, defaultValue)));
    }

    /// <summary>按类型解析默认值文本（INT/TIMESTAMP 数值、DOUBLE 浮点、BOOL 布尔，STRING/DATE 原样）。</summary>
    private static bool TryParseDefault(string dataType, string text, out JsonElement value)
    {
        value = default;
        switch (dataType)
        {
            case EdgePropDataTypes.Int:
            case EdgePropDataTypes.Timestamp:
                if (!long.TryParse(text, out var l)) return false;
                value = JsonSerializer.SerializeToElement(l);
                return true;
            case EdgePropDataTypes.Double:
                if (!double.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, out var d)) return false;
                value = JsonSerializer.SerializeToElement(d);
                return true;
            case EdgePropDataTypes.Bool:
                if (!bool.TryParse(text, out var b)) return false;
                value = JsonSerializer.SerializeToElement(b);
                return true;
            default:
                value = JsonSerializer.SerializeToElement(text);
                return true;
        }
    }
}
