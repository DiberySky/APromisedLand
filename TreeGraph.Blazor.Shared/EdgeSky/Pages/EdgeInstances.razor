@* EdgeInstances.razor — 边管理独立页（跨类型全局列表）
   与树节点「关系」页签互补：不依赖宿主入口，可按类型/显示名筛选并直接建边。 *@
@page "/edge-instances"
@using TreeGraph.Shared.EdgeSky.Dtos
@using TreeGraph.Blazor.Shared.EdgeSky.Services
@using TreeGraph.Blazor.Shared.EdgeSky.Components.Dialogs
@inject EdgeApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>边管理</PageTitle>

<PageHeaderSky Title="边管理">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="LoadAsync" Disabled="@_loading"
                   StartIcon="@Icons.Material.Filled.Refresh">
            刷新
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   Size="Size.Small"
                   OnClick="OpenCreateAsync"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="ml-2">
            新建边
        </MudButton>
    </Actions>
</PageHeaderSky>

<div class="d-flex align-center mb-3">
    <MudSelect T="string"
               Value="_filterEdgeTypeId"
               Label="边类型"
               Variant="Variant.Outlined"
               Dense="true"
               Clearable="true"
               Class="mr-3"
               Style="min-width: 220px;"
               ValueChanged="OnFilterChanged">
        <MudSelectItem T="string" Value="@("")">全部类型</MudSelectItem>
        @foreach (var et in _edgeTypes)
        {
            <MudSelectItem T="string" Value="@et.EdgeTypeId">
                @et.DisplayName（@et.TypeName）
            </MudSelectItem>
        }
    </MudSelect>

    <MudTextField T="string"
                  @bind-Value="_search"
                  Label="显示名关键字"
                  Variant="Variant.Outlined"
                  Dense="true"
                  Class="mr-3"
                  Clearable="true"
                  OnKeyDown="OnSearchKeyDown" />
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               OnClick="LoadAsync"
               StartIcon="@Icons.Material.Filled.Search">
        查询
    </MudButton>
</div>

<MudTable Items="_edges" Hover="true" Bordered="true" Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>类型</MudTh>
        <MudTh>起点</MudTh>
        <MudTh>终点</MudTh>
        <MudTh>显示名</MudTh>
        <MudTh>权重</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="类型">
            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                @context.EdgeTypeDisplayName
            </MudChip>
        </MudTd>
        <MudTd DataLabel="起点">@NodeLabel(context.FromNodeId, context.FromNodeText)</MudTd>
        <MudTd DataLabel="终点">@NodeLabel(context.ToNodeId, context.ToNodeText)</MudTd>
        <MudTd DataLabel="显示名">@(string.IsNullOrEmpty(context.DisplayName) ? "—" : context.DisplayName)</MudTd>
        <MudTd DataLabel="权重">
            @(context.Weight.HasValue ? context.Weight.Value.ToString("0.####") : "—")
        </MudTd>
        <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(async () => await DeleteAsync(context))"
                           title="删除" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await OpenEditAsync(context))"
                           title="编辑" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.Hub" Title="暂无边">
            <Description>
                <text>点击右上角「新建边」创建第一条</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<EdgeInstanceDto> _edges = [];
    private IReadOnlyList<EdgeTypeDto> _edgeTypes = [];
    private string _filterEdgeTypeId = "";
    private string? _search;
    private bool _loading;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _edgeTypes = await Api.ListEdgeTypesAsync() ?? [];
            _edges = await Api.ListAllEdgesAsync(
                string.IsNullOrEmpty(_filterEdgeTypeId) ? null : _filterEdgeTypeId,
                nodeIds: null,
                string.IsNullOrWhiteSpace(_search) ? null : _search) ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _edges = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnFilterChanged(string? edgeTypeId)
    {
        _filterEdgeTypeId = edgeTypeId ?? "";
        return LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        var options = new DialogConfig { MaxWidth = MaxWidth.Medium }.ToDialogOptions();
        var dialog = await DialogService.ShowExAsync<EdgeDialog>(
            string.Empty, new DialogParameters(), options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenEditAsync(EdgeInstanceDto edge)
    {
        var parameters = new DialogParameters<EdgeDialog>
        {
            { x => x.Editing, edge }
        };
        var options = new DialogConfig { MaxWidth = MaxWidth.Medium }.ToDialogOptions();
        var dialog = await DialogService.ShowExAsync<EdgeDialog>(
            string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteAsync(EdgeInstanceDto edge)
    {
        var from = NodeLabel(edge.FromNodeId, edge.FromNodeText);
        var to = NodeLabel(edge.ToNodeId, edge.ToNodeText);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除这条边吗？\n\n类型：{edge.EdgeTypeDisplayName}\n从 {from} → {to}",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteEdgeAsync(edge.EdgeTypeId, edge.EdgeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知"}", Severity.Error);
        }
    }

    private static string NodeLabel(string id, string text)
        => string.IsNullOrEmpty(text) ? id : text;
}
