@* SpaceListPage.razor — 空间管理页（Tab 集成）：「空间」只读列表（行展开二级列表：树 + 线路）+「空间维护」CRUD 面板。 *@
@page "/spaces"
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Blazor.Shared.SpaceSky
@using TreeGraph.Blazor.Shared.SpaceSky.Components
@using TreeGraph.Blazor.Shared.SpaceSky.Services
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky.Services
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@using TreeGraph.Blazor.Shared.NodeEavSky.Pages.Metadata
@using TreeGraph.Blazor.Shared.TreeEavSky.Trees.Space
@using TreeGraph.Blazor.Shared.TreeEavSky.Trees.Unit
@using TreeGraph.Blazor.Shared.TreeEavSky.Trees.Category
@using TreeGraph.Blazor.Shared.TreeEavSky.Services
@using TreeGraph.Blazor.Shared.TreeEavSky.Dialogs
@using TreeGraph.Shared.TreeEavSky.Entities
@using TreeGraph.Shared.TreeEavSky.Models
@inject SpaceApiClient Api
@inject LineManageApiClient LineApi
@inject TreeApiClient<SpaceTree> TreeApi
@inject BlazorService BlazorService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>空间管理</PageTitle>

@* 选项卡图标缩至 12px（scoped 类限定本页，不影响全局 MudTabs） *@
<style>
    .spaces-tabs .mud-tab .mud-icon-root {
        font-size: 12px;
        width: 12px;
        height: 12px;
    }

    /* 仅内嵌 tabs（节点属性 → 属性定义）：选中 tab 的文字用 Info 色 */
    .spaces-tabs .spaces-tabs .mud-tab.mud-tab-active {
        color: var(--mud-palette-info) !important;
    }
</style>

<PageSky Title="空间管理" ArrowBackVisible="false">
    <PageContent>
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" Class="spaces-tabs">
            <MudTabPanel Text="空间" Icon="@Icons.Material.Outlined.Workspaces">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_spaces is null || _spaces.Count == 0)
                {
                    <EmptyStateSky Icon="@Icons.Material.Outlined.Workspaces"
                                   Title="暂无空间">
                        <Description>
                            <text>切换到"空间维护"创建第一个</text>
                        </Description>
                    </EmptyStateSky>
                }
                else
                {
                    <MudTable Items="_spaces" Hover="true">
                        <HeaderContent>
                            <MudTh>名称</MudTh>
                            <MudTh>描述</MudTh>
                            <MudTh Style="width: 80px;">操作</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.Description</MudTd>
                            <MudTd>
                                @* 展开/收起二级列表（该空间的树与线路） *@
                                <MudIconButton Icon="@(_expandedIds.Contains(context.Id)
                                                        ? Icons.Material.Outlined.ExpandLess
                                                        : Icons.Material.Outlined.ExpandMore)"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => ToggleExpand(context.Id))"
                                               title="树与线路" />
                            </MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            @if (_expandedIds.Contains(context.Id))
                            {
                                <MudTr>
                                    <td colspan="3" style="padding: 0; background-color: #000;">
                                        @* 二级列表：两列（项目名称/操作）；操作列用类型图标（树=AccountTree，线路=Route） *@
                                        <MudSimpleTable Dense="true" Hover="true"
                                                        Style="background-color: #000; width: 320px; margin-left: auto; margin-right: 64px;">
                                            <thead>
                                                <tr>
                                                    <th>项目</th>
                                                    <th style="width: 1%; white-space: nowrap; text-align: right;">操作</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>@TreeLabel(context.Type)</td>
                                                    <td style="white-space: nowrap; text-align: right;">
                                                        @* 打开该空间对应的树（沿用行级 OpenTreeAsync 逻辑） *@
                                                        <MudIconButton Icon="@Icons.Material.Outlined.AccountTree"
                                                                       Color="Color.Info"
                                                                       Size="Size.Small"
                                                                       OnClick="@(async () => await OpenTreeAsync(context))"
                                                                       title="打开树" />
                                                    </td>
                                                </tr>
                                                @foreach (var line in LinesOf(context.Id))
                                                {
                                                    <tr>
                                                        <td>线路</td>
                                                        <td style="white-space: nowrap; text-align: right;">
                                                            @* 打开该空间的线路维护对话框（与空间维护 → 线路设置 同一入口） *@
                                                            <MudIconButton Icon="@Icons.Material.Outlined.Route"
                                                                           Color="Color.Success"
                                                                           Size="Size.Small"
                                                                           OnClick="@(async () => await OpenLinesAsync(context))"
                                                                           title="线路" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    </td>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                }
            </MudTabPanel>
            <MudTabPanel Text="空间维护" Icon="@Icons.Material.Outlined.Settings">
                <SpaceManagePanel OnChanged="LoadAsync" />
            </MudTabPanel>
            @* 节点属性：内嵌属性定义管理（IsDialogMode 隐藏页头，工具栏置于内容顶部）。
               线路/关系已改为 per-space 入口（空间维护 → 线路设置/关系设置），不再保留全局 tab *@
            <MudTabPanel Text="节点属性" Icon="@Icons.Material.Outlined.Category">
                <MudTabs Elevation="0" ApplyEffectsToContainer="true" Class="spaces-tabs mt-2">
                    <MudTabPanel Text="属性定义" Icon="@Icons.Material.Outlined.Category">
                        <EntityTypes IsDialogMode="true" />
                    </MudTabPanel>
                    <MudTabPanel Text="组合定义" Icon="@Icons.Material.Outlined.AccountTree">
                        <CompositeTypes IsDialogMode="true" />
                    </MudTabPanel>
                    <MudTabPanel Text="表格定义" Icon="@Icons.Material.Outlined.TableChart">
                        <CustomTables IsDialogMode="true" />
                    </MudTabPanel>
                    <MudTabPanel Text="选项集定义" Icon="@Icons.Material.Outlined.Checklist">
                        <OptionSets IsDialogMode="true" />
                    </MudTabPanel>
                </MudTabs>
            </MudTabPanel>
        </MudTabs>
    </PageContent>
</PageSky>

@code {
    private IReadOnlyList<SpaceDto>? _spaces;
    private IReadOnlyList<LineDto>? _lines;
    private bool _loading;
    private bool _initialized;

    /// <summary>已展开二级列表的空间 Id。</summary>
    private readonly HashSet<string> _expandedIds = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _spaces = await Api.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _spaces = [];
        }
        finally
        {
            _loading = false;
        }

        // 二级列表的线路数据源：加载失败不阻断空间列表，仅线路行为空
        try
        {
            _lines = await LineApi.GetAllAsync();
        }
        catch
        {
            _lines = [];
        }
    }

    /// <summary>展开/收起该空间的二级列表（树 + 线路）。</summary>
    private void ToggleExpand(string spaceId)
    {
        if (!_expandedIds.Remove(spaceId))
            _expandedIds.Add(spaceId);
    }

    /// <summary>该空间下的线路（按 SpaceId 过滤；未加载到时为空）。</summary>
    private IEnumerable<LineDto> LinesOf(string spaceId)
        => _lines?.Where(l => l.SpaceId == spaceId) ?? [];

    /// <summary>二级列表树行项目名称：空间类型对应的树标签（空间树/单位树/类型树/知识树）。</summary>
    private static string TreeLabel(string? type)
        => SpaceManagePanel.SpaceTypeOptions.FirstOrDefault(o => o.Value == type).Label
           ?? "空间树";

    /// <summary>打开该空间的线路维护对话框（LinesDialog，与空间维护 → 线路设置 同一入口）。</summary>
    private async Task OpenLinesAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<LinesDialog>
        {
            { x => x.SpaceId, space.Id },
            { x => x.SpaceName, space.Name }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true,
            // Extensions 的遮罩点击在打开时按初始 options 注册，
            // DialogSky 运行时 SetOptionsAsync 对其无效，必须在打开点显式关闭。
            BackdropClick = false
        };
        await DialogService.ShowExAsync<LinesDialog>("线路", parameters, options);
    }

    /// <summary>
    /// 根据空间类型打开对应树：
    /// - Type = Unit → 打开单位树（整棵树，不使用空间 Id）
    /// - Type = Type → 打开分类树（整棵树，不使用空间 Id）
    /// - Type = Knowledge → 打开知识树（整棵树，不使用空间 Id）
    /// - 其他（Dynamic）→ 打开空间树（RootId = Space.Id）
    /// </summary>
    private async Task OpenTreeAsync(SpaceDto space)
    {
        switch (space.Type)
        {
            case "Unit":
                await BlazorService.ShowUnitTreeDialogPageAsync();
                break;

            case "Type":
                await BlazorService.ShowCategoryTreeDialogPageAsync();
                break;

            case "Knowledge":
                await BlazorService.ShowKnowledgeTreeDialogPageAsync();
                break;

            default:
                await OpenSpaceTreeAsync(space);
                break;
        }
    }

    /// <summary>打开该空间对应的空间树对话框（RootId = Space.Id）。打开前自检：根节点不存在则补建。</summary>
    private async Task OpenSpaceTreeAsync(SpaceDto space)
    {
        try
        {
            var root = await TreeApi.GetFullTreeAsync(space.Id);
            if (root is null)
            {
                var entity = new SpaceTree
                {
                    Id = space.Id,
                    Name = space.Name,
                    Description = space.Description ?? "",
                    ParentId = null,
                    CanHaveChildren = true,
                    SortOrder = 0,
                    HasChildren = false
                };
                await TreeApi.CreateNodeAsync(new TreeNodeDto<SpaceTree>
                {
                    Id = entity.Id,
                    Text = entity.Name,
                    ParentId = null,
                    Value = entity
                });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"空间树检查失败：{ex.Message}", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<SpaceTreeDialogPage>
        {
            { x => x.RootId, space.Id },
            { x => x.Title, $"空间树：{space.Name}" }
        };
        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            Position = DialogPosition.TopCenter,
            MaximizeButton = true,
            BackdropClick = false
        };

        await DialogService.ShowExAsync<SpaceTreeDialogPage>(
            string.Empty, parameters, options);
    }
}
