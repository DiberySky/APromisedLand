@* SpaceCreateDialog.razor — 新建空间（DialogSky 外壳，与选项集对话框风格一致） *@
@using TreeGraph.Blazor.Shared.SpaceSky
@using TreeGraph.Blazor.Shared.SpaceSky.Components
@using TreeGraph.Blazor.Shared.SpaceSky.Services
@inject SpaceApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="新建空间"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
           SubmitButtonDisabled="@_submitting"
           OnSubmitClick="CreateAsync">
    <DialogContent>
        <MudTextField @bind-Value="_form.Name"
                      Label="名称"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <MudSelect T="string"
                   @bind-Value="_form.Type"
                   Label="类型"
                   Variant="Variant.Outlined"
                   Class="mb-3">
            @foreach (var opt in SpaceManagePanel.SpaceTypeOptions)
            {
                <MudSelectItem T="string" Value="@opt.Value">@opt.Label</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_form.Description"
                      Label="描述"
                      Variant="Variant.Outlined"
                      Lines="3" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private readonly SpaceDto _form = new();
    private bool _submitting;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("请填写名称", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var created = await Api.CreateAsync(_form);
            Snackbar.Add($"创建成功：{created.Name}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
