@* SyncRefreshDialog.razor — 同步刷新对话框：分步列出 space/tree/line/edge 同步到 向量/图 的过程进度 *@
@* 打开即自动执行：向量 space→tree→line，图 space→tree→line→edge，顺序调用逐步更新格子；
   边在向量库无对应数据，该格显示不适用；单步失败不中断后续步骤；关闭即取消剩余步骤 *@

@namespace TreeGraph.Blazor.Shared.SpaceSky.Dialogs
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@using TreeGraph.Shared.NodeEavSky.Dtos
@implements IDisposable
@inject EavApiClient EavApi

<DialogSky Title="同步刷新"
           CancelButtonVisible="true" CancelButtonText="关闭"
           SubmitButtonVisible="true" SubmitButtonText="@_submitText"
           SubmitButtonDisabled="_running"
           OnSubmitClick="@RunAllAsync">
    @* 状态文字不放 ToolBarContent：MudBlazor.Extensions 宿主在标题区注入 header-actions 后，
       Blazor 对标题区的后续更新会打到游离节点（状态冻结）；内容区更新可靠 *@
    <DialogContent>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@SummaryText</MudText>
        <MudSimpleTable Hover="false" Dense="true" Bordered="true">
            <thead>
                <tr>
                    <th>数据类别</th>
                    <th>向量</th>
                    <th>图</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@row.Label</td>
                        <td>@CellContent(row.Vector, row.Key == "edge",
                                row.Vector.Status == StepStatus.Running ? _currentItem : null)</td>
                        <td>@CellContent(row.Graph)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        @* 同步项收纳：按数据类别分面板（空间树 / 单位·分类·知识树 / 线路），流式对账逐项追加，
           最新在顶部；运行中的类别自动展开，执行后面板始终保留 *@
        @if (_hasRun)
        {
            <MudExpansionPanels Class="mt-2" Elevation="0">
                @foreach (var row in _rows.Where(r => r.Key != "edge"))
                {
                    <MudExpansionPanel Text="@FeedTitle(row)"
                                       Expanded="row.FeedExpanded"
                                       ExpandedChanged="@(expanded => OnFeedExpandedChanged(row, expanded))"
                                       Dense="true">
                        <MudList T="FeedItem" Dense="true" Class="pa-1"
                                 Style="height:150px; overflow-y:auto;">
                            @if (row.Feed.Count == 0)
                            {
                                <MudListItem T="FeedItem" Class="py-0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(_running && _currentVectorKey == row.Key ? "准备中…" : "本轮无同步项")
                                    </MudText>
                                </MudListItem>
                            }
                            @foreach (var item in row.Feed)
                            {
                                <MudListItem T="FeedItem" Class="py-0">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@item.Icon" Size="Size.Small" Color="@item.Color"/>
                                        <MudText Typo="Typo.caption">@item.Text</MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private const string VectorNAText = "—（无关系向量）";

    /// <summary>总步数 = 向量 3 步 + 图 4 步（边→向量不适用不计）。</summary>
    private const int TotalSteps = 7;

    private bool _running;
    private bool _disposed;
    private string _submitText = "开始同步";
    private CancellationTokenSource _cts = new();

    /// <summary>各类别同步项列表上限（防渲染膨胀）。</summary>
    private const int FeedLimit = 200;

    /// <summary>是否已执行过同步（执行后面板始终保留展示，即使本轮无同步项）。</summary>
    private bool _hasRun;

    /// <summary>当前正在执行的向量类别键（space/tree/line），用于自动展开对应面板与「准备中」提示。</summary>
    private string? _currentVectorKey;

    private static string FeedTitle(CategoryRow row) =>
        $"{row.Label} · 同步项（{row.Feed.Count}）";

    private Task OnFeedExpandedChanged(CategoryRow row, bool expanded)
    {
        row.FeedExpanded = expanded;
        return Task.CompletedTask;
    }

    /// <summary>同步项（图标区分同步 / 清理）。</summary>
    private sealed record FeedItem(string Text, string Icon, Color Color);

    /// <summary>当前正在同步的项（滚动流最新一条的名称，向量格子 Running 时显示）。</summary>
    private string? _currentItem;

    private enum StepStatus { Pending, Running, Done, Failed }

    private sealed class StepState
    {
        public StepStatus Status { get; set; } = StepStatus.Pending;
        public string? Detail { get; set; }
        /// <summary>完成但带警告（如图写入存在错误批次），用 Warning 色展示。</summary>
        public bool Warn { get; set; }
    }

    private sealed class CategoryRow
    {
        public CategoryRow(string key, string label) { Key = key; Label = label; }
        public string Key { get; }
        public string Label { get; }
        public StepState Vector { get; } = new();
        public StepState Graph { get; } = new();
        /// <summary>该类别的同步项列表（最新在顶部）。</summary>
        public List<FeedItem> Feed { get; } = new();
        /// <summary>该类别同步项面板的展开状态。</summary>
        public bool FeedExpanded { get; set; }
    }

    private readonly List<CategoryRow> _rows =
    [
        new("space", "空间树"),
        new("tree", "单位/分类/知识树"),
        new("line", "线路"),
        new("edge", "语义关系"),
    ];

    private CategoryRow Row(string key) => _rows.First(r => r.Key == key);

    /// <summary>每次打开都重新执行全部步骤（对话框组件实例可能被宿主复用，不能只挂 OnInitializedAsync）。</summary>
    protected override async Task OnParametersSetAsync() => await RunAllAsync();

    /// <summary>顺序执行：向量 space→tree→line，图 space→tree→line→edge。</summary>
    private async Task RunAllAsync()
    {
        if (_running) return;
        _running = true;
        _submitText = "同步中…";
        ResetSteps();
        // 复用实例时上一轮 CTS 已在关闭时取消/释放，每轮执行前重建
        _cts.Dispose();
        _cts = new();
        SafeRefresh();
        try
        {
            foreach (var key in new[] { "space", "tree", "line" })
            {
                if (StopRequested()) return;
                await RunVectorStepAsync(key);
            }
            _currentVectorKey = null;
            foreach (var key in new[] { "space", "tree", "line", "edge" })
            {
                if (StopRequested()) return;
                await RunGraphStepAsync(key);
            }
        }
        finally
        {
            _running = false;
            _submitText = "重新同步";
            SafeRefresh();
        }
    }

    private void ResetSteps()
    {
        foreach (var row in _rows)
        {
            row.Vector.Status = StepStatus.Pending;
            row.Vector.Detail = null;
            row.Vector.Warn = false;
            row.Graph.Status = StepStatus.Pending;
            row.Graph.Detail = null;
            row.Graph.Warn = false;
            row.Feed.Clear();
            row.FeedExpanded = false;
        }
        MarkVectorNA();
        _hasRun = true;
        _currentItem = null;
        _currentVectorKey = null;
    }

    private void MarkVectorNA()
    {
        Row("edge").Vector.Status = StepStatus.Done;
        Row("edge").Vector.Detail = VectorNAText;
    }

    private bool StopRequested() => _disposed || _cts.IsCancellationRequested;

    private async Task RunVectorStepAsync(string key)
    {
        var row = Row(key);
        var step = row.Vector;
        step.Status = StepStatus.Running;
        // 运行中的类别自动展开，其余折叠收纳
        _currentVectorKey = key;
        foreach (var r in _rows) r.FeedExpanded = r.Key == key;
        SafeRefresh();
        try
        {
            // 流式对账：逐项实时追加同步节点名 / 清理项 / 失败项到对应类别面板
            var outcome = await EavApi.StreamReconcileAsync(
                category: key,
                onEvent: evt => InvokeAsync(() =>
                {
                    var mapped = VectorReconcileDialog.MapFeedEvent(evt);
                    _currentItem = $"[{row.Label}] {mapped.Text}";
                    row.Feed.Insert(0, new FeedItem(mapped.Text, mapped.Icon, mapped.Color));
                    if (row.Feed.Count > FeedLimit)
                        row.Feed.RemoveAt(row.Feed.Count - 1);
                    SafeRefresh();
                }),
                ct: _cts.Token);
            if (outcome.Summary is null)
            {
                step.Status = StepStatus.Failed;
                step.Detail = outcome.Error ?? "未知错误";
            }
            else
            {
                var result = outcome.Summary;
                step.Status = StepStatus.Done;
                step.Warn = result.FailedCount > 0;
                step.Detail = result.FailedCount > 0
                    ? $"新增 {result.FixedCount} · 清理 {result.DeletedCount} · 失败 {result.FailedCount}"
                    : $"新增 {result.FixedCount} · 清理 {result.DeletedCount}";
            }
        }
        catch (OperationCanceledException)
        {
            step.Status = StepStatus.Pending;
            step.Detail = null;
            return;
        }
        catch (Exception ex)
        {
            step.Status = StepStatus.Failed;
            step.Detail = ex.Message;
        }
        SafeRefresh();
    }

    private async Task RunGraphStepAsync(string key)
    {
        var step = Row(key).Graph;
        step.Status = StepStatus.Running;
        SafeRefresh();
        try
        {
            var result = await EavApi.SyncGraphCategoryAsync(key, _cts.Token);
            if (result is null)
            {
                step.Status = StepStatus.Failed;
                step.Detail = "接口未返回结果";
            }
            else
            {
                step.Status = StepStatus.Done;
                step.Warn = result.Errors.Count > 0;
                step.Detail = result.Errors.Count > 0
                    ? $"顶点 {result.VerticesWritten}/{result.Vertices} · 关系 {result.EdgesWritten}/{result.Edges} · 错误批次 {result.Errors.Count}"
                    : $"顶点 {result.VerticesWritten} · 关系 {result.EdgesWritten}";
            }
        }
        catch (OperationCanceledException)
        {
            step.Status = StepStatus.Pending;
            step.Detail = null;
            return;
        }
        catch (Exception ex)
        {
            step.Status = StepStatus.Failed;
            step.Detail = ex.Message;
        }
        SafeRefresh();
    }

    private string SummaryText
    {
        get
        {
            var done = _rows.Count(r => r.Key != "edge" && r.Vector.Status == StepStatus.Done)
                       + _rows.Count(r => r.Graph.Status == StepStatus.Done);
            var failed = _rows.Count(r => r.Vector.Status == StepStatus.Failed)
                         + _rows.Count(r => r.Graph.Status == StepStatus.Failed);
            return _running
                ? $"进行中：完成 {done}/{TotalSteps} 步"
                : failed > 0
                    ? $"已结束：完成 {done}/{TotalSteps} 步，失败 {failed} 步"
                    : $"已结束：{TotalSteps}/{TotalSteps} 步全部完成";
        }
    }

    /// <summary>单元格渲染：按步骤状态展示 等待/同步中(当前同步项或进度条)/完成统计/失败原因。</summary>
    private RenderFragment CellContent(StepState step, bool notApplicable = false, string? current = null) => __builder =>
    {
        if (notApplicable)
        {
            __builder.AddContent(0, VectorNAText);
            return;
        }

        switch (step.Status)
        {
            case StepStatus.Pending:
                __builder.OpenElement(1, "span");
                __builder.AddAttribute(2, "style", "color: var(--mud-palette-text-disabled);");
                __builder.AddContent(3, "等待");
                __builder.CloseElement();
                break;

            case StepStatus.Running when current is not null:
                // 向量对账：显示当前正在同步的项（inode.name）
                __builder.OpenElement(4, "span");
                __builder.AddAttribute(5, "style",
                    "color: var(--mud-palette-info); white-space: nowrap; display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; vertical-align: middle;");
                __builder.AddContent(6, current);
                __builder.CloseElement();
                break;

            case StepStatus.Running:
                __builder.OpenComponent<MudProgressLinear>(7);
                __builder.AddAttribute(8, nameof(MudProgressLinear.Indeterminate), true);
                __builder.AddAttribute(9, nameof(MudProgressLinear.Color), Color.Info);
                __builder.AddAttribute(10, nameof(MudProgressLinear.Class), "my-1");
                __builder.CloseComponent();
                __builder.AddContent(11, "同步中…");
                break;

            case StepStatus.Done:
                __builder.OpenElement(12, "span");
                __builder.AddAttribute(13, "class",
                    step.Warn ? "mud-warning-text" : "mud-success-text");
                __builder.AddContent(14, step.Detail);
                __builder.CloseElement();
                break;

            case StepStatus.Failed:
                __builder.OpenElement(15, "span");
                __builder.AddAttribute(16, "class", "mud-error-text");
                __builder.AddContent(17, step.Detail);
                __builder.CloseElement();
                break;
        }
    };

    private void SafeRefresh()
    {
        if (!_disposed) StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        try { _cts.Cancel(); _cts.Dispose(); } catch { /* 关闭竞态容错 */ }
    }
}
