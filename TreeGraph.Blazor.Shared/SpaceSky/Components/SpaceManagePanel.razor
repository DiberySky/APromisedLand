@* SpaceManagePanel.razor — 空间维护面板（工具栏 + 列表 + CRUD 对话框），供对话框/选项卡复用 *@
@namespace TreeGraph.Blazor.Shared.SpaceSky.Components
@using TreeGraph.Blazor.Shared.SpaceSky
@using TreeGraph.Blazor.Shared.SpaceSky.Dialogs
@using TreeGraph.Blazor.Shared.SpaceSky.Services
@inject SpaceApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TreeGraph.Blazor.Shared.EdgeSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky.Dialogs

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* 表格始终渲染：空态走 NoRecordsContent（EmptyStateSky，与 EntityTypes 对齐），
       表头操作列的新建 + 按钮在空态时同样可用 *@
    <MudTable Items="_spaces ?? (IReadOnlyList<SpaceDto>)[]" Hover="true" Bordered="true" Dense="true">
        <HeaderContent>
            <MudTh>名称</MudTh>
            <MudTh>类型</MudTh>
            <MudTh>描述</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                <MudIconButton Icon="@Icons.Material.Outlined.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateAsync"
                               title="新建空间" />
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@SpaceTypeLabel(context.Type)</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd Style="white-space: nowrap; text-align: right;">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenDeleteAsync(context))"
                               title="删除空间" />
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenEditAsync(context))"
                               title="编辑空间" />
                <MudIconButton Icon="@(IsExpanded(context.Id) ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)"
                               Color="Color.Info"
                               Size="Size.Small"
                               OnClick="@(() => ToggleExpand(context.Id))"
                               title="线路/关系" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (IsExpanded(context.Id))
            {
                <MudTr>
                    <td colspan="4" style="padding: 0 32px; background-color: #000;">
                        @* 二级列表：线路 + 关系 + 语义刷新（与空间管理「空间」列表二级列表风格对齐） *@
                        <MudSimpleTable Dense="true" Hover="true"
                                        Style="background-color: #000;">
                            <tbody>
                                <tr>
                                    <td>线路</td>
                                    <td style="white-space: nowrap; text-align: right;">
                                        @* 打开该空间的线路维护对话框（Line 为图空间级资源） *@
                                        <MudIconButton Icon="@Icons.Material.Outlined.Route"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       OnClick="@(async () => await OpenLinesAsync(context))"
                                                       title="线路" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>节点关系</td>
                                    <td style="white-space: nowrap; text-align: right;">
                                        @* 打开该空间的边类型维护对话框（EdgeType 为图空间级资源） *@
                                        <MudIconButton Icon="@Icons.Material.Outlined.Share"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       OnClick="@(async () => await OpenEdgeTypesAsync(context))"
                                                       title="节点关系" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>语义刷新</td>
                                    <td style="white-space: nowrap; text-align: right;">
                                        @* 该空间范围的向量对账进度（补缺 + 删孤） *@
                                        <MudIconButton Icon="@Icons.Material.Outlined.Sync"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       OnClick="@(async () => await OpenVectorRefreshAsync(context))"
                                                       title="语义刷新" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>图同步</td>
                                    <td style="white-space: nowrap; text-align: right;">
                                        @* 按空间 delete + insert 同步：清空 NebulaGraph 该空间并从 PG 全量重建 *@
                                        <MudIconButton Icon="@Icons.Material.Outlined.SwapHoriz"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(async () => await OpenSpaceGraphSyncAsync(context))"
                                                       title="图同步" />
                                    </td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <EmptyStateSky Icon="@Icons.Material.Outlined.Workspaces"
                           Title="暂无空间">
                <Description>
                    <text>点击右上角 + 创建第一个</text>
                </Description>
            </EmptyStateSky>
        </NoRecordsContent>
    </MudTable>
}

@code {
    /// <summary>空间类型选项（值 = 后端 SpaceType 枚举名；标签随其承载的树命名）。</summary>
    internal static readonly (string Value, string Label)[] SpaceTypeOptions =
    {
        ("Dynamic", "空间树"),
        ("Type", "类型树"),
        ("Unit", "单位树"),
        ("Knowledge", "知识树"),
    };

    private static string SpaceTypeLabel(string? type)
        => SpaceTypeOptions.FirstOrDefault(o => o.Value == type).Label
           ?? type ?? "空间树";

    /// <summary>CRUD 变更后触发（供宿主刷新自身列表）。</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<SpaceDto>? _spaces;
    private bool _loading;
    private bool _initialized;

    /// <summary>已展开二级列表的空间 ID。</summary>
    private readonly HashSet<string> _expandedIds = new();

    private bool IsExpanded(string id) => _expandedIds.Contains(id);

    private void ToggleExpand(string id)
    {
        if (!_expandedIds.Add(id))
            _expandedIds.Remove(id);
    }

    /// <summary>CRUD 子对话框选项（与 OptionSets 页面一致：小宽度全宽）。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    /// <summary>打开该空间的边类型维护对话框（关系设置入口：EdgeType 归属于图空间）。</summary>
    private async Task OpenEdgeTypesAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<EdgeTypesDialog>
        {
            { x => x.SpaceId, space.Id },
            { x => x.SpaceName, space.Name }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true,
            BackdropClick = false
        };
        await DialogService.ShowExAsync<EdgeTypesDialog>(
            string.Empty, parameters, options);
    }

    /// <summary>打开该空间的线路维护对话框（线路设置入口：Line 归属于图空间）。</summary>
    private async Task OpenLinesAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<LinesDialog>
        {
            { x => x.SpaceId, space.Id },
            { x => x.SpaceName, space.Name }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true,
            // Extensions 的遮罩点击在打开时按初始 options 注册，
            // DialogSky 运行时 SetOptionsAsync 对其无效，必须在打开点显式关闭。
            BackdropClick = false
        };
        await DialogService.ShowExAsync<LinesDialog>(
            string.Empty, parameters, options);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _spaces = await Api.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _spaces = [];
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 打开向量刷新对话框（无确认步骤）：可视化该空间范围的向量对账进度。
    /// 范围与打开该空间的树一致：动态空间 = 空间树子树；单位空间 = 单位树；类型空间 = 分类树；知识库空间 = 知识树。
    /// </summary>
    private async Task OpenVectorRefreshAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceVectorRefreshDialog>
        {
            { x => x.Space, space }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true,
            BackdropClick = false
        };
        await DialogService.ShowExAsync<SpaceVectorRefreshDialog>(
            "向量刷新", parameters, options);
    }

    /// <summary>
    /// 打开图同步对话框：按空间 delete + insert 同步（DROP SPACE → 重建 schema → 全量装载写入 NebulaGraph）。
    /// </summary>
    private async Task OpenSpaceGraphSyncAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceGraphSyncDialog>
        {
            { x => x.Space, space }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true,
            BackdropClick = false
        };
        await DialogService.ShowExAsync<SpaceGraphSyncDialog>(
            $"图同步 · {space.Name}", parameters, options);
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<SpaceCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OpenEditAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceEditDialog>
        {
            { x => x.Space, space }
        };

        var dialog = await DialogService.ShowAsync<SpaceEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OpenDeleteAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceDeleteDialog>
        {
            { x => x.Space, space }
        };

        var dialog = await DialogService.ShowAsync<SpaceDeleteDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }
}
