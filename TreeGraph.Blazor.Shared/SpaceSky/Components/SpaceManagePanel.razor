@* SpaceManagePanel.razor — 空间维护面板（工具栏 + 列表 + CRUD 对话框），供对话框/选项卡复用 *@
@namespace TreeGraph.Blazor.Shared.SpaceSky.Components
@using TreeGraph.Blazor.Shared.SpaceSky
@using TreeGraph.Blazor.Shared.SpaceSky.Dialogs
@using TreeGraph.Blazor.Shared.SpaceSky.Services
@inject SpaceApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@inject EavApiClient EavApi

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* 表格始终渲染：空态走 NoRecordsContent（EmptyStateSky，与 EntityTypes 对齐），
       表头操作列的新建 + 按钮在空态时同样可用 *@
    <MudTable Items="_spaces ?? (IReadOnlyList<SpaceDto>)[]" Hover="true" Bordered="true" Dense="true">
        <HeaderContent>
            <MudTh>名称</MudTh>
            <MudTh>类型</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">属性设置</MudTh>
            <MudTh>描述</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">同步刷新</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                @* 同步刷新：分步列出 space/tree/line/edge 同步到 向量/图 的过程进度 *@
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Info"
                               Size="Size.Small"
                               OnClick="OpenSyncRefreshAsync"
                               title="同步刷新" />
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateAsync"
                               title="新建空间" />
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@SpaceTypeLabel(context.Type)</MudTd>
            <MudTd DataLabel="属性设置" Style="white-space: nowrap; text-align: center;">
                @* 设置图标：打开该空间的实体类型定义对话框（共享 ∪ 本空间独占） *@
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenEntityTypeDefsAsync(context))"
                               title="属性设置" />
            </MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd Style="white-space: nowrap; text-align: center;">
                @* 向量刷新：打开对话框可视化该空间范围的向量对账进度（补缺 + 删孤） *@
                <MudIconButton Icon="@Icons.Material.Filled.Sync"
                               Color="Color.Info"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenVectorRefreshAsync(context))"
                               title="向量刷新" />
            </MudTd>
            <MudTd Style="white-space: nowrap; text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenDeleteAsync(context))"
                               title="删除空间" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenEditAsync(context))"
                               title="编辑空间" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyStateSky Icon="@Icons.Material.Filled.Workspaces"
                           Title="暂无空间">
                <Description>
                    <text>点击右上角 + 创建第一个</text>
                </Description>
            </EmptyStateSky>
        </NoRecordsContent>
    </MudTable>
}

@code {
    /// <summary>空间类型选项（值 = 后端 SpaceType 枚举名；标签随其承载的树命名）。</summary>
    internal static readonly (string Value, string Label)[] SpaceTypeOptions =
    {
        ("Dynamic", "空间树"),
        ("Type", "类型树"),
        ("Unit", "单位树"),
        ("Knowledge", "知识树"),
    };

    private static string SpaceTypeLabel(string? type)
        => SpaceTypeOptions.FirstOrDefault(o => o.Value == type).Label
           ?? type ?? "空间树";

    /// <summary>CRUD 变更后触发（供宿主刷新自身列表）。</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<SpaceDto>? _spaces;
    private bool _loading;
    private bool _initialized;

    /// <summary>CRUD 子对话框选项（与 OptionSets 页面一致：小宽度全宽）。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    /// <summary>打开实体类型定义对话框（动态属性入口）。</summary>
    private async Task OpenEntityTypeDefsAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<EntityTypeDefinitionsDialog>();
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };
        await DialogService.ShowExAsync<EntityTypeDefinitionsDialog>(
            "实体类型定义", parameters, options);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _spaces = await Api.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _spaces = [];
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 打开向量刷新对话框（无确认步骤）：可视化该空间范围的向量对账进度。
    /// 范围与打开该空间的树一致：动态空间 = 空间树子树；单位空间 = 单位树；类型空间 = 分类树；知识库空间 = 知识树。
    /// </summary>
    private async Task OpenVectorRefreshAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceVectorRefreshDialog>
        {
            { x => x.Space, space }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };
        await DialogService.ShowExAsync<SpaceVectorRefreshDialog>(
            "向量刷新", parameters, options);
    }

    /// <summary>打开同步刷新对话框：分步列出 space/tree/line/edge 同步到 向量/图 的过程进度。</summary>
    private async Task OpenSyncRefreshAsync()
    {
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };
        await DialogService.ShowExAsync<SyncRefreshDialog>(
            "同步刷新", new DialogParameters<SyncRefreshDialog>(), options);
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<SpaceCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OpenEditAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceEditDialog>
        {
            { x => x.Space, space }
        };

        var dialog = await DialogService.ShowAsync<SpaceEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OpenDeleteAsync(SpaceDto space)
    {
        var parameters = new DialogParameters<SpaceDeleteDialog>
        {
            { x => x.Space, space }
        };

        var dialog = await DialogService.ShowAsync<SpaceDeleteDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }
}
