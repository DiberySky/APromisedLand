@page "/maf-wf/writer-critic"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode(prerender: false))
@inject MafWfApiClient Api
@inject MafWfSseReader Sse
@inject ISnackbar Snackbar

<PageTitle>Writer-Critic</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-3">Writer-Critic 工作流</MudText>

    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudTextField @bind-Value="_topic" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="输入主题，例如：vLLM 在消费级显卡上的部署要点"
                      Disabled="_running" Immediate="true" Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_running || string.IsNullOrWhiteSpace(_topic)"
                   OnClick="() => RunAsync(stream: false)">同步运行</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   Disabled="_running || string.IsNullOrWhiteSpace(_topic)"
                   OnClick="() => RunAsync(stream: true)">流式运行</MudButton>
    </MudStack>

    @if (_steps.Count > 0)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2">执行步骤</MudText>
        @foreach (var s in _steps)
        {
            <MudPaper Elevation="1" Class="pa-3 mb-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@s.Agent</MudText>
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@s.Text</MudText>
            </MudPaper>
        }
    }

    @if (!string.IsNullOrEmpty(_finalAnswer))
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">终稿</MudText>
        <MudPaper Elevation="2" Class="pa-3">
            <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@_finalAnswer</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private string _topic = string.Empty;
    private List<WorkflowStepDto> _steps = [];
    private string? _finalAnswer;
    private bool _running;

    private async Task RunAsync(bool stream)
    {
        var topic = _topic.Trim();
        if (topic.Length == 0) return;

        _steps.Clear();
        _finalAnswer = null;
        _running = true;
        StateHasChanged();

        try
        {
            if (stream)
            {
                await RunStreamingAsync(topic);
            }
            else
            {
                var reply = await Api.RunWriterCriticAsync(topic);
                _steps = reply.Steps.ToList();
                _finalAnswer = reply.FinalAnswer;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"运行失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    private async Task RunStreamingAsync(string topic)
    {
        var currentAgent = string.Empty;
        var currentText = new System.Text.StringBuilder();

        await foreach (var evt in Sse.WriterCriticStreamAsync(topic))
        {
            if (evt.IsFinal)
            {
                if (currentText.Length > 0)
                {
                    _steps.Add(new WorkflowStepDto(currentAgent, currentText.ToString()));
                    currentText.Clear();
                }
                _finalAnswer = evt.Delta;
                StateHasChanged();
                continue;
            }

            if (!evt.Agent.Equals(currentAgent, StringComparison.Ordinal))
            {
                if (currentText.Length > 0)
                {
                    _steps.Add(new WorkflowStepDto(currentAgent, currentText.ToString()));
                    currentText.Clear();
                }
                currentAgent = evt.Agent;
            }

            currentText.Append(evt.Delta);
            StateHasChanged();
        }

        if (currentText.Length > 0)
            _steps.Add(new WorkflowStepDto(currentAgent, currentText.ToString()));
    }
}
