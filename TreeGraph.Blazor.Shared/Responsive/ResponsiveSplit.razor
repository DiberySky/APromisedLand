@* ResponsiveSplit.razor
   桌面双列布局：基于 MudSplitPanel（官方 split 组件），左（可调宽）+ 拖拽条 + 右。
   宽度持久化到 localStorage（key = StorageKey）。
   样式对齐 MudBlazor 主题（面板透明、divider 悬停色取自主题变量）。

   手机时本组件不参与渲染（由外层 ResponsiveView 分派）。 *@
@namespace TreeGraph.Blazor.Shared.Responsive
@using Microsoft.JSInterop
@inject IJSRuntime JS

<MudSplitPanel @ref="_splitPanel"
               Class="responsive-split mud-width-full mud-height-full"
               Style="@($"--responsive-split-max: {MaxWidth}px")"
               FirstPanelInitialSize="@_leftWidth"
               MinPanelSize="@MinWidth"
               ResetOnDoubleClick="false"
               Transparent="true"
               ClassFirstPanel="responsive-split__left"
               ClassSecondPanel="responsive-split__right"
               @onmouseup="SyncAndPersistAsync"
               @ontouchend="SyncAndPersistAsync"
               @onkeyup="SyncAndPersistAsync"
               @ondblclick="ResetWidthAsync">
    <FirstPanel>
        @Left
    </FirstPanel>
    <SecondPanel>
        @Right
    </SecondPanel>
</MudSplitPanel>

@code {
    [Parameter] public RenderFragment? Left { get; set; }
    [Parameter] public RenderFragment? Right { get; set; }

    /// <summary>初始宽度（px）。默认 260。</summary>
    [Parameter] public int DefaultWidth { get; set; } = 260;

    /// <summary>最小宽度（px）。</summary>
    [Parameter] public int MinWidth { get; set; } = 160;

    /// <summary>最大宽度（px）。拖拽超出后松手自动回弹到该值。</summary>
    [Parameter] public int MaxWidth { get; set; } = 600;

    /// <summary>
    /// localStorage 键名。非空时自动持久化宽度。
    /// 建议格式："模块名-split"（如 "spaces-split"）。
    /// </summary>
    [Parameter] public string? StorageKey { get; set; }

    /// <summary>宽度变化时回调（可选）。</summary>
    [Parameter] public EventCallback<int> WidthChanged { get; set; }

    private MudSplitPanel? _splitPanel;
    private int _leftWidth;

    protected override async Task OnInitializedAsync()
    {
        _leftWidth = DefaultWidth;

        // 从 localStorage 恢复
        if (!string.IsNullOrEmpty(StorageKey))
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
                if (int.TryParse(stored, out var w))
                    _leftWidth = Math.Clamp(w, MinWidth, MaxWidth);
            }
            catch { /* 忽略 */ }
        }
    }

    // ============ 拖拽同步 ============
    // MudSplitPanel 的拖拽由 JS 直接改 DOM 且不抛事件，
    // 故在 mouseup / touchend / keyup 后统一读回实际宽度。

    private async Task SyncAndPersistAsync()
    {
        if (_splitPanel is null) return;

        int width;
        try { width = await _splitPanel.GetDividerPositionAsync(); }
        catch { return; }

        var clamped = Math.Clamp(width, MinWidth, MaxWidth);
        if (clamped == _leftWidth) return;

        _leftWidth = clamped;

        // 超出 MaxWidth：回弹到边界（JS 只约束 MinPanelSize，不约束最大宽度）
        if (clamped != width)
        {
            try { await _splitPanel.SetDividerPositionAsync(clamped); } catch { /* 忽略 */ }
        }

        await PersistAsync();
        if (WidthChanged.HasDelegate)
            await WidthChanged.InvokeAsync(_leftWidth);
    }

    // 双击重置：回到默认宽度。
    // 不用官方 ResetOnDoubleClick——它只会回到 FirstPanelInitialSize（含存储恢复值）。
    private async Task ResetWidthAsync()
    {
        _leftWidth = DefaultWidth;
        if (_splitPanel is not null)
        {
            try { await _splitPanel.SetDividerPositionAsync(DefaultWidth); } catch { /* 忽略 */ }
        }

        await PersistAsync();
        if (WidthChanged.HasDelegate)
            await WidthChanged.InvokeAsync(_leftWidth);
    }

    private async Task PersistAsync()
    {
        if (string.IsNullOrEmpty(StorageKey)) return;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem",
                StorageKey, _leftWidth.ToString());
        }
        catch { /* 忽略 */ }
    }
}
