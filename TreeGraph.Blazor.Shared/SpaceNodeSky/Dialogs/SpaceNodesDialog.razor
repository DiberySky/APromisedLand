@* SpaceNodesDialog.razor — 空间节点管理对话框（图空间级资源）。
   打开参数 SpaceId/SpaceName：整个维护作用于该空间，不再有空间列。
   列表 + 新建/删除 + 节点内容（只读）→ 设置修改（属性/关系绑定）。
   对齐 LinesDialog.razor 与 LineNodeActionsDialog 风格。 *@
@namespace TreeGraph.Blazor.Shared.SpaceNodeSky.Dialogs
@using TreeGraph.Blazor.Shared.SpaceNodeSky
@using TreeGraph.Blazor.Shared.SpaceNodeSky.Services
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@using TreeGraph.Shared.SpaceNodeSky.Dtos
@inject SpaceNodeApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="空间节点"
           SubmitButtonVisible="false">
    <ToolBarContent>
        <MudText Typo="Typo.subtitle1" Color="Color.Info">@(SpaceName ?? SpaceId)</MudText>
    </ToolBarContent>
    <ToolBarRightContent>
        @* 名称模糊搜索（客户端过滤） *@
        <MudTextField T="string"
                      @bind-Value="_query"
                      Placeholder="搜索节点名称"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Style="width: 230px;"
                      Immediate="true" />
    </ToolBarRightContent>
    <DialogContent>
        @* 表格始终渲染：空态走 NoRecordsContent（EmptyStateSky），
           表头操作列的新建 + 按钮在空态时同样可用 *@
        <MudTable Items="FilteredNodes" Hover="true" Bordered="true" Dense="true"
                  Loading="@_loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>名称</MudTh>
                <MudTh>描述</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap;">创建时间</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="OpenCreateAsync"
                                   title="新建节点" />
                </MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">详情</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="white-space: nowrap;">@context.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenDeleteAsync(context))"
                                   title="删除节点" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenEditAsync(context))"
                                   title="设置修改" />
                </MudTd>
                <MudTd Style="white-space: nowrap; text-align: center;">
                    @* 节点内容：只读基本信息、属性绑定与关系绑定 *@
                    <MudIconButton Icon="@Icons.Material.Outlined.MoreHoriz"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenDetailAsync(context))"
                                   title="节点内容" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyStateSky Icon="@Icons.Material.Outlined.Hub"
                               Title="暂无空间节点">
                    <Description>
                        <text>点击右上角 + 创建第一个</text>
                    </Description>
                </EmptyStateSky>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>打开参数：目标图空间 Id（整个维护作用于该空间）。</summary>
    [Parameter] public string SpaceId { get; set; } = string.Empty;

    /// <summary>打开参数：目标图空间显示名（仅标题展示用；缺省回退显示 Id）。</summary>
    [Parameter] public string? SpaceName { get; set; }

    /// <summary>打开参数：需定位的节点 Id（可选，语义搜索跳转用）；加载后按该节点名称过滤列表。</summary>
    [Parameter] public string? FocusNodeId { get; set; }

    private IReadOnlyList<SpaceNodeDto>? _nodes;
    private bool _loading;

    /// <summary>搜索关键字（按节点名称模糊匹配，客户端过滤）。</summary>
    private string? _query;

    /// <summary>定位参数是否已应用（只作用于首次加载，避免刷新后反复收敛列表）。</summary>
    private bool _focusApplied;

    /// <summary>按名称模糊过滤后的节点列表。</summary>
    private IReadOnlyList<SpaceNodeDto> FilteredNodes =>
        _nodes is null ? [] :
        string.IsNullOrWhiteSpace(_query) ? _nodes :
        _nodes.Where(n => !string.IsNullOrEmpty(n.Name)
                          && n.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();

    /// <summary>CRUD 子对话框选项（与 SpaceManagePanel / LinesDialog 一致：小宽度全宽）。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    /// <summary>节点内容/设置修改共用选项：顶部居中、可最大化。</summary>
    private static readonly DialogOptionsEx NodeDialogOptions = new()
    {
        Position = DialogPosition.TopCenter,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        MaximizeButton = true,
        BackdropClick = false
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _nodes = await Api.GetNodesAsync(SpaceId);

            // 首次加载时按定位节点名称收敛列表（语义搜索跳转）
            if (!_focusApplied && !string.IsNullOrEmpty(FocusNodeId))
            {
                _focusApplied = true;
                var focus = _nodes.FirstOrDefault(n => n.Id == FocusNodeId);
                if (focus?.Name is { Length: > 0 } name)
                    _query = name;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _nodes = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        var parameters = new DialogParameters<SpaceNodeEditDialog>
        {
            { x => x.SpaceId, SpaceId }
        };
        var dialog = await DialogService.ShowAsync<SpaceNodeEditDialog>(
            string.Empty, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenEditAsync(SpaceNodeDto node)
        => await ShowSettingsAsync(node);

    /// <summary>打开设置修改；保存后返回最新节点快照，删除流程结束返回 null。</summary>
    private async Task<SpaceNodeDto?> ShowSettingsAsync(SpaceNodeDto node)
    {
        var parameters = new DialogParameters<SpaceNodeEditDialog>
        {
            { x => x.SpaceId, SpaceId },
            { x => x.SpaceName, SpaceName ?? SpaceId },
            { x => x.Node, node }
        };
        var dialog = await DialogService.ShowExAsync<SpaceNodeEditDialog>(
            "设置修改", parameters, NodeDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string action }
            && action == SpaceNodeEditDialog.DeleteAction)
        {
            await OpenDeleteAsync(node);
            return null;
        }

        if (result is { Canceled: false, Data: SpaceNodeDto updated })
        {
            await LoadAsync();
            return updated;
        }

        return node;
    }

    private async Task OpenDeleteAsync(SpaceNodeDto node)
    {
        var parameters = new DialogParameters<SpaceNodeDeleteDialog>
        {
            { x => x.SpaceId, SpaceId },
            { x => x.Node, node }
        };

        var dialog = await DialogService.ShowAsync<SpaceNodeDeleteDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    /// <summary>只读节点内容 → 设置修改；保存后重新打开节点内容，删除或关闭时退出。</summary>
    private async Task OpenDetailAsync(SpaceNodeDto node)
    {
        SpaceNodeDto? current = node;
        while (current is not null)
        {
            var parameters = new DialogParameters<SpaceNodeDetailDialog>
            {
                { x => x.Node, current },
                { x => x.SpaceName, SpaceName ?? SpaceId }
            };
            var dialog = await DialogService.ShowExAsync<SpaceNodeDetailDialog>(
                "节点内容", parameters, NodeDialogOptions);
            var result = await dialog.Result;

            if (result is not { Canceled: false })
                break;

            current = await ShowSettingsAsync(current);
        }
    }
}
