@* SpaceNodeDetailDialog.razor — 空间节点只读宿主：
   基本信息 + 属性绑定（只读）+ 关系绑定（只读）；
   「设置修改」仅返回动作，由 SpaceNodesDialog 打开编辑对话框并循环重开。 *@
@using TreeGraph.Blazor.Shared.EdgeSky.Components
@using TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@using TreeGraph.Blazor.Shared.NodeEavSky.Pages
@using TreeGraph.Shared.SpaceNodeSky.Dtos

<style>
    .snd-info .mud-collapse-container,
    .snd-info .mud-expand-panel-content {
        background-color: #000;
        padding-top: 4px;
    }

    .snd-rel .mud-collapse-container,
    .snd-rel .mud-expand-panel-content,
    .snd-rel .mud-tabs,
    .snd-rel .mud-tabs-panels,
    .snd-rel .mud-table-container,
    .snd-rel .mud-table-root,
    .snd-rel .mud-table-row,
    .snd-rel .mud-table-cell {
        background-color: #000;
    }
</style>

<DialogSky Title="节点内容"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭"
           OnCanceledClick="@Close">
    <ToolBarContent>
        <MudText Typo="Typo.subtitle1" Color="Color.Info">@SpaceName</MudText>
    </ToolBarContent>
    <ToolBarRightContent>
        @* AI 综合：空间节点为平面节点，无子项，仅综合当前节点 + 属性 + 关系 *@
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.AutoAwesome"
                   Size="Size.Small"
                   Color="Color.Warning"
                   OnClick="OnAiSummarize">
            AI 综合
        </MudButton>
    </ToolBarRightContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4" MaxWidth="MaxWidth.Medium">
            <MudExpansionPanel Class="snd-info mb-2" Expanded="true">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">基本信息</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="2">
                        <MudTextField T="string" Value="Node.Name"
                                      Label="名称" Variant="Variant.Outlined" ReadOnly="true" />
                        <MudTextField T="string" Value="Node.Description"
                                      Label="描述" Variant="Variant.Outlined" ReadOnly="true" Lines="3" />
                        <NodeAttributeItemsSky NodeId="@Node.Id" ReadOnly="true" />
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>

            <MudExpansionPanel Class="snd-rel">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">关系绑定</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <NodeRelationBindingsSky NodeId="@Node.Id" NodeName="@Node.Name" AllowManage="false" />
                </ChildContent>
            </MudExpansionPanel>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @* 设置修改移至底部左侧，与「关闭」同一行水平对齐 *@
        <MudButton OnClick="OnEdit"
                   Variant="Variant.Text"
                   Color="Color.Success"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.EditNote">
            设置修改
        </MudButton>
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public SpaceNodeDto Node { get; set; } = null!;

    [Parameter] public string SpaceName { get; set; } = string.Empty;

    [Inject] private IDialogService DialogService { get; set; } = default!;

    /// <summary>AI 综合：空间节点为平面节点，仅综合当前节点（含属性与关系），无子项。</summary>
    private async Task OnAiSummarize()
    {
        var parameters = new DialogParameters<NodeExpandDialog>
        {
            { x => x.InodeId, Node.Id },
            { x => x.HostType, "SpaceNode" },
            { x => x.NodeName, Node.Name },
            { x => x.InitialDepth, 0 },
            { x => x.HasChildren, false },
        };

        var options = new DialogConfig
        {
            MaxWidth = MaxWidth.Small,
            DragMode = MudDialogDragMode.None,
        }.ToDialogOptions();

        await DialogService.ShowExAsync<NodeExpandDialog>("AI 综合", parameters, options);
    }

    private void OnEdit() => MudDialog?.Close(DialogResult.Ok(true));

    private void Close() => MudDialog?.Close(DialogResult.Cancel());
}
