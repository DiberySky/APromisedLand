@* CompositeTypeFieldsPanel.razor — 组合类型字段内嵌编辑面板（供属性编辑对话框底部嵌入）。
   仅显示活动字段；增删改后自动重载详情。 *@
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!string.IsNullOrEmpty(CompositeTypeId))
{
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle2" Class="mb-2">
        字段 · @(_type is null ? "加载中…" : $"{_type.DisplayName} ({_type.TypeName})")
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_type is null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            组合类型加载失败
        </MudAlert>
    }
    else if (_fields.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            该组合类型暂无字段
        </MudAlert>
    }
    else
    {
        <MudTable Items="_fields"
                  Dense="true" Bordered="true" Hover="true"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">排序</MudTh>
                <MudTh>显示名</MudTh>
                <MudTh>类型</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                    @* 添加字段入口：置于操作列表头（与「字段定义」对话框一致） *@
                    <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Disabled="@(_type is null)"
                                   OnClick="@OpenAddFieldAsync"
                                   title="添加字段" />
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var idx = _fields.FindIndex(f => f.FieldId == context.FieldId);
                    var canMoveUp = idx > 0;
                    var canMoveDown = idx >= 0 && idx < _fields.Count - 1;
                }
                <MudTd DataLabel="排序" Style="white-space: nowrap; text-align: center;">
                    <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp"
                                   Size="Size.Small"
                                   Disabled="@(!canMoveUp)"
                                   OnClick="@(async () => await MoveUpAsync(context))"
                                   title="@(canMoveUp ? "上移" : "已在首位")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown"
                                   Size="Size.Small"
                                   Disabled="@(!canMoveDown)"
                                   OnClick="@(async () => await MoveDownAsync(context))"
                                   title="@(canMoveDown ? "下移" : "已在末位")" />
                </MudTd>
                <MudTd DataLabel="显示名">@context.DisplayName</MudTd>
                <MudTd DataLabel="类型">
                    <MudChip T="string" Size="Size.Small"
                             Color="@GetDataTypeColor(context.DataType)">
                        @EavDataTypeLabels.GetLabel(context.DataType)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(async () => await DeleteFieldAsync(context))"
                                   title="删除" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenEditFieldAsync(context))"
                                   title="编辑" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    /// <summary>目标组合类型 Id；空时不渲染。切换时自动重新加载。</summary>
    [Parameter] public string? CompositeTypeId { get; set; }

    private CompositeTypeDetailDto? _type;
    private List<CompositeFieldDetailDto> _fields = [];
    private IReadOnlyList<OptionSetSummaryDto>? _optionSets;
    private bool _loading;
    private string? _loadedId;

    private static readonly DialogOptions FieldDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnParametersSetAsync()
    {
        if (CompositeTypeId == _loadedId) return;
        _loadedId = CompositeTypeId;
        await ReloadAsync();
    }

    /// <summary>重新加载组合类型详情与引用数据（供宿主在管理对话框关闭后强制刷新）。</summary>
    public async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(CompositeTypeId))
        {
            _type = null;
            _fields = [];
            return;
        }

        _loading = true;
        try
        {
            _type = await Api.GetCompositeTypeAsync(CompositeTypeId);
            _fields = _type?.Fields
                .Where(f => !f.IsDeleted)
                .OrderBy(f => f.DisplayOrder)
                .ToList()
                ?? [];
            _optionSets ??= await Api.ListOptionSetsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddFieldAsync()
    {
        if (_type is null) return;

        var parameters = new DialogParameters<CompositeTypeFieldDialog>
        {
            { x => x.Type, _type },
            { x => x.InitialDisplayOrder, _fields.Count + 1 },
            { x => x.OptionSets, _optionSets }
        };

        var dialog = await DialogService.ShowAsync<CompositeTypeFieldDialog>(
            string.Empty, parameters, FieldDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task OpenEditFieldAsync(CompositeFieldDetailDto field)
    {
        if (_type is null) return;

        var parameters = new DialogParameters<CompositeTypeFieldDialog>
        {
            { x => x.Type, _type },
            { x => x.EditingField, field },
            { x => x.OptionSets, _optionSets }
        };

        var dialog = await DialogService.ShowAsync<CompositeTypeFieldDialog>(
            string.Empty, parameters, FieldDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task DeleteFieldAsync(CompositeFieldDetailDto field)
    {
        if (_type is null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除字段「{field.DisplayName}」？",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteCompositeFieldAsync(
            _type.CompositeTypeId, field.FieldId);

        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    /// <summary>上移一位（与相邻字段交换显示顺序）。</summary>
    private async Task MoveUpAsync(CompositeFieldDetailDto field)
    {
        if (_type is null) return;

        var idx = _fields.FindIndex(f => f.FieldId == field.FieldId);
        if (idx <= 0) return;

        (_fields[idx - 1], _fields[idx]) = (_fields[idx], _fields[idx - 1]);
        await ApplyReorderAsync();
    }

    /// <summary>下移一位（与相邻字段交换显示顺序）。</summary>
    private async Task MoveDownAsync(CompositeFieldDetailDto field)
    {
        if (_type is null) return;

        var idx = _fields.FindIndex(f => f.FieldId == field.FieldId);
        if (idx < 0 || idx >= _fields.Count - 1) return;

        (_fields[idx + 1], _fields[idx]) = (_fields[idx], _fields[idx + 1]);
        await ApplyReorderAsync();
    }

    /// <summary>按当前列表顺序重排 DisplayOrder（从 1 开始），只提交有变化的字段。</summary>
    private async Task ApplyReorderAsync()
    {
        if (_type is null) return;

        for (var i = 0; i < _fields.Count; i++)
        {
            var order = i + 1;
            if (_fields[i].DisplayOrder == order) continue;

            var (ok, error) = await Api.UpdateCompositeFieldAsync(
                _type.CompositeTypeId,
                _fields[i].FieldId,
                new UpdateCompositeFieldRequest { DisplayOrder = order });

            if (!ok)
            {
                Snackbar.Add($"排序失败：{error ?? "未知错误"}", Severity.Error);
                break;
            }
        }

        await ReloadAsync();
    }

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        _ => Color.Default
    };
}
