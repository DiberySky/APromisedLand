@* TableField.razor *@
@* 自定义表字段渲染器：行面板入口。
   点击「管理行数据」打开一级弹窗 TableRowManageDialog（行摘要表），
   其内部再打开二级弹窗 TableRowEditDialog 做行级增量保存；本组件只展示行数。 *@
@inject EavApiClient Api
@inject IDialogService DialogService

<MudPaper Class="pa-3" Elevation="1" Outlined="true">
    <div class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.TableChart"
                 Size="Size.Small" Color="Color.Primary" Class="mr-1" />
        <MudText Typo="Typo.subtitle2">@Attr.DisplayName</MudText>
        @if (_available)
        {
            <MudChip T="string" Size="Size.Small" Class="ml-2">
                @(_loading ? "加载中…" : $"{_rowCount} 行")
            </MudChip>
        }
        <MudSpacer />
        <MudButton Size="Size.Small"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@(ReadOnly ? Icons.Material.Filled.Visibility : Icons.Material.Filled.Settings)"
                   OnClick="OpenManageAsync"
                   Disabled="@(!_available || _loading)">
            @(ReadOnly ? "查看行数据" : "管理行数据")
        </MudButton>
    </div>

    @if (string.IsNullOrEmpty(EntityId))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            请先保存属性数据，然后再维护 @Attr.DisplayName 数据
        </MudAlert>
    }
    else if (Attr.RefTableDefinitionId is null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
            该属性未关联自定义表定义，无法维护行数据
        </MudAlert>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public AttributeSchemaDto Attr { get; set; } = null!;
    [Parameter, EditorRequired] public string EntityType { get; set; } = "";
    [Parameter] public string EntityId { get; set; } = "";
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>记录模式（record 类型）：透传给行管理弹窗以屏蔽序号列。</summary>
    [Parameter] public bool RecordMode { get; set; }

    // 表数据独立端点加载/保存，不参与 DynamicForm 提交；保留兼容参数
    [Parameter] public JsonElement? Value { get; set; }
    [Parameter] public EventCallback<JsonElement?> ValueChanged { get; set; }

    private int _rowCount;
    private bool _loading;
    private string? _loadedKey;

    private bool _available =>
        !string.IsNullOrEmpty(EntityId) && Attr.RefTableDefinitionId is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (!_available) return;

        var key = $"{EntityType}|{EntityId}|{Attr.AttributeName}";
        if (key == _loadedKey) return;
        _loadedKey = key;

        await ReloadCountAsync();
    }

    private async Task ReloadCountAsync()
    {
        _loading = true;
        try
        {
            var table = await Api.LoadCustomTableAsync(
                EntityType, EntityId, Attr.AttributeName);
            _rowCount = table?.Rows.Count ?? 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenManageAsync()
    {
        if (!_available) return;

        var parameters = new DialogParameters<TableRowManageDialog>
        {
            { x => x.EntityType, EntityType },
            { x => x.EntityId, EntityId },
            { x => x.TableName, Attr.AttributeName },
            { x => x.DisplayName, Attr.DisplayName },
            { x => x.RefTableDefinitionId, Attr.RefTableDefinitionId! },
            { x => x.ReadOnly, ReadOnly },
            { x => x.RecordMode, RecordMode }
        };

        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            MaximizeButton = true
        };

        var dialog = await DialogService.ShowExAsync<TableRowManageDialog>(
            Attr.DisplayName, parameters, options);

        // 行增删改后刷新行数
        var result = await dialog.Result;
        if (result is not null)
        {
            await ReloadCountAsync();
        }
    }
}
