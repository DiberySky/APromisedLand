@* LocationField.razor *@
@* 位置（location）字段：GCJ-02 经纬度 + 地点名 / 地址。
   主要用途：为节点设置坐标，供高德等地图导航软件定位。
   支持手动输入、「获取当前位置」（浏览器定位 WGS-84 转 GCJ-02）与「地图选点」（Leaflet + 高德瓦片，GCJ-02 直连）；
   编辑/只读状态均提供「导航」「查看地图」入口。 *@
@using TreeGraph.Shared.NodeEavSky.Dtos
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@inject IJSRuntime JS
@inject IDialogService DialogService

<div class="d-flex flex-column" style="gap: 8px;">
    @if (!ReadOnly)
    {
        <MudText Typo="Typo.caption" Class="py-1">
            @Attr.DisplayName
            @if (Attr.IsRequired) { <span style="color: var(--mud-palette-error);">*</span> }
            <MudText Typo="Typo.caption" Class="ml-1" Style="color: var(--mud-palette-text-secondary);">
                （GCJ-02 火星坐标）
            </MudText>
        </MudText>
        <MudStack Row="true" Spacing="2">
            <NumberInputField T="double?" Label="纬度"
                              Value="_lat" ValueChanged="OnLatChanged"
                              Min="-90" Max="90"
                              Step="0.000001m"
                              Dense="true"
                              HelperText="范围 -90 ~ 90" Class="flex-grow-1" />
            <NumberInputField T="double?" Label="经度"
                              Value="_lng" ValueChanged="OnLngChanged"
                              Min="-180" Max="180"
                              Step="0.000001m"
                              Dense="true"
                              HelperText="范围 -180 ~ 180" Class="flex-grow-1" />
        </MudStack>

        <MudTextField T="string" Label="地点名称（可选，导航终点名）"
                      Value="_label" ValueChanged="OnLabelChanged"
                      Variant="Variant.Outlined" Dense="true" />
        <MudTextField T="string" Label="地址（可选）"
                      Value="_address" ValueChanged="OnAddressChanged"
                      Variant="Variant.Outlined" Dense="true" />

        @if (_lat is not null || _lng is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                请同时填写纬度和经度，仅有一项时坐标不完整。
            </MudAlert>
        }
    }
    else
    {
        <div style="position: relative; margin-top: 10px;">
            <MudText Typo="Typo.caption"
                     Style="position: absolute; top: -9px; left: 8px; z-index: 1; padding: 0 4px; background: var(--mud-palette-surface); color: var(--mud-palette-text-secondary); line-height: 18px;">
                @Attr.DisplayName （GCJ-02 火星坐标）
            </MudText>
            <MudPaper Outlined="true" Class="pa-3">
                @if (HasCoord)
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2" Align="Align.Right">
                            纬度 @_lat?.ToString("0.######")　经度 @_lng?.ToString("0.######")
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_label))
                        {
                            <MudText Typo="Typo.body2">@_label</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_address))
                        {
                            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">@_address</MudText>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">未设置位置坐标</MudText>
                }
            </MudPaper>
        </div>
    }

    <MudStack Row="true" Spacing="2" Class="mt-1" Justify="Justify.FlexEnd">
        @if (ReadOnly)
        {
            <MudText Typo="Typo.caption" Class="align-self-center"
                     Style="color: var(--mud-palette-text-secondary);">
                （仅支持高德地图）
            </MudText>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Navigation"
                   Disabled="!HasCoord" OnClick="NavigateAmapAsync">
            导航前往
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Map"
                   Disabled="!HasCoord" OnClick="ShowOnMapAsync">
            查看地图
        </MudButton>
        @if (!ReadOnly)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.MyLocation"
                       Disabled="_locating" OnClick="GetCurrentPositionAsync">
                @(_locating ? "定位中…" : "获取当前位置")
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.AddLocationAlt"
                       OnClick="PickOnMapAsync">
                地图选点
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Clear"
                       Disabled="@(_lat is null && _lng is null && string.IsNullOrWhiteSpace(_label) && string.IsNullOrWhiteSpace(_address))"
                       OnClick="ClearAsync">
                清空
            </MudButton>
        }
    </MudStack>

    @if (!string.IsNullOrEmpty(_geoError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-1"
                  ShowCloseIcon="true" CloseIconClicked="() => _geoError = null">
            @_geoError
        </MudAlert>
    }
</div>

@code {
    [Parameter, EditorRequired] public AttributeSchemaDto Attr { get; set; } = null!;
    [Parameter] public EavLocationValue? Value { get; set; }
    [Parameter] public EventCallback<EavLocationValue?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private double? _lat;
    private double? _lng;
    private string? _label;
    private string? _address;
    private bool _locating;
    private string? _geoError;

    // 已同步到内部编辑态的外部值引用；引用变化（外部加载）时才回填，避免编辑中被覆盖
    private EavLocationValue? _sourceRef;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Value, _sourceRef))
        {
            _sourceRef = Value;
            _lat = Value?.Latitude;
            _lng = Value?.Longitude;
            _label = Value?.Label;
            _address = Value?.Address;
        }
    }

    private bool HasCoord =>
        _lat is double la && la is >= -90 and <= 90
        && _lng is double lo && lo is >= -180 and <= 180;

    private Task OnLatChanged(double? v) { _lat = v; return CommitAsync(); }
    private Task OnLngChanged(double? v) { _lng = v; return CommitAsync(); }
    private Task OnLabelChanged(string? v) { _label = v; return CommitAsync(); }
    private Task OnAddressChanged(string? v) { _address = v; return CommitAsync(); }

    private Task CommitAsync()
    {
        var hasCoord = _lat is not null || _lng is not null;
        var hasText = !string.IsNullOrWhiteSpace(_label)
                   || !string.IsNullOrWhiteSpace(_address);

        // 坐标与文本均空：视为未设置（null），保存时按空值 / 删除处理
        if (!hasCoord && !hasText)
        {
            _sourceRef = null;
            return ValueChanged.InvokeAsync(null);
        }

        var v = Value is not null && ReferenceEquals(Value, _sourceRef)
            ? Value
            : new EavLocationValue();

        v.Latitude = _lat ?? 0;
        v.Longitude = _lng ?? 0;
        v.Label = _label;
        v.Address = _address;
        v.CoordinateSystem = "gcj02";

        _sourceRef = v;
        return ValueChanged.InvokeAsync(v);
    }

    private string MarkerName =>
        Uri.EscapeDataString(
            string.IsNullOrWhiteSpace(_label) ? Attr.DisplayName : _label!);

    /// <summary>
    /// 高德驾车导航（callnative=1 唤起高德 App；坐标 GCJ-02 直连）。
    /// 起点优先取当前设备位置（WGS-84 转 GCJ-02）；定位失败则不带起点，由高德默认当前位置。
    /// </summary>
    private async Task NavigateAmapAsync()
    {
        if (!HasCoord) return;
        var url = $"https://uri.amap.com/navigation?to={_lng:0.######},{_lat:0.######},{MarkerName}"
                  + "&mode=car&coordinate=gaode&callnative=1&src=treegrapheav";

        try
        {
            var geo = await JS.InvokeAsync<GeoResult>("treegraphGeo.getCurrentPosition");
            if (geo is { Error: null, Latitude: not null, Longitude: not null })
            {
                var (fromLat, fromLng) = Gcj02Converter.Wgs84ToGcj02(
                    geo.Latitude.Value, geo.Longitude.Value);
                url += $"&from={fromLng:0.######},{fromLat:0.######},{Uri.EscapeDataString("我的位置")}";
            }
        }
        catch (JSException)
        {
            // 定位组件不可用：不带起点
        }

        await JS.InvokeVoidAsync("open", url, "_blank").AsTask();
    }

    /// <summary>高德地图打点预览。</summary>
    private Task ShowOnMapAsync()
    {
        if (!HasCoord) return Task.CompletedTask;
        var url = $"https://uri.amap.com/marker?position={_lng:0.######},{_lat:0.######}"
                  + $"&name={MarkerName}&coordinate=gaode&callnative=1&src=treegrapheav";
        return JS.InvokeVoidAsync("open", url, "_blank").AsTask();
    }

    /// <summary>
    /// 获取当前设备位置（浏览器 / WebView Geolocation API）。
    /// API 返回 WGS-84 坐标，转换为 GCJ-02 后填入（与存储坐标系一致）。
    /// 宿主需引用 _content/TreeGraph.Blazor.Shared/js/geolocation.js。
    /// </summary>
    private async Task GetCurrentPositionAsync()
    {
        _locating = true;
        _geoError = null;
        try
        {
            var result = await JS.InvokeAsync<GeoResult>("treegraphGeo.getCurrentPosition");
            if (result is null || result.Error is not null)
            {
                _geoError = result?.Error ?? "定位失败";
                return;
            }

            var (lat, lng) = Gcj02Converter.Wgs84ToGcj02(
                result.Latitude!.Value, result.Longitude!.Value);
            _lat = Math.Round(lat, 6);
            _lng = Math.Round(lng, 6);
            await CommitAsync();
        }
        catch (JSException)
        {
            // 宿主未引用 geolocation.js 或 WebView 不支持
            _geoError = "定位组件不可用（页面未加载 geolocation.js）";
        }
        finally
        {
            _locating = false;
        }
    }

    /// <summary>清空坐标与文本，按未设置处理（保存时删除该位置值）。</summary>
    private Task ClearAsync()
    {
        _lat = null;
        _lng = null;
        _label = null;
        _address = null;
        return CommitAsync();
    }

    /// <summary>打开地图选点对话框；确认后回填经纬度（GCJ-02，无需转换）。</summary>
    private async Task PickOnMapAsync()
    {
        var parameters = new DialogParameters<LocationPickDialog>();
        if (HasCoord)
        {
            parameters.Add(x => x.Latitude, _lat!.Value);
            parameters.Add(x => x.Longitude, _lng!.Value);
        }

        var options = new DialogOptions
        {
            FullScreen = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<LocationPickDialog>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: LocationPickDialog.LocationPickResult picked })
        {
            _lat = picked.Latitude;
            _lng = picked.Longitude;
            // 逆地理编码回填：地址随选点更新；地点名称仅在未填写时补充，不覆盖用户输入
            if (!string.IsNullOrWhiteSpace(picked.Address)) _address = picked.Address;
            if (string.IsNullOrWhiteSpace(_label) && !string.IsNullOrWhiteSpace(picked.Label))
                _label = picked.Label;
            await CommitAsync();
        }
    }

    /// <summary>JS 定位返回：成功带经纬度，失败带 error。</summary>
    private sealed class GeoResult
    {
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public string? Error { get; set; }
    }
}
