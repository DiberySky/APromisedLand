@* FileField.razor — EAV file 属性渲染器 *@
@* 存储 JSON shape：docId/fileName/contentType/size/sha256/version/status *@
@* ★ InputFile 必须始终在 DOM 中（d-none 切可见性），否则 Blazor WASM JS 侧文件注册表清空 *@
@* ★ 上传流程委托给 UploadProgressDialog —— 对话框自己管进度/心跳/完成/取消 *@

@inject IFileStorageClient FileStorage
@inject IDialogService Dialog
@inject TreeGraph.Blazor.Shared.Platform.IPlatformContext Platform
@using TreeGraph.Blazor.Shared.FileStorageSky.Services
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Shared.FileStorageSky.Contracts
@using Microsoft.AspNetCore.Components.Forms

@* InputFile 专用 wrapper：始终在 DOM 中，用 d-none 切可见性 *@
<div class="@(ShowInputFile ? "" : "d-none")">
    <label class="mud-button-root mud-button mud-button-filled mud-button-filled-size-medium
                 mud-button-filled-primary mud-button-filled">
        <InputFile OnChange="OnFileSelected" accept="*/*" class="d-none" />
        <span class="mud-button-label">@($"上传{Attr.DisplayName}")</span>
    </label>
    @if (Attr.IsRequired)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">必填</MudText>
    }
</div>

@if (_meta is null)
{
    @if (ReadOnly)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            @Attr.DisplayName：暂无文件
        </MudText>
    }
}
else
{
    <MudPaper Class="pa-2 mb-2" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2">@_meta!.FileName</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            类型: @_meta!.ContentType | 大小: @FormatSize(_meta!.Size) | 版本: v@_meta!.Version
        </MudText>
        @if (!string.IsNullOrEmpty(_meta.Sha256))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                SHA256: @(_meta.Sha256!.Length > 16 ? _meta.Sha256![..16] + "…" : _meta.Sha256)
            </MudText>
        }
        <div class="d-flex gap-2 mt-2">
            @if (CanPreview)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="OnPreviewAsync">预览</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="OnDownloadAsync">下载</MudButton>
            @if (!ReadOnly)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="OnDeleteAsync">删除</MudButton>
            }
        </div>
    </MudPaper>
}
@if (_errorMessage is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="mb-2">@_errorMessage</MudText>
}

@code {
    [Parameter, EditorRequired] public AttributeSchemaDto Attr { get; set; } = null!;
    [Parameter] public JsonElement? Value { get; set; }
    [Parameter] public EventCallback<JsonElement?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private FileMeta? _meta;
    private string? _errorMessage;

    private bool ShowInputFile => !ReadOnly && _meta is null;

    private static readonly JsonSerializerOptions WebJsonOpt = new(JsonSerializerDefaults.Web);

    // ============================================================
    // 预览分类
    // ============================================================

    private bool CanPreview => _meta is not null && IsPreviewable(_meta);

    private static bool IsPreviewable(FileMeta m)
    {
        var ct = m.ContentType ?? "";
        if (ct.StartsWith("image/") || ct == "application/pdf" || ct.StartsWith("text/"))
            return true;
        var ext = Path.GetExtension(m.FileName ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" or ".png" or ".jpg" or ".jpeg" or ".gif" or ".bmp" or ".webp" or ".svg" or ".ico"
                => true,
            ".txt" or ".log" or ".cs" or ".csx" or ".json" or ".xml" or ".csproj" or ".sln"
                or ".config" or ".css" or ".scss" or ".html" or ".htm" or ".js" or ".jsx"
                or ".ts" or ".tsx" or ".md" or ".markdown" or ".yaml" or ".yml" or ".toml"
                or ".ini" or ".env" or ".gitignore" or ".sql" or ".csv" or ".py" or ".go"
                or ".rs" or ".java" or ".kt" or ".rb" or ".php" or ".sh" or ".bat" or ".ps1"
                or ".proto" or ".graphql" or ".dockerfile" or ".makefile"
                => true,
            _ => false
        };
    }

    private async Task OnPreviewAsync()
    {
        if (_meta is null) return;
        var parameters = new DialogParameters
        {
            { nameof(FilePreviewDialog.FileMeta), new FilePreviewDialog.FilePreviewMeta(
                _meta.DocId, _meta.FileName, _meta.ContentType, _meta.Version, _meta.Size) }
        };
        var options = new DialogOptionsEx
        {
            FullScreen = true, FullWidth = true, MaxWidth = MaxWidth.False,
            CloseButton = false, BackdropClick = false, CloseOnEscapeKey = true,
            MaximizeButton = false, Position = DialogPosition.Center,
        };
        await Dialog.ShowExAsync<FilePreviewDialog>(string.Empty, parameters, options);
    }

    // ============================================================
    // 上传：开 UploadProgressDialog，等 DialogResult.Ok(FileMeta)
    //     对话框自己管 Initiate → Heartbeat → Chunks → Complete → CloseWith
    // ============================================================

    protected override void OnParametersSet()
    {
        if (Value is { ValueKind: JsonValueKind.Object } obj
            && obj.TryGetProperty("docId", out var d)
            && !string.IsNullOrWhiteSpace(d.GetString()))
        {
            _meta = new FileMeta
            {
                DocId = d.GetString()!,
                FileName = obj.TryGetProperty("fileName", out var fn) ? fn.GetString() ?? "" : "",
                ContentType = obj.TryGetProperty("contentType", out var ct) ? ct.GetString() ?? "" : "",
                Size = obj.TryGetProperty("size", out var sz) && sz.TryGetInt64(out var s) ? s : 0,
                Sha256 = obj.TryGetProperty("sha256", out var sh) ? sh.GetString() : null,
                Version = obj.TryGetProperty("version", out var v) && v.TryGetInt32(out var vi) ? vi : 1,
                Status = obj.TryGetProperty("status", out var st) ? st.GetString() ?? "active" : "active",
            };
        }
        else _meta = null;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        var request = new UploadProgressDialog.UploadRequest(e.File);
        var parameters = new DialogParameters
        {
            { nameof(UploadProgressDialog.Request), request }
        };
        var options = new DialogOptionsEx
        {
            FullScreen = false, FullWidth = false, MaxWidth = MaxWidth.Small,
            CloseButton = true, BackdropClick = false, CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
        };
        var dialogRef = await Dialog.ShowExAsync<UploadProgressDialog>(
            string.Empty, parameters, options);
        var result = await dialogRef.Result;

        if (result?.Data is UploadProgressDialog.UploadDialogResult r)
        {
            if (r.Meta is not null)
            {
                _meta = new FileMeta
                {
                    DocId = r.Meta.DocId, FileName = r.Meta.FileName, ContentType = r.Meta.ContentType,
                    Size = r.Meta.Size, Sha256 = r.Meta.Sha256, Version = r.Meta.Version, Status = r.Meta.Status,
                };
                var json = JsonSerializer.SerializeToElement(_meta, WebJsonOpt);
                await ValueChanged.InvokeAsync(json);
            }
            else if (r.Error is not null)
            {
                _errorMessage = r.Error;
            }
        }
        // DialogResult.Cancel（用户取消）→ 不处理
    }

    // ============================================================
    // 下载 / 删除
    // ============================================================

    private async Task OnDownloadAsync()
    {
        if (_meta is null) return;
        _errorMessage = null;
        var parameters = new DialogParameters
        {
            { nameof(DownloadProgressDialog.Request), new DownloadProgressDialog.DownloadRequest(
                _meta.DocId, _meta.Version, _meta.FileName, _meta.Size) }
        };
        var options = new DialogOptionsEx
        {
            FullScreen = false, FullWidth = false, MaxWidth = MaxWidth.Small,
            CloseButton = true, BackdropClick = false, CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
        };
        var dialogRef = await Dialog.ShowExAsync<DownloadProgressDialog>(
            string.Empty, parameters, options);
        var result = await dialogRef.Result;

        if (result?.Data is DownloadProgressDialog.DownloadDialogResult r && r.Error is not null)
        {
            _errorMessage = r.Error;
        }
        // DialogResult.Cancel（用户取消）→ 不处理
    }

    private async Task OnDeleteAsync()
    {
        if (_meta is null) return;
        var ok = await Dialog.ShowMessageBoxAsync("删除文件", "确认删除该文件？",
            yesText: "删除", cancelText: "取消");
        if (ok != true) return;

        _errorMessage = null;
        try
        {
            var full = await FileStorage.GetFileByDocIdAsync(_meta.DocId, _meta.Version, CancellationToken.None);
            if (full is not null) await FileStorage.DeleteFileAsync(full.Id, CancellationToken.None);
            _meta = null;
            await ValueChanged.InvokeAsync(null);
        }
        catch (Exception ex) { _errorMessage = $"删除失败: {ex.Message}"; }
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:F1} MB"
        : bytes >= 1024 ? $"{bytes / 1024.0:F1} KB"
        : $"{bytes} B";

    private sealed class FileMeta
    {
        public string DocId { get; set; } = "";
        public string FileName { get; set; } = "";
        public string ContentType { get; set; } = "";
        public long Size { get; set; }
        public string? Sha256 { get; set; }
        public int Version { get; set; } = 1;
        public string Status { get; set; } = "active";
    }
}
