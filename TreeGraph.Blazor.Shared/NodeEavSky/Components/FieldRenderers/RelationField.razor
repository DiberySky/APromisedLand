@* RelationField.razor *@
@* 关系（relation）字段：一条记录 = 一条有向边（宿主实体 → 目标节点）。
   目标节点通过搜索选择；边实例名称可选。提交体 { toNodeId, name? }。
   只读态展示「名称（→ 目标名）」。 *@
@using TreeGraph.Shared.NodeEavSky.Dtos
@inject EavApiClient Api
@inject IDialogService DialogService

<div class="d-flex flex-column" style="gap: 8px;">
    @if (!ReadOnly)
    {
        <MudText Typo="Typo.caption" Class="py-1">
            @Attr.DisplayName
            @if (Attr.IsRequired) { <span style="color: var(--mud-palette-error);">*</span> }
            @if (!string.IsNullOrEmpty(Attr.RelationType))
            {
                <MudText Typo="Typo.caption" Class="ml-1" Style="color: var(--mud-palette-text-secondary);">
                    （图边：@Attr.RelationType）
                </MudText>
            }
        </MudText>

        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
            <div style="flex: 1;">
                <MudAutocomplete T="NodeOptionDto"
                                 Label="目标节点"
                                 Value="_selected"
                                 ValueChanged="OnTargetChanged"
                                 SearchFunc="SearchNodesAsync"
                                 ToStringFunc="@(n => n is null ? "" : n.Name ?? n.Id)"
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 ResetValueOnEmptyText="false"
                                 CoerceText="false"
                                 HelperText="输入节点名称搜索；清空目标即删除该关系" />
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Search"
                           Color="Color.Primary"
                           Title="语义搜索选择目标节点"
                           OnClick="PickTargetAsync"/>
        </MudStack>

        <MudTextField T="string" Label="关系名称（可选）"
                      Value="_name" ValueChanged="OnNameChanged"
                      Placeholder="如 主供 / 备用"
                      MaxLength="200"
                      Variant="Variant.Outlined" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-1">
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Clear"
                       Disabled="@(_selected is null && string.IsNullOrWhiteSpace(_name))"
                       OnClick="ClearAsync">
                清空
            </MudButton>
        </MudStack>
    }
    else
    {
        <div style="position: relative; margin-top: 10px;">
            <MudText Typo="Typo.caption"
                     Style="position: absolute; top: -9px; left: 8px; z-index: 1; padding: 0 4px; background: var(--mud-palette-surface); color: var(--mud-palette-text-secondary); line-height: 18px;">
                @Attr.DisplayName
                @if (!string.IsNullOrEmpty(Attr.RelationType))
                {
                    <span>（图边：@Attr.RelationType）</span>
                }
            </MudText>
            <MudPaper Outlined="true" Class="pa-3">
                @if (!string.IsNullOrEmpty(_targetId))
                {
                    <MudText Typo="Typo.body2">
                        名称：@(string.IsNullOrWhiteSpace(_name) ? "—" : _name)
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                        → 目标：@(_targetName ?? _targetId)
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">未设置关系</MudText>
                }
            </MudPaper>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AttributeSchemaDto Attr { get; set; } = null!;
    [Parameter] public EavRelationValue? Value { get; set; }
    [Parameter] public EventCallback<EavRelationValue?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private NodeOptionDto? _selected;
    private string? _name;
    private string? _targetId;
    private string? _targetName;

    // 已同步到内部编辑态的外部值引用；引用变化（外部加载）时才回填，避免编辑中被覆盖
    private EavRelationValue? _sourceRef;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(Value, _sourceRef)) return;

        _sourceRef = Value;
        _name = Value?.Name;
        _targetId = Value?.ToNodeId;

        if (string.IsNullOrEmpty(_targetId))
        {
            _selected = null;
            _targetName = null;
            return;
        }

        // 回显目标节点名称（读取体只有 toNodeId）
        if (_selected?.Id != _targetId)
        {
            try
            {
                _selected = await Api.GetNodeAsync(_targetId);
            }
            catch
            {
                _selected = null;
            }
            _selected ??= new NodeOptionDto(_targetId, _targetId, null);
        }
        _targetName = _selected?.Name;
    }

    private async Task<IEnumerable<NodeOptionDto>> SearchNodesAsync(
        string? search, CancellationToken ct = default)
    {
        var items = await Api.SearchNodesAsync(search, ct);
        return items;
    }

    /// <summary>语义搜索选目标节点（补充按语义找节点的入口，选中后与 autocomplete 走同一提交逻辑）。</summary>
    private async Task PickTargetAsync()
    {
        var picked = await NodePicker.PickAsync(
            DialogService,
            topK: 10,
            title: "选择目标节点");

        if (picked is null) return;

        await OnTargetChanged(
            new NodeOptionDto(picked.InodeId, picked.NodeName ?? picked.InodeId, picked.HostType));
    }

    private Task OnTargetChanged(NodeOptionDto? v)
    {
        if (v is null)
        {
            // 清空目标 = 删除该关系（名称一并清空，避免残留无目标的脏值）
            _selected = null;
            _name = null;
            _sourceRef = null;
            return ValueChanged.InvokeAsync(null);
        }

        _selected = v;
        _targetId = v.Id;
        _targetName = v.Name;
        return CommitAsync();
    }

    private Task OnNameChanged(string? v)
    {
        _name = v;
        return CommitAsync();
    }

    /// <summary>清空目标与名称，按未设置处理（保存时删除该关系值）。</summary>
    private Task ClearAsync()
    {
        _selected = null;
        _name = null;
        _targetId = null;
        _targetName = null;
        _sourceRef = null;
        return ValueChanged.InvokeAsync(null);
    }

    private Task CommitAsync()
    {
        // 目标必填：未选目标时不提交（保持表单原值）
        if (_selected is null) return Task.CompletedTask;

        var v = new EavRelationValue
        {
            ToNodeId = _selected.Id,
            Name = string.IsNullOrWhiteSpace(_name) ? null : _name.Trim()
        };
        _sourceRef = v;
        return ValueChanged.InvokeAsync(v);
    }
}
