@* CustomTableColumnsPanel.razor — 自定义表列内嵌编辑面板（供属性编辑对话框底部嵌入）。
   仅显示活动列；增删改后自动重载详情。 *@
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!string.IsNullOrEmpty(TableId))
{
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle2" Class="mb-2">
        列 · @(_table is null ? "加载中…" : $"{_table.DisplayName} ({_table.TableName})")
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_table is null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            自定义表加载失败
        </MudAlert>
    }
    else if (_columns.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            该自定义表暂无列
        </MudAlert>
    }
    else
    {
        <MudTable Items="_columns"
                  Dense="true" Bordered="true" Hover="true"
                  Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">排序</MudTh>
                <MudTh>显示名</MudTh>
                <MudTh>类型</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                    @* 添加列入口：置于操作列表头（与「列定义」对话框一致） *@
                    <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Disabled="@(_table is null)"
                                   OnClick="@OpenAddColumnAsync"
                                   title="添加列" />
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var locked = IsLockedTimeColumn(context);
                    var idx = _columns.FindIndex(c => c.ColumnId == context.ColumnId);
                    var canMoveUp = !locked && idx > LockedColumnCount();
                    var canMoveDown = !locked && idx >= 0 && idx < _columns.Count - 1;
                }
                <MudTd DataLabel="排序" Style="white-space: nowrap; text-align: center;">
                    <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp"
                                   Size="Size.Small"
                                   Disabled="@(!canMoveUp)"
                                   OnClick="@(async () => await MoveUpAsync(context))"
                                   title="@(locked ? "时间维度列已锁定，不可排序" : canMoveUp ? "上移" : "已在首位")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown"
                                   Size="Size.Small"
                                   Disabled="@(!canMoveDown)"
                                   OnClick="@(async () => await MoveDownAsync(context))"
                                   title="@(locked ? "时间维度列已锁定，不可排序" : canMoveDown ? "下移" : "已在末位")" />
                </MudTd>
                <MudTd DataLabel="显示名">@context.DisplayName</MudTd>
                <MudTd DataLabel="类型">
                    <MudChip T="string" Size="Size.Small"
                             Color="@GetDataTypeColor(context.DataType)">
                        @EavDataTypeLabels.GetLabel(context.DataType)
                    </MudChip>
                    @if (locked)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Lock"
                                 Color="Color.Tertiary" Size="Size.Small"
                                 Class="ml-1"
                                 title="时间维度列已锁定（创建时定死）" />
                    }
                </MudTd>
                <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   Disabled="@locked"
                                   title="@(locked ? "时间维度列已锁定，不可删除" : "删除")"
                                   OnClick="@(async () => await DeleteColumnAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenEditColumnAsync(context))"
                                   title="编辑" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    /// <summary>目标自定义表 Id；空时不渲染。切换时自动重新加载。</summary>
    [Parameter] public string? TableId { get; set; }

    private CustomTableDetailDto? _table;
    private List<CustomTableColumnDto> _columns = [];
    private bool _loading;
    private string? _loadedId;

    private static readonly DialogOptions ColumnDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnParametersSetAsync()
    {
        if (TableId == _loadedId) return;
        _loadedId = TableId;
        await ReloadAsync();
    }

    /// <summary>重新加载自定义表详情与引用数据（供宿主在管理对话框关闭后强制刷新）。</summary>
    public async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(TableId))
        {
            _table = null;
            _columns = [];
            return;
        }

        _loading = true;
        try
        {
            _table = await Api.GetCustomTableAsync(TableId);
            _columns = _table?.Columns
                .Where(c => !c.IsDeleted)
                .OrderBy(c => c.DisplayOrder)
                .ToList()
                ?? [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddColumnAsync()
    {
        if (_table is null) return;

        var parameters = new DialogParameters<CustomTableColumnDialog>
        {
            { x => x.Table, _table },
            { x => x.InitialDisplayOrder, _columns.Count + 1 }
        };

        var dialog = await DialogService.ShowAsync<CustomTableColumnDialog>(
            string.Empty, parameters, ColumnDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task OpenEditColumnAsync(CustomTableColumnDto column)
    {
        if (_table is null) return;

        var parameters = new DialogParameters<CustomTableColumnDialog>
        {
            { x => x.Table, _table },
            { x => x.EditingColumn, column }
        };

        var dialog = await DialogService.ShowAsync<CustomTableColumnDialog>(
            string.Empty, parameters, ColumnDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task DeleteColumnAsync(CustomTableColumnDto column)
    {
        if (_table is null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除列「{column.DisplayName}」？",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteTableColumnAsync(
            _table.TableDefinitionId, column.ColumnId);

        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    /// <summary>record 表锁定时间维度列数（第 1 列日期 + 可选第 2 列时间）。</summary>
    private int LockedColumnCount()
        => _table?.IsRecordTable == true ? (_table.HasTimeColumn ? 2 : 1) : 0;

    /// <summary>判定列是否为 record 表的锁定时间维度列。</summary>
    private bool IsLockedTimeColumn(CustomTableColumnDto column)
    {
        var n = LockedColumnCount();
        if (n == 0) return false;
        return _columns
            .OrderBy(c => c.DisplayOrder)
            .Take(n)
            .Any(c => c.ColumnId == column.ColumnId);
    }

    /// <summary>上移一位（时间维度锁定列不参与排序）。</summary>
    private async Task MoveUpAsync(CustomTableColumnDto column)
    {
        if (IsLockedTimeColumn(column)) return;

        var idx = _columns.FindIndex(c => c.ColumnId == column.ColumnId);
        if (idx <= LockedColumnCount()) return;

        (_columns[idx - 1], _columns[idx]) = (_columns[idx], _columns[idx - 1]);
        await ApplyReorderAsync();
    }

    /// <summary>下移一位（时间维度锁定列不参与排序）。</summary>
    private async Task MoveDownAsync(CustomTableColumnDto column)
    {
        if (IsLockedTimeColumn(column)) return;

        var idx = _columns.FindIndex(c => c.ColumnId == column.ColumnId);
        if (idx < 0 || idx >= _columns.Count - 1) return;

        (_columns[idx + 1], _columns[idx]) = (_columns[idx], _columns[idx + 1]);
        await ApplyReorderAsync();
    }

    /// <summary>按当前列表顺序重排 DisplayOrder（从 1 开始），只提交有变化的列。</summary>
    private async Task ApplyReorderAsync()
    {
        if (_table is null) return;

        for (var i = 0; i < _columns.Count; i++)
        {
            var order = i + 1;
            if (_columns[i].DisplayOrder == order) continue;

            var (ok, error) = await Api.UpdateTableColumnAsync(
                _table.TableDefinitionId,
                _columns[i].ColumnId,
                new UpdateTableColumnRequest { DisplayOrder = order });

            if (!ok)
            {
                Snackbar.Add($"排序失败：{error ?? "未知错误"}", Severity.Error);
                break;
            }
        }

        await ReloadAsync();
    }

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        _ => Color.Default
    };
}
