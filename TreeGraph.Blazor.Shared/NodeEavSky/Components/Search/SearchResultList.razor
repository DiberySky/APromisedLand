@* SearchResultList.razor — 语义搜索结果的分页列表（/semantic-search-direct 与 /search 共用）。
   行内容：宿主图标 + 名称 + 命中/宿主标签 + ⋯操作菜单 + 路径 + 父节点 + 相似度。
   底部：条数区间 + 每页条数选择 + 翻页按钮。
   分页为纯前端切片（搜索接口单次最多返回 TopK 条，无需服务端分页）。 *@
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Components.Search
@using TreeGraph.Shared.NodeEavSky.Dtos

<style>
    .srl-row { padding: 4px 8px; border-radius: 6px; }
    .srl-clickable { cursor: pointer; }
    .srl-clickable:hover { background: var(--mud-palette-action-default-hover); }
</style>

@if (Items.Count > 0)
{
    <MudList T="SemanticSearchItemDto" Dense="true">
        @foreach (var item in PageItems)
        {
            @* 纯 div 行：整行（图标/文字/留白）都在点击热区内，避免 MudListItem 容器出现点不中的死区 *@
            <div class="srl-row @(OnItemClick.HasDelegate ? "srl-clickable" : null)"
                 style="@(IsSelected(item) ? "background: var(--mud-palette-action-default-hover); border-radius: 6px;" : null)"
                 @onclick="() => OnItemClick.InvokeAsync(item)">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@GetHostTypeIcon(item.HostType)" Size="Size.Small" Color="Color.Default"/>
                        <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body1">
                                    <strong>@(item.NodeName ?? item.InodeId)</strong>
                                </MudText>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (item.MatchKind == "Entity")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                                            属性数据命中@(string.IsNullOrEmpty(item.EntityType) ? "" : $"：{item.EntityType}")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                            节点命中
                                        </MudChip>
                                    }
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                        @item.HostType
                                    </MudChip>

                                    @* 行内操作菜单：阻止冒泡，避免点图标时触发整行点击 *@
                                    @if (ShowActions)
                                    {
                                        <span @onclick:stopPropagation="true">
                                            <SearchResultActionsMenu Item="item"
                                                                     OnOpenTree="OnOpenTree"
                                                                     OnAiExpand="OnAiExpand"
                                                                     OnChanged="OnChanged"
                                                                     OnDeleted="OnDeleted"/>
                                        </span>
                                    }
                                </MudStack>
                            </MudStack>

                            @if (!string.IsNullOrEmpty(item.Path))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    路径：@item.Path
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(item.ParentName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    父节点：@item.ParentName
                                </MudText>
                            }

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">相似度：</MudText>
                                <MudProgressLinear Value="@((double)item.Score * 100)"
                                                   Color="@GetScoreColor(item.Score)"
                                                   Size="Size.Small"
                                                   Style="width: 100px; height: 6px;"/>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @item.Score.ToString("F4")
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudStack>
                </div>
            <MudDivider/>
        }
    </MudList>

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            第 @ItemStart - @ItemEnd 条 / 共 @Items.Count 条
        </MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudSelect T="int"
                       @bind-Value="PageSizeValue"
                       Label="每页"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="width: 130px;">
                @foreach (var size in PageSizeOptions)
                {
                    <MudSelectItem T="int" Value="@size">@($"{size} 条/页")</MudSelectItem>
                }
            </MudSelect>

            <MudIconButton Icon="@Icons.Material.Outlined.FirstPage"
                           Size="Size.Small"
                           title="首页"
                           Disabled="@(_page <= 1)"
                           OnClick="@(() => GoTo(1))"/>
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft"
                           Size="Size.Small"
                           title="上一页"
                           Disabled="@(_page <= 1)"
                           OnClick="@(() => GoTo(_page - 1))"/>
            <MudText Typo="Typo.body2" Style="white-space: nowrap;">
                @_page / @PageCount
            </MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                           Size="Size.Small"
                           title="下一页"
                           Disabled="@(_page >= PageCount)"
                           OnClick="@(() => GoTo(_page + 1))"/>
            <MudIconButton Icon="@Icons.Material.Outlined.LastPage"
                           Size="Size.Small"
                           title="末页"
                           Disabled="@(_page >= PageCount)"
                           OnClick="@(() => GoTo(PageCount))"/>
        </MudStack>
    </MudStack>
}

<style>
    .srl-clickable {
        cursor: pointer;
    }
</style>

@code {
    /// <summary>结果集（页面持有；顺序即展示顺序）。</summary>
    [Parameter, EditorRequired] public IReadOnlyList<SemanticSearchItemDto> Items { get; set; } = [];

    /// <summary>树定位（页面打开对应树对话框）。</summary>
    [Parameter] public EventCallback<SemanticSearchItemDto> OnOpenTree { get; set; }

    /// <summary>AI 综合（页面打开/触发）。</summary>
    [Parameter] public EventCallback<SemanticSearchItemDto> OnAiExpand { get; set; }

    /// <summary>变更完成（建子/编辑/移动/排序/线路维护）后触发，可为空。</summary>
    [Parameter] public EventCallback<SemanticSearchItemDto> OnChanged { get; set; }

    /// <summary>删除成功（或节点已不存在）后触发。</summary>
    [Parameter] public EventCallback<SemanticSearchItemDto> OnDeleted { get; set; }

    /// <summary>整行点击（如跳转详情页或选择器选中）；不设置则整行不可点。</summary>
    [Parameter] public EventCallback<SemanticSearchItemDto> OnItemClick { get; set; }

    /// <summary>是否显示行内操作菜单（⋯/树定位/AI 综合）。选择器场景设为 false。</summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    /// <summary>高亮选中的结果行（按 InodeId 匹配）；为空不高亮。</summary>
    [Parameter] public string? SelectedInodeId { get; set; }

    private static readonly int[] PageSizeOptions = [5, 10, 20];

    private int _page = 1;
    private int _pageSize = 5;

    /// <summary>上一次接到的结果集引用：引用变化（重新搜索/新一批结果）时回到第 1 页。</summary>
    private IReadOnlyList<SemanticSearchItemDto>? _lastItems;

    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)Items.Count / _pageSize));

    /// <summary>每页条数：切换后回到第 1 页。</summary>
    private int PageSizeValue
    {
        get => _pageSize;
        set
        {
            if (_pageSize == value) return;
            _pageSize = value;
            _page = 1;
        }
    }

    private int ItemStart => Items.Count == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int ItemEnd => Math.Min(_page * _pageSize, Items.Count);

    private IEnumerable<SemanticSearchItemDto> PageItems =>
        Items.Skip((_page - 1) * _pageSize).Take(_pageSize);

    protected override void OnParametersSet()
    {
        // 结果集换了（重新搜索 / 流式返回新一批）→ 回到第 1 页
        if (!ReferenceEquals(_lastItems, Items))
        {
            _lastItems = Items;
            _page = 1;
        }

        // 结果被删减（如删除结果行）后可能超出末页
        if (_page > PageCount) _page = PageCount;
        if (_page < 1) _page = 1;
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 1, PageCount);

    private bool IsSelected(SemanticSearchItemDto item) =>
        !string.IsNullOrEmpty(SelectedInodeId) && item.InodeId == SelectedInodeId;

    private static string GetHostTypeIcon(string hostType) => hostType switch
    {
        "SpaceTree" => Icons.Material.Outlined.Forest,
        "UnitTree" => Icons.Material.Outlined.CorporateFare,
        "CategoryTree" => Icons.Material.Outlined.Category,
        "KnowledgeTree" => Icons.Material.Outlined.MenuBook,
        "LineNode" => Icons.Material.Outlined.AccountTree,
        "TreeNode" => Icons.Material.Outlined.AccountTree,
        _ => Icons.Material.Outlined.HelpOutline
    };

    private static Color GetScoreColor(float score) => score switch
    {
        >= 0.7f => Color.Success,
        >= 0.5f => Color.Warning,
        _ => Color.Error
    };
}
