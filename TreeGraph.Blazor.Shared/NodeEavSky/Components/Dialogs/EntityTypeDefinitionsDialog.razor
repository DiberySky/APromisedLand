@* EntityTypeDefinitionsDialog.razor — 实体类型定义对话框（动态属性的入口）
   内嵌 EntityTypes 页面组件（IsDialogMode 隐藏页头，工具栏置于内容顶部）。
   「动态属性」的本质即实体类型定义：在此管理实体类型及其属性定义入口。 *@
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs

@using TreeGraph.Blazor.Shared.NodeEavSky.Pages.Metadata

<DialogSky Title="@_title"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭"
           OnCanceledClick="@Close">
    <DialogContent>
        <EntityTypes IsDialogMode="true"
                     SpaceId="@SpaceId"
                     SpaceName="@SpaceName"
                     ExclusiveOnly="true" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>空间过滤：仅显示 共享类型 ∪ 该空间独占类型；新建时默认独占该空间。</summary>
    [Parameter] public string? SpaceId { get; set; }
    /// <summary>空间显示名（标题后缀）。</summary>
    [Parameter] public string? SpaceName { get; set; }

    private string _title => string.IsNullOrEmpty(SpaceName)
        ? "实体类型定义"
        : $"实体类型定义 · {SpaceName}";

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }
}
