@* InodeSelectorDialog.razor — 宿主 inode 选择器（DialogSky 外壳）
   把「语义搜索（直连）」（/semantic-search-direct）包装成选择器对话框：
   搜索 → 结果卡片列表 → 选中一行 → 确定，返回宿主 inode（InodeId + HostType）。
   仅呈现宿主节点：排除 HostType=TreeNode（未挂载树宿主的裸实体节点）；
   NodeType 非空时进一步限定宿主类型（如边类型的 ToNodeType）。 *@
@using Microsoft.Extensions.Logging
@inject EavApiClient EavApi
@inject ILogger<InodeSelectorDialog> Logger

<DialogSky Title="@DialogTitle"
           ActionsMaxWidth="MaxWidth.False"
           SubmitButtonVisible="true"
           SubmitButtonText="确定"
           SubmitButtonDisabled="@(_selected is null)"
           OnSubmitClick="Confirm">
    <DialogContent>
        @* ═══ 搜索输入 ═══ *@
        <MudPaper Elevation="0" Class="pa-2">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="_query"
                              Label="搜索内容"
                              Placeholder="输入关键词进行语义搜索..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleKeyDown"
                              Immediate="true"
                              Disabled="_searching" />

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <NumberInputField @bind-Value="_topK"
                                      Label="返回数量"
                                      Min="1" Max="20"
                                      Style="width: 120px;"
                                      Disabled="_searching"/>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">最低相似度</MudText>
                        <div style="width: 160px;">
                            <MudSlider @bind-Value="_minScore"
                                       Min="0" Max="1" Step="0.05"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="_searching"/>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @_minScore.ToString("0.00")
                        </MudText>
                    </MudStack>
                    <MudSpacer/>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="DoSearchAsync"
                               Disabled="_searching || string.IsNullOrWhiteSpace(_query)">
                        搜索
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @* ═══ 错误提示 ═══ *@
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="ma-2">
                @_error
            </MudAlert>
        }

        @* ═══ 结果列表（可选中）═══ *@
        <div style="min-height: 220px; max-height: 46vh; overflow-y: auto;" class="pa-2">
            @if (_searching)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
            }
            else if (VisibleResults.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    找到 <strong>@VisibleResults.Count</strong> 个宿主节点（查询：@_lastQuery）
                </MudText>

                @foreach (var item in VisibleResults)
                {
                    var isSelected = _selected is not null
                        && _selected.InodeId == item.InodeId
                        && _selected.HostType == item.HostType;
                    <MudPaper Elevation="@(isSelected ? 3 : 0)"
                              Class="@(isSelected ? "pa-2 mb-1 mud-theme-primary" : "pa-2 mb-1")"
                              Style="cursor: pointer;"
                              @onclick="@(() => Select(item))">
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@GetHostTypeIcon(item.HostType)" Size="Size.Small"/>
                                    <MudText Typo="Typo.body1">
                                        <strong>@(item.NodeName ?? item.InodeId)</strong>
                                    </MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (item.MatchKind == "Entity")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                 Variant="Variant.Filled">
                                            实体命中@(string.IsNullOrEmpty(item.EntityType) ? "" : $"：{item.EntityType}")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                                 Variant="Variant.Filled">
                                            节点命中
                                        </MudChip>
                                    }
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                             Variant="Variant.Outlined">
                                        @item.HostType
                                    </MudChip>
                                    @if (isSelected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Color="Color.Success" Size="Size.Small"/>
                                    }
                                </MudStack>
                            </MudStack>

                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                ID：@item.InodeId
                            </MudText>

                            @if (!string.IsNullOrEmpty(item.Path))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    路径：@item.Path
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(item.ParentName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    父节点：@item.ParentName
                                </MudText>
                            }

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">相似度：</MudText>
                                <MudProgressLinear Value="@((double)item.Score * 100)"
                                                   Color="@GetScoreColor(item.Score)"
                                                   Size="Size.Small"
                                                   Style="width: 100px; height: 6px;"/>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @item.Score.ToString("F4")
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
            else if (_searched)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-4">
                    未找到匹配的宿主节点
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-4">
                    输入关键词后点击「搜索」
                </MudText>
            }
        </div>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>限定宿主类型（如边类型的 ToNodeType）；为空则不限类型。</summary>
    [Parameter] public string? NodeType { get; set; }

    /// <summary>对话框标题。</summary>
    [Parameter] public string Title { get; set; } = "选择宿主节点";

    /// <summary>可选预填查询词。</summary>
    [Parameter] public string? InitialQuery { get; set; }

    private string _query = "";
    private int _topK = 5;
    /// <summary>最低相似度：低于该值的命中不返回（与服务端 SemanticSearch:MinScore 默认值一致）。</summary>
    private double _minScore = 0.5;
    private bool _searching;
    private bool _searched;
    private string? _error;
    private string _lastQuery = "";
    private List<SemanticSearchItemDto> _results = new();
    private SemanticSearchItemDto? _selected;

    private string DialogTitle =>
        string.IsNullOrEmpty(NodeType) ? $"{Title}｜语义搜索" : $"{Title}（{NodeType}）｜语义搜索";

    /// <summary>可见结果：宿主节点（排除未挂载树宿主的 TreeNode），并按 NodeType 限定。</summary>
    private List<SemanticSearchItemDto> VisibleResults =>
        _results.Where(IsHostNode).ToList();

    private bool IsHostNode(SemanticSearchItemDto item)
    {
        if (string.Equals(item.HostType, "TreeNode", StringComparison.Ordinal))
            return false;
        if (!string.IsNullOrEmpty(NodeType)
            && !string.Equals(item.HostType, NodeType, StringComparison.Ordinal))
            return false;
        return true;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(InitialQuery) && string.IsNullOrEmpty(_query))
        {
            _query = InitialQuery;
        }
    }

    private void Select(SemanticSearchItemDto item)
    {
        _selected = item;
        StateHasChanged();
    }

    private async Task DoSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _searching) return;

        _searching = true;
        _error = null;
        _selected = null;
        _results.Clear();
        _lastQuery = _query;
        StateHasChanged();

        try
        {
            var request = new SemanticSearchRequest
            {
                Query = _query,
                TopK = _topK,
                MinScore = (float)_minScore,
            };
            var response = await EavApi.SemanticSearchAsync(request);

            if (response is null)
            {
                _error = "搜索服务返回空响应";
            }
            else
            {
                _results = response.Items?.ToList() ?? new List<SemanticSearchItemDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "语义搜索失败");
            _error = $"搜索失败：{ex.Message}";
        }
        finally
        {
            _searching = false;
            _searched = true;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_searching)
        {
            await DoSearchAsync();
        }
    }

    private void Confirm()
    {
        if (_selected is null) return;

        MudDialog?.Close(DialogResult.Ok(
            new InodeSelection(_selected.InodeId, _selected.HostType, _selected.NodeName)));
    }

    private static string GetHostTypeIcon(string hostType) => hostType switch
    {
        "SpaceTree" => Icons.Material.Filled.Forest,
        "UnitTree" => Icons.Material.Filled.CorporateFare,
        "CategoryTree" => Icons.Material.Filled.Category,
        "TreeNode" => Icons.Material.Filled.AccountTree,
        _ => Icons.Material.Filled.HelpOutline
    };

    private static Color GetScoreColor(float score) => score switch
    {
        >= 0.7f => Color.Success,
        >= 0.5f => Color.Warning,
        _ => Color.Error
    };

    /// <summary>选择结果：宿主 inode（InodeId + HostType），NodeName 可能为 null。</summary>
    public sealed record InodeSelection(string InodeId, string HostType, string? NodeName);
}
