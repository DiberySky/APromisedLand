@* CompositeTypeFieldDialog.razor — 添加 / 编辑组合类型字段（DialogSky 外壳，与树节点对话框风格一致） *@
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="@(EditingField is null ? "添加字段" : "编辑字段")"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
               SubmitButtonDisabled="@_submitting"
               OnSubmitClick="SaveFieldAsync">
    <ToolBarContent>
        @* 静态内容：所属组合类型（ToolBarContent 不支持动态更新） *@
        @if (Type is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Info">
                @Type.DisplayName (@Type.TypeName)
            </MudText>
        }
    </ToolBarContent>
    <DialogContent>
        <MudTextField @bind-Value="_fieldForm.DisplayName"
                      Label="显示名"
                      Placeholder="界面上展示的中文名称"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <NamingTextField @bind-Value="_fieldForm.FieldName"
                         SourceText="@_fieldForm.DisplayName"
                         NameCase="snake"
                         Label="内部标识"
                         Placeholder="小写英文+下划线，如 street_name"
                         Disabled="@(EditingField is not null)"
                         Class="mb-3" />

        @* 数据类型行：参照 AttributeEditDialog 的 Grid 定比布局，
           int / decimal 时「单位」「小数精度」与数据类型合并到同一行 *@
        <div style="@DataTypeRowStyle" class="mb-3">
            <div>
                <MudSelect T="string"
                           Value="_fieldForm.DataType"
                           ValueChanged="OnFieldDataTypeChanged"
                           Label="数据类型"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="@(EditingField is not null)">
                    @foreach (var dt in DataTypeOptions)
                    {
                        <MudSelectItem T="string" Value="@dt.Value">@dt.Label</MudSelectItem>
                    }
                </MudSelect>
            </div>
            @if (_fieldForm.DataType == "decimal")
            {
                <div>
                    <NumberInputField T="int?"
                                      @bind-Value="_fieldForm.Precision"
                                      Label="小数精度（可选）"
                                      Min="0" Max="10" Step="1"
                                      Margin="Margin.Dense"
                                      HelperText="0–10 位，留空不限制" />
                </div>
            }
            @if (_fieldForm.DataType is "int" or "decimal")
            {
                <div>
                    <UnitTreeField @bind-UnitId="_fieldForm.UnitId"
                                   @bind-UnitName="_fieldForm.UnitName"
                                   Margin="Margin.Dense" />
                </div>
            }
        </div>

        @* single_choice 的选项集 *@
        @if (_fieldForm.DataType == "single_choice")
        {
            <MudSelect T="string"
                       Value="@(_fieldForm.RefOptionSetId ?? "")"
                       ValueChanged="@(v => _fieldForm.RefOptionSetId = string.IsNullOrEmpty(v) ? null : v)"
                       Label="选项集"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                <MudSelectItem T="string" Value="@("")">
                    （不绑定，仅用 AllowedValues）
                </MudSelectItem>
                @foreach (var os in OptionSets ?? (IReadOnlyList<OptionSetSummaryDto>)Array.Empty<OptionSetSummaryDto>())
                {
                    <MudSelectItem T="string" Value="@os.OptionSetId">
                        @os.DisplayName (@os.SetName)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                绑定选项集后，前端渲染为下拉并显示 Label；否则使用 AllowedValues。
            </MudText>
        }

        @* composite 类型的嵌套引用 *@
        @if (_fieldForm.DataType == "composite")
        {
            <MudSelect T="string"
                       Value="@(_fieldForm.RefCompositeTypeId ?? "")"
                       ValueChanged="@(v => _fieldForm.RefCompositeTypeId = string.IsNullOrEmpty(v) ? null : v)"
                       Label="嵌套组合类型"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                @foreach (var t in NestedTypes)
                {
                    <MudSelectItem T="string" Value="@t.CompositeTypeId">
                        @t.DisplayName (@t.TypeName)
                    </MudSelectItem>
                }
            </MudSelect>
        }

        <MudGrid Justify="Justify.Center" Class="mb-3">
            <MudItem xs="12" sm="3" Class="d-flex align-center justify-center">
                <MudSwitch T="bool"
                           @bind-Value="_fieldForm.IsArray"
                           Label="可多行"
                           Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center justify-center">
                <MudSwitch T="bool"
                           @bind-Value="_fieldForm.IsRequired"
                           Label="必填"
                           Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center justify-center">
                <MudSwitch T="bool"
                           @bind-Value="_fieldForm.IsSearchable"
                           Label="可搜索"
                           Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>所属组合类型。</summary>
    [Parameter] public CompositeTypeDetailDto? Type { get; set; }
    /// <summary>编辑目标；null 表示添加新字段。</summary>
    [Parameter] public CompositeFieldDetailDto? EditingField { get; set; }
    /// <summary>添加模式下的初始显示顺序（现有活动字段数 + 1）。</summary>
    [Parameter] public int InitialDisplayOrder { get; set; }
    /// <summary>选项集候选（single_choice 类型用）。</summary>
    [Parameter] public IReadOnlyList<OptionSetSummaryDto>? OptionSets { get; set; }
    /// <summary>嵌套组合类型候选（已排除自身与已删除类型）。</summary>
    [Parameter] public IEnumerable<CompositeTypeDetailDto> NestedTypes { get; set; } = Enumerable.Empty<CompositeTypeDetailDto>();

    private FieldForm _fieldForm = new();
    private bool _submitting;

    /// <summary>
    /// 数据类型行布局（与 AttributeEditDialog 一致）：
    /// decimal 三等分、int 两列（数据类型稍宽）、其它单列。
    /// 用 Grid + minmax(0, fr) 固定分配，避免宽度被控件固有内容撑开。
    /// </summary>
    private string DataTypeRowStyle => _fieldForm.DataType switch
    {
        "decimal" => "display:grid; gap:8px; align-items:start; "
                   + "grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);",
        "int" => "display:grid; gap:8px; align-items:start; "
               + "grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);",
        _ => "display:grid; gap:8px; align-items:start; grid-template-columns:minmax(0,1fr);"
    };

    private static readonly (string Value, string Label)[] DataTypeOptions =
    {
        ("string",   "字符串"),
        ("int",      "整数"),
        ("decimal",  "小数"),
        ("bool",     "布尔"),
        ("datetime", "日期时间"),
        ("date",     "日期"),
        ("time",     "时间"),
        ("single_choice", "单选"),
        ("composite", "嵌套组合"),
        ("json",     "JSON")
    };

    protected override void OnParametersSet()
    {
        _fieldForm = EditingField is null
            ? new FieldForm
            {
                // ★ 只统计活动字段的显示顺序
                DisplayOrder = InitialDisplayOrder,
                IsSearchable = true
            }
            : new FieldForm
            {
                FieldName = EditingField.FieldName,
                DisplayName = EditingField.DisplayName,
                DataType = EditingField.DataType,
                RefCompositeTypeId = EditingField.RefCompositeTypeId,
                UnitId = EditingField.UnitId,
                UnitName = FormatUnitName(EditingField.UnitName, EditingField.UnitAbbreviation),
                RefOptionSetId = EditingField.RefOptionSetId,
                IsArray = EditingField.IsArray,
                IsRequired = EditingField.IsRequired,
                IsSearchable = EditingField.IsSearchable,
                IsSortable = EditingField.IsSortable,
                DisplayOrder = EditingField.DisplayOrder,
                Precision = ExtractPrecision(EditingField.ValidationRule)
            };
    }

    /// <summary>
    /// 切换类型时清空不适用的引用。
    ///   - int / decimal 保留 UnitId，清空 RefOptionSetId / RefCompositeTypeId
    ///   - single_choice 保留 RefOptionSetId，清空 UnitId / RefCompositeTypeId
    ///   - composite 保留 RefCompositeTypeId，清空 UnitId / RefOptionSetId
    ///   - 其它类型全部清空
    /// </summary>
    private void OnFieldDataTypeChanged(string dt)
    {
        _fieldForm.DataType = dt;

        if (dt != "int" && dt != "decimal") { _fieldForm.UnitId = null; _fieldForm.UnitName = null; }
        if (dt != "decimal") _fieldForm.Precision = null;
        if (dt != "single_choice") _fieldForm.RefOptionSetId = null;
        if (dt != "composite") _fieldForm.RefCompositeTypeId = null;
    }

    private async Task SaveFieldAsync()
    {
        if (Type is null) return;

        if (string.IsNullOrWhiteSpace(_fieldForm.FieldName) ||
            string.IsNullOrWhiteSpace(_fieldForm.DisplayName))
        {
            Snackbar.Add("请填写字段名和显示名", Severity.Warning);
            return;
        }

        if (_fieldForm.DataType == "composite" &&
            _fieldForm.RefCompositeTypeId is null)
        {
            Snackbar.Add("组合类型字段必须指定嵌套类型", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            if (EditingField is null)
            {
                var id = await Api.AddCompositeFieldAsync(
                    Type.CompositeTypeId,
                    new CreateCompositeFieldRequest
                    {
                        FieldName = _fieldForm.FieldName,
                        DisplayName = _fieldForm.DisplayName,
                        DataType = _fieldForm.DataType,
                        RefCompositeTypeId = _fieldForm.RefCompositeTypeId,
                        UnitId = _fieldForm.UnitId,
                        RefOptionSetId = _fieldForm.RefOptionSetId,
                        IsArray = _fieldForm.IsArray,
                        IsRequired = _fieldForm.IsRequired,
                        IsSearchable = _fieldForm.IsSearchable,
                        IsSortable = _fieldForm.IsSortable,
                        DisplayOrder = _fieldForm.DisplayOrder,
                        // decimal 精度 → ValidationRule.precision
                        ValidationRule = _fieldForm.Precision is int p
                            ? System.Text.Json.JsonSerializer.SerializeToElement(new { precision = p })
                            : null
                    });

                if (id is null)
                {
                    Snackbar.Add("添加失败", Severity.Error);
                    return;
                }
                Snackbar.Add($"添加成功：Id={id}", Severity.Success);
            }
            else
            {
                // diff 计算 ClearRefOptionSetId / ClearUnitId
                var (optId, clearOpt) = Diff(
                    _fieldForm.RefOptionSetId, EditingField.RefOptionSetId);
                var (unitId, clearUnit) = Diff(
                    _fieldForm.UnitId, EditingField.UnitId);

                var (ok, error) = await Api.UpdateCompositeFieldAsync(
                    Type.CompositeTypeId,
                    EditingField.FieldId,
                    new UpdateCompositeFieldRequest
                    {
                        DisplayName = _fieldForm.DisplayName,
                        IsRequired = _fieldForm.IsRequired,
                        IsSearchable = _fieldForm.IsSearchable,
                        IsSortable = _fieldForm.IsSortable,
                        DisplayOrder = _fieldForm.DisplayOrder,

                        RefOptionSetId = optId,
                        ClearRefOptionSetId = clearOpt,

                        UnitId = unitId,
                        ClearUnitId = clearUnit,

                        // 合并 ValidationRule：保留既有规则键，仅增删 precision
                        ValidationRule = MergeValidationRule(
                            EditingField.ValidationRule, _fieldForm.Precision)
                    });

                if (!ok)
                {
                    Snackbar.Add($"更新失败：{error ?? "未知错误"}", Severity.Error);
                    return;
                }
                Snackbar.Add("更新成功", Severity.Success);
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>计算 diff：返回 (要设置的值, 是否清除)。</summary>
    private static (long? Value, bool Clear) Diff(long? current, long? original)
    {
        if (current is null && original is not null) return (null, true);
        if (current is not null && current != original) return (current, false);
        return (null, false);
    }

    private static string? FormatUnitName(string? name, string? abbreviation)
        => name is null ? null
            : string.IsNullOrEmpty(abbreviation) ? name
            : $"{name} 【{abbreviation}】";

    /// <summary>从既有 ValidationRule 解析 precision；缺失/非法返回 null。</summary>
    private static int? ExtractPrecision(System.Text.Json.JsonElement? rule)
        => rule is { ValueKind: System.Text.Json.JsonValueKind.Object } obj
            && obj.TryGetProperty("precision", out var p)
            && p.TryGetInt32(out var n)
            ? n : null;

    /// <summary>
    /// 合并 ValidationRule：保留既有规则键，仅写入/移除 precision。
    /// 置空精度且原规则无其他键时返回 null（清空整个规则对象）。
    /// </summary>
    private static System.Text.Json.JsonElement? MergeValidationRule(
        System.Text.Json.JsonElement? original, int? precision)
    {
        var hasPrecision = precision is int p && p >= 0;
        if (original is not { ValueKind: System.Text.Json.JsonValueKind.Object } obj)
        {
            return hasPrecision
                ? System.Text.Json.JsonSerializer.SerializeToElement(
                    new { precision = precision })
                : null;
        }

        var dict = new Dictionary<string, System.Text.Json.JsonElement>();
        foreach (var prop in obj.EnumerateObject())
            dict[prop.Name] = prop.Value.Clone();

        if (hasPrecision)
            dict["precision"] = System.Text.Json.JsonSerializer.SerializeToElement(precision);
        else if (!dict.Remove("precision"))
            return null;

        return System.Text.Json.JsonSerializer.SerializeToElement(dict);
    }

    /// <summary>string 版 diff（ID 字符串化后用）。</summary>
    private static (string? Value, bool Clear) Diff(string? current, string? original)
    {
        if (current is null && original is not null) return (null, true);
        if (current is not null && current != original) return (current, false);
        return (null, false);
    }

    private class FieldForm
    {
        public string FieldName { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string DataType { get; set; } = "string";
        public string? RefCompositeTypeId { get; set; }
        public string? UnitId { get; set; }
        public string? UnitName { get; set; }
        public string? RefOptionSetId { get; set; }
        public bool IsArray { get; set; }
        public bool IsRequired { get; set; }
        public bool IsSearchable { get; set; }
        public bool IsSortable { get; set; }
        public int DisplayOrder { get; set; }
        public int? Precision { get; set; }  // decimal 精度 → ValidationRule.precision
    }
}
