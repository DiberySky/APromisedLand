@* CustomTableCreateDialog.razor — 新建自定义表（DialogSky 外壳，与树节点对话框风格一致） *@
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="新建自定义表"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
               SubmitButtonDisabled="@_submitting"
               OnSubmitClick="CreateAsync">
    <DialogContent>
        <div Class="d-flex align-center mb-3">
            <MudSelect T="string"
                       Value="_newTable.EntityType"
                       ValueChanged="OnEntityTypeChanged"
                       Label="实体类型"
                       Variant="Variant.Outlined"
                       Class="flex-grow-1"
                       HelperText="选择该自定义表归属的实体类型"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft">
                @foreach (var et in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@et.EntityType">
                        @(string.IsNullOrWhiteSpace(et.DisplayName) ? et.EntityType : $"{et.DisplayName}（{et.EntityType}）")
                    </MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (_entityTypes.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                暂无实体类型，请先到「实体类型管理」创建。
            </MudAlert>
        }

        <MudTextField @bind-Value="_newTable.DisplayName"
                      Label="显示名"
                      Placeholder="规格参数"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <NamingTextField @bind-Value="_newTable.TableName"
                         SourceText="@_newTable.DisplayName"
                         NameCase="snake"
                         Label="内部标识"
                         Placeholder="specs"
                         Class="mb-3" />
        <NumberInputField T="int"
                          @bind-Value="_newTable.DisplayOrder"
                          Label="显示顺序"
                          Class="mb-3" />

        @* 时序记录表：创建时服务端预置时间维度列（第 1 列日期、可选第 2 列时间），此后锁定 *@
        <MudSwitch T="bool"
                   @bind-Value="_newTable.IsRecordTable"
                   Color="Color.Primary"
                   Class="mb-2">
            时序记录
        </MudSwitch>
        @if (_newTable.IsRecordTable)
        {
            <MudSwitch T="bool"
                       @bind-Value="_newTable.HasTimeColumn"
                       Color="Color.Primary"
                       Class="mb-2">
                包含时间列
            </MudSwitch>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                自动预置：第 1 列「日期」@(_newTable.HasTimeColumn ? "、第 2 列「时间」" : "")。
                时序结构创建后定死——这两列不可删除、不可调顺序，业务列可自由增删改；
                引用该表的属性自动为时序记录（行列表不显示序号）。
            </MudAlert>
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private CreateCustomTableRequest _newTable = new();
    private bool _submitting;
    private IReadOnlyList<EntityTypeSummaryDto> _entityTypes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entityTypes = (await Api.ListEntityTypesAsync()) ?? [];
            // 归属不再区分全局共享：默认选第一个实体类型
            if (string.IsNullOrWhiteSpace(_newTable.EntityType))
            {
                _newTable.EntityType = _entityTypes.FirstOrDefault()?.EntityType ?? "";
            }
        }
        catch
        {
            _entityTypes = [];
        }
    }

    private Task OnEntityTypeChanged(string? value)
    {
        _newTable.EntityType = value ?? "";
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTable.EntityType) ||
            string.IsNullOrWhiteSpace(_newTable.TableName) ||
            string.IsNullOrWhiteSpace(_newTable.DisplayName))
        {
            Snackbar.Add("请填写所有字段", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var id = await Api.CreateCustomTableAsync(_newTable);
            if (id is null)
            {
                Snackbar.Add("创建失败", Severity.Error);
                return;
            }

            Snackbar.Add($"创建成功：Id={id}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }
}
