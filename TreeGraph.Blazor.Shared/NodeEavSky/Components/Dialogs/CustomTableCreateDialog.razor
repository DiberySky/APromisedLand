@* CustomTableCreateDialog.razor — 新建自定义表（DialogSky 外壳，与树节点对话框风格一致） *@
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="新建自定义表"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
               SubmitButtonDisabled="@_submitting"
               OnSubmitClick="CreateAsync">
    <DialogContent>
        @* 显示名与时序记录同一行：Grid 两列，开关垂直居中 *@
        <div style="display:grid; gap:8px; align-items:center; grid-template-columns:minmax(0,1fr) auto;" class="mb-3">
            <div>
                <MudTextField @bind-Value="_newTable.DisplayName"
                              Label="显示名"
                              Placeholder="请输入中文"
                              Variant="Variant.Outlined" />
            </div>
            <div>
                @* 时序记录表：创建时服务端预置时间维度列（第 1 列日期、可选第 2 列时间），此后锁定 *@
                <MudSwitch T="bool"
                           @bind-Value="_newTable.IsRecordTable"
                           Color="Color.Primary">
                    时序记录
                </MudSwitch>
            </div>
        </div>
        <NamingTextField @bind-Value="_newTable.TableName"
                         SourceText="@_newTable.DisplayName"
                         NameCase="snake"
                         Label="内部标识"
                         Placeholder="使用下划线分隔的小写英文单词"
                         Class="mb-3" />

        @if (_newTable.IsRecordTable)
        {
            <MudSwitch T="bool"
                       @bind-Value="_newTable.HasTimeColumn"
                       Color="Color.Primary"
                       Class="mb-2">
                包含时间列
            </MudSwitch>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                自动预置：第 1 列「日期」@(_newTable.HasTimeColumn ? "、第 2 列「时间」" : "")。
                时序结构创建后定死——这两列不可删除、不可调顺序，业务列可自由增删改；
                引用该表的属性自动为时序记录（行列表不显示序号）。
            </MudAlert>
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private CreateCustomTableRequest _newTable = new();
    private bool _submitting;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTable.TableName) ||
            string.IsNullOrWhiteSpace(_newTable.DisplayName))
        {
            Snackbar.Add("请填写所有字段", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var id = await Api.CreateCustomTableAsync(_newTable);
            if (id is null)
            {
                Snackbar.Add("创建失败", Severity.Error);
                return;
            }

            Snackbar.Add($"创建成功：Id={id}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }
}
