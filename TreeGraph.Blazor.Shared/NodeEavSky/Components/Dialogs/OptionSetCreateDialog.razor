@* OptionSetCreateDialog.razor — 新建选项集（DialogSky 外壳，与新建组合类型一致） *@
@using TreeGraph.Shared.NodeEavSky.Dtos
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="新建选项集"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
               SubmitButtonDisabled="@_submitting"
               ActionsMaxWidth="MaxWidth.False"
               OnSubmitClick="CreateAsync">
    <DialogContent>
        <MudTextField @bind-Value="_newSet.DisplayName"
                      Label="显示名"
                      Placeholder="请输入中文"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <NamingTextField @bind-Value="_newSet.SetName"
                         SourceText="@_newSet.DisplayName"
                         NameCase="snake"
                         Label="内部标识"
                         Placeholder="使用下划线分隔的小写英文单词" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private CreateOptionSetRequest _newSet = new();
    private bool _submitting;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSet.SetName) ||
            string.IsNullOrWhiteSpace(_newSet.DisplayName))
        {
            Snackbar.Add("请填写所有字段", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var id = await Api.CreateOptionSetAsync(_newSet);
            if (id is null)
            {
                Snackbar.Add("创建失败", Severity.Error);
                return;
            }
            Snackbar.Add($"创建成功：Id={id}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }
}
