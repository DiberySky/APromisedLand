@* AttributeEditDialog.razor — 编辑属性（DialogSky 外壳，与树节点对话框风格一致） *@
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="编辑属性"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
           SubmitButtonDisabled="@_submitting"
           ActionsMaxWidth="MaxWidth.False"
           OnSubmitClick="UpdateAsync">
    @* 与「新建属性」一致：属性定义固定展示在标题栏下方工具栏（编辑期间不变） *@
    <ToolBarContent>
        <MudText Typo="Typo.body2">属性定义：@EntityTypeDisplay</MudText>
    </ToolBarContent>
    <DialogContent>
        <MudTextField @bind-Value="_editForm.DisplayName"
                      Label="显示名"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      HelperText="用户在界面上看到的名字" />

        @* 内部标识：创建后不可修改，只读展示完整值 *@
        <MudTextField Value="@Attribute?.AttributeName"
                      Label="内部标识"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      ReadOnly="true"
                      Class="mt-3"
                      HelperText="系统内部标识，不可修改" />

        @* 数据类型行：显式 Grid 定比分配（每个控件独立一层，避免 MudBlazor 内部结构干扰宽度） *@
        <div style="@DataTypeRowStyle" class="mt-3 mb-3">
            <div>
                <MudTextField Value="@DataTypeLabel"
                              Label="数据类型"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ReadOnly="true" />
            </div>
            @if (Attribute?.DataType == "decimal")
            {
                <div>
                    <NumberInputField T="int?"
                                      @bind-Value="_editForm.Precision"
                                      Label="小数精度（可选）"
                                      Min="0" Max="10" Step="1"
                                      Margin="Margin.Dense" />
                </div>
            }
            @if (Attribute?.DataType is "decimal" or "int")
            {
                <div>
                    <UnitTreeField @bind-UnitId="_editForm.UnitId"
                                   @bind-UnitName="_editForm.UnitName"
                                   Margin="Margin.Dense" />
                </div>
            }
        </div>

        @if (Attribute?.DataType == "composite")
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudSelect T="string"
                           Value="@(_editForm.RefCompositeTypeId ?? "")"
                           ValueChanged="@(v => _editForm.RefCompositeTypeId = string.IsNullOrEmpty(v) ? null : v)"
                           Label="组合类型"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="flex: 1;">
                    @foreach (var t in _compositeTypes)
                    {
                        <MudSelectItem T="string" Value="@t.CompositeTypeId">
                            @t.DisplayName (@t.TypeName)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               title="管理组合类型"
                               OnClick="OpenCompositeTypeManageAsync" />
            </div>
            @if (_compositeTypes.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    暂无组合类型，可点击右侧齿轮按钮直接创建。
                </MudAlert>
            }
        }

        @if (Attribute?.DataType == "table")
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudSelect T="string"
                           Value="@(_editForm.RefTableDefinitionId ?? "")"
                           ValueChanged="@(v => _editForm.RefTableDefinitionId = string.IsNullOrEmpty(v) ? null : v)"
                           Label="自定义表"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="flex: 1;">
                    @foreach (var t in _customTables)
                    {
                        <MudSelectItem T="string" Value="@t.TableDefinitionId">
                            @t.DisplayName (@t.TableName)@(t.IsRecordTable ? "（时序）" : "")
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               title="管理自定义表"
                               OnClick="OpenCustomTableManageAsync" />
            </div>
            @if (_customTables.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    暂无自定义表，可点击右侧齿轮按钮直接创建。
                </MudAlert>
            }
            <MudSwitch T="bool"
                       Value="_editForm.IsRecordMode"
                       Color="Color.Primary"
                       Class="mb-2"
                       Disabled="true">
                时序记录
            </MudSwitch>
            @if (_editForm.IsRecordMode)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    当前引用的是时序记录表：行列表不显示序号，时间维度列已锁定，
                    业务列可自由增删改；改绑普通表后该属性不再是时序记录。
                </MudAlert>
            }
        }

        @if (Attribute?.DataType == "single_choice")
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudSelect T="string"
                           Value="@(_editForm.RefOptionSetId ?? "")"
                           ValueChanged="@(v => _editForm.RefOptionSetId = string.IsNullOrEmpty(v) ? null : v)"
                           Label="选项集"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="flex: 1;">
                    @foreach (var s in _optionSets)
                    {
                        <MudSelectItem T="string" Value="@s.OptionSetId">
                            @s.DisplayName (@s.SetName)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               title="管理选项集"
                               OnClick="OpenOptionSetManageAsync" />
            </div>
            @if (_optionSets.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    暂无选项集，可点击右侧齿轮按钮直接创建。
                </MudAlert>
            }
        }

        <div class="d-flex justify-center gap-4 flex-wrap">
            <MudSwitch T="bool" @bind-Value="_editForm.IsRequired"
                       Label="必填" Color="Color.Primary" />
            <MudSwitch T="bool" @bind-Value="_editForm.IsSearchable"
                       Label="可搜索" Color="Color.Primary" />
        </div>

        @* 单选：选中选项集后底部内嵌选项编辑面板 *@
        @if (Attribute?.DataType == "single_choice")
        {
            <OptionSetItemsPanel @ref="_itemsPanel" Set="@_selectedOptionSet" />
        }

        @* 组合类型：选中后底部内嵌字段编辑面板 *@
        @if (Attribute?.DataType == "composite")
        {
            <CompositeTypeFieldsPanel @ref="_fieldsPanel"
                                      CompositeTypeId="@_editForm.RefCompositeTypeId" />
        }

        @* 自定义表：选中后底部内嵌列编辑面板 *@
        @if (Attribute?.DataType == "table")
        {
            <CustomTableColumnsPanel @ref="_columnsPanel"
                                     TableId="@_editForm.RefTableDefinitionId" />
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>编辑目标（页面已通过 GetAttributeAsync 取详情）。</summary>
    [Parameter] public AttributeDetailDto? Attribute { get; set; }
    /// <summary>属性定义列表（用于工具栏展示中文显示名，缺失时回退内部标识）。</summary>
    [Parameter] public IReadOnlyList<EntityTypeSummaryDto>? EntityTypes { get; set; }
    [Parameter] public IReadOnlyList<CompositeTypeDetailDto>? CompositeTypes { get; set; }
    [Parameter] public IReadOnlyList<CustomTableDetailDto>? CustomTables { get; set; }
    [Parameter] public IReadOnlyList<OptionSetSummaryDto>? OptionSets { get; set; }

    private UpdateAttributeForm _editForm = new();
    private bool _submitting;

    /// <summary>选项集本地副本（参数不回流：管理对话框关闭后重新拉取刷新）。</summary>
    private IReadOnlyList<OptionSetSummaryDto> _optionSets = new List<OptionSetSummaryDto>();

    /// <summary>组合类型本地副本。</summary>
    private IReadOnlyList<CompositeTypeDetailDto> _compositeTypes = new List<CompositeTypeDetailDto>();

    /// <summary>自定义表本地副本。</summary>
    private IReadOnlyList<CustomTableDetailDto> _customTables = new List<CustomTableDetailDto>();

    /// <summary>底部选项编辑面板引用（齿轮管理回来后强制刷新）。</summary>
    private OptionSetItemsPanel? _itemsPanel;

    /// <summary>底部组合字段面板引用。</summary>
    private CompositeTypeFieldsPanel? _fieldsPanel;

    /// <summary>底部表列面板引用。</summary>
    private CustomTableColumnsPanel? _columnsPanel;

    /// <summary>当前选中的选项集（未选择/已删除时为 null，面板不渲染）。</summary>
    private OptionSetSummaryDto? _selectedOptionSet
        => _optionSets.FirstOrDefault(s => s.OptionSetId == _editForm.RefOptionSetId);

    /// <summary>数据类型中文标签（只读展示）。</summary>
    private string DataTypeLabel
        => Attribute is null ? "" : EavDataTypeLabels.GetLabel(Attribute.DataType);

    /// <summary>
    /// 数据类型行布局：decimal 三等分、int 两列（数据类型稍宽）、其它单列。
    /// 用 Grid + minmax(0, fr) 固定分配，避免宽度被控件固有内容撑开。
    /// </summary>
    private string DataTypeRowStyle => Attribute?.DataType switch
    {
        "decimal" => "display:grid; gap:8px; align-items:start; "
                   + "grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);",
        "int" => "display:grid; gap:8px; align-items:start; "
               + "grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);",
        _ => "display:grid; gap:8px; align-items:start; grid-template-columns:minmax(0,1fr);"
    };

    /// <summary>属性定义展示名（优先中文显示名，缺失回退内部标识）。</summary>
    private string EntityTypeDisplay
    {
        get
        {
            var entityType = Attribute?.EntityType;
            var match = (EntityTypes ?? Array.Empty<EntityTypeSummaryDto>())
                .FirstOrDefault(et => et.EntityType == entityType);
            if (!string.IsNullOrWhiteSpace(match?.DisplayName))
            {
                return match.DisplayName;
            }

            return entityType ?? string.Empty;
        }
    }

    protected override void OnParametersSet()
    {
        _optionSets = OptionSets ?? new List<OptionSetSummaryDto>();
        _compositeTypes = CompositeTypes ?? new List<CompositeTypeDetailDto>();
        _customTables = CustomTables ?? new List<CustomTableDetailDto>();

        if (Attribute is not null)
        {
            _editForm = new UpdateAttributeForm
            {
                DisplayName = Attribute.DisplayName,
                IsRequired = Attribute.IsRequired,
                IsSearchable = Attribute.IsSearchable,
                IsSortable = Attribute.IsSortable,
                DisplayOrder = Attribute.DisplayOrder,
                UnitId = Attribute.UnitId,
                UnitName = FormatUnitName(Attribute.UnitName, Attribute.UnitAbbreviation),
                RefCompositeTypeId = Attribute.RefCompositeTypeId,
                RefTableDefinitionId = Attribute.RefTableDefinitionId,
                IsRecordMode = Attribute.IsRecordMode,
                RefOptionSetId = Attribute.RefOptionSetId,
                // 从既有 ValidationRule 解析 decimal 精度
                Precision = ExtractPrecision(Attribute.ValidationRule)
            };
        }
    }

    private async Task UpdateAsync()
    {
        if (Attribute is null) return;

        var (unitId, clearUnit) = Diff(_editForm.UnitId, Attribute.UnitId);
        var (ctId, clearCt) = Diff(_editForm.RefCompositeTypeId, Attribute.RefCompositeTypeId);
        var (tblId, clearTbl) = Diff(_editForm.RefTableDefinitionId, Attribute.RefTableDefinitionId);
        var (optId, clearOpt) = Diff(_editForm.RefOptionSetId, Attribute.RefOptionSetId);

        // 合并 ValidationRule：保留既有规则键，仅增删 precision（避免覆盖其他规则）
        var rule = MergeValidationRule(Attribute.ValidationRule, _editForm.Precision);

        _submitting = true;
        try
        {
            var (ok, error) = await Api.UpdateAttributeAsync(
                Attribute.AttributeId,
                new UpdateAttributeRequest
                {
                    DisplayName = _editForm.DisplayName,
                    IsRequired = _editForm.IsRequired,
                    IsSearchable = _editForm.IsSearchable,
                    IsSortable = _editForm.IsSortable,
                    DisplayOrder = _editForm.DisplayOrder,
                    ValidationRule = rule,

                    UnitId = unitId,
                    ClearUnitId = clearUnit,

                    RefCompositeTypeId = ctId,
                    ClearRefCompositeTypeId = clearCt,

                    RefTableDefinitionId = tblId,
                    ClearRefTableDefinitionId = clearTbl,

                    RefOptionSetId = optId,
                    ClearRefOptionSetId = clearOpt
                });

            if (!ok)
            {
                Snackbar.Add($"更新失败：{error ?? "未知错误"}", Severity.Error);
                return;
            }

            Snackbar.Add("更新成功", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>打开选项集管理对话框；关闭后刷新本地选项集列表与底部选项面板。</summary>
    private async Task OpenOptionSetManageAsync()
    {
        var dialog = await DialogService.ShowAsync<OptionSetManageDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;
        _optionSets = await Api.ListOptionSetsAsync() ?? new List<OptionSetSummaryDto>();

        // 面板内选项可能被增删，强制重载（同 Id 时 OnParametersSetAsync 不会触发）
        if (_itemsPanel is not null)
            await _itemsPanel.ReloadAsync();
    }

    /// <summary>打开组合类型管理对话框；关闭后刷新本地列表与底部字段面板。</summary>
    private async Task OpenCompositeTypeManageAsync()
    {
        var dialog = await DialogService.ShowAsync<CompositeTypeManageDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;
        _compositeTypes = await Api.ListCompositeTypesAsync() ?? new List<CompositeTypeDetailDto>();

        if (_fieldsPanel is not null)
            await _fieldsPanel.ReloadAsync();
    }

    /// <summary>打开自定义表管理对话框；关闭后刷新本地列表与底部列面板。</summary>
    private async Task OpenCustomTableManageAsync()
    {
        var dialog = await DialogService.ShowAsync<CustomTableManageDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;
        _customTables = await Api.ListCustomTablesAsync() ?? new List<CustomTableDetailDto>();

        if (_columnsPanel is not null)
            await _columnsPanel.ReloadAsync();
    }

    private static (string? Value, bool Clear) Diff(string? current, string? original)
    {
        if (current is null && original is not null) return (null, true);
        if (current is not null && current != original) return (current, false);
        return (null, false);
    }

    /// <summary>从既有 ValidationRule 解析 precision；缺失/非法返回 null。</summary>
    private static int? ExtractPrecision(System.Text.Json.JsonElement? rule)
        => rule is { ValueKind: System.Text.Json.JsonValueKind.Object } obj
            && obj.TryGetProperty("precision", out var p)
            && p.TryGetInt32(out var n)
            ? n : null;

    /// <summary>
    /// 合并 ValidationRule：保留既有规则键，仅写入/移除 precision。
    /// 置空精度且原规则无其他键时返回 null（清空整个规则对象）。
    /// </summary>
    private static System.Text.Json.JsonElement? MergeValidationRule(
        System.Text.Json.JsonElement? original, int? precision)
    {
        var hasPrecision = precision is int p && p >= 0;
        if (original is not { ValueKind: System.Text.Json.JsonValueKind.Object } obj)
        {
            return hasPrecision
                ? System.Text.Json.JsonSerializer.SerializeToElement(
                    new { precision = precision })
                : null;
        }

        var dict = new Dictionary<string, System.Text.Json.JsonElement>();
        foreach (var prop in obj.EnumerateObject())
            dict[prop.Name] = prop.Value.Clone();

        if (hasPrecision)
            dict["precision"] = System.Text.Json.JsonSerializer.SerializeToElement(precision);
        else if (!dict.Remove("precision"))
            return null; // 原本就没有 precision，也无新增 → 不发送规则

        return System.Text.Json.JsonSerializer.SerializeToElement(dict);
    }

    private static string? FormatUnitName(string? name, string? abbreviation)
        => name is null ? null
            : string.IsNullOrEmpty(abbreviation) ? name
            : $"{name} 【{abbreviation}】";

    private class UpdateAttributeForm
    {
        public string DisplayName { get; set; } = "";
        public bool IsRequired { get; set; }
        public bool IsSearchable { get; set; }
        public bool IsSortable { get; set; }
        public int DisplayOrder { get; set; }
        public string? UnitId { get; set; }
        public string? UnitName { get; set; }
        /// <summary>decimal 小数精度（0–10，null 不限制）→ ValidationRule.precision</summary>
        public int? Precision { get; set; }
        public string? RefCompositeTypeId { get; set; }
        public string? RefTableDefinitionId { get; set; }
        /// <summary>时序记录模式（仅 table）。</summary>
        public bool IsRecordMode { get; set; }
        public string? RefOptionSetId { get; set; }
    }
}
