@* CompositeTypeCreateDialog.razor — 新建组合类型（DialogSky 外壳，与树节点对话框风格一致） *@
@using TreeGraph.Shared.NodeEavSky.Dtos
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="新建组合类型"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
               SubmitButtonDisabled="@_submitting"
               ActionsMaxWidth="MaxWidth.False"
               OnSubmitClick="CreateAsync">
    <DialogContent>
        <div Class="d-flex align-center mb-3">
            <MudSelect T="string"
                       Value="_newType.EntityType"
                       ValueChanged="OnEntityTypeChanged"
                       Label="实体类型"
                       Variant="Variant.Outlined"
                       Class="flex-grow-1"
                       HelperText="选择该组合类型归属的实体类型"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft">
                @foreach (var et in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@et.EntityType">
                        @(string.IsNullOrWhiteSpace(et.DisplayName) ? et.EntityType : $"{et.DisplayName}（{et.EntityType}）")
                    </MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (_entityTypes.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                暂无实体类型，请先到「实体类型管理」创建。
            </MudAlert>
        }

        <MudTextField @bind-Value="_newType.DisplayName"
                      Label="显示名"
                      Placeholder="中文名称"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <NamingTextField @bind-Value="_newType.TypeName"
                         SourceText="@_newType.DisplayName"
                         NameCase="pascal"
                         Label="内部标识"
                         Placeholder="意义接近的英文名称，如 Address" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private CreateCompositeTypeRequest _newType = new();
    private bool _submitting;
    private IReadOnlyList<EntityTypeSummaryDto> _entityTypes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entityTypes = (await Api.ListEntityTypesAsync()) ?? [];
            // 归属不再区分全局共享：默认选第一个实体类型
            if (string.IsNullOrWhiteSpace(_newType.EntityType))
            {
                _newType.EntityType = _entityTypes.FirstOrDefault()?.EntityType ?? "";
            }
        }
        catch
        {
            _entityTypes = [];
        }
    }

    private Task OnEntityTypeChanged(string? value)
    {
        _newType.EntityType = value ?? "";
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newType.EntityType) ||
            string.IsNullOrWhiteSpace(_newType.TypeName) ||
            string.IsNullOrWhiteSpace(_newType.DisplayName))
        {
            Snackbar.Add("请填写所有字段", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var id = await Api.CreateCompositeTypeAsync(_newType);
            if (id is null)
            {
                Snackbar.Add("创建失败", Severity.Error);
                return;
            }

            Snackbar.Add($"创建成功：Id={id}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }
}
