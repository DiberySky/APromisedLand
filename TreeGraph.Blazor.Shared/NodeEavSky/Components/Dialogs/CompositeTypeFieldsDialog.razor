@* CompositeTypeFieldsDialog.razor — 单一组合类型的字段定义管理对话框 *@
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs

@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Blazor.Shared.NodeEavSky
@using TreeGraph.Shared.NodeEavSky.Dtos

@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="字段定义"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭"
           OnCanceledClick="@Close">
    <ToolBarContent>
        <MudText Typo="Typo.body2">组合类型：@Type.DisplayName (@Type.TypeName)</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@OpenAddFieldAsync">
            添加字段
        </MudButton>
    </ToolBarContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_fields.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">该组合类型暂无字段</MudAlert>
        }
        else
        {
            <MudTable Items="_fields" Dense="true" Bordered="true" Hover="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>字段名</MudTh>
                    <MudTh>显示名</MudTh>
                    <MudTh>类型</MudTh>
                    <MudTh>引用</MudTh>
                    <MudTh>数组</MudTh>
                    <MudTh>必填</MudTh>
                    <MudTh>可搜索</MudTh>
                    <MudTh>可排序</MudTh>
                    <MudTh>顺序</MudTh>
                    <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="字段名"><code>@context.FieldName</code></MudTd>
                    <MudTd DataLabel="显示名">@context.DisplayName</MudTd>
                    <MudTd DataLabel="类型">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@GetDataTypeColor(context.DataType)">
                            @EavDataTypeLabels.GetLabel(context.DataType)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="引用">
                        @if (context.UnitId is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="mr-1">单位</MudChip>
                        }
                        @if (context.RefOptionSetId is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mr-1">选项: @context.OptionSetName</MudChip>
                        }
                        @if (context.RefCompositeTypeId is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark">嵌套: @GetNestedTypeName(context.RefCompositeTypeId!)</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="数组">
                        @if (context.IsArray)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                    <MudTd DataLabel="必填">
                        @if (context.IsRequired)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                    <MudTd DataLabel="可搜索">
                        @if (context.IsSearchable)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                    <MudTd DataLabel="可排序">
                        @if (context.IsSortable)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                    <MudTd DataLabel="顺序">@context.DisplayOrder</MudTd>
                    <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditFieldAsync(context))"
                                       title="编辑" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteFieldAsync(context))"
                                       title="删除" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>锁定的组合类型。</summary>
    [Parameter, EditorRequired] public CompositeTypeDetailDto Type { get; set; } = default!;

    /// <summary>选项集（供字段对话框下拉）。</summary>
    [Parameter] public IReadOnlyList<OptionSetSummaryDto>? OptionSets { get; set; }

    /// <summary>可作嵌套引用的组合类型（已排除当前 Type 与已删除）。</summary>
    [Parameter] public IReadOnlyList<CompositeTypeDetailDto>? NestedTypes { get; set; }

    /// <summary>字段变更回调（父级刷新徽标计数）。</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<CompositeFieldDetailDto> _fields = [];
    private bool _loading;

    private static readonly DialogOptions FieldDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override void OnInitialized()
    {
        _fields = Type.Fields
            .Where(f => !f.IsDeleted)
            .OrderBy(f => f.DisplayOrder)
            .ToList();
    }

    private async Task ReloadFieldsAsync()
    {
        _loading = true;
        try
        {
            var fresh = await Api.GetCompositeTypeAsync(Type.CompositeTypeId);
            if (fresh is not null)
            {
                _fields = fresh.Fields
                    .Where(f => !f.IsDeleted)
                    .OrderBy(f => f.DisplayOrder)
                    .ToList();
            }
        }
        finally
        {
            _loading = false;
        }

        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private async Task OpenAddFieldAsync()
    {
        var parameters = new DialogParameters<CompositeTypeFieldDialog>
        {
            { x => x.Type, Type },
            { x => x.InitialDisplayOrder, _fields.Count + 1 },
            { x => x.OptionSets, OptionSets },
            { x => x.NestedTypes, NestedTypes }
        };

        var dialog = await DialogService.ShowAsync<CompositeTypeFieldDialog>(
            string.Empty, parameters, FieldDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadFieldsAsync();
    }

    private async Task OpenEditFieldAsync(CompositeFieldDetailDto field)
    {
        var parameters = new DialogParameters<CompositeTypeFieldDialog>
        {
            { x => x.Type, Type },
            { x => x.EditingField, field },
            { x => x.OptionSets, OptionSets },
            { x => x.NestedTypes, NestedTypes }
        };

        var dialog = await DialogService.ShowAsync<CompositeTypeFieldDialog>(
            string.Empty, parameters, FieldDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadFieldsAsync();
    }

    private async Task DeleteFieldAsync(CompositeFieldDetailDto field)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除字段「{field.DisplayName}」？",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteCompositeFieldAsync(Type.CompositeTypeId, field.FieldId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await ReloadFieldsAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    private string GetNestedTypeName(string compositeTypeId)
        => NestedTypes?.FirstOrDefault(t => t.CompositeTypeId == compositeTypeId)?.TypeName
           ?? compositeTypeId;

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        _ => Color.Default
    };

    private void Close() => MudDialog?.Close(DialogResult.Cancel());
}
