@* EntityTypeEditDialog.razor — 新建 / 编辑实体类型（DialogSky 外壳，与树节点对话框风格一致） *@
@inject EavApiClient Api
@inject SpaceApiClient SpaceApi
@inject ISnackbar Snackbar
@using TreeGraph.Blazor.Shared.SpaceSky
@using TreeGraph.Blazor.Shared.SpaceSky.Services

<DialogSky Title="@(Editing is null ? "新建实体类型" : "编辑实体类型")"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
               SubmitButtonDisabled="@_submitting"
               OnSubmitClick="SaveAsync">
    <DialogContent>
        @* 编辑时展示内部标识（供调试，用户平时看不到） *@
        @if (Editing is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                <MudText Typo="Typo.caption">
                    内部标识：<code>@Editing.EntityType</code>
                </MudText>
            </MudAlert>
        }

        <MudTextField @bind-Value="_form.DisplayName"
                      Label="实体类型名称"
                      Placeholder="请输入中文名称"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      HelperText="@(Editing is null
                          ? "界面上显示的名称，例如：分类树、单位树、订单"
                          : "实体类型在界面上显示的名称")" />

        @* 内部标识（仅新建时可填，用于与树类型名等外部系统对齐） *@
        @if (Editing is null)
        {
            <MudTextField @bind-Value="_form.EntityType"
                          Label="内部标识（可选）"
                          Placeholder="普通使用请留空"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          HelperText="系统内部使用的英文标识。一般留空即可（自动生成 et_xxx）；仅当要在树节点上挂此类型属性时才需填写：分类树填 CategoryTree，单位树填 UnitTree。" />
        }

        <MudTextField @bind-Value="_form.Description"
                      Label="说明（可选）"
                      Variant="Variant.Outlined"
                      Lines="2"
                      Class="mb-3" />

        @* 范围（仅新建时可选）：共享 = 所有空间可见；独占 = 仅所属空间可见。
           带空间上下文（DefaultOwnerSpaceId）时锁定为独占该空间；
           ForceShared（仅共享视图）时隐藏选择，新建必为共享。 *@
        @if (Editing is null && !ForceShared)
        {
            @if (!string.IsNullOrEmpty(DefaultOwnerSpaceId))
            {
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                    <MudText Typo="Typo.caption">
                        范围：独占 · @(DefaultOwnerSpaceName ?? DefaultOwnerSpaceId)
                    </MudText>
                </MudAlert>
            }
            else
            {
                <MudRadioGroup T="bool" @bind-Value="_form.IsExclusive" Class="mb-2">
                    <MudRadio T="bool" Value="false" Color="Color.Success" Dense="true">共享（所有空间可见）</MudRadio>
                    <MudRadio T="bool" Value="true" Color="Color.Warning" Dense="true">独占（仅所属空间可见）</MudRadio>
                </MudRadioGroup>

                @if (_form.IsExclusive)
                {
                    <MudSelect T="string"
                               @bind-Value="_form.OwnerSpaceId"
                               Label="所属空间"
                               Variant="Variant.Outlined"
                               Class="mb-3"
                               Required="true"
                               RequiredError="独占类型须选择所属空间">
                        @foreach (var s in _spaces ?? [])
                        {
                            <MudSelectItem T="string" Value="@s.Id">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
        }

        <NumberInputField T="int"
                          @bind-Value="_form.DisplayOrder"
                          Label="显示顺序" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>编辑目标；null 表示新建。</summary>
    [Parameter] public EntityTypeDetailDto? Editing { get; set; }
    /// <summary>新建模式下的初始显示顺序（现有类型数 + 1）。</summary>
    [Parameter] public int InitialDisplayOrder { get; set; }
    /// <summary>空间上下文：新建时锁定为独占该空间（隐藏范围选择）。</summary>
    [Parameter] public string? DefaultOwnerSpaceId { get; set; }
    /// <summary>空间上下文显示名。</summary>
    [Parameter] public string? DefaultOwnerSpaceName { get; set; }
    /// <summary>仅共享视图：隐藏范围选择，新建必为共享类型。</summary>
    [Parameter] public bool ForceShared { get; set; }

    private FormModel _form = new();
    private bool _submitting;
    private IReadOnlyList<SpaceDto>? _spaces;

    protected override async Task OnInitializedAsync()
    {
        // 新建且可选范围时预载空间列表（独占需要选择所属空间）
        if (Editing is null && string.IsNullOrEmpty(DefaultOwnerSpaceId))
            _spaces = await SpaceApi.GetAllAsync() ?? [];
    }

    protected override void OnParametersSet()
    {
        _form = Editing is null
            ? new FormModel { DisplayOrder = InitialDisplayOrder }
            : new FormModel
            {
                DisplayName = Editing.DisplayName,
                Description = Editing.Description ?? "",
                DisplayOrder = Editing.DisplayOrder
            };
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.DisplayName))
        {
            Snackbar.Add("请填写名称", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            if (Editing is null)
            {
                // 范围解析：锁定上下文 > 用户选择（独占须选空间）
                string? ownerSpaceId = !string.IsNullOrEmpty(DefaultOwnerSpaceId)
                    ? DefaultOwnerSpaceId
                    : _form.IsExclusive ? _form.OwnerSpaceId : null;

                if (_form.IsExclusive && string.IsNullOrEmpty(DefaultOwnerSpaceId)
                    && string.IsNullOrWhiteSpace(ownerSpaceId))
                {
                    Snackbar.Add("独占类型须选择所属空间", Severity.Warning);
                    return;
                }

                // 新建：EntityType 为空时服务端自动生成 et_xxxx，否则使用用户指定值
                var id = await Api.CreateEntityTypeAsync(new CreateEntityTypeRequest
                {
                    EntityType = string.IsNullOrWhiteSpace(_form.EntityType)
                        ? null : _form.EntityType.Trim(),
                    DisplayName = _form.DisplayName.Trim(),
                    Description = string.IsNullOrWhiteSpace(_form.Description)
                        ? null : _form.Description,
                    DisplayOrder = _form.DisplayOrder,
                    OwnerSpaceId = ownerSpaceId
                });

                if (id is null)
                {
                    Snackbar.Add("创建失败", Severity.Error);
                    return;
                }

                Snackbar.Add($"已创建「{_form.DisplayName.Trim()}」", Severity.Success);
            }
            else
            {
                // 编辑
                var (ok, error) = await Api.UpdateEntityTypeAsync(
                    Editing.EntityTypeId,
                    new UpdateEntityTypeRequest
                    {
                        DisplayName = _form.DisplayName,
                        Description = _form.Description,
                        DisplayOrder = _form.DisplayOrder
                    });

                if (!ok)
                {
                    Snackbar.Add($"更新失败：{error ?? "未知错误"}", Severity.Error);
                    return;
                }

                Snackbar.Add("更新成功", Severity.Success);
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }

    private class FormModel
    {
        public string DisplayName { get; set; } = "";
        public string EntityType { get; set; } = "";
        public string Description { get; set; } = "";
        public int DisplayOrder { get; set; }
        /// <summary>范围：false=共享；true=独占（须选 OwnerSpaceId）。</summary>
        public bool IsExclusive { get; set; }
        public string? OwnerSpaceId { get; set; }
    }
}
