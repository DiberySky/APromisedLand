@* EdgeDefinitionCreateDialog.razor — 新建边类型（DialogSky 外壳） *@
@using TreeGraph.Shared.NodeEavSky.Dtos
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="新建边类型"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
           SubmitButtonDisabled="@_submitting"
           ActionsMaxWidth="MaxWidth.False"
           OnSubmitClick="CreateAsync">
    <DialogContent>
        <MudTextField @bind-Value="_newType.TypeName"
                      Label="类型名（PascalCase）"
                      Placeholder="如 Collaboration、Follow"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      HelperText="作为 EAV entityType 使用；首字母大写，只含字母和数字" />

        <MudTextField @bind-Value="_newType.DisplayName"
                      Label="显示名"
                      Placeholder="中文名称，如 协作关系"
                      Variant="Variant.Outlined"
                      Class="mb-3" />

        <div Class="d-flex mb-3">
            <MudSelect T="string"
                       Value="_newType.FromNodeType"
                       ValueChanged="v => _newType.FromNodeType = v"
                       Label="起点节点类型（可选）"
                       Variant="Variant.Outlined"
                       Class="flex-grow-1 mr-3"
                       Clearable="true">
                <MudSelectItem T="string" Value="@("")">不限</MudSelectItem>
                @foreach (var et in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@et.EntityType">
                        @(string.IsNullOrWhiteSpace(et.DisplayName)
                            ? et.EntityType
                            : $"{et.DisplayName}（{et.EntityType}）")
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string"
                       Value="_newType.ToNodeType"
                       ValueChanged="v => _newType.ToNodeType = v"
                       Label="终点节点类型（可选）"
                       Variant="Variant.Outlined"
                       Class="flex-grow-1"
                       Clearable="true">
                <MudSelectItem T="string" Value="@("")">不限</MudSelectItem>
                @foreach (var et in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@et.EntityType">
                        @(string.IsNullOrWhiteSpace(et.DisplayName)
                            ? et.EntityType
                            : $"{et.DisplayName}（{et.EntityType}）")
                    </MudSelectItem>
                }
            </MudSelect>
        </div>

        <div Class="d-flex align-center mb-3 gap-4">
            <BoolFieldSky Label="全局共享（所有节点类型可用）"
                          @bind-Value="_newType.IsGlobal" />
            <BoolFieldSky Label="有向（from → to 有方向）"
                          @bind-Value="_newType.IsDirected" />
        </div>

        <MudTextField @bind-Value="_newType.Description"
                      Label="描述（可选）"
                      Placeholder="边类型的用途说明"
                      Variant="Variant.Outlined"
                      Lines="3"
                      TextArea="true" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    private CreateEdgeTypeRequest _newType = new() { IsGlobal = true, IsDirected = true };
    private bool _submitting;
    private IReadOnlyList<EntityTypeSummaryDto> _entityTypes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entityTypes = await Api.ListEntityTypesAsync(sharedOnly: true) ?? [];
        }
        catch { _entityTypes = []; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newType.TypeName) ||
            string.IsNullOrWhiteSpace(_newType.DisplayName))
        {
            Snackbar.Add("请填写类型名和显示名", Severity.Warning);
            return;
        }

        if (!(char.IsUpper(_newType.TypeName[0]) &&
              _newType.TypeName.Skip(1).All(c => char.IsLetterOrDigit(c))))
        {
            Snackbar.Add("类型名必须是 PascalCase（首字母大写、只含字母数字）", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var id = await Api.CreateEdgeTypeAsync(_newType);
            if (id is null)
            {
                Snackbar.Add("创建失败（类型名可能已被占用）", Severity.Error);
                return;
            }

            Snackbar.Add($"创建成功", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally { _submitting = false; }
    }
}
