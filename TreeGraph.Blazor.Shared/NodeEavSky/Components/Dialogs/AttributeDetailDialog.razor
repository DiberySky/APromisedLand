@* AttributeDetailDialog.razor — 属性详情（DialogSky 外壳，与树节点对话框风格一致） *@
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="属性详情"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭"
           OnCanceledClick="@Close">
    <DialogContent>
        @if (_detail is null)
        {
            <MudStack Class="py-8" AlignItems="AlignItems.Center">
                <MudProgressCircular Indeterminate="true" />
            </MudStack>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">属性名（内部标识）</MudText>
                    <MudText Typo="Typo.body1"><code>@_detail.AttributeName</code></MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">显示名</MudText>
                    <MudText Typo="Typo.body1">@_detail.DisplayName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">数据类型</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetDataTypeColor(_detail.DataType)">
                        @EavDataTypeLabels.GetLabel(_detail.DataType)
                    </MudChip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">实体类型</MudText>
                    <MudText Typo="Typo.body1">@_detail.EntityType</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">必填</MudText>
                    <MudIcon Icon="@(_detail.IsRequired ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(_detail.IsRequired ? Color.Success : Color.Default)" Size="Size.Small" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">可搜索</MudText>
                    <MudIcon Icon="@(_detail.IsSearchable ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(_detail.IsSearchable ? Color.Success : Color.Default)" Size="Size.Small" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">可排序</MudText>
                    <MudIcon Icon="@(_detail.IsSortable ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(_detail.IsSortable ? Color.Success : Color.Default)" Size="Size.Small" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">显示顺序</MudText>
                    <MudText Typo="Typo.body1">@_detail.DisplayOrder</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">版本</MudText>
                    <MudText Typo="Typo.body1">v@_detail.Version</MudText>
                </MudItem>

                @if (!string.IsNullOrEmpty(_detail.DefaultValue))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">默认值</MudText>
                        <MudText Typo="Typo.body1">@_detail.DefaultValue</MudText>
                    </MudItem>
                }

                @* 引用信息 *@
                @if (_detail.UnitId is not null || _detail.RefCompositeTypeId is not null
                    || _detail.RefTableDefinitionId is not null || _detail.RefOptionSetId is not null)
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">引用</MudText>
                    </MudItem>

                    @if (_detail.UnitId is not null)
                    {
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">单位</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                @_detail.UnitName (@_detail.UnitAbbreviation)
                            </MudChip>
                        </MudItem>
                    }
                    @if (_detail.RefCompositeTypeId is not null)
                    {
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">组合类型</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Dark">
                                @(_detail.CompositeTypeDisplayName ?? _detail.CompositeTypeName)
                            </MudChip>
                        </MudItem>
                    }
                    @if (_detail.RefTableDefinitionId is not null)
                    {
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">自定义表</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                @(_detail.TableDisplayName ?? _detail.TableName)
                            </MudChip>
                        </MudItem>
                    }
                    @if (_detail.RefOptionSetId is not null)
                    {
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">选项集</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                @(_detail.OptionSetDisplayName ?? _detail.OptionSetName)
                            </MudChip>
                        </MudItem>
                    }
                }

                <MudItem xs="12">
                    <MudDivider Class="my-3" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">创建时间</MudText>
                    <MudText Typo="Typo.body2">@_detail.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">更新时间</MudText>
                    <MudText Typo="Typo.body2">@_detail.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </MudItem>

                @if (_detail.IsDeleted)
                {
                    <MudItem xs="12">
                        <MudChip T="string" Color="Color.Error">已删除</MudChip>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string AttributeId { get; set; }

    private AttributeDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        _detail = await Api.GetAttributeAsync(AttributeId);
        if (_detail is null)
        {
            Snackbar.Add("加载属性详情失败", Severity.Error);
        }
    }

    private void Close() => MudDialog?.Close(DialogResult.Cancel());

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        "table" => Color.Info,
        "file" => Color.Default,
        _ => Color.Default
    };
}
