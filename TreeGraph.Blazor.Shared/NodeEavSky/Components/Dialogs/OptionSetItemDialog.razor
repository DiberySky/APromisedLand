@* OptionSetItemDialog.razor — 添加 / 编辑选项（DialogSky 外壳，与新建选项集风格一致） *@
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="@(EditingItem is null ? "添加选项" : "编辑选项")"
               SubmitButtonVisible="true"
               SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
               SubmitButtonDisabled="@_submitting"
               ActionsMaxWidth="MaxWidth.False"
               OnSubmitClick="SaveAsync">
    <ToolBarContent>
        @if (Set is not null)
        {
            <MudText>选项集：@Set.DisplayName (@Set.SetName)</MudText>
        }
    </ToolBarContent>
    <DialogContent>
        @* 显示名 + 默认开关同一行：显示名占剩余宽度，开关靠右垂直居中 *@
        <div class="d-flex align-center mb-3" style="gap: 12px;">
            <MudTextField @bind-Value="_form.Label"
                          Label="显示名"
                          Placeholder="请输入中文"
                          Variant="Variant.Outlined"
                          Style="flex: 1 1 auto;" />
            <MudSwitch T="bool"
                       @bind-Value="_form.IsDefault"
                       Label="设为默认选项"
                       Color="Color.Primary"
                       Style="flex: 0 0 auto;" />
        </div>
        <NamingTextField @bind-Value="_form.Value"
                         SourceText="@_form.Label"
                         NameCase="snake"
                         Label="内部标识"
                         Placeholder="使用下划线分隔的小写英文单词"
                         Disabled="@(EditingItem is not null)"
                         HelperText="@(EditingItem is not null ? "存储的稳定标识，不可修改；如需变更请新建选项" : null)" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>所属选项集。</summary>
    [Parameter] public OptionSetSummaryDto? Set { get; set; }
    /// <summary>编辑目标；null 表示添加新选项。</summary>
    [Parameter] public OptionItemDetailDto? EditingItem { get; set; }
    /// <summary>添加模式下的初始显示顺序（现有活动项数 + 1）。</summary>
    [Parameter] public int InitialDisplayOrder { get; set; }

    private OptionItemForm _form = new();
    private bool _submitting;

    protected override void OnParametersSet()
    {
        _form = EditingItem is null
            ? new OptionItemForm { DisplayOrder = InitialDisplayOrder }
            : new OptionItemForm
            {
                Value = EditingItem.Value,
                Label = EditingItem.Label,
                DisplayOrder = EditingItem.DisplayOrder,
                IsDefault = EditingItem.IsDefault
            };
    }

    private async Task SaveAsync()
    {
        if (Set is null) return;

        if (string.IsNullOrWhiteSpace(_form.Value) ||
            string.IsNullOrWhiteSpace(_form.Label))
        {
            Snackbar.Add("请填写显示名和内部标识", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            if (EditingItem is null)
            {
                var id = await Api.AddOptionItemAsync(
                    Set.OptionSetId,
                    new CreateOptionItemRequest
                    {
                        Value = _form.Value,
                        Label = _form.Label,
                        DisplayOrder = _form.DisplayOrder,
                        IsDefault = _form.IsDefault
                    });

                if (id is null)
                {
                    Snackbar.Add("添加失败（内部标识可能已存在）", Severity.Error);
                    return;
                }
                Snackbar.Add($"添加成功：Id={id}", Severity.Success);
            }
            else
            {
                var (ok, error) = await Api.UpdateOptionItemAsync(
                    Set.OptionSetId,
                    EditingItem.OptionItemId,
                    new UpdateOptionItemRequest
                    {
                        Label = _form.Label,
                        DisplayOrder = _form.DisplayOrder,
                        IsDefault = _form.IsDefault
                    });

                if (!ok)
                {
                    Snackbar.Add($"更新失败：{error ?? "未知错误"}", Severity.Error);
                    return;
                }
                Snackbar.Add("更新成功", Severity.Success);
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }

    private class OptionItemForm
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
        public int DisplayOrder { get; set; }
        public bool IsDefault { get; set; }
    }
}
