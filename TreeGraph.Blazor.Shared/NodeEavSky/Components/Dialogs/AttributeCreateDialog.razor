@* AttributeCreateDialog.razor — 新建属性（DialogSky 外壳，与树节点对话框风格一致） *@
@using TreeGraph.Blazor.Shared.MafWfSky.Components
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="新建属性"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
           SubmitButtonDisabled="@_submitting"
           OnSubmitClick="CreateAsync">
    <DialogContent>
        @* 实体类型（下拉）；锁定模式下禁用，强制使用父级传入的实体类型 *@
        <MudSelect T="string"
                   Value="_createForm.EntityType"
                   ValueChanged="@(v => _createForm.EntityType = v)"
                   Label="实体类型"
                   Variant="Variant.Outlined"
                   Class="mb-3"
                   Disabled="@IsEntityTypeLocked"
                   HelperText="@(IsEntityTypeLocked ? "当前已锁定实体类型" : "如需新类型，请先到「实体类型管理」创建")">
            @foreach (var et in EntityTypes ?? Array.Empty<EntityTypeSummaryDto>())
            {
                <MudSelectItem T="string" Value="@et.EntityType">
                    @GetDisplayName(et)
                </MudSelectItem>
            }
        </MudSelect>

        @* 显示名（必填，中文） *@
        <MudTextField @bind-Value="_createForm.DisplayName"
                      Label="显示名"
                      Placeholder="如：名称、长度、价格"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      HelperText="用户在界面上看到的名字" />

        @* 数据类型 *@
        <MudSelect T="string"
                   Value="_createForm.DataType"
                   ValueChanged="OnCreateDataTypeChanged"
                   Label="数据类型"
                   Variant="Variant.Outlined"
                   Class="mb-3">
            @foreach (var dt in DataTypeOptions)
            {
                <MudSelectItem T="string" Value="@dt.Value">@dt.Label</MudSelectItem>
            }
        </MudSelect>

        @* int / decimal：单位（复制原系统 UintTreeField 调用方式：只读文本 + 单位树选择对话框） *@
        @if (_createForm.DataType is "decimal" or "int")
        {
            <UnitTreeField @bind-UnitId="_createForm.UnitId"
                           @bind-UnitName="_createForm.UnitName" />
        }

        @* decimal：小数精度（ValidationRule.precision） *@
        @if (_createForm.DataType == "decimal")
        {
            <NumberInputField T="int?"
                              @bind-Value="_createForm.Precision"
                              Label="小数精度（可选）"
                              Min="0" Max="10" Step="1"
                              Class="mb-3"
                              HelperText="显示与保存的小数位上限（0–10），如填 2 则 111.123 会被拒绝，留空不限制" />
        }

        @* composite：下拉 + 右侧新建入口（无可选类型时可就地创建） *@
        @if (_createForm.DataType == "composite")
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudSelect T="string"
                           Value="@(_createForm.RefCompositeTypeId ?? "")"
                           ValueChanged="@(v => _createForm.RefCompositeTypeId = string.IsNullOrEmpty(v) ? null : v)"
                           Label="组合类型"
                           Variant="Variant.Outlined"
                           Style="flex: 1;">
                    @foreach (var t in _compositeTypes ?? new List<CompositeTypeDetailDto>())
                    {
                        <MudSelectItem T="string" Value="@t.CompositeTypeId">
                            @t.DisplayName (@t.TypeName)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               title="管理组合类型"
                               OnClick="OpenCompositeTypeManageAsync" />
            </div>
            @if (_compositeTypes is null || _compositeTypes.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    暂无组合类型，可点击右侧齿轮按钮直接创建。
                </MudAlert>
            }
        }

        @* table：选择自定义表（选中时序记录表则该属性自动为时序记录，行列表屏蔽序号） *@
        @if (_createForm.DataType == "table")
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudSelect T="string"
                           Value="@(_createForm.RefTableDefinitionId ?? "")"
                           ValueChanged="@(v => _createForm.RefTableDefinitionId = string.IsNullOrEmpty(v) ? null : v)"
                           Label="自定义表"
                           Variant="Variant.Outlined"
                           Style="flex: 1;">
                    @foreach (var t in _customTables ?? new List<CustomTableDetailDto>())
                    {
                        <MudSelectItem T="string" Value="@t.TableDefinitionId">
                            @t.DisplayName (@t.TableName)@(t.IsRecordTable ? "（时序）" : "")
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               title="管理自定义表"
                               OnClick="OpenCustomTableManageAsync" />
            </div>
            @if (_customTables is null || _customTables.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    暂无自定义表，可点击右侧齿轮按钮直接创建。
                </MudAlert>
            }
        }

        @* single_choice：下拉 + 右侧新建入口 *@
        @if (_createForm.DataType == "single_choice")
        {
            <div class="d-flex align-center gap-2 mb-3">
                <MudSelect T="string"
                           Value="@(_createForm.RefOptionSetId ?? "")"
                           ValueChanged="@(v => _createForm.RefOptionSetId = string.IsNullOrEmpty(v) ? null : v)"
                           Label="选项集"
                           Variant="Variant.Outlined"
                           Style="flex: 1;">
                    @foreach (var s in _optionSets ?? new List<OptionSetSummaryDto>())
                    {
                        <MudSelectItem T="string" Value="@s.OptionSetId">
                            @s.DisplayName (@s.SetName)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               title="管理选项集"
                               OnClick="OpenOptionSetManageAsync" />
            </div>
            @if (_optionSets is null || _optionSets.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    暂无选项集，可点击右侧齿轮按钮直接创建。
                </MudAlert>
            }
        }

        <NumberInputField T="int"
                          @bind-Value="_createForm.DisplayOrder"
                          Label="显示顺序"
                          Class="mb-3" />

        <MudGrid>
            <MudItem xs="6" md="3">
                <MudSwitch T="bool" @bind-Value="_createForm.IsRequired"
                           Label="必填" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSwitch T="bool" @bind-Value="_createForm.IsSearchable"
                           Label="可搜索" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSwitch T="bool" @bind-Value="_createForm.IsSortable"
                           Label="可排序" Color="Color.Primary" />
            </MudItem>
        </MudGrid>

        @* 高级选项：AttributeName 可选覆盖 *@
        <MudExpansionPanels Class="mt-3">
            <MudExpansionPanel Text="高级选项（内部标识）">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    <MudText Typo="Typo.caption">
                        内部标识（AttributeName）会出现在 <b>JSON key</b>、
                        查询过滤、审计日志、导出列名里。
                        留空则系统自动生成（如 <code>attr_3f9a2b1c8d4e</code>）。
                        如需与外部系统对接，建议手动指定可读的英文标识。
                    </MudText>
                </MudAlert>
                <NamingTextField @bind-Value="_createForm.AttributeName"
                                 SourceText="@_createForm.DisplayName"
                                 NameCase="snake"
                                 Label="内部标识（可选）"
                                 Placeholder="如：name、length"
                                 HelperText="留空自动生成；填了则：字母开头，只含字母/数字/下划线" />
            </MudExpansionPanel>
        </MudExpansionPanels>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>初始实体类型（页面当前选中项）。</summary>
    [Parameter] public string? EntityType { get; set; }
    /// <summary>是否锁定实体类型（锁定时禁止切换，强制使用 EntityType）。</summary>
    [Parameter] public bool IsEntityTypeLocked { get; set; }
    /// <summary>新建模式下的初始显示顺序（现有属性数 + 1）。</summary>
    [Parameter] public int InitialDisplayOrder { get; set; }
    [Parameter] public IReadOnlyList<EntityTypeSummaryDto>? EntityTypes { get; set; }
    [Parameter] public IReadOnlyList<CompositeTypeDetailDto>? CompositeTypes { get; set; }
    [Parameter] public IReadOnlyList<CustomTableDetailDto>? CustomTables { get; set; }
    [Parameter] public IReadOnlyList<OptionSetSummaryDto>? OptionSets { get; set; }

    private CreateAttributeForm _createForm = new();
    private bool _submitting;
    /// <summary>组合类型本地副本（就地新建后刷新，不依赖父组件重传参数）。</summary>
    private IReadOnlyList<CompositeTypeDetailDto>? _compositeTypes;
    /// <summary>自定义表本地副本（同上）。</summary>
    private IReadOnlyList<CustomTableDetailDto>? _customTables;
    /// <summary>选项集本地副本（同上）。</summary>
    private IReadOnlyList<OptionSetSummaryDto>? _optionSets;

    private static readonly (string Value, string Label)[] DataTypeOptions =
    {
        ("string",   "字符串"),
        ("int",      "整数"),
        ("decimal",  "小数"),
        ("bool",     "布尔"),
        ("datetime", "日期时间"),
        ("date",     "日期"),
        ("time",     "时间"),
        ("single_choice", "单选"),
        ("location", "位置"),
        ("file",     "文件"),
        ("composite", "组合类型"),
        ("table",    "自定义表"),
        ("json",     "JSON")
    };

    protected override void OnParametersSet()
    {
        _createForm = new CreateAttributeForm
        {
            EntityType = EntityType ?? "",
            DisplayOrder = InitialDisplayOrder,
            IsSearchable = true
        };
        _compositeTypes = CompositeTypes;
        _customTables = CustomTables;
        _optionSets = OptionSets;
    }

    /// <summary>就地打开「组合类型管理」对话框；关闭后刷新本地列表供下拉选择。</summary>
    private async Task OpenCompositeTypeManageAsync()
    {
        var dialog = await DialogService.ShowAsync<CompositeTypeManageDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;

        // 管理对话框内可能增删组合类型，无论结果如何都刷新本地列表
        _compositeTypes = await Api.ListCompositeTypesAsync();
    }

    /// <summary>就地打开「自定义表管理」对话框（含列 CRUD）；关闭后刷新本地列表。</summary>
    private async Task OpenCustomTableManageAsync()
    {
        var dialog = await DialogService.ShowAsync<CustomTableManageDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;

        // 管理对话框内可能增删表/列，无论结果如何都刷新本地列表
        _customTables = await Api.ListCustomTablesAsync();
    }

    /// <summary>就地打开「选项集管理」对话框（含选项项 CRUD）；关闭后刷新本地列表。</summary>
    private async Task OpenOptionSetManageAsync()
    {
        var dialog = await DialogService.ShowAsync<OptionSetManageDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
        await dialog.Result;

        // 管理对话框内可能增删选项集/选项项，无论结果如何都刷新本地列表
        _optionSets = await Api.ListOptionSetsAsync();
    }

    private static string GetDisplayName(EntityTypeSummaryDto et)
        => string.IsNullOrWhiteSpace(et.DisplayName)
            ? et.EntityType
            : et.DisplayName;

    private void OnCreateDataTypeChanged(string dt)
    {
        _createForm.DataType = dt;
        if (dt is not ("decimal" or "int")) { _createForm.UnitId = null; _createForm.UnitName = null; }
        // decimal：精度默认 2（可改可清空）；切走则清空
        if (dt != "decimal") _createForm.Precision = null;
        else _createForm.Precision ??= 2;
        if (dt != "composite") _createForm.RefCompositeTypeId = null;
        if (dt != "table") { _createForm.RefTableDefinitionId = null; }
        if (dt != "single_choice") _createForm.RefOptionSetId = null;
        // 位置不参与文本筛选与排序
        _createForm.IsSearchable = dt is not "location";
    }

    private async Task CreateAsync()
    {
        var f = _createForm;
        if (string.IsNullOrWhiteSpace(f.EntityType) ||
            string.IsNullOrWhiteSpace(f.DisplayName))
        {
            Snackbar.Add("请填写实体类型、显示名", Severity.Warning);
            return;
        }
        if (f.DataType == "composite" && f.RefCompositeTypeId is null)
        {
            Snackbar.Add("请先选择组合类型；如无可用类型，请先到「组合类型」标签页创建", Severity.Warning);
            return;
        }
        if (f.DataType == "table" && f.RefTableDefinitionId is null)
        {
            Snackbar.Add("请先选择自定义表；如无可用表，请先到「自定义表」标签页创建", Severity.Warning);
            return;
        }
        if (f.DataType == "single_choice" && f.RefOptionSetId is null)
        {
            Snackbar.Add("请先选择选项集；如无可用选项集，请先到「选项集」标签页创建", Severity.Warning);
            return;
        }

        // 高级选项校验（如填了 AttributeName）
        if (!string.IsNullOrWhiteSpace(f.AttributeName))
        {
            var name = f.AttributeName.Trim();
            if (!System.Text.RegularExpressions.Regex.IsMatch(
                    name, @"^[A-Za-z][A-Za-z0-9_]*$"))
            {
                Snackbar.Add(
                    "内部标识必须以字母开头，只含字母、数字、下划线（或留空自动生成）",
                    Severity.Warning);
                return;
            }
        }

        _submitting = true;
        try
        {
            var id = await Api.CreateAttributeAsync(new CreateAttributeRequest
            {
                EntityType = f.EntityType,
                // null / 空 → 服务端自动生成
                AttributeName = string.IsNullOrWhiteSpace(f.AttributeName)
                    ? null
                    : f.AttributeName.Trim(),
                DisplayName = f.DisplayName.Trim(),
                DataType = f.DataType,
                IsRequired = f.IsRequired,
                IsSearchable = f.IsSearchable,
                IsSortable = f.IsSortable,
                DisplayOrder = f.DisplayOrder,
                UnitId = f.UnitId,
                // decimal 精度 → ValidationRule.precision
                ValidationRule = f.Precision is int p
                    ? System.Text.Json.JsonSerializer.SerializeToElement(new { precision = p })
                    : null,
                RefCompositeTypeId = f.RefCompositeTypeId,
                RefTableDefinitionId = f.RefTableDefinitionId,
                RefOptionSetId = f.RefOptionSetId
            });

            if (id is null)
            {
                Snackbar.Add("创建失败", Severity.Error);
                return;
            }

            Snackbar.Add($"创建成功：{f.DisplayName}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        finally
        {
            _submitting = false;
        }
    }

    private class CreateAttributeForm
    {
        public string EntityType { get; set; } = "";
        public string? AttributeName { get; set; }    // 可空
        public string DisplayName { get; set; } = "";
        public string DataType { get; set; } = "string";
        public bool IsRequired { get; set; }
        public bool IsSearchable { get; set; }
        public bool IsSortable { get; set; }
        public int DisplayOrder { get; set; }
        public string? UnitId { get; set; }
        public string? UnitName { get; set; }
        /// <summary>decimal 小数精度（0–10，null 不限制）→ ValidationRule.precision</summary>
        public int? Precision { get; set; }
        public string? RefCompositeTypeId { get; set; }
        public string? RefTableDefinitionId { get; set; }
        public string? RefOptionSetId { get; set; }
    }
}
