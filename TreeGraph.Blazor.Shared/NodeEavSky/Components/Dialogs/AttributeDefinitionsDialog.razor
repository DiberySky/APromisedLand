@* AttributeDefinitionsDialog.razor — 独立属性定义对话框（单一用途）
   嵌入 Attributes 页面组件（属性已全局化，不再锁定实体类型）。
   区别于 AttributesManageDialog（5 标签全量元数据维护），本对话框只做属性定义。 *@
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs

@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Blazor.Shared.NodeEavSky.Pages.Metadata

<DialogSky Title="属性定义"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭"
           OnCanceledClick="@Close">
    <DialogContent>
        <Attributes OnAttributesChanged="@OnAttributesChanged" />
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>属性变更回调。</summary>
    [Parameter] public EventCallback OnAttributesChanged { get; set; }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }
}
