@page "/semantic-search-direct"
@using Microsoft.Extensions.Logging
@using TreeGraph.Shared.NodeEavSky.Dtos
@using TreeGraph.Blazor.Shared.TreeEavSky
@using TreeGraph.Shared.TreeEavSky.Entities
@using TreeGraph.Shared.TreeEavSky.Abstractions
@using MudBlazor
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Pages
@inject EavApiClient EavApi
@inject ILogger<SemanticSearchDirect> Logger
@inject IDialogService DialogService
@inject BlazorService BlazorService

<PageSky Title="语义搜索（直连）"
         ArrowBackVisible="false"
         MaxWidth="MaxWidth.Medium">

    <PageContent>
        @* ═══ 搜索输入 ═══ *@
        <MudPaper Elevation="0" Class="pa-4">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_query"
                              Label="搜索内容"
                              Placeholder="输入关键词进行语义搜索..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyDown="HandleKeyDown"
                              Immediate="true"
                              Disabled="_searching"/>

                <MudStack Row="true" Spacing="2">
                    <NumberInputField @bind-Value="_topK"
                                      Label="返回数量"
                                      Min="1" Max="20"
                                      Style="width: 120px;"
                                      Disabled="_searching"/>

                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">最低相似度</MudText>
                        <div style="width: 160px;">
                            <MudSlider @bind-Value="_minScore"
                                       Min="0" Max="1" Step="0.05"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="_searching"/>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @_minScore.ToString("0.00")
                        </MudText>
                    </MudStack>

                    <MudSpacer/>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="DoSearchAsync"
                               Disabled="_searching || string.IsNullOrWhiteSpace(_query)">
                        @if (_searching)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        }
                        搜索
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @* ═══ 错误提示 ═══ *@
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="ma-3">
                @_error
            </MudAlert>
        }

        @* ═══ 搜索结果 ═══ *@
        @if (_results.Count > 0)
        {
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    找到 <strong>@_results.Count</strong> 个结果（查询：@_lastQuery）
                </MudText>

                <MudList T="SemanticSearchItemDto" Dense="true">
                    @foreach (var item in _results)
                    {
                        <MudListItem Icon="@GetHostTypeIcon(item.HostType)">
                            <MudStack Spacing="1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body1">
                                        <strong>@(item.NodeName ?? item.InodeId)</strong>
                                    </MudText>
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        @if (item.MatchKind == "Entity")
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                                                实体命中@(string.IsNullOrEmpty(item.EntityType) ? "" : $"：{item.EntityType}")
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                节点命中
                                            </MudChip>
                                        }
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                            @item.HostType
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    路径：@item.Path
                                </MudText>
                                @if (!string.IsNullOrEmpty(item.ParentName))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        父节点：@item.ParentName
                                    </MudText>
                                }
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        相似度：
                                    </MudText>
                                    <MudProgressLinear Value="@((double)item.Score * 100)"
                                                       Color="@GetScoreColor(item.Score)"
                                                       Size="Size.Small"
                                                       Style="width: 100px; height: 6px;"/>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @item.Score.ToString("F4")
                                    </MudText>
                                </MudStack>
                            </MudStack>

                            @* ★ 操作按钮：AI 综合 / 查看详情 *@
                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                                <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               Title="AI 综合"
                                               OnClick="@(() => OpenExpandDialogAsync(item))"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Title="查看详情"
                                               OnClick="@(() => OpenTreeDialogAsync(item))"/>
                            </MudStack>
                        </MudListItem>
                        <MudDivider/>
                    }
                </MudList>
            </MudPaper>
        }
        else if (_searched && !_searching)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="ma-3">
                未找到匹配结果
            </MudAlert>
        }

        @* ═══ 搜索中 ═══ *@
        @if (_searching)
        {
            <MudPaper Elevation="0" Class="pa-4 d-flex justify-center">
                <MudProgressCircular Indeterminate="true"/>
            </MudPaper>
        }
    </PageContent>
</PageSky>

@code {
    private string _query = "";
    private int _topK = 5;
    /// <summary>最低相似度：低于该值的命中不返回（与服务端 SemanticSearch:MinScore 默认值一致）。</summary>
    private double _minScore = 0.5;
    private bool _searching;
    private bool _searched;
    private string? _error;
    private string _lastQuery = "";
    private List<SemanticSearchItemDto> _results = new();

    private async Task DoSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _searching) return;

        _searching = true;
        _error = null;
        _results.Clear();
        _lastQuery = _query;
        StateHasChanged();

        try
        {
            var request = new SemanticSearchRequest
            {
                Query = _query,
                TopK = _topK,
                MinScore = (float)_minScore,
            };
            var response = await EavApi.SemanticSearchAsync(request);

            if (response is null)
            {
                _error = "搜索服务返回空响应";
            }
            else
            {
                _results = response.Items?.ToList() ?? new List<SemanticSearchItemDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "语义搜索失败");
            _error = $"搜索失败：{ex.Message}";
        }
        finally
        {
            _searching = false;
            _searched = true;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_searching)
        {
            await DoSearchAsync();
        }
    }

    // ═══════════════════════════════════════════════════════
    // AI 综合：点击 ✨ 立即打开对话框，框内显示进度 → 框内呈现结果
    // ═══════════════════════════════════════════════════════

    private async Task OpenExpandDialogAsync(SemanticSearchItemDto item)
    {
        var parameters = new DialogParameters<NodeExpandDialog>
        {
            { x => x.InodeId, item.InodeId },
            { x => x.HostType, item.HostType },
            { x => x.NodeName, item.NodeName ?? item.InodeId },
        };

        var options = new DialogConfig
        {
            MaxWidth = MaxWidth.Small,
            DragMode = MudDialogDragMode.None, // 本对话框不可移动
        }.ToDialogOptions();

        await DialogService.ShowExAsync<NodeExpandDialog>(
            "AI 综合", parameters, options);
    }

    // ═══════════════════════════════════════════════════════
    // 树对话框
    // ═══════════════════════════════════════════════════════

    private async Task OpenTreeDialogAsync(SemanticSearchItemDto item)
    {
        if (string.IsNullOrEmpty(item.RootId))
        {
            _error = "该节点没有根节点信息，无法打开树视图";
            StateHasChanged();
            return;
        }

        switch (item.HostType)
        {
            case "SpaceTree":
                await ShowTreeDialogAsync<SpaceTree>(item.InodeId);
                break;
            case "UnitTree":
                await ShowTreeDialogAsync<UnitTree>(item.InodeId);
                break;
            case "CategoryTree":
                await ShowTreeDialogAsync<CategoryTree>(item.InodeId);
                break;
            default:
                _error = $"未知的节点类型：{item.HostType}";
                StateHasChanged();
                break;
        }
    }

    private async Task ShowTreeDialogAsync<TItem>(string rootId)
        where TItem : class, ITreeNodeBase<TItem>, new()
    {
        var parameters = new DialogParameters<TreeDialogPageSky<TItem>>
        {
            { x => x.Title, "树节点" },
            { x => x.TitleToolBar, "" },
            { x => x.RootId, rootId },
        };

        var options = BlazorService.DialogOptions;

        var dialog = await DialogService.ShowExAsync<TreeDialogPageSky<TItem>>(
            "树节点", parameters, options);

        var result = await dialog.Result;

        // 用户在树对话框中选择了节点
        if (result is { Canceled: false, Data: TItem selectedNode })
        {
            _error = null;
            // 可以在这里添加后续处理，比如跳转到详情页
            StateHasChanged();
        }
    }

    private static string GetHostTypeIcon(string hostType) => hostType switch
    {
        "SpaceTree" => Icons.Material.Filled.Forest,
        "UnitTree" => Icons.Material.Filled.CorporateFare,
        "CategoryTree" => Icons.Material.Filled.Category,
        "TreeNode" => Icons.Material.Filled.AccountTree,
        _ => Icons.Material.Filled.HelpOutline
    };

    private static Color GetScoreColor(float score) => score switch
    {
        >= 0.7f => Color.Success,
        >= 0.5f => Color.Warning,
        _ => Color.Error
    };
}
