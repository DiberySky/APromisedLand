@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using TreeGraph.Blazor.Shared.MafWfSky.Services
@using MudBlazor
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Pages
@inject MafWfApiClient MafWfApi
@inject ILogger<NodeExpandDialog> Logger
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<DialogSky Title="@($"AI 综合：{NodeName}")"
           CancelButtonText="关闭"
           ActionsMaxWidth="MaxWidth.Medium">
    @* 操作行不放 ToolBarContent：MudBlazor.Extensions 宿主在标题区注入 header-actions 后，
       Blazor 对标题区的后续更新会打到游离节点（步进器显示值冻结）；内容区更新可靠 *@
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
            <MudToolBar Dense="true" DisableGutters="true" Class="mb-3">
                <NumberStepper @bind-Value="_depth" Label="包含子项" Suffix="层" Min="0" Max="10"/>
                <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="重新综合"
                               OnClick="RunAsync"/>
                <MudSpacer/>
                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                               Size="Size.Small"
                               Color="Color.Success"
                               Title="复制 Markdown"
                               OnClick="CopyAsync"/>
            </MudToolBar>
            @if (_loading)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-6">
                    <MudProgressCircular Indeterminate="true" Color="Color.Secondary"/>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        正在加载子树并综合，本地模型可能需要几分钟…
                    </MudText>
                </MudStack>
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                    @_error
                </MudAlert>
            }
            else
            {
                <div class="markdown-preview">
                    @((MarkupString)MarkdownRenderer.ToHtml(_reply))
                </div>
            }
        </MudContainer>
    </DialogContent>
</DialogSky>

@code {
    [Parameter, EditorRequired] public string InodeId { get; set; } = "";
    [Parameter, EditorRequired] public string HostType { get; set; } = "";
    [Parameter] public string? NodeName { get; set; }

    private int _depth = 3;         // 子树层数：0 = 仅节点本身，默认 3 层
    private bool _loading = true;
    private bool _running;          // 重入守卫：字段值始终准确，不依赖 DOM 渲染状态
    private string? _error;
    private string? _reply;

    protected override Task OnInitializedAsync() => RunAsync();

    private async Task RunAsync()
    {
        if (_running)
        {
            Snackbar.Add("正在进行 AI 综合，请稍候…", Severity.Info);
            return;
        }

        _running = true;
        _loading = true;
        _error = null;
        _reply = null;
        StateHasChanged();

        try
        {
            var result = await MafWfApi.ExpandNodeAsync(
                conversationId: null, InodeId, HostType, _depth);
            _reply = result.Reply;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI 综合失败：{InodeId}", InodeId);
            _error = $"AI 综合失败：{ex.Message}";
        }
        finally
        {
            _loading = false;
            _running = false;
            StateHasChanged();
        }
    }

    private async Task CopyAsync()
    {
        if (_reply is null)
        {
            Snackbar.Add("结果尚未就绪，请稍候再试", Severity.Info);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _reply);
            Snackbar.Add("已复制 Markdown 到剪贴板", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "复制失败");
            Snackbar.Add($"复制失败：{ex.Message}", Severity.Error);
        }
    }
}
