@* AttachTypeDialog.razor — 为 iNode 声明新属性定义（DialogSky 外壳） *@
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Shared.NodeEavSky.Dtos
@namespace TreeGraph.Blazor.Shared.NodeEavSky.Pages.Inodes

<DialogSky Title="声明新类型"
               SubmitButtonVisible="true"
               SubmitButtonText="声明"
               OnSubmitClick="Submit">
    <DialogContent>
        @if (AvailableTypes is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (AvailableTypes.Count == 0)
        {
            <MudAlert Severity="Severity.Info">所有属性定义均已声明</MudAlert>
        }
        else
        {
            <MudSelect T="string"
                       @bind-Value="_selected"
                       Label="属性定义"
                       Variant="Variant.Outlined">
                @foreach (var t in AvailableTypes)
                {
                    <MudSelectItem T="string" Value="@t.EntityType">
                        @(string.IsNullOrWhiteSpace(t.DisplayName)
                            ? t.EntityType
                            : $"{t.DisplayName} ({t.EntityType})")
                    </MudSelectItem>
                }
            </MudSelect>
        }
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>可选属性定义；null 表示仍在加载。</summary>
    [Parameter] public IReadOnlyList<EntityTypeSummaryDto>? AvailableTypes { get; set; }

    private string? _selected;

    private void Submit()
    {
        if (string.IsNullOrEmpty(_selected)) return;
        MudDialog?.Close(DialogResult.Ok(_selected));
    }
}
