@* InodeDetail.razor *@
@page "/inodes/{InodeId}"
@using System.Text.Json
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@using TreeGraph.Shared.NodeEavSky.Dtos
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TreeGraph.Blazor.Shared.Platform.IPlatformContext Platform
@* InodeDetail.razor *@
<PageTitle>iNode @InodeId</PageTitle>

<PageHeaderSky Title="iNode 详情"
               ArrowBackVisible="true"
               OnArrowBackClick="BackToList">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="OpenAttachDialog">
            声明新类型
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.AddCircleOutline"
                   OnClick="OpenCreateBindingAsync">
            新建绑定
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.DataObject"
                   OnClick="OpenJsonDrawer">
            JSON 预览
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   OnClick="ReloadAsync" Disabled="@_loading">
            刷新
        </MudButton>
    </Actions>
</PageHeaderSky>

<MudPaper Class="@(Platform.IsCompact ? "pa-2 mb-3" : "pa-3 mb-4")">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">iNode ID</MudText>
        <code>@InodeId</code>
        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                       Size="Size.Small" OnClick="CopyId" title="复制" />
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_cards is null || _cards.Count == 0)
{
    <EmptyStateSky Icon="@Icons.Material.Outlined.Inbox"
                   Title="该 iNode 尚未声明任何类型">
        <Description>
            <text>点击下方按钮，为该 iNode 声明它会使用的属性定义</text>
        </Description>
        <Action>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Outlined.Add"
                       OnClick="OpenAttachDialog">
                声明新类型
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.AddCircleOutline"
                       OnClick="OpenCreateBindingAsync">
                新建绑定
            </MudButton>
        </Action>
    </EmptyStateSky>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">
        类型卡片（@_cards.Count）
    </MudText>

    <MudGrid>
        @foreach (var card in _cards)
        {
            var captured = card;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="1" Class="h-100">
                    <MudCardContent>
                        <div class="d-flex align-center flex-wrap mb-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Category"
                                     Color="@(captured.HasEntity ? Color.Success : Color.Default)"
                                     Size="Size.Medium" />
                            <MudText Typo="Typo.h6" Class="ml-2" Style="min-width: 0; overflow-wrap: anywhere;">
                                @captured.DisplayName
                            </MudText>
                            @if (captured.HasEntity)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="Color.Success" Class="ml-2">
                                    @(captured.BindingCount > 1
                                        ? $"{captured.BindingCount} 条绑定"
                                        : "已绑定")
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="Color.Warning" Class="ml-2">
                                    未填写
                                </MudChip>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            <code>@captured.EntityType</code>
                        </MudText>

                        @if (!string.IsNullOrEmpty(captured.Description))
                        {
                            <MudText Typo="Typo.caption" Class="mt-1">
                                @captured.Description
                            </MudText>
                        }

                        @if (captured.EntityUpdatedAt is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                最近更新：@captured.EntityUpdatedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@(captured.HasEntity
                                       ? Icons.Material.Outlined.Edit
                                       : Icons.Material.Outlined.Add)"
                                   OnClick="@(() => GoToEdit(captured))">
                            @(captured.BindingCount > 1
                                ? "绑定"
                                : captured.HasEntity ? "编辑" : "填写")
                        </MudButton>
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Text"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Outlined.History"
                                   OnClick="@(() => GoToHistory(captured))"
                                   Disabled="@(!captured.HasEntity)">
                            历史
                        </MudButton>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                       Size="Size.Medium"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DetachAsync(captured))"
                                       title="取消声明" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@* ============================================================ *@
@* ★ JSON 预览抽屉（右侧滑出；桌面 600px，紧凑全宽） *@
@* ============================================================ *@
<MudDrawer @bind-Open="_jsonDrawerOpen"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Elevation="4"
           Width="@(Platform.IsCompact ? "100%" : "600px")">
    <MudPaper Class="@(Platform.IsCompact ? "pa-2" : "pa-4")" Style="height: 100%; display: flex; flex-direction: column;">

        @* 标题区 *@
        <div class="d-flex align-center mb-3">
            <MudIcon Icon="@Icons.Material.Outlined.DataObject"
                     Color="Color.Info" Class="mr-2" Size="Size.Small" />
            <MudText Typo="Typo.h6">原始 JSON 预览</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Medium"
                           OnClick="@(() => _jsonDrawerOpen = false)"
                           title="关闭" />
        </div>

        @* 选项开关 *@
        <MudPaper Class="pa-3 mb-3" Outlined="true" Elevation="0">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                选项（切换后自动刷新）
            </MudText>
            <div class="d-flex flex-wrap" style="gap: 12px;">
                <MudSwitch T="bool"
                           Value="_jsonIncludeNull"
                           ValueChanged="OnIncludeNullChanged"
                           Label="includeNull"
                           Color="Color.Primary" />
                <MudSwitch T="bool"
                           Value="_jsonDisplayName"
                           ValueChanged="OnDisplayNameChanged"
                           Label="displayName"
                           Color="Color.Primary" />
            </div>
        </MudPaper>

        @* 操作区 *@
        <div class="d-flex align-center flex-wrap mb-3" style="gap: 8px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Medium"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="LoadJsonAsync"
                       Disabled="_jsonLoading">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       Size="Size.Medium"
                       StartIcon="@Icons.Material.Outlined.ContentCopy"
                       OnClick="CopyJsonToClipboard"
                       Disabled="@(string.IsNullOrEmpty(_jsonText))">
                复制
            </MudButton>
            <MudSpacer />
            @if (!string.IsNullOrEmpty(_jsonText))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(_jsonText.Length) 字符
                </MudText>
            }
        </div>

        @* JSON 内容区 *@
        @if (_jsonLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (string.IsNullOrEmpty(_jsonText))
        {
            <EmptyStateSky Icon="@Icons.Material.Outlined.DataObject"
                           Title="暂无数据">
                <Description>
                    <text>可能 iNode 下没有任何属性数据。</text>
                </Description>
            </EmptyStateSky>
        }
        else
        {
            <MudPaper Class="pa-3" Outlined="true" Elevation="0"
                      Style="flex: 1; overflow: auto;
                             background: var(--mud-palette-background-gray);
                             font-family: 'Consolas', 'Menlo', monospace;
                             font-size: 12px;
                             white-space: pre;">
                <pre class="ma-0">@_jsonText</pre>
            </MudPaper>
        }
    </MudPaper>
</MudDrawer>

@code {
    [Parameter] public string InodeId { get; set; } = "";

    private IReadOnlyList<InodeTypeCardDto>? _cards;

    /// <summary>该 iNode 下的全部命名绑定（用于卡片跳转到编辑/历史页）。</summary>
    private IReadOnlyList<InodeBindingDto>? _bindings;

    private IReadOnlyList<EntityTypeSummaryDto>? _allTypes;
    private bool _loading;
    private bool _initialized;

    // ★ JSON 预览状态
    private bool _jsonDrawerOpen;
    private bool _jsonLoading;
    private string? _jsonText;
    private bool _jsonIncludeNull;
    private bool _jsonDisplayName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        await LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var cardsTask = Api.ListInodeTypeCardsAsync(InodeId);
            var bindingsTask = Api.ListInodeBindingsAsync(InodeId);
            await Task.WhenAll(cardsTask, bindingsTask);

            _cards = cardsTask.Result;
            _bindings = bindingsTask.Result;

            _allTypes = await Api.ListEntityTypesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private void BackToList() => Nav.NavigateTo("/inodes");

    private void CopyId() => Snackbar.Add($"iNode ID: {InodeId}", Severity.Info);

    /// <summary>
    /// 进入该类型的绑定编辑页：已有绑定则进第一条，
    /// 尚无绑定时先让用户输入绑定名并新建。
    /// </summary>
    private async Task GoToEdit(InodeTypeCardDto card)
    {
        var binding = _bindings?
            .FirstOrDefault(b => b.EntityType == card.EntityType);

        if (binding is null)
        {
            var name = await PromptBindingNameAsync(
                $"为「{card.DisplayName}」新建绑定", "新建");
            if (name is null) return;

            var (bindingId, error) = await Api.CreateInodeBindingAsync(
                InodeId, card.EntityType, name);
            if (bindingId is null)
            {
                Snackbar.Add($"新建绑定失败：{error ?? "未知错误"}", Severity.Error);
                return;
            }

            await LoadAsync();
            NavigateBinding(bindingId);
            return;
        }

        NavigateBinding(binding.BindingId);
    }

    private async Task GoToHistory(InodeTypeCardDto card)
    {
        var binding = _bindings?
            .FirstOrDefault(b => b.EntityType == card.EntityType);
        if (binding is null)
        {
            Snackbar.Add("该类型下尚无绑定", Severity.Warning);
            return;
        }

        Nav.NavigateTo(
            $"/inodes/{Uri.EscapeDataString(InodeId)}/bindings/" +
            $"{Uri.EscapeDataString(binding.BindingId)}/history");
    }

    private void NavigateBinding(string bindingId)
        => Nav.NavigateTo(
            $"/inodes/{Uri.EscapeDataString(InodeId)}/bindings/" +
            $"{Uri.EscapeDataString(bindingId)}");

    private async Task<string?> PromptBindingNameAsync(string title, string submitText)
    {
        var parameters = new DialogParameters
        {
            { nameof(BindingNameDialog.Title), title },
            { nameof(BindingNameDialog.SubmitText), submitText },
            { nameof(BindingNameDialog.HelperText), "同一类型下绑定名不可重复" }
        };

        var dialog = await DialogService.ShowAsync<BindingNameDialog>(title, parameters);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not string name)
            return null;

        return string.IsNullOrWhiteSpace(name) ? null : name.Trim();
    }

    // ============================================================
    // ★ JSON 预览
    // ============================================================

    private async Task OpenJsonDrawer()
    {
        _jsonDrawerOpen = true;
        await LoadJsonAsync();
    }

    private async Task LoadJsonAsync()
    {
        _jsonLoading = true;
        try
        {
            var raw = await Api.GetInodeJsonAsync(
                InodeId,
                includeNull: _jsonIncludeNull,
                displayName: _jsonDisplayName);

            _jsonText = PrettyPrint(raw);
        }
        finally
        {
            _jsonLoading = false;
        }
    }

    // 注意：必须先写回字段再刷新。若只更新 UI 不写字段，
    // 查询参数会静默保持旧值（CS0649 警告即此信号）。
    private async Task OnIncludeNullChanged(bool value)
    {
        _jsonIncludeNull = value;
        await LoadJsonAsync();
    }

    private async Task OnDisplayNameChanged(bool value)
    {
        _jsonDisplayName = value;
        await LoadJsonAsync();
    }

    /// <summary>把单行 JSON 美化为缩进 2 空格的多行文本。</summary>
    private static string? PrettyPrint(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw;
        try
        {
            using var doc = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch (JsonException)
        {
            // 不是合法 JSON，原样返回
            return raw;
        }
    }

    private async Task CopyJsonToClipboard()
    {
        if (string.IsNullOrEmpty(_jsonText)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _jsonText);
            Snackbar.Add("已复制到剪贴板", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"复制失败：{ex.Message}", Severity.Error);
        }
    }

    // ============================================================
    // 声明类型
    // ============================================================

    // ============================================================
    // 新建绑定（选类型 + 输绑定名，一步完成）
    // ============================================================

    private async Task OpenCreateBindingAsync()
    {
        var parameters = new DialogParameters
        {
            { nameof(BindingCreateDialog.NodeId), InodeId },
            { nameof(BindingCreateDialog.DialogContext),
              "为该 iNode 新建命名绑定：同一类型可建多条绑定，每条绑定拥有独立的属性数据。" }
        };

        var dialog = await DialogService.ShowAsync<BindingCreateDialog>(
            "新建绑定", parameters);
        var result = await dialog.Result;

        if (result?.Canceled != false
            || result.Data is not BindingCreateDialog.CreatedBinding)
        {
            return;
        }

        await LoadAsync();

        // 抽屉开着时也刷新 JSON
        if (_jsonDrawerOpen) await LoadJsonAsync();

        StateHasChanged();
    }

    private async Task OpenAttachDialog()
    {
        var declared = _cards?.Select(c => c.EntityType).ToHashSet()
                       ?? new HashSet<string>();
        var available = _allTypes?
            .Where(t => !declared.Contains(t.EntityType))
            .ToList();

        var parameters = new DialogParameters
        {
            { nameof(AttachTypeDialog.AvailableTypes), available }
        };

        var dialog = await DialogService.ShowAsync<AttachTypeDialog>("声明新类型", parameters);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not string entityType)
            return;

        var (ok, error) = await Api.AttachInodeTypeAsync(InodeId, entityType);
        if (!ok)
        {
            Snackbar.Add($"声明失败：{error ?? "未知错误"}", Severity.Error);
            return;
        }

        Snackbar.Add("声明成功", Severity.Success);
        await LoadAsync();

        // 抽屉开着时也刷新 JSON
        if (_jsonDrawerOpen) await LoadJsonAsync();

        StateHasChanged();
    }

    private async Task DetachAsync(InodeTypeCardDto card)
    {
        if (card.HasEntity)
        {
            Snackbar.Add("该类型下仍有绑定，请先删除全部绑定", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认取消声明",
            $"确定取消类型「{card.DisplayName}」的声明？",
            yesText: "取消声明", cancelText: "关闭");

        if (confirmed != true) return;

        var (ok, error) = await Api.DetachInodeTypeAsync(
            InodeId, card.EntityType);
        if (!ok)
        {
            Snackbar.Add($"取消失败：{error ?? "未知错误"}", Severity.Error);
            return;
        }

        Snackbar.Add("已取消声明", Severity.Success);
        await LoadAsync();

        // 抽屉开着时也刷新 JSON
        if (_jsonDrawerOpen) await LoadJsonAsync();

        StateHasChanged();
    }

}
