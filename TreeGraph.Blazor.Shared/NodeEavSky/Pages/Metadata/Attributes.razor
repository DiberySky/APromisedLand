@* Attributes.razor — 属性定义管理（对话框内容组件，由 AttributesManageDialog 承载）
   属性已全局化，不再按实体类型过滤。 *@
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudTable Items="_attributes" Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">排序</MudTh>
        <MudTh>属性名</MudTh>
        <MudTh Style="text-align: center;">类型</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           Color="Color.Success"
                           OnClick="OpenCreateAsync"
                           title="新建属性" />
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="排序" Style="text-align: right;">
            <div class="d-flex flex-nowrap justify-end gap-2 align-center">
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                               Size="Size.Small"
                               OnClick="@(async () => await MoveAsync(context, -1))"
                               Disabled="@(_moving || !CanMove(context, -1))"
                               title="上移" />
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                               Size="Size.Small"
                               OnClick="@(async () => await MoveAsync(context, 1))"
                               Disabled="@(_moving || !CanMove(context, 1))"
                               title="下移" />
            </div>
        </MudTd>
        <MudTd DataLabel="属性名">
            @* 中文（英文内部标识），统一默认色 *@
            <MudText Typo="Typo.body2">@context.DisplayName (@context.AttributeName)</MudText>
        </MudTd>
        <MudTd DataLabel="类型" Style="text-align: center;">
            <MudChip T="string" Size="Size.Small"
                     Color="@GetDataTypeColor(context.DataType)">
                @EavDataTypeLabels.GetLabel(context.DataType)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="操作" Style="text-align: right;">
            <div class="d-flex flex-nowrap justify-end">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(async () => await DeleteAsync(context))"
                               title="删除" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(async () => await OpenEditAsync(context))"
                               title="编辑" />
            </div>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.ListAlt"
                       Title="暂无属性定义">
            <Description>
                <text>点击表头「＋」添加第一个属性</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>属性变更后回调（通知父对话框/宿主刷新）。</summary>
    [Parameter] public EventCallback OnAttributesChanged { get; set; }

    private IReadOnlyList<AttributeDetailDto>? _attributes;
    private bool _loading;
    private bool _moving;

    private IReadOnlyList<CompositeTypeDetailDto>? _compositeTypes;
    private IReadOnlyList<CustomTableDetailDto>? _customTables;
    private IReadOnlyList<OptionSetSummaryDto>? _optionSets;

    /// <summary>新建/编辑属性弹窗选项：窄版，带最大化按钮。</summary>
    private static readonly DialogOptionsEx CreateDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        MaximizeButton = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadReferencesAsync();
        await LoadAsync();
    }

    private async Task LoadReferencesAsync()
    {
        var compTask = Api.ListCompositeTypesAsync();
        var tablesTask = Api.ListCustomTablesAsync();
        var optTask = Api.ListOptionSetsAsync();
        await Task.WhenAll(compTask, tablesTask, optTask);

        _compositeTypes = compTask.Result;
        _customTables = tablesTask.Result;
        _optionSets = optTask.Result;

        var failed = new List<string>();
        if (_compositeTypes is null) failed.Add("组合类型");
        if (_customTables is null) failed.Add("自定义表");
        if (_optionSets is null) failed.Add("选项集");
        if (failed.Count > 0)
            Snackbar.Add($"引用加载失败：{string.Join("、", failed)}", Severity.Warning);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _attributes = await Api.ListAttributesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 新建 ----------

    private async Task OpenCreateAsync()
    {
        var parameters = new DialogParameters<AttributeCreateDialog>
        {
            { x => x.InitialDisplayOrder, (_attributes?.Count ?? 0) + 1 },
            { x => x.CompositeTypes, _compositeTypes },
            { x => x.CustomTables, _customTables },
            { x => x.OptionSets, _optionSets }
        };

        var dialog = await DialogService.ShowExAsync<AttributeCreateDialog>(
            string.Empty, parameters, CreateDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnAttributesChanged.InvokeAsync();
        }
    }

    // ---------- 编辑 ----------

    private async Task OpenEditAsync(AttributeDetailDto attr)
    {
        var detail = await Api.GetAttributeAsync(attr.AttributeId);
        if (detail is null)
        {
            Snackbar.Add("加载详情失败", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<AttributeEditDialog>
        {
            { x => x.Attribute, detail },
            { x => x.CompositeTypes, _compositeTypes },
            { x => x.CustomTables, _customTables },
            { x => x.OptionSets, _optionSets }
        };

        var dialog = await DialogService.ShowExAsync<AttributeEditDialog>(
            string.Empty, parameters, CreateDialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await OnAttributesChanged.InvokeAsync();
        }
    }

    // ---------- 删除 ----------

    private async Task DeleteAsync(AttributeDetailDto attr)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除属性「{attr.DisplayName}」？" +
            "删除后定义与数据一并移除，且不可恢复。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteAttributeAsync(attr.AttributeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
            await OnAttributesChanged.InvokeAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 排序 ----------

    private bool CanMove(AttributeDetailDto attr, int delta)
    {
        if (_attributes is null) return false;
        var i = IndexOf(attr);
        var j = i + delta;
        return i >= 0 && j >= 0 && j < _attributes.Count;
    }

    private int IndexOf(AttributeDetailDto attr)
    {
        if (_attributes is null) return -1;
        for (var i = 0; i < _attributes.Count; i++)
        {
            if (_attributes[i].AttributeId == attr.AttributeId) return i;
        }
        return -1;
    }

    /// <summary>
    /// 与相邻行交换显示顺序：正常情况互换两行的 DisplayOrder；
    /// 两行顺序值相同（历史数据重复）时按当前展示位置重排 1..N 兜底。
    /// </summary>
    private async Task MoveAsync(AttributeDetailDto attr, int delta)
    {
        if (_attributes is null || _moving) return;

        var list = _attributes.ToList();
        var i = IndexOf(attr);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= list.Count) return;

        var moves = new List<(string Id, int Order)>();
        if (list[i].DisplayOrder == list[j].DisplayOrder)
        {
            for (var k = 0; k < list.Count; k++)
            {
                var target = k == i ? j + 1 : k == j ? i + 1 : k + 1;
                if (list[k].DisplayOrder != target)
                    moves.Add((list[k].AttributeId, target));
            }
        }
        else
        {
            moves.Add((list[i].AttributeId, list[j].DisplayOrder));
            moves.Add((list[j].AttributeId, list[i].DisplayOrder));
        }

        _moving = true;
        try
        {
            foreach (var (id, order) in moves)
            {
                var (ok, error) = await Api.UpdateAttributeAsync(
                    id, new UpdateAttributeRequest { DisplayOrder = order });
                if (!ok)
                {
                    Snackbar.Add($"调整顺序失败：{error ?? "未知错误"}", Severity.Error);
                    return;
                }
            }

            await LoadAsync();
            await OnAttributesChanged.InvokeAsync();
        }
        finally
        {
            _moving = false;
        }
    }

    // ---------- 辅助 ----------

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        "table" => Color.Info,
        "file" => Color.Default,
        "relation" => Color.Secondary,
        _ => Color.Default
    };
}
