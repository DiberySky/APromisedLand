@* OptionSets.razor — 选项集管理（对话框已抽取为 DialogService 组件，见 Components/Dialogs/OptionSet*Dialog.razor）
   支持对话框模式：IsDialogMode=true 时隐藏 PageHeaderSky。 *@
@page "/metadata/option-sets"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!IsDialogMode)
{
    <PageTitle>选项集管理</PageTitle>

    <PageHeaderSky Title="选项集管理">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateSetAsync"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                新建选项集
            </MudButton>
        </Actions>
    </PageHeaderSky>
}

@* 过滤器栏（无 MudPaper 包裹）；对话框模式下追加新建按钮 *@
<MudGrid Class="mb-4">
    <MudItem xs="12" md="4" Class="d-flex align-center">
        <MudTextField @bind-Value="_entityType" Label="实体类型（可选）"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="留空显示全部" />
    </MudItem>
    @if (IsDialogMode)
    {
        <MudItem xs="12" md="8" Class="d-flex justify-end align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="@_loading"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Class="mr-2">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateSetAsync"
                       StartIcon="@Icons.Material.Filled.Add">
                新建选项集
            </MudButton>
        </MudItem>
    }
</MudGrid>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_sets is null || _sets.Count == 0)
{
    <EmptyStateSky Icon="@Icons.Material.Filled.Checklist"
                   Title="暂无选项集">
        <Description>
            <text>点击"新建选项集"创建第一个</text>
        </Description>
    </EmptyStateSky>
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var set in _sets)
        {
            var currentSet = set;
            var items = _itemsCache.TryGetValue(currentSet.OptionSetId, out var list)
                ? list
                : new List<OptionItemDetailDto>();

            <MudExpansionPanel @key="currentSet.OptionSetId">
                <TitleContent>
                    <div class="d-flex align-center" style="width: 100%; min-width: 0;">
                        <div class="d-flex align-center" style="flex: 1 1 auto; min-width: 0; overflow: hidden;">
                        <MudIcon Icon="@Icons.Material.Filled.Checklist"
                                 Color="Color.Primary"
                                 Class="mr-2" />
                        <MudText Typo="Typo.subtitle1"
                                 Style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @currentSet.DisplayName
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                 Class="ml-2">
                            @currentSet.SetName
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                 Class="ml-2">
                            @currentSet.EntityType
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                 Class="ml-2">
                            @items.Count 项
                        </MudChip>
                        </div>
                        <div class="d-flex align-center" style="flex: 0 0 auto;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Medium"
                                       OnClick="@(async () => await OpenEditSetAsync(currentSet))"
                                       title="编辑选项集" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Medium"
                                       OnClick="@(async () => await DeleteSetAsync(currentSet))"
                                       title="删除选项集" />
                        </div>
                    </div>
                </TitleContent>

                <ChildContent>
                    <div class="d-flex mb-3 justify-end">
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(async () => await OpenAddItemAsync(currentSet))">
                            添加选项
                        </MudButton>
                    </div>

                    @if (items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">
                            该选项集暂无选项
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="items" Bordered="true"
                                  Hover="true">
                            <HeaderContent>
                                <MudTh>Value</MudTh>
                                <MudTh>Label</MudTh>
                                <MudTh>顺序</MudTh>
                                <MudTh>默认</MudTh>
                                <MudTh>状态</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <code>@context.Value</code>
                                </MudTd>
                                <MudTd>@context.Label</MudTd>
                                <MudTd>@context.DisplayOrder</MudTd>
                                <MudTd>
                                    @if (context.IsDefault)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star"
                                                 Color="Color.Warning"
                                                 Size="Size.Small" />
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="Color.Success">
                                        启用
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                                   Size="Size.Medium"
                                                   OnClick="@(async () => await MoveUpAsync(currentSet, context))"
                                                   title="上移" />
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                                   Size="Size.Medium"
                                                   OnClick="@(async () => await MoveDownAsync(currentSet, context))"
                                                   title="下移" />
                                    @if (!context.IsDefault)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.StarBorder"
                                                       Size="Size.Medium"
                                                       Color="Color.Warning"
                                                       OnClick="@(async () => await SetDefaultAsync(currentSet, context))"
                                                       title="设为默认" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Medium"
                                                   Color="Color.Primary"
                                                   OnClick="@(async () => await OpenEditItemAsync(currentSet, context))"
                                                   title="编辑" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Medium"
                                                   Color="Color.Error"
                                                   OnClick="@(async () => await DeleteItemAsync(currentSet, context))"
                                                   title="删除" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    /// <summary>对话框模式：隐藏页头，刷新/新建按钮移至过滤器栏右侧。</summary>
    [Parameter] public bool IsDialogMode { get; set; }

    private string? _entityType;
    private IReadOnlyList<OptionSetSummaryDto>? _sets;
    private readonly Dictionary<string, List<OptionItemDetailDto>> _itemsCache = new();
    private bool _loading;
    private bool _initialized;

    /// <summary>桌面端对话框选项：DialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _sets = await Api.ListOptionSetsAsync(_entityType);
            if (_sets is null)
            {
                Snackbar.Add("加载失败，请检查后端服务", Severity.Error);
                _sets = Array.Empty<OptionSetSummaryDto>();
                _itemsCache.Clear();
                return;
            }

            if (_sets.Count == 0)
            {
                _itemsCache.Clear();
                return;
            }

            var tasks = _sets.Select(async set =>
            {
                var items = await Api.ListOptionItemsAsync(set.OptionSetId);
                return (set.OptionSetId, Items: items);
            });

            var results = await Task.WhenAll(tasks);

            _itemsCache.Clear();
            int failedCount = 0;
            foreach (var (setId, items) in results)
            {
                if (items is null) failedCount++;
                _itemsCache[setId] = items?.ToList() ?? new List<OptionItemDetailDto>();
            }

            if (failedCount > 0)
                Snackbar.Add($"{failedCount} 个选项集的选项加载失败", Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadItemsAsync(string optionSetId)
    {
        var items = await Api.ListOptionItemsAsync(optionSetId);
        _itemsCache[optionSetId] = items?.ToList() ?? new List<OptionItemDetailDto>();
    }

    // ---------- 选项集 CRUD ----------

    private async Task OpenCreateSetAsync()
    {
        var dialog = await DialogService.ShowAsync<OptionSetCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditSetAsync(OptionSetSummaryDto set)
    {
        var parameters = new DialogParameters<OptionSetEditDialog>
        {
            { x => x.Set, set }
        };

        var dialog = await DialogService.ShowAsync<OptionSetEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteSetAsync(OptionSetSummaryDto set)
    {
        var refs = await Api.GetOptionSetReferencesAsync(set.OptionSetId);
        if (refs is not null && refs.Count > 0)
        {
            var refList = string.Join("\n",
                refs.Select(r => $"  · {r.EntityType}.{r.AttributeName} ({r.DisplayName})"));
            await DialogService.ShowMessageBoxAsync(
                "无法删除",
                $"选项集「{set.DisplayName}」仍被以下属性引用：\n{refList}\n\n请先解除引用。",
                yesText: "知道了");
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除选项集「{set.DisplayName}」？删除后不可恢复。\n\n" +
            "仍有选项时需先删除全部选项。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteOptionSetAsync(set.OptionSetId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 选项 CRUD ----------

    private async Task OpenAddItemAsync(OptionSetSummaryDto set)
    {
        var existingCount = _itemsCache.TryGetValue(set.OptionSetId, out var items)
            ? items.Count(i => !i.IsDeleted)
            : 0;

        var parameters = new DialogParameters<OptionSetItemDialog>
        {
            { x => x.Set, set },
            { x => x.InitialDisplayOrder, existingCount + 1 }
        };

        var dialog = await DialogService.ShowAsync<OptionSetItemDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadItemsAsync(set.OptionSetId);
        }
    }

    private async Task OpenEditItemAsync(
        OptionSetSummaryDto set, OptionItemDetailDto item)
    {
        var parameters = new DialogParameters<OptionSetItemDialog>
        {
            { x => x.Set, set },
            { x => x.EditingItem, item }
        };

        var dialog = await DialogService.ShowAsync<OptionSetItemDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await ReloadItemsAsync(set.OptionSetId);
        }
    }

    private async Task DeleteItemAsync(
        OptionSetSummaryDto set, OptionItemDetailDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除选项「{item.Label}」({item.Value})？" +
            "已有数据中引用的该值仍会保留，读取时降级显示。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteOptionItemAsync(set.OptionSetId, item.OptionItemId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await ReloadItemsAsync(set.OptionSetId);
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 设为默认 ----------

    private async Task SetDefaultAsync(
        OptionSetSummaryDto set, OptionItemDetailDto item)
    {
        var (ok, error) = await Api.UpdateOptionItemAsync(
            set.OptionSetId, item.OptionItemId,
            new UpdateOptionItemRequest { IsDefault = true });

        if (!ok)
        {
            Snackbar.Add($"设置默认失败：{error ?? "未知错误"}", Severity.Error);
            return;
        }

        Snackbar.Add($"已将「{item.Label}」设为默认", Severity.Success);
        await ReloadItemsAsync(set.OptionSetId);
    }

    // ---------- 重排序（上移 / 下移） ----------

    private async Task MoveUpAsync(
        OptionSetSummaryDto set, OptionItemDetailDto item)
    {
        var items = _itemsCache[set.OptionSetId]
            .Where(i => !i.IsDeleted)
            .OrderBy(i => i.DisplayOrder)
            .ThenBy(i => i.OptionItemId)
            .ToList();

        var idx = items.FindIndex(i => i.OptionItemId == item.OptionItemId);
        if (idx <= 0) return;

        (items[idx - 1], items[idx]) = (items[idx], items[idx - 1]);
        await ApplyReorderAsync(set.OptionSetId, items);
    }

    private async Task MoveDownAsync(
        OptionSetSummaryDto set, OptionItemDetailDto item)
    {
        var items = _itemsCache[set.OptionSetId]
            .Where(i => !i.IsDeleted)
            .OrderBy(i => i.DisplayOrder)
            .ThenBy(i => i.OptionItemId)
            .ToList();

        var idx = items.FindIndex(i => i.OptionItemId == item.OptionItemId);
        if (idx < 0 || idx >= items.Count - 1) return;

        (items[idx + 1], items[idx]) = (items[idx], items[idx + 1]);
        await ApplyReorderAsync(set.OptionSetId, items);
    }

    private async Task ApplyReorderAsync(
        string optionSetId, List<OptionItemDetailDto> orderedItems)
    {
        var orders = orderedItems
            .Select((it, i) => new ReorderOptionItem
            {
                OptionItemId = it.OptionItemId,
                DisplayOrder = i + 1
            })
            .ToList();

        var (ok, error) = await Api.ReorderOptionItemsAsync(optionSetId, orders);

        if (!ok)
            Snackbar.Add($"重排序失败：{error ?? "未知错误"}", Severity.Error);

        await ReloadItemsAsync(optionSetId);
    }
}
