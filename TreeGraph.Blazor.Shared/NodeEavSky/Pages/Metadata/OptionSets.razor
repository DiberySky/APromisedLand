@* OptionSets.razor — 选项集定义管理（平铺表格，对齐组合定义模式；选项定义在独立对话框中管理）
   支持对话框模式：IsDialogMode=true 时隐藏 PageHeaderSky，新建按钮置于表头操作列。 *@
@page "/metadata/option-sets"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!IsDialogMode)
{
    <PageTitle>选项集定义管理</PageTitle>

    <PageHeaderSky Title="选项集定义管理">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateSetAsync"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                新建选项集
            </MudButton>
        </Actions>
    </PageHeaderSky>
}

<MudTable T="OptionSetSummaryDto" Items="_sets" Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>名称</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">选项定义</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            @if (IsDialogMode)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateSetAsync"
                               title="新建选项集" />
            }
            else
            {
                <text>操作</text>
            }
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <div class="d-flex align-center flex-nowrap">
                <MudText Typo="Typo.body1">@context.DisplayName</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">
                    @context.SetName
                </MudChip>
                @if (!string.IsNullOrWhiteSpace(context.EntityType))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-2">
                        @context.EntityType
                    </MudChip>
                }
            </div>
        </MudTd>
        <MudTd DataLabel="选项定义" Style="white-space: nowrap; text-align: center;">
            @* 图标入口：点击打开选项定义对话框并锁定该选项集；
               选项数量以徽标叠加在图标右上角 *@
            <MudBadge Content="@ItemCount(context.OptionSetId)" Color="Color.Info"
                      Overlap="true" Bordered="true" Max="99">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenItemsAsync(context))"
                               title="管理选项定义" />
            </MudBadge>
        </MudTd>
        <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(async () => await DeleteSetAsync(context))"
                           title="删除" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(() => OpenEditSetAsync(context))"
                           title="编辑" />
            <MudIconButton Icon="@(IsExpanded(context.OptionSetId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small"
                           Color="Color.Info"
                           OnClick="@(() => ToggleExpand(context.OptionSetId))"
                           title="查看选项" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (IsExpanded(context.OptionSetId))
        {
            var items = ItemsOf(context.OptionSetId);
            <MudTr>
                <td colspan="3" style="padding: 0;">
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background: var(--mud-palette-background-grey);">
                        @if (items.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">该选项集暂无选项</MudAlert>
                        }
                        else
                        {
                            @* 二级列表底色纯黑，与外层表格拉开层级 *@
                            <MudSimpleTable Dense="true" Bordered="true" Hover="true"
                                            Style="overflow-x: auto; background-color: #000;">
                                <thead>
                                    <tr>
                                        <th>显示名</th>
                                        <th>值</th>
                                        <th style="text-align: center;">默认</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in items)
                                    {
                                        <tr>
                                            <td>@item.Label</td>
                                            <td><code>@item.Value</code></td>
                                            <td style="text-align: center;">
                                                @if (item.IsDefault)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Star"
                                                             Color="Color.Warning" Size="Size.Small" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.Checklist"
                       Title="暂无选项集">
            <Description>
                <text>点击右上角 + 创建第一个</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>嵌入模式（对话框/选项卡）：隐藏页头与工具栏，新建按钮置于表头操作列。</summary>
    [Parameter] public bool IsDialogMode { get; set; }

    private IReadOnlyList<OptionSetSummaryDto>? _sets;
    private readonly Dictionary<string, List<OptionItemDetailDto>> _itemsCache = new();
    private bool _loading;
    private bool _initialized;

    /// <summary>桌面端对话框选项：DialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _sets = await Api.ListOptionSetsAsync();
            if (_sets is null)
            {
                Snackbar.Add("加载失败，请检查后端服务", Severity.Error);
                _sets = Array.Empty<OptionSetSummaryDto>();
                _itemsCache.Clear();
                return;
            }

            // 批量加载各选项集的选项（徽标计数 + 展开视图共用）
            var tasks = _sets.Select(async set =>
                (set.OptionSetId, Items: await Api.ListOptionItemsAsync(set.OptionSetId)));
            var results = await Task.WhenAll(tasks);

            _itemsCache.Clear();
            int failedCount = 0;
            foreach (var (setId, items) in results)
            {
                if (items is null) failedCount++;
                _itemsCache[setId] = items?
                    .Where(i => !i.IsDeleted)
                    .OrderBy(i => i.DisplayOrder)
                    .ThenBy(i => i.OptionItemId)
                    .ToList()
                    ?? [];
            }

            if (failedCount > 0)
                Snackbar.Add($"{failedCount} 个选项集的选项加载失败", Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 选项集 CRUD ----------

    private async Task OpenCreateSetAsync()
    {
        var dialog = await DialogService.ShowAsync<OptionSetCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditSetAsync(OptionSetSummaryDto set)
    {
        var parameters = new DialogParameters<OptionSetEditDialog>
        {
            { x => x.Set, set }
        };

        var dialog = await DialogService.ShowAsync<OptionSetEditDialog>(
            string.Empty, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteSetAsync(OptionSetSummaryDto set)
    {
        var refs = await Api.GetOptionSetReferencesAsync(set.OptionSetId);
        if (refs is not null && refs.Count > 0)
        {
            var refList = string.Join("\n",
                refs.Select(r => $"  · {r.EntityType}.{r.AttributeName} ({r.DisplayName})"));
            await DialogService.ShowMessageBoxAsync(
                "无法删除",
                $"选项集「{set.DisplayName}」仍被以下属性引用：\n{refList}\n\n请先解除引用。",
                yesText: "知道了");
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除选项集「{set.DisplayName}」？删除后不可恢复。\n\n" +
            "仍有选项时需先删除全部选项。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteOptionSetAsync(set.OptionSetId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 选项定义对话框 ----------

    /// <summary>打开独立选项定义对话框并锁定该选项集。</summary>
    private async Task OpenItemsAsync(OptionSetSummaryDto set)
    {
        var parameters = new DialogParameters<OptionSetItemsDialog>
        {
            { x => x.Set, set },
            { x => x.OnChanged, EventCallback.Factory.Create(this, LoadAsync) }
        };

        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };

        var dialog = await DialogService.ShowExAsync<OptionSetItemsDialog>(
            string.Empty, parameters, options);
        await dialog.Result;

        // 选项可能增删，关闭后刷新徽标计数
        await LoadAsync();
    }

    // ---------- 行内展开：选项二级列表（只读） ----------

    /// <summary>已展开行的选项集 ID。</summary>
    private readonly HashSet<string> _expandedIds = new();

    private bool IsExpanded(string optionSetId) => _expandedIds.Contains(optionSetId);

    /// <summary>切换展开（选项数据已批量加载，无需请求）。</summary>
    private void ToggleExpand(string optionSetId)
    {
        if (!_expandedIds.Add(optionSetId))
            _expandedIds.Remove(optionSetId);
    }

    /// <summary>选项集的活动选项数（徽标）。</summary>
    private int ItemCount(string optionSetId)
        => _itemsCache.TryGetValue(optionSetId, out var items) ? items.Count : 0;

    /// <summary>选项集的活动选项列表（已按顺序排好）。</summary>
    private List<OptionItemDetailDto> ItemsOf(string optionSetId)
        => _itemsCache.TryGetValue(optionSetId, out var items) ? items : [];
}
