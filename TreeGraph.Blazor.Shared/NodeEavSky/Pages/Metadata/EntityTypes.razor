@* EntityTypes.razor — 实体类型管理（对话框已抽取为 DialogService 组件，见 Components/Dialogs/EntityTypeEditDialog.razor）
   支持对话框模式：IsDialogMode=true 时隐藏 PageHeaderSky，新建按钮移至内容区顶部。 *@
@page "/metadata/entity-types"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject EntityTypeDisplayService EntityTypeDisplay
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@using TreeGraph.Shared.NodeEavSky.Dtos

@if (!IsDialogMode)
{
    <PageTitle>实体类型管理</PageTitle>

    <PageHeaderSky Title="实体类型管理">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="@_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateAsync"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                新建实体类型
            </MudButton>
        </Actions>
    </PageHeaderSky>
}
else
{
    @* 嵌入模式（对话框/选项卡）：无独立工具栏，与 SpaceManagePanel 风格对齐——
       新建按钮置于表头操作列，行操作为右对齐小号图标 *@
}

<MudTable T="EntityTypeDetailDto" Items="_types" Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">排序</MudTh>
        <MudTh>名称</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">属性定义</MudTh>
        <MudTh>说明</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            @if (IsDialogMode)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateAsync"
                               title="新建实体类型" />
            }
            else
            {
                <text>操作</text>
            }
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="排序" Style="text-align: right;">
            @* 排序：与相邻行交换 DisplayOrder 并持久化 *@
            <div class="d-flex flex-nowrap justify-end gap-2 align-center">
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                               Size="Size.Small"
                               Disabled="@(_moving || !CanMove(context, -1))"
                               OnClick="@(async () => await MoveAsync(context, -1))"
                               title="上移" />
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                               Size="Size.Small"
                               Disabled="@(_moving || !CanMove(context, 1))"
                               OnClick="@(async () => await MoveAsync(context, 1))"
                               title="下移" />
            </div>
        </MudTd>
        <MudTd DataLabel="名称">
            @* 只显示 DisplayName（中文），不显示 et_xxx 内部标识 *@
            <MudText Typo="Typo.body1">@context.DisplayName</MudText>
        </MudTd>
        <MudTd DataLabel="属性定义" Style="white-space: nowrap; text-align: center;">
            @* 图标入口：点击打开独立属性定义对话框并锁定该类型；
               属性数量以徽标叠加在图标右上角 *@
            <MudBadge Content="@context.AttributeCount" Color="Color.Info"
                      Overlap="true" Bordered="true" Max="99">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenAttributesAsync(context))"
                               title="管理属性定义" />
            </MudBadge>
        </MudTd>
        <MudTd DataLabel="说明">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(string.IsNullOrEmpty(context.Description) ? "—" : context.Description)
            </MudText>
        </MudTd>
        <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(async () => await DeleteAsync(context))"
                           title="删除" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(async () => await OpenEditAsync(context))"
                           title="编辑" />
            <MudIconButton Icon="@(IsExpanded(context.EntityTypeId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small"
                           Color="Color.Info"
                           OnClick="@(async () => await ToggleExpandAsync(context))"
                           title="查看属性" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (IsExpanded(context.EntityTypeId))
        {
            <MudTr>
                <td colspan="5" style="padding: 0;">
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background: var(--mud-palette-background-grey);">
                        @if (_attrsLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Info" />
                        }
                        else
                        {
                            var attrs = GetAttrs(context.EntityTypeId);
                            if (attrs.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">该实体类型暂无属性</MudAlert>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Bordered="true" Hover="true"
                                                Style="overflow-x: auto;">
                                    <thead>
                                        <tr>
                                            <th>属性名</th>
                                            <th>显示名</th>
                                            <th>类型</th>
                                            <th>引用</th>
                                            <th>必填</th>
                                            <th>可搜索</th>
                                            <th>可排序</th>
                                            <th style="text-align: right;">顺序</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in attrs)
                                        {
                                            <tr>
                                                <td><code>@a.AttributeName</code></td>
                                                <td>@a.DisplayName</td>
                                                <td>
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@GetDataTypeColor(a.DataType)">
                                                        @EavDataTypeLabels.GetLabel(a.DataType)
                                                    </MudChip>
                                                </td>
                                                <td>
                                                    @if (a.UnitId is not null)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="mr-1">单位</MudChip>
                                                    }
                                                    @if (a.RefOptionSetId is not null)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mr-1">选项: @(a.OptionSetDisplayName ?? a.OptionSetName)</MudChip>
                                                    }
                                                    @if (a.RefCompositeTypeId is not null)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="mr-1">组合: @(a.CompositeTypeDisplayName ?? a.CompositeTypeName)</MudChip>
                                                    }
                                                    @if (a.RefTableDefinitionId is not null)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">表: @(a.TableDisplayName ?? a.TableName)</MudChip>
                                                    }
                                                </td>
                                                <td>
                                                    @if (a.IsRequired)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                </td>
                                                <td>
                                                    @if (a.IsSearchable)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                </td>
                                                <td>
                                                    @if (a.IsSortable)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                </td>
                                                <td style="text-align: right;">@a.DisplayOrder</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        }
                    </MudPaper>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.Category"
                       Title="暂无实体类型">
            <Description>
                <text>点击右上角 + 创建第一个</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>嵌入模式（对话框/选项卡）：隐藏页头与工具栏，新建按钮置于表头操作列。</summary>
    [Parameter] public bool IsDialogMode { get; set; }

    private IReadOnlyList<EntityTypeDetailDto>? _types;
    private bool _loading;
    private bool _initialized;
    /// <summary>排序提交中：期间禁用全部箭头，避免并发交换。</summary>
    private bool _moving;

    /// <summary>已展开行的实体类型 ID（key 用持久 ID 而非可变 EntityType 标识）。</summary>
    private readonly HashSet<string> _expandedIds = new();

    /// <summary>实体类型 ID → 该类型的属性列表（惰性加载缓存）。</summary>
    private readonly Dictionary<string, IReadOnlyList<AttributeDetailDto>> _attrsCache = new();

    /// <summary>属性列表拉取中（展开行显示 loading）。</summary>
    private bool _attrsLoading;

    /// <summary>桌面端对话框选项：DialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // ★ 1 次 HTTP 替代 1+N 次（原 foreach 串行 GetEntityTypeAsync）
            _types = await Api.ListEntityTypeDetailsAsync()
                     ?? Array.Empty<EntityTypeDetailDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 新建 / 编辑 ----------

    private async Task OpenCreateAsync()
    {
        var parameters = new DialogParameters<EntityTypeEditDialog>
        {
            { x => x.InitialDisplayOrder, (_types?.Count ?? 0) + 1 }
        };

        var dialog = await DialogService.ShowAsync<EntityTypeEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await RefreshDisplayMapAsync();
        }
    }

    private async Task OpenEditAsync(EntityTypeDetailDto dto)
    {
        var parameters = new DialogParameters<EntityTypeEditDialog>
        {
            { x => x.Editing, dto }
        };

        var dialog = await DialogService.ShowAsync<EntityTypeEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await RefreshDisplayMapAsync();
        }
    }

    /// <summary>刷新全局 DisplayName 映射，让 NavMenu 等页面立即生效。</summary>
    private async Task RefreshDisplayMapAsync()
    {
        EntityTypeDisplay.Invalidate();
        await EntityTypeDisplay.EnsureLoadedAsync();
    }

    // ---------- 排序 ----------

    /// <summary>当前展示位置能否向 delta 方向移动（首行不能上移、末行不能下移）。</summary>
    private bool CanMove(EntityTypeDetailDto dto, int delta)
    {
        var list = _types;
        if (list is null) return false;
        var index = IndexOf(list, dto);
        var target = index + delta;
        return index >= 0 && target >= 0 && target < list.Count;
    }

    private static int IndexOf(IReadOnlyList<EntityTypeDetailDto> list, EntityTypeDetailDto dto)
    {
        for (var i = 0; i < list.Count; i++)
        {
            if (list[i].EntityTypeId == dto.EntityTypeId) return i;
        }
        return -1;
    }

    /// <summary>
    /// 与相邻行交换 DisplayOrder 并持久化（复用 PUT api/eav/entity-types/{id}）。
    /// 两行顺序值相同（历史数据重复）时，按当前展示位置 1..N 兜底重排。
    /// </summary>
    private async Task MoveAsync(EntityTypeDetailDto dto, int delta)
    {
        var list = _types;
        if (_moving || list is null) return;

        var index = IndexOf(list, dto);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= list.Count) return;

        var other = list[target];
        var sameOrder = dto.DisplayOrder == other.DisplayOrder;

        _moving = true;
        try
        {
            var (ok, error) = await Api.UpdateEntityTypeAsync(
                dto.EntityTypeId,
                new UpdateEntityTypeRequest
                {
                    DisplayName = dto.DisplayName,
                    Description = dto.Description,
                    DisplayOrder = sameOrder ? target + 1 : other.DisplayOrder
                });
            if (!ok)
            {
                Snackbar.Add($"调整顺序失败：{error ?? "未知错误"}", Severity.Error);
                return;
            }

            var (okOther, errorOther) = await Api.UpdateEntityTypeAsync(
                other.EntityTypeId,
                new UpdateEntityTypeRequest
                {
                    DisplayName = other.DisplayName,
                    Description = other.Description,
                    DisplayOrder = sameOrder ? index + 1 : dto.DisplayOrder
                });
            if (!okOther)
            {
                Snackbar.Add($"调整顺序失败：{errorOther ?? "未知错误"}", Severity.Error);
                return;
            }
        }
        finally
        {
            _moving = false;
        }

        await LoadAsync();
    }

    /// <summary>打开独立属性定义对话框（属性已全局化，不再按类型锁定）。</summary>
    private async Task OpenAttributesAsync(EntityTypeDetailDto dto)
    {
        var parameters = new DialogParameters<AttributeDefinitionsDialog>
        {
            { x => x.OnAttributesChanged, EventCallback.Factory.Create(this, LoadAsync) }
        };

        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };

        var dialog = await DialogService.ShowExAsync<AttributeDefinitionsDialog>(
            string.Empty, parameters, options);
        await dialog.Result;

        // 属性可能增删，关闭后刷新属性数
        await LoadAsync();
    }

    private async Task DeleteAsync(EntityTypeDetailDto dto)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除实体类型「{dto.DisplayName}」？删除后不可恢复。\n\n" +
            "· 仍有活动属性时将被拒绝。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteEntityTypeAsync(dto.EntityTypeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
            EntityTypeDisplay.Invalidate();
            await EntityTypeDisplay.EnsureLoadedAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 行内展开：属性二级列表 ----------

    private bool IsExpanded(string entityTypeId) => _expandedIds.Contains(entityTypeId);

    private IReadOnlyList<AttributeDetailDto> GetAttrs(string entityTypeId)
        => _attrsCache.TryGetValue(entityTypeId, out var list)
            ? list
            : Array.Empty<AttributeDetailDto>();

    /// <summary>切换展开；首次展开时拉取属性列表（属性已全局化）。</summary>
    private async Task ToggleExpandAsync(EntityTypeDetailDto dto)
    {
        if (!_expandedIds.Add(dto.EntityTypeId))
        {
            _expandedIds.Remove(dto.EntityTypeId);
            return;
        }

        if (_attrsCache.ContainsKey(dto.EntityTypeId)) return;

        _attrsLoading = true;
        try
        {
            var list = await Api.ListAttributesAsync();
            _attrsCache[dto.EntityTypeId] =
                (list ?? Array.Empty<AttributeDetailDto>())
                .OrderBy(a => a.DisplayOrder).ToList();
        }
        catch
        {
            Snackbar.Add("属性加载失败", Severity.Warning);
            _attrsCache[dto.EntityTypeId] = Array.Empty<AttributeDetailDto>();
        }
        finally
        {
            _attrsLoading = false;
        }
    }

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        _ => Color.Default
    };
}
