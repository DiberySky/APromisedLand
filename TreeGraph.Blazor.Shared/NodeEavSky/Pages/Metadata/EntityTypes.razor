@* EntityTypes.razor — 实体类型管理（对话框已抽取为 DialogService 组件，见 Components/Dialogs/EntityTypeEditDialog.razor）
   支持对话框模式：IsDialogMode=true 时隐藏 PageHeaderSky，新建按钮移至内容区顶部。 *@
@page "/metadata/entity-types"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject EntityTypeDisplayService EntityTypeDisplay
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@using TreeGraph.Shared.NodeEavSky.Dtos

@if (!IsDialogMode)
{
    <PageTitle>实体类型管理</PageTitle>

    <PageHeaderSky Title="实体类型管理">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="@_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateAsync"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                新建实体类型
            </MudButton>
        </Actions>
    </PageHeaderSky>
}
else
{
    @* 嵌入模式（对话框/选项卡）：无独立工具栏，与 SpaceManagePanel 风格对齐——
       新建按钮置于表头操作列，行操作为右对齐小号图标 *@
}

<MudTable Items="_types" Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>名称</MudTh>
        <MudTh>设置</MudTh>
        <MudTh>说明</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            @if (IsDialogMode)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateAsync"
                               title="新建实体类型" />
            }
            else
            {
                <text>操作</text>
            }
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            @* 只显示 DisplayName（中文），不显示 et_xxx 内部标识 *@
            <MudText Typo="Typo.body1">@context.DisplayName</MudText>
        </MudTd>
        <MudTd DataLabel="设置">
            @* 图标入口（左）：点击打开独立属性定义对话框并锁定该类型；
               数量胶囊靠右展示 *@
            <div class="d-flex align-center justify-space-between">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenAttributesAsync(context))"
                               title="管理属性定义" />
                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                    @context.AttributeCount
                </MudChip>
            </div>
        </MudTd>
        <MudTd DataLabel="说明">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @(string.IsNullOrEmpty(context.Description) ? "—" : context.Description)
            </MudText>
        </MudTd>
        <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
            @if (!context.IsDeleted)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(async () => await DeleteAsync(context))"
                               title="删除" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(async () => await OpenEditAsync(context))"
                               title="编辑" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash"
                               Size="Size.Small"
                               Color="Color.Success"
                               OnClick="@(async () => await UndeleteAsync(context))"
                               title="恢复" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.Category"
                       Title="暂无实体类型">
            <Description>
                <text>点击右上角 + 创建第一个</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>嵌入模式（对话框/选项卡）：隐藏页头与工具栏，新建按钮置于表头操作列。</summary>
    [Parameter] public bool IsDialogMode { get; set; }

    private IReadOnlyList<EntityTypeDetailDto>? _types;
    private bool _loading;
    private bool _initialized;

    /// <summary>桌面端对话框选项：DialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // ★ 1 次 HTTP 替代 1+N 次（原 foreach 串行 GetEntityTypeAsync）
            _types = await Api.ListEntityTypeDetailsAsync()
                     ?? Array.Empty<EntityTypeDetailDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 新建 / 编辑 ----------

    private async Task OpenCreateAsync()
    {
        var parameters = new DialogParameters<EntityTypeEditDialog>
        {
            { x => x.InitialDisplayOrder, (_types?.Count ?? 0) + 1 }
        };

        var dialog = await DialogService.ShowAsync<EntityTypeEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await RefreshDisplayMapAsync();
        }
    }

    private async Task OpenEditAsync(EntityTypeDetailDto dto)
    {
        var parameters = new DialogParameters<EntityTypeEditDialog>
        {
            { x => x.Editing, dto }
        };

        var dialog = await DialogService.ShowAsync<EntityTypeEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
            await RefreshDisplayMapAsync();
        }
    }

    /// <summary>刷新全局 DisplayName 映射，让 NavMenu 等页面立即生效。</summary>
    private async Task RefreshDisplayMapAsync()
    {
        EntityTypeDisplay.Invalidate();
        await EntityTypeDisplay.EnsureLoadedAsync();
    }

    /// <summary>打开独立属性定义对话框并锁定该实体类型。</summary>
    private async Task OpenAttributesAsync(EntityTypeDetailDto dto)
    {
        var parameters = new DialogParameters<AttributeDefinitionsDialog>
        {
            { x => x.EntityType, dto.EntityType },
            { x => x.DisplayName, dto.DisplayName },
            { x => x.OnAttributesChanged, EventCallback.Factory.Create(this, LoadAsync) }
        };

        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            MaximizeButton = true
        };

        var dialog = await DialogService.ShowExAsync<AttributeDefinitionsDialog>(
            string.Empty, parameters, options);
        await dialog.Result;

        // 属性可能增删，关闭后刷新属性数
        await LoadAsync();
    }

    private async Task DeleteAsync(EntityTypeDetailDto dto)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除实体类型「{dto.DisplayName}」？\n\n" +
            "· 仍有活动属性时将被拒绝。\n" +
            "· 删除后可通过恢复按钮还原。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteEntityTypeAsync(dto.EntityTypeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
            EntityTypeDisplay.Invalidate();
            await EntityTypeDisplay.EnsureLoadedAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    private async Task UndeleteAsync(EntityTypeDetailDto dto)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认恢复",
            $"确定恢复实体类型「{dto.DisplayName}」？",
            yesText: "恢复", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.UndeleteEntityTypeAsync(dto.EntityTypeId);
        if (ok)
        {
            Snackbar.Add("恢复成功", Severity.Success);
            await LoadAsync();
            EntityTypeDisplay.Invalidate();
            await EntityTypeDisplay.EnsureLoadedAsync();
        }
        else
        {
            Snackbar.Add($"恢复失败：{error ?? "未知错误"}", Severity.Error);
        }
    }
}
