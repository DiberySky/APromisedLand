@* CustomTables.razor — 表格定义管理（平铺表格 + 排序列，对齐 EntityTypes 风格；列定义在独立对话框中管理）
   支持对话框模式：IsDialogMode=true 时隐藏 PageHeaderSky，新建按钮置于表头操作列。 *@
@page "/metadata/custom-tables"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!IsDialogMode)
{
    <PageTitle>表格定义管理</PageTitle>

    <PageHeaderSky Title="表格定义管理">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateTableAsync"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                新建自定义表
            </MudButton>
        </Actions>
    </PageHeaderSky>
}

<MudTable T="CustomTableDetailDto" Items="_tables" Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">排序</MudTh>
        <MudTh>名称</MudTh>
        <MudTh>TableName</MudTh>
        <MudTh>实体类型</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">列定义</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            @if (IsDialogMode)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateTableAsync"
                               title="新建自定义表" />
            }
            else
            {
                <text>操作</text>
            }
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="排序" Style="text-align: right;">
            @* 排序：与相邻行交换 DisplayOrder 并持久化 *@
            <div class="d-flex flex-nowrap justify-end gap-2 align-center">
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                               Size="Size.Small"
                               Disabled="@(_moving || !CanMove(context, -1))"
                               OnClick="@(async () => await MoveAsync(context, -1))"
                               title="上移" />
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                               Size="Size.Small"
                               Disabled="@(_moving || !CanMove(context, 1))"
                               OnClick="@(async () => await MoveAsync(context, 1))"
                               title="下移" />
            </div>
        </MudTd>
        <MudTd DataLabel="名称">
            <div class="d-flex align-center flex-nowrap">
                <MudText Typo="Typo.body1">@context.DisplayName</MudText>
                @* 时序记录专属表标记 *@
                @if (context.IsRecordTable)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary"
                             Class="ml-2" Icon="@Icons.Material.Filled.Lock">
                        时序
                    </MudChip>
                }
            </div>
        </MudTd>
        <MudTd DataLabel="TableName">
            <code>@context.TableName</code>
        </MudTd>
        <MudTd DataLabel="实体类型">
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                @context.EntityType
            </MudChip>
        </MudTd>
        <MudTd DataLabel="列定义" Style="white-space: nowrap; text-align: center;">
            @* 图标入口：点击打开列定义对话框并锁定该表；
               列数量以徽标叠加在图标右上角 *@
            <MudBadge Content="@context.Columns.Count(c => !c.IsDeleted)" Color="Color.Info"
                      Overlap="true" Bordered="true" Max="99">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenColumnsAsync(context))"
                               title="管理列定义" />
            </MudBadge>
        </MudTd>
        <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(async () => await DeleteTableAsync(context))"
                           title="删除" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(() => OpenEditTableAsync(context))"
                           title="编辑" />
            <MudIconButton Icon="@(IsExpanded(context.TableDefinitionId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small"
                           Color="Color.Info"
                           OnClick="@(() => ToggleExpand(context.TableDefinitionId))"
                           title="查看列" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (IsExpanded(context.TableDefinitionId))
        {
            var columns = context.Columns.Where(c => !c.IsDeleted)
                .OrderBy(c => c.DisplayOrder).ToList();
            <MudTr>
                <td colspan="6" style="padding: 0;">
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background: var(--mud-palette-background-grey);">
                        @if (columns.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">该自定义表暂无列</MudAlert>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Bordered="true" Hover="true"
                                            Style="overflow-x: auto;">
                                <thead>
                                    <tr>
                                        <th>列名</th>
                                        <th>显示名</th>
                                        <th>类型</th>
                                        <th>引用</th>
                                        <th>必填</th>
                                        <th>可搜索</th>
                                        <th>可排序</th>
                                        <th>唯一</th>
                                        <th style="text-align: right;">顺序</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < columns.Count; i++)
                                    {
                                        var c = columns[i];
                                        var locked = IsLockedTimeColumn(context, i);
                                        <tr>
                                            <td>
                                                <code>@c.ColumnName</code>
                                                @if (locked)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Lock"
                                                             Size="Size.Small" Color="Color.Tertiary"
                                                             Class="ml-1" />
                                                }
                                            </td>
                                            <td>@c.DisplayName</td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@GetDataTypeColor(c.DataType)">
                                                    @EavDataTypeLabels.GetLabel(c.DataType)
                                                </MudChip>
                                            </td>
                                            <td>
                                                @if (c.UnitId is not null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="mr-1">单位</MudChip>
                                                }
                                                @if (c.RefCompositeTypeId is not null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark">组合: @GetCompositeTypeName(c.RefCompositeTypeId)</MudChip>
                                                }
                                            </td>
                                            <td>
                                                @if (c.IsRequired)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>
                                                @if (c.IsSearchable)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>
                                                @if (c.IsSortable)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>
                                                @if (c.IsUnique)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td style="text-align: right;">@c.DisplayOrder</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.TableChart"
                       Title="暂无自定义表">
            <Description>
                <text>点击右上角 + 创建第一个</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>嵌入模式（对话框/选项卡）：隐藏页头与工具栏，新建按钮置于表头操作列。</summary>
    [Parameter] public bool IsDialogMode { get; set; }

    private IReadOnlyList<CustomTableDetailDto>? _tables;
    private IReadOnlyList<CompositeTypeDetailDto>? _compositeTypes;
    private bool _loading;
    private bool _initialized;
    /// <summary>排序提交中：期间禁用全部箭头，避免并发交换。</summary>
    private bool _moving;

    /// <summary>桌面端对话框选项：DialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadCompositeTypesAsync();
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadCompositeTypesAsync()
    {
        _compositeTypes = await Api.ListCompositeTypesAsync();
        if (_compositeTypes is null)
            Snackbar.Add("组合类型加载失败（列若需嵌套类型将不可选）", Severity.Warning);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var list = await Api.ListCustomTablesAsync();
            if (list is null)
            {
                Snackbar.Add("加载失败，请检查后端服务", Severity.Error);
                list = Array.Empty<CustomTableDetailDto>();
            }
            _tables = list.OrderBy(t => t.DisplayOrder).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 新建自定义表 ----------

    private async Task OpenCreateTableAsync()
    {
        var dialog = await DialogService.ShowAsync<CustomTableCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 编辑自定义表 ----------

    private async Task OpenEditTableAsync(CustomTableDetailDto table)
    {
        var parameters = new DialogParameters<CustomTableEditDialog>
        {
            { x => x.Table, table }
        };

        var dialog = await DialogService.ShowAsync<CustomTableEditDialog>(
            string.Empty, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 删除自定义表 ----------

    private async Task DeleteTableAsync(CustomTableDetailDto table)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除自定义表「{table.DisplayName}」？此操作将同时删除其所有列。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteCustomTableAsync(table.TableDefinitionId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 排序 ----------

    /// <summary>当前展示位置能否向 delta 方向移动（首行不能上移、末行不能下移）。</summary>
    private bool CanMove(CustomTableDetailDto dto, int delta)
    {
        var list = _tables;
        if (list is null) return false;
        var index = IndexOf(list, dto);
        var target = index + delta;
        return index >= 0 && target >= 0 && target < list.Count;
    }

    private static int IndexOf(IReadOnlyList<CustomTableDetailDto> list, CustomTableDetailDto dto)
    {
        for (var i = 0; i < list.Count; i++)
        {
            if (list[i].TableDefinitionId == dto.TableDefinitionId) return i;
        }
        return -1;
    }

    /// <summary>
    /// 与相邻行交换 DisplayOrder 并持久化（复用 PUT api/eav/custom-tables/{id}）。
    /// 两行顺序值相同（历史数据重复）时，按当前展示位置 1..N 兜底重排。
    /// </summary>
    private async Task MoveAsync(CustomTableDetailDto dto, int delta)
    {
        var list = _tables;
        if (_moving || list is null) return;

        var index = IndexOf(list, dto);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= list.Count) return;

        var other = list[target];
        var sameOrder = dto.DisplayOrder == other.DisplayOrder;

        _moving = true;
        try
        {
            var (ok, error) = await Api.UpdateCustomTableAsync(
                dto.TableDefinitionId,
                new UpdateCustomTableRequest
                {
                    DisplayName = dto.DisplayName,
                    DisplayOrder = sameOrder ? target + 1 : other.DisplayOrder
                });
            if (!ok)
            {
                Snackbar.Add($"调整顺序失败：{error ?? "未知错误"}", Severity.Error);
                return;
            }

            var (okOther, errorOther) = await Api.UpdateCustomTableAsync(
                other.TableDefinitionId,
                new UpdateCustomTableRequest
                {
                    DisplayName = other.DisplayName,
                    DisplayOrder = sameOrder ? index + 1 : dto.DisplayOrder
                });
            if (!okOther)
            {
                Snackbar.Add($"调整顺序失败：{errorOther ?? "未知错误"}", Severity.Error);
                return;
            }
        }
        finally
        {
            _moving = false;
        }

        await LoadAsync();
    }

    // ---------- 列定义对话框 ----------

    /// <summary>打开独立列定义对话框并锁定该自定义表。</summary>
    private async Task OpenColumnsAsync(CustomTableDetailDto table)
    {
        var parameters = new DialogParameters<CustomTableColumnsDialog>
        {
            { x => x.Table, table },
            { x => x.CompositeTypes, _compositeTypes },
            { x => x.OnChanged, EventCallback.Factory.Create(this, LoadAsync) }
        };

        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };

        var dialog = await DialogService.ShowExAsync<CustomTableColumnsDialog>(
            string.Empty, parameters, options);
        await dialog.Result;

        // 列可能增删，关闭后刷新列数徽标
        await LoadAsync();
    }

    // ---------- 行内展开：列二级列表 ----------

    /// <summary>已展开行的自定义表 ID。</summary>
    private readonly HashSet<string> _expandedIds = new();

    private bool IsExpanded(string tableDefinitionId) => _expandedIds.Contains(tableDefinitionId);

    /// <summary>切换展开（列数据已在 context.Columns，无需请求）。</summary>
    private void ToggleExpand(string tableDefinitionId)
    {
        if (!_expandedIds.Add(tableDefinitionId))
            _expandedIds.Remove(tableDefinitionId);
    }

    /// <summary>时序表时间维度列是否锁定（第 1 列日期、可选第 2 列时间）。</summary>
    private static bool IsLockedTimeColumn(CustomTableDetailDto table, int columnIndex)
        => table.IsRecordTable && columnIndex < (table.HasTimeColumn ? 2 : 1);

    /// <summary>组合引用的组合类型显示名。</summary>
    private string GetCompositeTypeName(string refCompositeTypeId)
        => _compositeTypes?.FirstOrDefault(t => t.CompositeTypeId == refCompositeTypeId)?.DisplayName
           ?? refCompositeTypeId;

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        _ => Color.Default
    };
}
