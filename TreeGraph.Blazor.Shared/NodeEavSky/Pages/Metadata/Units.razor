@* Units.razor — 单位管理（对话框已抽取为 DialogService 组件，见 Components/Dialogs/Unit*Dialog.razor） *@
@page "/metadata/units"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<PageTitle>单位管理</PageTitle>

<PageHeaderSky Title="单位管理">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="LoadAsync" Disabled="_loading"
                   StartIcon="@Icons.Material.Filled.Refresh">
            刷新
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   Size="Size.Small"
                   OnClick="OpenCreateAsync"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="ml-2">
            新建单位
        </MudButton>
    </Actions>
</PageHeaderSky>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_categories is null || _categories.Count == 0)
{
    <EmptyStateSky Icon="@Icons.Material.Filled.Straighten"
                   Title="暂无单位">
        <Description>
            <text>点击"新建单位"创建第一个</text>
        </Description>
    </EmptyStateSky>
}
else
{
    @foreach (var c in _categories)
    {
        <MudPaper Class="pa-4 mb-4">
            <div class="d-flex align-center flex-wrap mb-2">
                <MudText Typo="Typo.h6">@c.Category</MudText>
                @if (c.BaseUnit is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success"
                             Class="ml-2">
                        基准: @c.BaseUnit.Symbol
                    </MudChip>
                }
                else
                {
                    @* ★ 无基准分类的"重新指定"入口 *@
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                             Class="ml-2">
                        无基准单位
                    </MudChip>
                    @if (c.Units.Count > 0)
                    {
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Star"
                                   Class="ml-2"
                                   OnClick="@(() => OpenAssignBaseDialogAsync(c))">
                            指定基准单位
                        </MudButton>
                    }
                }
            </div>
            <MudTable Items="c.Units" Hover="true" Bordered="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>名称</MudTh>
                    <MudTh>符号</MudTh>
                    <MudTh>换算系数</MudTh>
                    <MudTh>顺序</MudTh>
                    <MudTh>基准</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="名称">@context.Name</MudTd>
                    <MudTd DataLabel="符号">@context.Symbol</MudTd>
                    <MudTd DataLabel="换算系数">@context.ToBaseFactor</MudTd>
                    <MudTd DataLabel="顺序">@context.DisplayOrder</MudTd>
                    <MudTd DataLabel="基准">
                        @if (context.IsBaseUnit)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check"
                                     Color="Color.Success" />
                        }
                    </MudTd>
                    <MudTd DataLabel="操作">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Medium"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditAsync(context))"
                                       title="编辑" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Medium"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteAsync(context))"
                                       title="删除" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<UnitCategoryDto>? _categories;
    private bool _loading;
    private bool _initialized;

    /// <summary>桌面端对话框选项：PageDialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _categories = await Api.GetUnitCategoriesAsync();
            if (_categories is null)
            {
                Snackbar.Add("单位加载失败，请检查后端服务", Severity.Error);
                _categories = Array.Empty<UnitCategoryDto>();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<string> GetAllCategories()
        => _categories?.Select(c => c.Category).Distinct() ?? Enumerable.Empty<string>();

    // ---------- 新建 ----------

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<UnitCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 编辑 ----------

    private async Task OpenEditAsync(UnitDto unit)
    {
        var parameters = new DialogParameters<UnitEditDialog>
        {
            { x => x.Unit, unit },
            { x => x.Categories, GetAllCategories() }
        };

        var dialog = await DialogService.ShowAsync<UnitEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 指定基准单位（无基准分类） ----------

    private async Task OpenAssignBaseDialogAsync(UnitCategoryDto category)
    {
        var parameters = new DialogParameters<UnitAssignBaseDialog>
        {
            { x => x.Category, category }
        };

        var dialog = await DialogService.ShowAsync<UnitAssignBaseDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 删除 ----------

    private async Task DeleteAsync(UnitDto unit)
    {
        var extraHint = unit.IsBaseUnit
            ? "\n\n注意：这是该分类的基准单位，删除后本分类将没有基准单位。"
            : "";

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除单位「{unit.Name}」({unit.Symbol})？{extraHint}",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteUnitAsync(unit.Id);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }
}
