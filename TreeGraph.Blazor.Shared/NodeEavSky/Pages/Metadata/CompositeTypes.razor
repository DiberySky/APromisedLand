@* CompositeTypes.razor — 组合定义管理（平铺表格，对齐 EntityTypes 风格；字段定义在独立对话框中管理）
   支持对话框模式：IsDialogMode=true 时隐藏 PageHeaderSky，新建按钮置于表头操作列。 *@
@page "/metadata/composite-types"
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!IsDialogMode)
{
    <PageTitle>组合定义管理</PageTitle>

    <PageHeaderSky Title="组合定义管理">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="LoadAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                刷新
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small"
                       OnClick="OpenCreateTypeAsync"
                       StartIcon="@Icons.Material.Filled.Add"
                       Class="ml-2">
                新建组合类型
            </MudButton>
        </Actions>
    </PageHeaderSky>
}

<MudTable T="CompositeTypeDetailDto" Items="_types" Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>名称</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">字段定义</MudTh>
        <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
            @if (IsDialogMode)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="OpenCreateTypeAsync"
                               title="新建组合类型" />
            }
            else
            {
                <text>操作</text>
            }
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <MudText Typo="Typo.body1">@context.DisplayName</MudText>
        </MudTd>
        <MudTd DataLabel="字段定义" Style="white-space: nowrap; text-align: center;">
            @* 图标入口：点击打开字段定义对话框并锁定该类型；
               字段数量以徽标叠加在图标右上角 *@
            <MudBadge Content="@context.Fields.Count(f => !f.IsDeleted)" Color="Color.Info"
                      Overlap="true" Bordered="true" Max="99">
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Color="Color.Success"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenFieldsAsync(context))"
                               title="管理字段定义" />
            </MudBadge>
        </MudTd>
        <MudTd DataLabel="操作" Style="white-space: nowrap; text-align: right;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(async () => await DeleteTypeAsync(context))"
                           title="删除" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(() => OpenEditTypeAsync(context))"
                           title="编辑" />
            <MudIconButton Icon="@(IsExpanded(context.CompositeTypeId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small"
                           Color="Color.Info"
                           OnClick="@(() => ToggleExpand(context.CompositeTypeId))"
                           title="查看字段" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (IsExpanded(context.CompositeTypeId))
        {
            var fields = context.Fields.Where(f => !f.IsDeleted)
                .OrderBy(f => f.DisplayOrder).ToList();
            <MudTr>
                <td colspan="3" style="padding: 0;">
                    <MudPaper Elevation="0" Class="pa-3"
                              Style="background: var(--mud-palette-background-grey);">
                        @if (fields.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">该组合类型暂无字段</MudAlert>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Bordered="true" Hover="true"
                                            Style="overflow-x: auto;">
                                <thead>
                                    <tr>
                                        <th>字段名</th>
                                        <th>显示名</th>
                                        <th>类型</th>
                                        <th>引用</th>
                                        <th>数组</th>
                                        <th>必填</th>
                                        <th>可搜索</th>
                                        <th>可排序</th>
                                        <th style="text-align: right;">顺序</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in fields)
                                    {
                                        <tr>
                                            <td><code>@f.FieldName</code></td>
                                            <td>@f.DisplayName</td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small"
                                                         Color="@GetDataTypeColor(f.DataType)">
                                                    @EavDataTypeLabels.GetLabel(f.DataType)
                                                </MudChip>
                                            </td>
                                            <td>
                                                @if (f.UnitId is not null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="mr-1">单位</MudChip>
                                                }
                                                @if (f.RefOptionSetId is not null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mr-1">选项: @(f.OptionSetDisplayName ?? f.OptionSetName)</MudChip>
                                                }
                                                @if (f.RefCompositeTypeId is not null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark">嵌套: @GetNestedTypeName(f.RefCompositeTypeId)</MudChip>
                                                }
                                            </td>
                                            <td>
                                                @if (f.IsArray)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>
                                                @if (f.IsRequired)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>
                                                @if (f.IsSearchable)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>
                                                @if (f.IsSortable)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td style="text-align: right;">@f.DisplayOrder</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudPaper>
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.AccountTree"
                       Title="暂无组合类型">
            <Description>
                <text>点击右上角 + 创建第一个</text>
            </Description>
        </EmptyStateSky>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>嵌入模式（对话框/选项卡）：隐藏页头与工具栏，新建按钮置于表头操作列。</summary>
    [Parameter] public bool IsDialogMode { get; set; }

    private IReadOnlyList<CompositeTypeDetailDto>? _types;
    private bool _loading;
    private bool _initialized;

    // 引用数据（供字段对话框使用）
    private IReadOnlyList<OptionSetSummaryDto>? _optionSets;

    /// <summary>桌面端对话框选项：DialogSky 全默认时不触碰，此处显式指定保持原外观。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        await LoadReferencesAsync();
        await LoadAsync();
        StateHasChanged();
    }

    /// <summary>加载选项集引用。</summary>
    private async Task LoadReferencesAsync()
    {
        _optionSets = await Api.ListOptionSetsAsync();

        if (_optionSets is null)
            Snackbar.Add("引用加载失败：选项集", Severity.Warning);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _types = await Api.ListCompositeTypesAsync();
            if (_types is null)
            {
                Snackbar.Add("加载失败，请检查后端服务", Severity.Error);
                _types = Array.Empty<CompositeTypeDetailDto>();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    // ---------- 新建组合类型 ----------

    private async Task OpenCreateTypeAsync()
    {
        var dialog = await DialogService.ShowAsync<CompositeTypeCreateDialog>(
            string.Empty, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 编辑组合类型 ----------

    private async Task OpenEditTypeAsync(CompositeTypeDetailDto type)
    {
        var parameters = new DialogParameters<CompositeTypeEditDialog>
        {
            { x => x.Type, type }
        };

        var dialog = await DialogService.ShowAsync<CompositeTypeEditDialog>(
            string.Empty, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // ---------- 删除组合类型 ----------

    private async Task DeleteTypeAsync(CompositeTypeDetailDto type)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除组合类型「{type.DisplayName}」？此操作将同时删除其所有字段。",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteCompositeTypeAsync(type.CompositeTypeId);
        if (ok)
        {
            Snackbar.Add("删除成功", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
        }
    }

    // ---------- 字段定义对话框 ----------

    /// <summary>打开独立字段定义对话框并锁定该组合类型。</summary>
    private async Task OpenFieldsAsync(CompositeTypeDetailDto type)
    {
        var parameters = new DialogParameters<CompositeTypeFieldsDialog>
        {
            { x => x.Type, type },
            { x => x.OptionSets, _optionSets },
            { x => x.NestedTypes, GetNestedTypeOptions(type) },
            { x => x.OnChanged, EventCallback.Factory.Create(this, LoadAsync) }
        };

        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };

        var dialog = await DialogService.ShowExAsync<CompositeTypeFieldsDialog>(
            string.Empty, parameters, options);
        await dialog.Result;

        // 字段可能增删，关闭后刷新字段数徽标
        await LoadAsync();
    }

    /// <summary>嵌套类型候选：排除当前类型自身。</summary>
    private List<CompositeTypeDetailDto> GetNestedTypeOptions(
        CompositeTypeDetailDto currentType)
    {
        if (_types is null) return [];
        return _types
            .Where(t => t.CompositeTypeId != currentType.CompositeTypeId)
            .ToList();
    }

    // ---------- 行内展开：字段二级列表 ----------

    /// <summary>已展开行的组合类型 ID。</summary>
    private readonly HashSet<string> _expandedIds = new();

    private bool IsExpanded(string compositeTypeId) => _expandedIds.Contains(compositeTypeId);

    /// <summary>切换展开（字段数据已在 context.Fields，无需请求）。</summary>
    private void ToggleExpand(string compositeTypeId)
    {
        if (!_expandedIds.Add(compositeTypeId))
            _expandedIds.Remove(compositeTypeId);
    }

    /// <summary>嵌套引用的组合类型显示名（找不到时回退 TypeName）。</summary>
    private string GetNestedTypeName(string refCompositeTypeId)
        => _types?.FirstOrDefault(t => t.CompositeTypeId == refCompositeTypeId)?.DisplayName
           ?? refCompositeTypeId;

    private static Color GetDataTypeColor(string dataType) => dataType switch
    {
        "string" => Color.Info,
        "int" or "decimal" => Color.Primary,
        "bool" => Color.Success,
        "datetime" or "date" or "time" => Color.Warning,
        "single_choice" => Color.Tertiary,
        "composite" => Color.Dark,
        _ => Color.Default
    };
}
