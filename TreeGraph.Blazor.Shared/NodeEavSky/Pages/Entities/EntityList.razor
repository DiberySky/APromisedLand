@* EntityList.razor — 对齐 DiberyTree 模式：PageHeaderSky + MudTable Breakpoint + MoreHoriz 行操作 *@
@page "/entities/{EntityType}"
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Dialogs
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@using TreeGraph.Shared.NodeEavSky.Dtos
@inject EavApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject EntityTypeDisplayService EntityTypeDisplay

<PageTitle>@GetDisplayTitle() 实体列表</PageTitle>

<PageHeaderSky Title="@($"{GetDisplayTitle()} 实体")"
               ArrowBackVisible="true"
               OnArrowBackClick="BackToHome">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync" Disabled="@_loading">
            刷新
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateNew"
                   Disabled="@_loading">
            新建实体
        </MudButton>
    </Actions>
</PageHeaderSky>

@* 动态查询过滤器 *@
@if (_schema is not null && _schema.Count > 0)
{
    <QueryFilterBuilder Filters="_filters"
                        SupportedAttributes="_searchableAttributes"
                        OnApply="OnFilterChanged" />
}

@if (_result is not null)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        共 <b>@_result.Total</b> 个实体，第 @_result.Page / @TotalPages 页
    </MudText>
}

<MudTable Items="@_result?.Items"
          T="DynamicEntityDto"
          Hover="true" Bordered="true"
          Dense="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@_loading"
          LoadingProgressColor="Color.Primary"
          @key="(_result?.Page ?? 0, _result?.Total ?? 0, _filters.Count)">
    <HeaderContent>
        <MudTh>EntityId</MudTh>
        @foreach (var col in _previewColumns)
        {
            <MudTh>@GetColumnDisplayName(col)</MudTh>
        }
        <MudTh Style="text-align:right">操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="EntityId">
            <code>@context.EntityId</code>
        </MudTd>
        @foreach (var col in _previewColumns)
        {
            <MudTd DataLabel="@GetColumnDisplayName(col)">
                @FormatPreview(context.Properties.GetValueOrDefault(col))
            </MudTd>
        }
        <MudTd Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(() => ShowRowActionsAsync(context))"
                           title="操作" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyStateSky Icon="@Icons.Material.Filled.Inbox"
                       Title="@(_result is null ? "加载失败" : "未找到实体")">
            @if (_result is not null && _result.Items.Count == 0)
            {
                @if (_filters.Count > 0)
                {
                    <text>当前查询条件无匹配结果，试试清空过滤条件。</text>
                }
                else
                {
                    <text>点击"新建实体"创建第一个</text>
                }
            }
            else
            {
                <text>请检查后端服务是否正常</text>
            }
        </EmptyStateSky>
    </NoRecordsContent>
    <PagerContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudSelect T="int"
                       Value="_pageSize"
                       ValueChanged="OnPageSizeChanged"
                       Label="每页"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Size="Size.Small">
                <MudSelectItem T="int" Value="10">10</MudSelectItem>
                <MudSelectItem T="int" Value="20">20</MudSelectItem>
                <MudSelectItem T="int" Value="50">50</MudSelectItem>
                <MudSelectItem T="int" Value="100">100</MudSelectItem>
            </MudSelect>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Size="Size.Small"
                           Disabled="@(_result is null || _result.Page <= 1)"
                           OnClick="@(() => GoToPage(_result!.Page - 1))" />
            <MudText Typo="Typo.body2">@(_result?.Page ?? 0) / @TotalPages</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Size="Size.Small"
                           Disabled="@(_result is null || _result.Page >= TotalPages)"
                           OnClick="@(() => GoToPage(_result!.Page + 1))" />
        </MudStack>
    </PagerContent>
</MudTable>

@code {
    [Parameter] public string EntityType { get; set; } = "";

    private string GetDisplayTitle() => EntityTypeDisplay.GetDisplayName(EntityType);

    private IReadOnlyList<AttributeSchemaDto>? _schema;
    private List<AttributeSchemaDto> _searchableAttributes = new();
    private List<string> _previewColumns = new();

    private readonly List<AttributeFilter> _filters = new();
    private PagedResult<DynamicEntityDto>? _result;

    private bool _loading;
    private bool _initialized;
    private int _page = 1;
    private int _pageSize = 20;
    private int TotalPages => _result is null || _result.PageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling((double)_result.Total / _result.PageSize));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        var schema = await Api.GetSchemaAsync(EntityType);
        if (schema is not null)
        {
            _schema = schema;

            _searchableAttributes = schema
                .Where(a => a.IsSearchable && FilterOperatorCatalog.IsSupported(a))
                .OrderBy(a => a.DisplayOrder)
                .ToList();

            _previewColumns = schema
                .Where(a => a.IsSearchable && a.DataType != "table" && a.DataType != "composite")
                .OrderBy(a => a.DisplayOrder)
                .Take(3)
                .Select(a => a.AttributeName)
                .ToList();
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var request = new EavQueryRequest
            {
                EntityType = EntityType,
                Filters = _filters,
                Page = _page,
                PageSize = _pageSize
            };

            _result = await Api.QueryAsync(EntityType, request);
            if (_result is null)
                Snackbar.Add("加载失败", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        _page = page;
        await LoadAsync();
    }

    /// <summary>
    /// 行 MoreHoriz → 打开 EntityRowActionsDialog，聚合该实体的全部操作。
    /// 对齐 DiberyTree TreeNodeActionsDialog 模式。
    /// </summary>
    private async Task ShowRowActionsAsync(DynamicEntityDto item)
    {
        var summaryLines = _previewColumns
            .Select(col => new SummaryLine(
                GetColumnDisplayName(col),
                FormatPreview(item.Properties.GetValueOrDefault(col))))
            .ToList();

        var parameters = new DialogParameters<EntityRowActionsDialog>
        {
            { x => x.EntityTypeDisplayName, GetDisplayTitle() },
            { x => x.EntityId, item.EntityId },
            { x => x.SummaryLines, summaryLines }
        };

        var dialog = await DialogService.ShowAsync<EntityRowActionsDialog>(
            null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;

        if (result.Canceled) return;
        if (result.Data is not EntityRowAction action) return;

        switch (action)
        {
            case EntityRowAction.Edit:
                Nav.NavigateTo($"/entities/{EntityType}/{item.EntityId}");
                break;
            case EntityRowAction.CopyId:
                Snackbar.Add($"EntityId: {item.EntityId}", Severity.Info);
                break;
            case EntityRowAction.History:
                Nav.NavigateTo($"/entities/{EntityType}/{item.EntityId}/history");
                break;
            case EntityRowAction.Delete:
                await ConfirmDelete(item.EntityId);
                break;
        }
    }

    private async Task ConfirmDelete(string entityId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除实体 {EntityType}/{entityId} 及其所有属性值和子表数据吗？\n\n" +
            "此操作不可撤销。",
            yesText: "永久删除", cancelText: "取消");

        if (confirmed != true) return;

        var (ok, error) = await Api.DeleteEntityAsync(EntityType, entityId);
        if (!ok)
        {
            Snackbar.Add($"删除失败：{error ?? "未知错误"}", Severity.Error);
            return;
        }

        Snackbar.Add("已删除", Severity.Success);
        await LoadAsync();
        StateHasChanged();
    }

    private void CreateNew()
    {
        var newId = Guid.NewGuid().ToString("D");
        Snackbar.Add($"已生成 EntityId：{newId}", Severity.Info);
        Nav.NavigateTo($"/entities/{EntityType}/{newId}");
    }

    private void BackToHome()
    {
        Nav.NavigateTo("/");
    }

    private string GetColumnDisplayName(string name)
        => _schema?.FirstOrDefault(a => a.AttributeName == name)?.DisplayName ?? name;

    private static string FormatPreview(System.Text.Json.JsonElement? elem)
    {
        if (elem is null) return "";
        var e = elem.Value;
        return e.ValueKind switch
        {
            System.Text.Json.JsonValueKind.Null => "",
            System.Text.Json.JsonValueKind.String => e.GetString() ?? "",
            System.Text.Json.JsonValueKind.Number => e.ToString(),
            System.Text.Json.JsonValueKind.True => "✓",
            System.Text.Json.JsonValueKind.False => "✗",
            System.Text.Json.JsonValueKind.Object => FormatObjectPreview(e),
            System.Text.Json.JsonValueKind.Array => $"[{e.GetArrayLength()}]",
            _ => e.ToString()
        };
    }

    private static string FormatObjectPreview(System.Text.Json.JsonElement e)
    {
        if (e.TryGetProperty("label", out var lbl)
            && lbl.ValueKind == System.Text.Json.JsonValueKind.String)
            return lbl.GetString() ?? "";

        if (e.TryGetProperty("value", out var v)
            && v.ValueKind == System.Text.Json.JsonValueKind.Number)
            return v.ToString();

        return "{…}";
    }
}
