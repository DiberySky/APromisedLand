@* PageSky.razor — 页面骨架：顶部栏 + 正文 + 可选底部栏 *@
@namespace TreeGraph.Blazor.Shared.Common

@inject NavigationManager NavigationManager

<MudAppBar Class="mud-theme-primary" Color="Color.Inherit" Dense="true"
           Elevation="0">
    <ChildContent>
        @if (ArrowBackVisible)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                           Edge="Edge.Start" Color="Color.Warning"
                           OnClick="BackClick" Size="Size.Small" />
        }

        @if (string.IsNullOrEmpty(Title) == false)
        {
            <MudSpacer/>
            <MudText>@Title</MudText>
            <MudSpacer/>
        }

        @if (TopBarRightContent is not null)
        {
            @TopBarRightContent
        }

        @if (StartButtonVisible)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                           Color="Color.Success"
                           OnClick="StartClick" Size="Size.Small" />
        }
    </ChildContent>
</MudAppBar>

<MudContainer MaxWidth="@MaxWidth"
              Class="@(BottomBarVisible ? null : "mb-16")"
              Style="@(BottomBarVisible ? "padding-bottom: 180px;" : null)">
    @if (PageContent is not null)
    {
        @PageContent
    }
</MudContainer>

@if (BottomBarVisible)
{
    @* 底部固定栏：脱离文档流悬浮于视口底部，滚动正文时不移动。
       与 /search 输入栏同一套定位规则（桌面端避让抽屉宽度）。 *@
    <div class="page-sky-bottom-bar">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-4 py-2">
            @if (BottomBarContent is not null)
            {
                @BottomBarContent
            }

            @if (LogoutButtonVisible)
            {
                <MudSpacer/>
                <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                               Color="Color.Error"
                               OnClick="Logout" Size="Size.Small" />
            }
        </MudStack>
    </div>
}

<style>
    .page-sky-bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 200;
        background: var(--mud-palette-surface);
        border-top: 1px solid var(--mud-palette-lines-default);
        padding-bottom: env(safe-area-inset-bottom, 0px);
        box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
    }

    /* 桌面端（≥960px）抽屉展开时避让其宽度；移动端为浮层，不推挤内容 */
    @@media (min-width: 960px) {
        .mud-layout.mud-drawer-open-responsive-md-left .page-sky-bottom-bar {
            left: var(--mud-drawer-width-left, 240px);
        }
    }
</style>

@code {
    [Parameter] public required string Title { get; set; }
    [Parameter] public bool ArrowBackVisible { get; set; } = true;
    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.False;
    [Parameter] public bool BottomBarVisible { get; set; } = false;
    [Parameter] public bool StartButtonVisible { get; set; } = false;

    /// <summary>底部栏是否显示登出按钮，由调用方按自身认证状态控制。</summary>
    [Parameter] public bool LogoutButtonVisible { get; set; }

    [Parameter] public RenderFragment? TopBarRightContent { get; set; }
    [Parameter] public RenderFragment? PageContent { get; set; }
    [Parameter] public RenderFragment? BottomBarContent { get; set; }

    [Parameter] public EventCallback OnStartClick { get; set; }

    [Parameter] public EventCallback OnBackClick { get; set; }
    [Parameter] public string? BackPage { get; set; }

    /// <summary>点击登出按钮时触发；登出与跳转逻辑由调用方实现。</summary>
    [Parameter] public EventCallback OnLogout { get; set; }

    private async Task BackClick()
    {
        if (string.IsNullOrEmpty(BackPage))
        {
            await OnBackClick.InvokeAsync();
        }
        else
        {
            NavigationManager.NavigateTo(BackPage);
        }
    }

    private Task StartClick() => OnStartClick.InvokeAsync();

    private Task Logout() => OnLogout.InvokeAsync();
}
