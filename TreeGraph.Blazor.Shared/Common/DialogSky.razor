@* DialogSky.razor — 对齐 APromisedLand.Razor DialogSky 外壳（ButtonLoadingSky 以 MudButton 替代） *@
@namespace TreeGraph.Blazor.Shared.Common

<MudDialog TitleClass="@EffectiveTitleClass"
           ContentClass="@ContentClass"
           ActionsClass="@ActionsClass">
    <TitleContent>
        @if (!string.IsNullOrEmpty(Title))
        {
            <MudToolBar Dense>
                <MudSpacer/>
                <DevDialogSourceButton>
                    <MudText Color="Color.Inherit">@Title</MudText>
                </DevDialogSourceButton>
                <MudSpacer/>
                @* 全屏/最大化按钮：由 MudBlazor.Extensions 在 ShowExAsync 打开时经 JS
                   注入到标题栏右上角（DialogOptionsEx.MaximizeButton，默认开），此处不手写。 *@
            </MudToolBar>
        }

        @if (ToolBarContent != null)
        {
            <MudPaper>
                <MudToolBar Dense>
                    @ToolBarContent
                </MudToolBar>
            </MudPaper>
        }
    </TitleContent>
    <DialogContent>

        @if (DialogContent != null)
        {
            @DialogContent
        }
    </DialogContent>
    <DialogActions>
        <MudContainer MaxWidth="@ActionsMaxWidth">

            <MudStack Row Class="@ActionsContentClass" Spacing="2" AlignItems="AlignItems.Center">
                @if (DialogLeftActions != null)
                {
                    @DialogLeftActions
                }

                <MudSpacer/>

                @if (DialogRightActions != null)
                {
                    @DialogRightActions
                }

                @if (SubmitButtonVisible)
                {
                    <MudButton Variant="Variant.Text"
                               Color="@SubmitButtonColor"
                               Disabled="@SubmitButtonDisabled"
                               StartIcon="@(IconsVisible ? Icons.Material.Outlined.SaveAs : null)"
                               Size="Size.Small"
                               OnClick="@SubmitAsync">
                        @SubmitButtonText
                    </MudButton>
                }

                @if (CancelButtonVisible)
                {
                    <MudButton Variant="Variant.Text"
                               StartIcon="@(IconsVisible ? Icons.Material.Outlined.Close : null)"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="@CancelAsync">
                        @CancelButtonText
                    </MudButton>
                }

            </MudStack>

        </MudContainer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required string Title { get; set; }
    [Parameter] public bool TitleDense { get; set; } = true;

    /// <summary>操作区容器的最大宽度（默认 False 铺满全宽，按钮靠右对齐）。</summary>
    [Parameter] public MaxWidth ActionsMaxWidth { get; set; } = MaxWidth.False;

    [Parameter] public bool CancelButtonVisible { get; set; } = true;
    [Parameter] public bool SubmitButtonVisible { get; set; }
    [Parameter] public bool IconsVisible { get; set; } = true;
    /// <summary>禁用提交按钮（如提交中防重复点击）。</summary>
    [Parameter] public bool SubmitButtonDisabled { get; set; }
    /// <summary>提交按钮颜色：默认 Success（与编辑对话框一致）；危险操作对话框可传 Color.Error。</summary>
    [Parameter] public Color SubmitButtonColor { get; set; } = Color.Success;

    [Parameter] public string CancelButtonText { get; set; } = "取消";
    [Parameter] public string SubmitButtonText { get; set; } = "提交";

    [Parameter] public string TitleClass { get; set; } = "mud-theme-success px-0 pa-0";
    [Parameter] public string ContentClass { get; set; } = "mud-theme-dark";
    [Parameter] public string ActionsClass { get; set; } = "mud-theme-default";
    [Parameter] public string ActionsContentClass { get; set; } = "";

    /// <summary>
    /// 工具栏内容（标题栏下方，可选）。
    /// ⚠ 仅放静态内容：MudBlazor.Extensions 宿主在标题区注入 header-actions 后，
    /// Blazor 对标题区的后续更新会打到游离节点（动态文本/绑定值冻结在初始渲染）。
    /// 需要随状态更新的内容（状态文字、步进器绑定值等）放 DialogContent 顶部。
    /// </summary>
    [Parameter] public RenderFragment? ToolBarContent { get; set; }
    [Parameter] public RenderFragment? DialogContent { get; set; }
    [Parameter] public RenderFragment? DialogLeftActions { get; set; }
    [Parameter] public RenderFragment? DialogRightActions { get; set; }

    [Parameter] public EventCallback OnCanceledClick { get; set; }
    [Parameter] public EventCallback OnSubmitClick { get; set; }

    // 不直接修改 [Parameter] TitleClass（渲染期改参数是 Blazor 反模式），改为计算属性。
    private string EffectiveTitleClass =>
        TitleDense && !TitleClass.Contains("pa-0")
            ? TitleClass + " pa-0"
            : TitleClass;

    /// <summary>关闭流程已开始：阻断取消的重入触发。</summary>
    private bool _closing;

    /// <summary>
    /// 统一交互约定：DialogSky 对话框点击背景遮罩不关闭，避免误触丢失未保存内容。
    /// MudBlazor 9 的 BackdropClick 为 init-only 且默认 true，无法原地修改，
    /// 故克隆打开方传入的 DialogOptions（含 DialogOptionsEx 扩展属性）后重新注入。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (MudDialog is null || MudDialog.Options.BackdropClick == false)
            return;

        await MudDialog.SetOptionsAsync(CloneWithBackdropClickDisabled(MudDialog.Options));
    }

    /// <summary>反射复制全部可读写属性，仅将 BackdropClick 置为 false。</summary>
    private static DialogOptions CloneWithBackdropClickDisabled(DialogOptions source)
    {
        var clone = (DialogOptions)Activator.CreateInstance(source.GetType())!;
        foreach (var prop in source.GetType()
                     .GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))
        {
            if (prop.Name != nameof(DialogOptions.BackdropClick) && prop.CanRead && prop.CanWrite)
                prop.SetValue(clone, prop.GetValue(source));
        }

        typeof(DialogOptions).GetProperty(nameof(DialogOptions.BackdropClick))!
            .SetValue(clone, false);
        return clone;
    }

    private async Task CancelAsync()
    {
        if (_closing)
        {
            return;
        }
        _closing = true;

        MudDialog?.Close(DialogResult.Cancel());

        try
        {
            await OnCanceledClick.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DialogSky] OnCanceledClick failed: {ex}");
        }
    }

    private async Task SubmitAsync()
    {
        // 默认不关闭对话框，由父组件决定；重入防护由 SubmitButtonDisabled 负责。
        try
        {
            await OnSubmitClick.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DialogSky] OnSubmitClick failed: {ex}");
        }
    }
}
