@* 数字输入框：Outlined 可键入 + 右侧内嵌 NumberStepper（−/+）。
   MudBlazor 9 的 MudTextField 无自定义 adornment 通道，
   故用容器相对定位 + 步进器绝对定位叠进输入框内。
   T 支持 int 与 int?：可空时清空输入框即提交 null。 *@
@typeparam T

<div class="numinput @Class" style="@Style">
    <MudTextField T="string"
                  Value="_text"
                  ValueChanged="OnTextChangedAsync"
                  Label="@Label"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  HideSpinButtons="true"
                  Disabled="@Disabled"
                  HelperText="@HelperText"
                  Class="numinput-field"/>
    <div class="numinput-stepper">
        <NumberStepper Embedded="true" Label="" Suffix="@Suffix" Disabled="@Disabled"
                       Value="CurrentInt" ValueChanged="StepToAsync"
                       Min="@Min" Max="@Max" Step="@Step"/>
    </div>
</div>

@code {
    private static readonly bool IsNullable =
        Nullable.GetUnderlyingType(typeof(T)) is not null;

    /// <summary>当前值（配合 @bind-Value 使用）。</summary>
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }

    /// <summary>浮动标签文字。</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>步进器右侧单位后缀（如"层"），空则不显示。</summary>
    [Parameter] public string? Suffix { get; set; }

    [Parameter] public int Min { get; set; } = int.MinValue;
    [Parameter] public int Max { get; set; } = int.MaxValue;
    [Parameter] public int Step { get; set; } = 1;

    /// <summary>作用于外层容器的样式（如宽度）。</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>附加到外层容器的 CSS 类（如 mb-3）。</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>输入框下方辅助说明文字。</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>禁用输入与步进。</summary>
    [Parameter] public bool Disabled { get; set; }

    private string _text = string.Empty;

    /// <summary>步进器视角的当前数值；null 时回退到 Min（或 0）。</summary>
    private int CurrentInt
    {
        get
        {
            if (Value is int i) return i;
            return Min > int.MinValue ? Min : 0;
        }
    }

    protected override void OnParametersSet()
        => _text = Value is int i ? i.ToString() : string.Empty;

    private async Task OnTextChangedAsync(string text)
    {
        _text = text;
        if (string.IsNullOrWhiteSpace(text))
        {
            await CommitAsync(null);
            return;
        }
        if (int.TryParse(text, out var v))
            await CommitAsync(Math.Clamp(v, Min, Max));
    }

    private Task StepToAsync(int v) => CommitAsync(Math.Clamp(v, Min, Max));

    private async Task CommitAsync(int? v)
    {
        if (v is null && !IsNullable) return; // int 不接受空

        if (v is int x) _text = x.ToString();

        if (Value is int cur && cur == v) return;

        Value = (T?)(object?)v;
        await ValueChanged.InvokeAsync(Value);
    }
}
