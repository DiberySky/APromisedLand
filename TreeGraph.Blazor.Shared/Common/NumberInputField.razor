@* 数字输入框：Outlined 可键入 + 右侧内嵌 NumberStepper（−/+）。
   MudBlazor 9 的 MudTextField 无自定义 adornment 通道，
   故用容器相对定位 + 步进器绝对定位叠进输入框内。
   辅助/错误文案由本组件在外层渲染（不交给 MudTextField），
   使步进器的定位上下文只含输入框本体，−/+ 始终相对输入框垂直居中。
   T 支持 int/long/decimal/double 及可空形式：可空时清空输入框即提交 null。 *@
@typeparam T

<div class="numinput @Class" style="@Style">
    <div class="numinput-box">
        <MudTextField T="string"
                      Value="_text"
                      ValueChanged="OnTextChangedAsync"
                      Label="@Label"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      HideSpinButtons="true"
                      Disabled="@Disabled"
                      ReadOnly="@ReadOnly"
                      Placeholder="@Placeholder"
                      Required="@Required"
                      Error="@Error"
                      Margin="@Margin"
                      InputMode="@InputMode"
                      Class="numinput-field"/>
        <div class="numinput-stepper">
            <NumberStepper T="decimal" Embedded="true" Label="" Suffix="@Suffix"
                           Disabled="@(Disabled || ReadOnly)"
                           Value="CurrentDecimal" ValueChanged="StepToAsync"
                           Min="@Min" Max="@Max" Step="@Step"/>
        </div>
    </div>
    @if (Error && !string.IsNullOrEmpty(ErrorText))
    {
        <div class="numinput-helper numinput-helper-error">@ErrorText</div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="numinput-helper">@HelperText</div>
    }
</div>

@code {
    private static readonly bool IsNullable =
        Nullable.GetUnderlyingType(typeof(T)) is not null;

    /// <summary>当前值（配合 @bind-Value 使用）。</summary>
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }

    /// <summary>浮动标签文字。</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>步进器右侧单位后缀（如"层"），空则不显示。</summary>
    [Parameter] public string? Suffix { get; set; }

    [Parameter] public decimal Min { get; set; } = decimal.MinValue;
    [Parameter] public decimal Max { get; set; } = decimal.MaxValue;
    [Parameter] public decimal Step { get; set; } = 1m;

    /// <summary>作用于外层容器的样式（如宽度）。</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>附加到外层容器的 CSS 类（如 mb-3）。</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>输入框下方辅助说明文字。</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>禁用输入与步进。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>只读：文本不可编辑且步进禁用（样式保留）。</summary>
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public InputMode InputMode { get; set; } = InputMode.none;

    private string _text = string.Empty;

    /// <summary>步进器视角的当前数值；null 时回退到 Min（或 0）。</summary>
    private decimal CurrentDecimal
        => NumberMath.ToDecimal(Value, Min > decimal.MinValue ? Min : 0m);

    protected override void OnParametersSet()
        => _text = Value is null
            ? string.Empty
            : NumberMath.Format(NumberMath.ToDecimal(Value), typeof(T));

    private async Task OnTextChangedAsync(string text)
    {
        _text = text;
        if (string.IsNullOrWhiteSpace(text))
        {
            await CommitAsync(null);
            return;
        }
        if (NumberMath.TryParse(text, typeof(T), out var v))
            await CommitAsync(Math.Clamp(v, Min, Max));
    }

    private Task StepToAsync(decimal v) => CommitAsync(Math.Clamp(v, Min, Max));

    private async Task CommitAsync(decimal? v)
    {
        if (v is null && !IsNullable) return; // 非可空不接受空

        if (v is { } x) _text = NumberMath.Format(x, typeof(T));

        if (v is not null && Value is not null
            && NumberMath.ToDecimal(Value) == v.Value) return;

        Value = v is null ? default : (T?)NumberMath.FromDecimal(v.Value, typeof(T));
        await ValueChanged.InvokeAsync(Value);
    }
}
