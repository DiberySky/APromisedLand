@* DownloadProgressDialog.razor — 下载进度对话框（DialogSky 外壳） *@
@* WASM 默认通过 File System Access API 将 DotNetStreamReference 分块写入磁盘；旧 Server 保留原下载流程。 *@
@namespace TreeGraph.Blazor.Shared.Common
@using Microsoft.JSInterop
@implements IAsyncDisposable

<DialogSky Title="@Title"
           CancelButtonVisible="true" CancelButtonText="取消"
           SubmitButtonVisible="@OperatingSystem.IsBrowser()"
           SubmitButtonText="保存文件"
           SubmitButtonDisabled="@(_downloading || _completed)"
           OnSubmitClick="DownloadInBrowserAsync"
           IconsVisible="true"
           OnCanceledClick="@CancelAsync">
    <DialogContent>
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">@StatusText</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">文件: @_fileName (@FormatSize(_totalBytes))</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">已下载 @_downloadedBytes / @_totalBytes</MudText>
            <MudProgressLinear Value="_progress" Max="100" Color="@_progressColor" Class="my-2" />
            @if (OperatingSystem.IsBrowser() && !_downloading && !_completed && _error is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    点击“保存文件”选择位置后开始下载；支持 File System Access API 的浏览器将分块写入，不缓冲整个文件；其他浏览器仅在 256 MiB 以内使用 Blob 兼容下载。
                </MudText>
            }
            @if (_error is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@_error</MudText>
            }
        </MudPaper>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }
    [Parameter, EditorRequired] public DownloadRequest Request { get; set; } = null!;

    private string Title => "下载文件";
    private string _fileName = "";
    private long _totalBytes;
    private long _downloadedBytes;
    private int _progress;
    private Color _progressColor = Color.Primary;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();
    private bool _cancelled;
    private bool _completed;
    private bool _downloading;
    private int _saveId;
    private const long MaxBlobFallbackBytes = 256L * 1024 * 1024;

    [Inject] private TreeGraph.Blazor.Shared.FileStorageSky.Services.IFileStorageClient FileStorage { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    protected override void OnInitialized()
    {
        _fileName = Request.FileName;
        _totalBytes = Request.Size;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!OperatingSystem.IsBrowser()) await DownloadLegacyAsync();
    }

    private async Task DownloadInBrowserAsync()
    {
        if (_downloading || _completed) return;
        _downloading = true;
        _error = null;
        _progressColor = Color.Primary;
        _downloadedBytes = 0;
        _progress = 0;

        try
        {
            var ct = _cts.Token;
            _saveId = await JS.InvokeAsync<int>("treegraphFile.prepareSave", ct, _fileName);
            if (_saveId == 0)
            {
                _cancelled = true;
                MudDialog?.Close(DialogResult.Cancel());
                return;
            }

            var full = await FileStorage.GetFileByDocIdAsync(Request.DocId, Request.Version, ct);
            if (full is null)
            {
                Fail("文件不存在");
                return;
            }

            var stream = await FileStorage.DownloadFileAsync(full.Id, ct: ct);
            if (stream is null)
            {
                Fail("文件不存在");
                return;
            }

            using var streamRef = new DotNetStreamReference(stream, leaveOpen: false);
            using var progressRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("treegraphFile.downloadToPreparedFile", ct,
                _saveId, streamRef, progressRef, MaxBlobFallbackBytes);

            _completed = true;
            MudDialog?.Close(DialogResult.Ok(new DownloadDialogResult(Error: null)));
        }
        catch (OperationCanceledException)
        {
            _cancelled = true;
            MudDialog?.Close(DialogResult.Cancel());
        }
        catch (JSException ex) when (_cts.IsCancellationRequested || ex.Message.Contains("AbortError", StringComparison.Ordinal))
        {
            _cancelled = true;
            MudDialog?.Close(DialogResult.Cancel());
        }
        catch (Exception ex)
        {
            Fail($"下载失败: {ex.Message}");
        }
        finally
        {
            _downloading = false;
            _saveId = 0;
        }
    }

    [JSInvokable]
    public async Task ReportDownloadProgress(long downloadedBytes)
    {
        _downloadedBytes = downloadedBytes;
        _progress = _totalBytes > 0 ? (int)Math.Min(100, _downloadedBytes * 100 / _totalBytes) : 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadLegacyAsync()
    {
        try
        {
            var ct = _cts.Token;
            var full = await FileStorage.GetFileByDocIdAsync(Request.DocId, Request.Version, ct);
            if (full is null)
            {
                Fail("文件不存在");
                return;
            }

            var stream = await FileStorage.DownloadFileAsync(full.Id, ct: ct);
            if (stream is null)
            {
                Fail("文件不存在");
                return;
            }

            var ms = new MemoryStream(_totalBytes > 0 && _totalBytes <= int.MaxValue ? (int)_totalBytes : 81920);
            await using (stream)
            {
                var buf = new byte[81920];
                int n;
                while ((n = await stream.ReadAsync(buf.AsMemory(0, buf.Length), ct)) > 0)
                {
                    await ms.WriteAsync(buf.AsMemory(0, n), ct);
                    _downloadedBytes += n;
                    _progress = _totalBytes > 0 ? (int)(_downloadedBytes * 100 / _totalBytes) : 0;
                    StateHasChanged();
                }
            }

            ms.Position = 0;
            using var streamRef = new DotNetStreamReference(ms, leaveOpen: false);
            await JS.InvokeVoidAsync("treegraphFile.downloadFromStream", ct, _fileName, streamRef);
            _completed = true;
            MudDialog?.Close(DialogResult.Ok(new DownloadDialogResult(Error: null)));
        }
        catch (OperationCanceledException)
        {
            _cancelled = true;
            MudDialog?.Close(DialogResult.Cancel());
        }
        catch (Exception ex)
        {
            Fail($"下载失败: {ex.Message}");
        }
    }

    private void Fail(string error)
    {
        _error = error;
        _progressColor = Color.Error;
        StateHasChanged();
        MudDialog?.Close(DialogResult.Ok(new DownloadDialogResult(Error: _error)));
    }

    private async Task CancelAsync()
    {
        if (_completed || _cancelled) return;
        try { await _cts.CancelAsync(); } catch (ObjectDisposedException) { }
        if (_saveId > 0)
        {
            try { await JS.InvokeVoidAsync("treegraphFile.cancelSave", _saveId); }
            catch (JSDisconnectedException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await _cts.CancelAsync(); } catch { }
        _cts.Dispose();
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:F1} MB"
        : bytes >= 1024 ? $"{bytes / 1024.0:F1} KB"
        : $"{bytes} B";

    private string StatusText => _error is not null ? "失败" :
        _completed ? "完成" :
        _cancelled ? "已取消" :
        _downloading ? "下载中" :
        OperatingSystem.IsBrowser() ? "等待选择保存位置" : "下载中";

    public sealed record DownloadRequest(string DocId, int Version, string FileName, long Size);
    public sealed record DownloadDialogResult(string? Error);
}
