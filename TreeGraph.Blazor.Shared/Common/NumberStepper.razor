@* 紧凑数字微调器：图标按钮【− 值 +】，替代 MudNumericField 的上下 stepper。
   T 支持 int/long/decimal/double 及其可空形式（可空时空值按 Min 或 0 起步）。 *@
@typeparam T
<span class="numstep">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="numstep-label">@Label</span>
    }
    <span class="numstep-frame @(Embedded ? "embedded" : "")">
        <span class="numstep-seg numstep-btn @(Disabled || Current <= Min ? "disabled" : "")"
              title="减少"
              @onclick="@(() => ChangeAsync(-Step))">
            <MudIcon Icon="@Icons.Material.Filled.RemoveCircle" Size="Size.Small"/>
        </span>
        @if (!Embedded)
        {
            @* 内嵌模式：宿主输入框已显示数值，这里只保留 −/+ *@
            <span class="numstep-seg numstep-value">@Value</span>
        }
        <span class="numstep-seg numstep-btn @(Disabled || Current >= Max ? "disabled" : "")"
              title="增加"
              @onclick="@(() => ChangeAsync(Step))">
            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small"/>
        </span>
    </span>
    @if (!string.IsNullOrEmpty(Suffix))
    {
        <span class="numstep-label">@Suffix</span>
    }
</span>

@code {
    /// <summary>当前值（配合 @bind-Value 使用）。</summary>
    [Parameter] public T Value { get; set; } = default!;
    [Parameter] public EventCallback<T> ValueChanged { get; set; }

    /// <summary>左侧标签文字，空则不显示。</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>右侧单位后缀（如"层"），空则不显示。</summary>
    [Parameter] public string? Suffix { get; set; }

    [Parameter] public decimal Min { get; set; } = decimal.MinValue;
    [Parameter] public decimal Max { get; set; } = decimal.MaxValue;
    [Parameter] public decimal Step { get; set; } = 1m;
    [Parameter] public Color Color { get; set; } = Color.Primary;

    /// <summary>内嵌模式：去掉自身描边框，供宿主控件（如 NumberInputField）承载边框。</summary>
    [Parameter] public bool Embedded { get; set; }

    /// <summary>禁用步进按钮。</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>当前值的 decimal 视角；空值回退到 Min（或 0）。</summary>
    private decimal Current
        => NumberMath.ToDecimal(Value, Min > decimal.MinValue ? Min : 0m);

    private async Task ChangeAsync(decimal delta)
    {
        if (Disabled) return;
        var next = Math.Clamp(Current + delta, Min, Max);
        if (next == Current) return;
        Value = (T)NumberMath.FromDecimal(next, typeof(T));
        await ValueChanged.InvokeAsync(Value);
    }
}
