@* LineNodeActionsMenu.razor — 线路节点行内操作菜单（编辑/属性/详情/删除，可选线路维护）。
   供 LineNodeManageDialog 行内与语义搜索结果复用；变更后经 OnChanged 通知调用方刷新。 *@
@namespace TreeGraph.Blazor.Shared.LineSky.Components
@using TreeGraph.Blazor.Shared.LineSky
@inject IDialogService DialogService

<MudMenu Icon="@Icons.Material.Filled.MoreVert"
         Size="Size.Small"
         Dense="true"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight">
    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="EditAsync">编辑</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Outlined.EditAttributes" OnClick="AttributesAsync">属性</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="ViewAsync">详情</MudMenuItem>
    @if (ShowLineManage && !string.IsNullOrEmpty(Node.LineId))
    {
        <MudMenuItem Icon="@Icons.Material.Filled.AccountTree" OnClick="LineManageAsync">线路节点维护</MudMenuItem>
    }
    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">删除</MudMenuItem>
</MudMenu>

@code {
    /// <summary>目标线路节点。</summary>
    [Parameter, EditorRequired] public LineNodeDto Node { get; set; } = null!;

    /// <summary>所属线路名称（仅用于对话框标题展示）。</summary>
    [Parameter] public string? LineName { get; set; }

    /// <summary>是否显示「线路节点维护」项（在线路管理对话框内为 false）。</summary>
    [Parameter] public bool ShowLineManage { get; set; }

    /// <summary>编辑/删除等变更完成后触发（调用方刷新列表）。</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task EditAsync()
    {
        if (await LineNodeActions.EditAsync(DialogService, Node))
            await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        if (await LineNodeActions.DeleteAsync(DialogService, Node))
            await OnChanged.InvokeAsync();
    }

    private Task ViewAsync() => LineNodeActions.ViewAsync(DialogService, Node.Id, LineName);

    private Task AttributesAsync() => LineNodeActions.AttributesAsync(DialogService, Node.Id);

    private async Task LineManageAsync()
    {
        await LineNodeActions.LineManageAsync(DialogService, Node.LineId, LineName);
        await OnChanged.InvokeAsync();
    }
}
