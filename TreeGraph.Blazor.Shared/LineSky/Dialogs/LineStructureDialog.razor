@* LineStructureDialog.razor — 线路结构图编辑器（R7 边集薄层）
   入口：线路维护面板 → 行内「结构」图标。
   结构 = relation 边集（一条记录 = 一条有向边）：段列表即边列表，「加段」= 选 from/to（同线节点）。
   拓扑模式已整体下线；诊断（连通/成环/度数/端子）只报告不阻断。 *@
@namespace TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky.Services
@using TreeGraph.Shared.LineSky.Dtos
@using TreeGraph.Shared.LineSky.Entities
@inject LineApiClient LineApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<DialogSky Title="@($"线路结构：{LineName}")"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭">
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_structure is null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">
                加载线路结构失败（线路可能已被删除）。
            </MudAlert>
        }
        else
        {
            @* 模板下拉：预填端子默认值（模板用 C# RenderFragment 构建，绕开 .NET 10 Razor 编译器 bug） *@
            <div class="d-flex gap-3 mb-3 flex-wrap">
                <MudSelect T="string" Value="_selectedTemplateKey" Label="模板" Variant="Variant.Outlined" Dense="true" Disabled="@(_templateKeys.Count == 0)" ValueChanged="OnSelectedTemplateKeyChanged" Style="min-width: 220px;">
                    @TemplateSelectItems
                </MudSelect>
            </div>

            @if (_candidateNodes.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    该线路暂无线路节点。请先在「线路节点」中添加节点。
                </MudAlert>
            }

            @* 诊断信息（只报告不阻断） *@
            var diag = _structure.Diagnostics;
            <MudPaper Elevation="0" Class="pa-2 mb-3"
                      Style="border: 1px solid var(--mud-palette-lines-default);">
                <div class="d-flex align-center flex-wrap gap-3">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(diag.Valid ? Color.Success : Color.Error)"
                             Variant="Variant.Outlined">
                        @(diag.Valid ? "诊断无异常" : "诊断存在异常")
                    </MudChip>
                    <MudText Typo="Typo.caption">节点 @diag.NodeCount</MudText>
                    <MudText Typo="Typo.caption">段 @diag.EdgeCount</MudText>
                    <MudText Typo="Typo.caption">单点最多连接 @diag.NodeDegreeMax</MudText>
                    <MudText Typo="Typo.caption">端点 @diag.NodeDegreeOneCount</MudText>
                    <MudText Typo="Typo.caption">成环 @(diag.HasCycle ? "是" : "否")</MudText>
                    <MudText Typo="Typo.caption">电源接入点 @diag.FeedInCount（投运 @diag.FeedInEnergizedCount）</MudText>
                    <MudText Typo="Typo.caption">联络点 @diag.TieCount</MudText>
                </div>
                @foreach (var w in diag.Warnings)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">• @w</MudText>
                }
                @foreach (var e in diag.Errors)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">• @e</MudText>
                }
            </MudPaper>

            @* ── 段（结构边列表） ── *@
            <MudText Typo="Typo.subtitle2" Class="mb-2">段（@_structure.Segments.Count）</MudText>
            @if (_structure.Segments.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    尚未添加任何段。
                </MudAlert>
            }
            else
            {
                <MudTable Items="_structure.Segments" Dense="true" Bordered="true" Hover="true" Class="mb-2">
                    <HeaderContent>
                        <MudTh>起点</MudTh>
                        <MudTh>终点</MudTh>
                        <MudTh>类型</MudTh>
                        <MudTh>显示名</MudTh>
                        <MudTh Style="width: 1%;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FromNodeName</MudTd>
                        <MudTd>@context.ToNodeName</MudTd>
                        <MudTd>@EdgeTypeLabel(context.EdgeType)</MudTd>
                        <MudTd>@(string.IsNullOrEmpty(context.DisplayName) ? "—" : context.DisplayName)</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Disabled="@_busy"
                                           OnClick="@(() => DeleteSegmentAsync(context))"
                                           title="删除该段" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            @* 添加段 *@
            <div class="d-flex align-center flex-wrap gap-2 mb-4">
                <MudSelect T="string" Value="_fromNodeId" Label="起点" Dense="true"
                           Variant="Variant.Outlined" Style="min-width: 180px;"
                           ValueChanged="OnFromNodeChanged">
                    @foreach (var n in _candidateNodes)
                    {
                        <MudSelectItem T="string" Value="@n.NodeId">@n.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                <MudSelect T="string" Value="_toNodeId" Label="终点" Dense="true"
                           Variant="Variant.Outlined" Style="min-width: 180px;"
                           ValueChanged="OnToNodeChanged">
                    @foreach (var n in _candidateNodes)
                    {
                        <MudSelectItem T="string" Value="@n.NodeId">@n.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_newDisplayName" Label="显示名"
                              Dense="true" Variant="Variant.Outlined"
                              Style="width: 160px;" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddLink"
                           Disabled="@_busy"
                           OnClick="AddSegmentAsync">
                    添加段
                </MudButton>
            </div>

            @* ── 端子 ── *@
            <MudText Typo="Typo.subtitle2" Class="mb-2">端子（@_structure.Terminals.Count）</MudText>
            @if (_structure.Terminals.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    尚未设置端子；投运状态的电源接入点（馈入）至多 1 个，其余不限。
                </MudAlert>
            }
            else
            {
                <MudTable Items="_structure.Terminals" Dense="true" Bordered="true" Hover="true" Class="mb-2">
                    <HeaderContent>
                        <MudTh>节点</MudTh>
                        <MudTh>角色</MudTh>
                        <MudTh>运行状态</MudTh>
                        <MudTh>外部连接</MudTh>
                        <MudTh Style="width: 1%;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@NodeName(context.NodeId)</MudTd>
                        <MudTd>@RoleLabel(context.TerminalRole ?? TerminalRole.FeedIn)</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@OperatingStateColor(context.OperatingState ?? TerminalOperatingState.Maintenance)">
                                @OperatingStateLabel(context.OperatingState ?? TerminalOperatingState.Maintenance)
                            </MudChip>
                        </MudTd>
                        <MudTd>@(string.IsNullOrEmpty(context.ExternalNodeId)
                                    ? "—"
                                    : context.ExternalNodeName ?? Clip(context.ExternalNodeId!))</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Disabled="@_busy"
                                           OnClick="@(() => DeleteTerminalAsync(context.NodeId))"
                                           title="移除端子" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            @* 设置端子 *@
            <div class="d-flex align-center flex-wrap gap-2 mb-4">
                <MudSelect T="string" Value="_terminalNodeId" Label="节点" Dense="true"
                           Variant="Variant.Outlined" Style="min-width: 180px;"
                           ValueChanged="OnTerminalNodeChanged">
                    @foreach (var n in _candidateNodes)
                    {
                        <MudSelectItem T="string" Value="@n.NodeId">@n.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_terminalRole" Label="角色" Dense="true"
                           Variant="Variant.Outlined" Style="min-width: 140px;"
                           ValueChanged="OnTerminalRoleChanged">
                    <MudSelectItem T="string" Value="@("FeedIn")">电源接入点（馈入）</MudSelectItem>
                    <MudSelectItem T="string" Value="@("FeedOut")">向外供电口（馈出）</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Tie")">联络点（与别处互备）</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" Value="_terminalOperatingState" Label="运行状态" Dense="true"
                           Variant="Variant.Outlined" Style="min-width: 140px;"
                           ValueChanged="OnTerminalOperatingStateChanged">
                    <MudSelectItem T="string" Value="@("Energized")">投运（带电）</MudSelectItem>
                    <MudSelectItem T="string" Value="@("HotStandby")">热备用</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ColdStandby")">冷备用</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Maintenance")">检修（停电）</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" @bind-Value="_terminalExternalId"
                              Label="外部连接 inode ID（可选）" Dense="true"
                              Variant="Variant.Outlined" Style="width: 260px;" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Power"
                           Disabled="@_busy"
                           OnClick="SaveTerminalAsync">
                    设置端子
                </MudButton>
            </div>

            @* ── 清空 ── *@
            <div class="d-flex align-center flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           Disabled="@_busy"
                           OnClick="ClearStructureAsync">
                    清空结构
                </MudButton>
                <MudSpacer />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(_busy ? "处理中..." : "结构变更即时保存")
                </MudText>
            </div>
        }
    </DialogContent>
</DialogSky>

@code {
    /// <summary>线路 ID。</summary>
    [Parameter, EditorRequired] public string LineId { get; set; } = "";

    /// <summary>线路名称（标题展示）。</summary>
    [Parameter] public string LineName { get; set; } = "";

    private bool _loading = true;
    private bool _busy;
    private LineStructureDto? _structure;

    private List<LineStructureNodeDto> _candidateNodes = [];

    /// <summary>模板下拉测试字段。</summary>
    private IReadOnlyList<string> _templateKeys = [];
    private string _selectedTemplateKey = "";

    private string _fromNodeId = "";
    private string _toNodeId = "";
    private string _newDisplayName = "";

    private string _terminalNodeId = "";
    private string _terminalRole = nameof(TerminalRole.FeedIn);
    private string _terminalOperatingState = nameof(TerminalOperatingState.Maintenance);
    private string _terminalExternalId = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _structure = await LineApi.GetStructureAsync(LineId);
            if (_structure is null) return;

            // 候选节点 = 本线全部线路节点（nodes where host_type='LineNode' and line_id=LineId）
            _candidateNodes = _structure.Nodes;

            // 模板加载（模板只预填端子默认值）
            try
            {
                var templates = await LineApi.GetLineTemplatesAsync() ?? [];
                _templateKeys = templates.Select(t => t.Key).ToList().AsReadOnly();
            }
            catch { _templateKeys = []; }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _structure = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>L1 模板：一键应用铁路牵引供电预设（端子默认 FeedIn/Maintenance）。</summary>
    private void ApplyRailwayFeedingTemplate()
    {
        _terminalRole = nameof(TerminalRole.FeedIn);
        _terminalOperatingState = nameof(TerminalOperatingState.Maintenance);

        Snackbar.Add("已应用铁路牵引供电预设：端子默认 FeedIn/Maintenance", Severity.Info);
    }

    private void OnSelectedTemplateKeyChanged(string? key)
    {
        _selectedTemplateKey = key ?? "";
        if (string.IsNullOrEmpty(_selectedTemplateKey)) return;
        ApplyRailwayFeedingTemplate();
    }

    /// <summary>C# 构建的 RenderFragment：手动写 MudSelectItem，绕开 .NET 10 Razor 编译器对第二个 @foreach 的 bug。</summary>
    private RenderFragment TemplateSelectItems => builder =>
    {
        var seq = 0;
        builder.OpenComponent<MudSelectItem<string>>(seq++);
        builder.AddAttribute(seq++, "T", typeof(string));
        builder.AddAttribute(seq++, "Value", "");
        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, "手动配置");
        builder.CloseElement();
        builder.CloseComponent();

        foreach (var k in _templateKeys)
        {
            builder.OpenComponent<MudSelectItem<string>>(seq++);
            builder.AddAttribute(seq++, "T", typeof(string));
            builder.AddAttribute(seq++, "Value", k);
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, k);
            builder.CloseElement();
            builder.CloseComponent();
        }
    };

    private void OnFromNodeChanged(string? nodeId) => _fromNodeId = nodeId ?? "";

    private void OnToNodeChanged(string? nodeId) => _toNodeId = nodeId ?? "";

    private void OnTerminalNodeChanged(string? nodeId) => _terminalNodeId = nodeId ?? "";

    private void OnTerminalRoleChanged(string? role)
        => _terminalRole = string.IsNullOrEmpty(role) ? nameof(TerminalRole.FeedIn) : role;

    private void OnTerminalOperatingStateChanged(string? state)
        => _terminalOperatingState = string.IsNullOrEmpty(state)
            ? nameof(TerminalOperatingState.Maintenance) : state;

    private async Task AddSegmentAsync()
    {
        if (string.IsNullOrEmpty(_fromNodeId) || string.IsNullOrEmpty(_toNodeId))
        {
            Snackbar.Add("请选择起点与终点", Severity.Warning);
            return;
        }
        if (_fromNodeId == _toNodeId)
        {
            Snackbar.Add("不允许自环（起点与终点相同）", Severity.Warning);
            return;
        }

        await RunBusyAsync(async () =>
        {
            var (dto, error) = await LineApi.AddSegmentAsync(LineId, new AddLineSegmentRequest
            {
                FromNodeId = _fromNodeId,
                ToNodeId = _toNodeId,
                DisplayName = string.IsNullOrWhiteSpace(_newDisplayName) ? null : _newDisplayName
            });
            if (dto is null)
            {
                Snackbar.Add($"添加段失败：{error}", Severity.Error);
                return;
            }

            _structure = dto;
            ResetSegmentInputs();
            Snackbar.Add("段已添加", Severity.Success);
        });
    }

    private async Task DeleteSegmentAsync(LineStructureSegmentDto segment)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确定删除这段结构吗？\n\n{segment.FromNodeName} → {segment.ToNodeName}",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true) return;

        await RunBusyAsync(async () =>
        {
            var (dto, error) = await LineApi.DeleteSegmentAsync(LineId, segment.EdgeId);
            if (dto is null)
            {
                Snackbar.Add($"删除段失败：{error}", Severity.Error);
                return;
            }
            _structure = dto;
            Snackbar.Add("段已删除", Severity.Success);
        });
    }

    private async Task SaveTerminalAsync()
    {
        if (string.IsNullOrEmpty(_terminalNodeId))
        {
            Snackbar.Add("请选择端子节点", Severity.Warning);
            return;
        }

        var role = Enum.Parse<TerminalRole>(_terminalRole);
        var state = Enum.Parse<TerminalOperatingState>(_terminalOperatingState);
        var externalId = string.IsNullOrWhiteSpace(_terminalExternalId)
            ? null
            : _terminalExternalId.Trim();

        await RunBusyAsync(async () =>
        {
            var (dto, error) = await LineApi.UpsertTerminalAsync(LineId, new AddLineTerminalRequest
            {
                NodeId = _terminalNodeId,
                Role = role,
                OperatingState = state,
                ExternalNodeId = externalId
            });
            if (dto is null)
            {
                Snackbar.Add($"设置端子失败：{error}", Severity.Error);
                return;
            }
            _structure = dto;
            _terminalExternalId = "";
            Snackbar.Add("端子已保存", Severity.Success);
        });
    }

    private async Task DeleteTerminalAsync(string nodeId)
    {
        await RunBusyAsync(async () =>
        {
            var (dto, error) = await LineApi.DeleteTerminalAsync(LineId, nodeId);
            if (dto is null)
            {
                Snackbar.Add($"移除端子失败：{error}", Severity.Error);
                return;
            }
            _structure = dto;
            Snackbar.Add("端子已移除", Severity.Success);
        });
    }

    /// <summary>清空结构：全量替换为空边集 + 空端子集。</summary>
    private async Task ClearStructureAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认清空",
            "清空后全部段与端子将一并删除，确定继续？",
            yesText: "清空", cancelText: "取消");
        if (confirmed != true) return;

        await RunBusyAsync(async () =>
        {
            var (dto, error) = await LineApi.ReplaceStructureAsync(
                LineId, new LineStructureRequest());
            if (dto is null)
            {
                Snackbar.Add($"清空结构失败：{error}", Severity.Error);
                return;
            }
            _structure = dto;
            Snackbar.Add("结构已清空", Severity.Success);
        });
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void ResetSegmentInputs()
    {
        _fromNodeId = "";
        _toNodeId = "";
        _newDisplayName = "";
    }

    private string NodeName(string id)
        => _candidateNodes.FirstOrDefault(n => n.NodeId == id)?.Name ?? Clip(id);

    private static string EdgeTypeLabel(string edgeType)
        => edgeType == "line_segment" ? "结构段" : edgeType;

    private static string RoleLabel(TerminalRole role) => role switch
    {
        TerminalRole.FeedIn => "电源接入点（馈入）",
        TerminalRole.FeedOut => "向外供电口（馈出）",
        TerminalRole.Tie => "联络点（与别处互备）",
        _ => role.ToString()
    };

    private static string OperatingStateLabel(TerminalOperatingState state) => state switch
    {
        TerminalOperatingState.Energized => "投运",
        TerminalOperatingState.HotStandby => "热备用",
        TerminalOperatingState.ColdStandby => "冷备用",
        TerminalOperatingState.Maintenance => "检修",
        _ => state.ToString()
    };

    private static Color OperatingStateColor(TerminalOperatingState state) => state switch
    {
        TerminalOperatingState.Energized => Color.Success,
        TerminalOperatingState.HotStandby => Color.Warning,
        TerminalOperatingState.ColdStandby => Color.Info,
        TerminalOperatingState.Maintenance => Color.Default,
        _ => Color.Default
    };

    private static string Clip(string s)
        => s.Length <= 8 ? s : s[..8] + "…";
}
