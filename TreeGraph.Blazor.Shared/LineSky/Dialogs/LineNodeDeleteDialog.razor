@* LineNodeDeleteDialog.razor — 删除线路节点确认（二级弹窗，危险色提交按钮） *@
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Services
@inject LineNodeManageApiClient Api
@inject ISnackbar Snackbar

<DialogSky Title="删除线路节点"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "删除中..." : "确认删除")"
           SubmitButtonColor="Color.Error"
           SubmitButtonDisabled="@_submitting"
           OnSubmitClick="DeleteAsync">
    <DialogContent>
        <MudText>确定要删除线路节点 <strong>"@Node?.Name"</strong> 吗？此操作不可撤销。</MudText>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public LineNodeDto? Node { get; set; }

    private bool _submitting;

    private async Task DeleteAsync()
    {
        if (Node is null) return;

        _submitting = true;
        try
        {
            var ok = await Api.DeleteAsync(Node.Id);
            if (!ok)
            {
                Snackbar.Add("删除失败：线路节点不存在或已被删除", Severity.Error);
                return;
            }
            Snackbar.Add("删除成功", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"删除失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
