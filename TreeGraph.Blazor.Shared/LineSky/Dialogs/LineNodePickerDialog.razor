@* LineNodePickerDialog.razor — 线路节点选择器（名称模糊搜索 + 服务端分页，单选）
   打开方式：IDialogService.ShowExAsync<LineNodePickerDialog>；
   单击结果行即选中并确认，返回 DialogResult.Ok(LineNodeDto)；取消返回 null。
   LineId 非空时仅搜索该线路节点（前驱选择场景）；为空时跨线路搜索。 *@
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Components
@using TreeGraph.Blazor.Shared.LineSky.Services
@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Shared.NodeEavSky.Dtos
@inject LineNodeManageApiClient NodeApi
@inject LineManageApiClient LineApi
@inject ISnackbar Snackbar

<DialogSky Title="@Title"
           CancelButtonVisible="true">
    <ToolBarContent>
        @if (!string.IsNullOrEmpty(LineName))
        {
            @* 限定线路模式：展示所属线路名（由调用方传入，对齐线路节点维护/设置修改等弹窗） *@
            <MudText Typo="Typo.subtitle1" Color="Color.Info">@LineName</MudText>
        }
    </ToolBarContent>
    <ToolBarRightContent>
        @* 搜索栏：Enter 或点击按钮刷新服务端分页 *@
        <LineNodeSearchBar Placeholder="搜索名称" Width="230px" @bind-Value="_query" OnSearch="OnSearchAsync" />
    </ToolBarRightContent>
    <DialogContent>
        @* 结果表（服务端分页）：单击行即确认选择并关闭 *@
        <MudTable T="LineNodeDto"
                  @ref="_table"
                  ServerData="LoadPageAsync"
                  OnRowClick="@(args => Confirm(args.Item))"
                  RowStyle="cursor: pointer;"
                  Hover="true"
                  Elevation="0"
                  RowsPerPage="30"
                  LoadingProgressColor="Color.Primary"
                  Style="max-height: 56vh; overflow-y: auto; background-color: #000000;">
            <HeaderContent>
                <MudTh>名称</MudTh>
                @if (LineId is null)
                {
                    <MudTh>线路</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                @if (LineId is null)
                {
                    <MudTd Class="mud-text-secondary">@LineLabel(context.LineId)</MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Color="Color.Secondary" Class="my-4">
                    未找到匹配的线路节点
                </MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="每页：" PageSizeOptions="@(new[] { 10, 30, 50, 100 })" HidePageNumber="true"
                                HorizontalAlignment="HorizontalAlignment.Center" />
            </PagerContent>
        </MudTable>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>对话框标题。</summary>
    [Parameter] public string Title { get; set; } = "选择线路节点";

    /// <summary>限定线路 ID（前驱选择场景）；为空则跨线路搜索。</summary>
    [Parameter] public string? LineId { get; set; }

    /// <summary>所属线路名称（限定线路模式下展示于工具栏，由调用方传入）。</summary>
    [Parameter] public string? LineName { get; set; }

    /// <summary>需排除的节点 Id（如当前编辑节点自身，避免选自己作为前驱）。</summary>
    [Parameter] public string? ExcludeNodeId { get; set; }

    private MudTable<LineNodeDto>? _table;
    private string? _query;
    private Dictionary<string, string> _lineNames = new();

    protected override async Task OnInitializedAsync()
    {
        if (LineId is null)
        {
            // 跨线路模式下预加载线路名称，用于结果行展示
            try
            {
                var lines = await LineApi.GetAllAsync();
                _lineNames = lines.ToDictionary(l => l.Id, l => l.Name);
            }
            catch
            {
                _lineNames = new();
            }
        }
    }

    /// <summary>MudTable 服务端数据回调。</summary>
    private async Task<TableData<LineNodeDto>> LoadPageAsync(TableState state, CancellationToken ct)
    {
        try
        {
            var page = state.Page + 1; // MudTable 页码从 0 开始，后端从 1 开始
            var pageSize = state.PageSize;
            var result = await NodeApi.SearchPagedAsync(LineId, _query, page, pageSize, ct);

            // 排除指定节点（如自身）—— 客户端过滤
            IEnumerable<LineNodeDto> items = result.Items;
            if (!string.IsNullOrEmpty(ExcludeNodeId))
                items = items.Where(n => n.Id != ExcludeNodeId);

            return new TableData<LineNodeDto>
            {
                Items = items.ToList(),
                TotalItems = result.Total
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            return new TableData<LineNodeDto> { Items = [], TotalItems = 0 };
        }
    }

    private Task OnSearchAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    /// <summary>点击结果行即选中并确认，直接关闭对话框返回该节点。</summary>
    private void Confirm(LineNodeDto node)
        => MudDialog?.Close(DialogResult.Ok(node));

    private bool TryGetLineName(string? lineId, out string name)
        => _lineNames.TryGetValue(lineId ?? string.Empty, out name!);

    private string LineLabel(string? lineId)
        => TryGetLineName(lineId, out var ln) ? ln : (lineId ?? "");
}
