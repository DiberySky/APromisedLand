@* LineNodeManageDialog.razor — 线路节点管理（一级弹窗）：列表 + 新建/编辑/删除（二级弹窗）
   入口：「空间管理」页 →「线路」选项卡 → 行内「设置」图标。
   列表使用服务端分页（线路节点可能成百上千）。 *@
@namespace TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Components
@using TreeGraph.Blazor.Shared.LineSky.Services
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@inject LineNodeManageApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="线路节点"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭">
    <ToolBarContent>
        <MudText Typo="Typo.body2" Color="Color.Info">@LineName</MudText>
    </ToolBarContent>
    <ToolBarRightContent>
        @* 仅当前线路的名称模糊搜索；防抖后回到第一页并刷新下方列表 *@
        <MudTextField T="string"
                      @bind-Value="_query"
                      Placeholder="搜索节点名称"
                      Variant="Variant.Filled"
                      Margin="Margin.Dense"
                      Typo="Typo.body2"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="OnSearchAsync"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      IconSize="Size.Small"
                      Clearable="true"
                      Style="width: 240px;" />
    </ToolBarRightContent>
    <DialogContent>
        <MudTable T="LineNodeDto"
                  @ref="_table"
                  ServerData="LoadPageAsync"
                  Hover="true"
                  Elevation="0"
                  RowsPerPage="10"
                  LoadingProgressColor="Color.Primary"
                  Style="max-height: 56vh; overflow-y: auto; background-color: #000000;">
            <HeaderContent>
                <MudTh>名称</MudTh>
                <MudTh>描述</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                    @* 操作列表头用 + 图标，点击即新建节点 *@
                    <MudIconButton Icon="@Icons.Material.Outlined.Add"
                                   Size="Size.Small"
                                   Color="Color.Success"
                                   title="新建节点"
                                   OnClick="OpenCreateAsync" />
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    @* 宿主操作模式：点击打开 LineNodeActionsDialog（基本信息内嵌 + 编辑/删除，连续操作循环） *@
                    <MudIconButton Icon="@Icons.Material.Outlined.Settings"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   title="节点操作"
                                   OnClick="@(() => OpenActionsAsync(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyStateSky Icon="@Icons.Material.Outlined.AccountTree"
                               Title="暂无线路节点">
                    <Description>
                        <text>点击操作列 + 图标添加第一个</text>
                    </Description>
                </EmptyStateSky>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="每页：" HidePageNumber="true"
                               HorizontalAlignment="HorizontalAlignment.Center" />
            </PagerContent>
        </MudTable>
    </DialogContent>
</DialogSky>

@code {
    /// <summary>所属线路 ID。</summary>
    [Parameter, EditorRequired] public string LineId { get; set; } = string.Empty;

    /// <summary>所属线路名称（仅用于标题展示）。</summary>
    [Parameter] public string LineName { get; set; } = string.Empty;

    private MudTable<LineNodeDto>? _table;

    /// <summary>搜索关键字（仅按当前线路的节点名称模糊匹配）。</summary>
    private string? _query;

    /// <summary>二级弹窗选项（与 TableRowManageDialog 一致）。</summary>
    private static readonly DialogOptionsEx NestedOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        MaximizeButton = true
    };

    /// <summary>MudTable 服务端数据回调（按 LineId 过滤 + 分页）。</summary>
    private async Task<TableData<LineNodeDto>> LoadPageAsync(TableState state, CancellationToken ct)
    {
        try
        {
            var page = state.Page + 1; // MudTable 页码从 0 开始，后端从 1 开始
            var pageSize = state.PageSize;
            var result = await Api.SearchPagedAsync(LineId, _query, page, pageSize, ct);
            return new TableData<LineNodeDto>
            {
                Items = result.Items,
                TotalItems = result.Total
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            return new TableData<LineNodeDto> { Items = [], TotalItems = 0 };
        }
    }

    /// <summary>刷新表格（新建/编辑/删除后调用）。</summary>
    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    /// <summary>搜索防抖结束后回到第一页并刷新列表。</summary>
    private async Task OnSearchAsync()
    {
        if (_table is null)
            return;

        if (_table.CurrentPage > 0)
            _table.NavigateTo(Page.First);

        await _table.ReloadServerData();
    }

    private async Task OpenActionsAsync(LineNodeDto node)
    {
        // 已在「线路节点维护」内，宿主不再提供跳转项（showLineManage: false）
        var outcome = await LineNodeActions.OperateAsync(
            DialogService, Api, node.Id, LineName, showLineManage: false, snackbar: Snackbar);
        if (outcome is LineNodeHostOutcome.Changed or LineNodeHostOutcome.Deleted)
            await ReloadAsync();
    }

    private async Task OpenCreateAsync()
    {
        var parameters = new DialogParameters<LineNodeCreateDialog>
        {
            { x => x.LineId, LineId }
        };

        var dialog = await DialogService.ShowExAsync<LineNodeCreateDialog>(
            "新建线路节点", parameters, NestedOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await ReloadAsync();
    }
}
