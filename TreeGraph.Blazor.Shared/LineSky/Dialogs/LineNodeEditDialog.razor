@* LineNodeEditDialog.razor — 编辑线路节点（二级弹窗，对齐 TreeNodeEditDialog「设置修改」模式）
   基本信息（名称/描述）+ 属性绑定（EAV）+ 关系绑定（EdgeSky）三个 Tab。 *@
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Components
@using TreeGraph.Blazor.Shared.LineSky.Services
@using TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@using TreeGraph.Blazor.Shared.EdgeSky.Components
@using TreeGraph.Blazor.Shared.EdgeSky.Services
@using TreeGraph.Shared.EdgeSky.Dtos
@inject LineNodeManageApiClient Api
@inject EdgeApiClient EdgeApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="设置修改"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "保存中..." : "保存")"
           SubmitButtonDisabled="@_submitting"
           OnSubmitClick="UpdateAsync">
    <ToolBarContent>
        @* 显示所属线路名（与只读宿主「节点操作」一致） *@
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">@LineName</MudText>
        <MudSpacer/>
    </ToolBarContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4">
            @* KeepPanelsAlive：非激活页也保持渲染，属性区组件引用（提交时保存属性）不因切页丢失 *@
            <MudTabs Elevation="0" Rounded="true" KeepPanelsAlive="true">
                <MudTabPanel Text="基本信息" Icon="@Icons.Material.Outlined.Info" IconSize="Size.Small">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_form.Name"
                                      Label="名称"
                                      Variant="Variant.Outlined"
                                      Size="Size.Small" />
                        <MudTextField @bind-Value="_form.Description"
                                      Label="描述"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Size="Size.Small" />
                        @* 前驱节点：线路节点可能很多，改用搜索对话框选择。
                           尾部放大镜打开选择器；清除按钮在只读态下 Clearable 不显示，改为行尾显式图标。 *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField T="string"
                                          Value="@_predecessorLabel"
                                          Label="前驱节点（清空并保存 = 断开连接）"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          ReadOnly="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Outlined.Search"
                                          IconSize="Size.Small"
                                          OnAdornmentClick="OpenPickerAsync"
                                          Style="flex: 1;" />
                            @if (!string.IsNullOrEmpty(_form.PredecessorId))
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Clear"
                                               Color="Color.Warning"
                                               Title="清除前驱（保存后断开连接）"
                                               Size="Size.Small"
                                               OnClick="ConfirmClearPredecessor" />
                            }
                        </MudStack>
                        @* 段边类型：仅在更换前驱时显示（为新连接指定，已移除默认边类型，后端强制必填）。
                           日常维护既有连接的边类型走「关系绑定」。 *@
                        @if (PredecessorChanged)
                        {
                            <MudSelect T="string"
                                       @bind-Value="_selectedEdgeType"
                                       Label="关系类型（边）"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small">
                                @foreach (var t in _edgeTypes)
                                {
                                    <MudSelectItem Value="@t.Name">@(t.DisplayName ?? t.Name)</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="属性绑定" Icon="@Icons.Material.Outlined.Link" IconSize="Size.Small">
                    @* 属性区：线路节点是 iNode 宿主，可关注属性定义并填写属性 *@
                    @if (Node is not null)
                    {
                        <NodeAttributeItemsSky @ref="_attrItems"
                                               NodeId="@Node.Id"
                                               ReadOnly="false"
                                               AllowManage="true" />
                    }
                </MudTabPanel>

                <MudTabPanel Text="关系绑定" Icon="@Icons.Material.Outlined.Share" IconSize="Size.Small">
                    @* 关系绑定：线路节点是 iNode 宿主，可维护出/入边 *@
                    @if (Node is not null)
                    {
                        <NodeRelationBindingsSky NodeId="@Node.Id" />
                    }
                </MudTabPanel>
            </MudTabs>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @* 对齐 Tree 设置修改：删除按钮置于左侧动作区；「添加下一个」在其左侧 *@
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.PlaylistAdd"
                   Size="Size.Small"
                   OnClick="@OnAddNext">
            添加下一个
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Outlined.Delete"
                   Size="Size.Small"
                   OnClick="@OnDelete">
            删除
        </MudButton>
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public LineNodeDto? Node { get; set; }

    /// <summary>所属线路名称（仅用于工具栏展示）。</summary>
    [Parameter] public string LineName { get; set; } = "";

    private readonly LineNodeDto _form = new();
    private NodeAttributeItemsSky? _attrItems;
    private bool _submitting;

    /// <summary>前驱节点展示名（只读文本框）。</summary>
    private string _predecessorLabel = string.Empty;

    /// <summary>当前空间的边类型列表（段边类型下拉数据源）。</summary>
    private List<EdgeTypeDto> _edgeTypes = [];

    /// <summary>段边类型选择（更换前驱时为新连接指定；隐藏时保留原值随请求透传）。</summary>
    private string? _selectedEdgeType;

    /// <summary>前驱已被更换（与原值不同且非空）——此时显示段边类型下拉。</summary>
    private bool PredecessorChanged =>
        !string.IsNullOrEmpty(_form.PredecessorId) && _form.PredecessorId != Node?.PredecessorId;

    protected override void OnParametersSet()
    {
        if (Node is not null)
        {
            _form.LineId = Node.LineId;
            _form.Name = Node.Name;
            _form.Description = Node.Description;
            // 前驱初始值：留空表示「不改连接」
            _form.PredecessorId = Node.PredecessorId;
            _form.DisconnectPredecessor = false;
            _predecessorLabel = Node.PredecessorName ?? string.Empty;
            _selectedEdgeType = Node.PredecessorEdgeType;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 边类型列表加载失败不阻塞基本信息编辑（下拉为空，保存时再校验）
        if (Node is null) return;
        var space = await EdgeApi.GetNodeSpaceAsync(Node.Id);
        if (space is not null)
            _edgeTypes = await EdgeApi.ListEdgeTypesAsync(space.SpaceId) ?? [];
    }

    /// <summary>打开线路节点搜索选择器，确认后写入 _form.PredecessorId 与展示名。</summary>
    private async Task OpenPickerAsync()
    {
        var parameters = new DialogParameters<LineNodePickerDialog>
        {
            { x => x.LineId, Node?.LineId },
            { x => x.LineName, LineName },
            { x => x.ExcludeNodeId, Node?.Id }
        };
        var dialog = await DialogService.ShowExAsync<LineNodePickerDialog>(
            "选择前驱节点", parameters,
            new DialogOptionsEx
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false,
                Position = DialogPosition.TopCenter
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: LineNodeDto picked })
        {
            _form.PredecessorId = picked.Id;
            _form.DisconnectPredecessor = false; // 改选新前驱 = 重接，取消断开标记
            _predecessorLabel = picked.Name;
            // 换了新前驱：新连接必须显式选关系类型（已移除默认边）；
            // 选回原前驱：恢复原边类型（视为未更换，透传原值不触发重写）
            _selectedEdgeType = picked.Id == Node?.PredecessorId ? Node?.PredecessorEdgeType : null;
        }
    }

    /// <summary>清除前驱选择前先确认（保存后显式断开：删入边，节点变回首节点）。</summary>
    private async Task ConfirmClearPredecessor()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "清除前驱",
            $"确定要清除前驱节点“{_predecessorLabel}”吗？保存后该节点将不再接在该前驱之后。",
            "清除", "取消");
        if (confirm == true)
        {
            _form.PredecessorId = null;
            _form.DisconnectPredecessor = true;
            _predecessorLabel = string.Empty;
        }
    }

    private async Task UpdateAsync()
    {
        if (Node is null) return;

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("请填写名称", Severity.Warning);
            return;
        }

        // 段边类型：仅在更换前驱时必填（隐藏时透传原值，后端见同前驱同类型会跳过重写）。
        // 日常维护既有连接的边类型走「关系绑定」页签。
        if (PredecessorChanged && string.IsNullOrWhiteSpace(_selectedEdgeType))
        {
            Snackbar.Add("更换前驱后，请选择新连接的关系类型（边）", Severity.Warning);
            return;
        }
        _form.PredecessorEdgeType = _selectedEdgeType;

        // 先保存属性（任一类型失败时不关闭对话框，用户可重试）
        if (_attrItems != null && !await _attrItems.SubmitUpdateNodeAttributesAsync())
            return;

        _submitting = true;
        try
        {
            var updated = await Api.UpdateAsync(Node.Id, _form);
            if (updated is null)
            {
                Snackbar.Add("更新失败：线路节点不存在或已被删除", Severity.Error);
                return;
            }
            Snackbar.Add("更新成功", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(updated));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"更新失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>删除：关闭并返回 Delete 动作，由编排器打开 LineNodeDeleteDialog 执行。</summary>
    private void OnDelete()
        => MudDialog?.Close(DialogResult.Ok(LineNodeHostAction.Delete));

    /// <summary>添加下一个：关闭并返回 AddNext 动作，由编排器打开新建对话框（前驱 = 当前节点）。</summary>
    private void OnAddNext()
        => MudDialog?.Close(DialogResult.Ok(LineNodeHostAction.AddNext));
}
