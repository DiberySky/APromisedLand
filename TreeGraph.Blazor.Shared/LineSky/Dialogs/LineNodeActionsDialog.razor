@* LineNodeActionsDialog.razor — 线路节点宿主操作对话框（对齐 TreeNodeActionsDialog 模式）：
   基本信息 Tab（只读）+ 关系绑定折叠面板；「设置修改」入口在工具栏右侧，「线路节点维护」在底部右侧。
   按钮不直接执行，仅携带 LineNodeHostAction 关窗，由 LineNodeActions.OperateAsync 编排执行并循环重开。 *@
@namespace TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Components
@using TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@using TreeGraph.Blazor.Shared.EdgeSky.Components

<style>
    /* 选项卡图标小号（对齐 TreeNodeActionsDialog） */
    .lna-tabs .mud-tab .mud-icon-root {
        width: 12px;
        height: 12px;
        font-size: 12px;
    }

    /* 基本信息折叠面板：内容区顶部更紧凑 */
    .lna-info .mud-collapse-container,
    .lna-info .mud-expand-panel-content {
        background-color: #000;
        padding-top: 4px;
    }

    /* 关系绑定折叠面板：内容区底色设为纯黑（无 padding 覆盖） */
    .lna-rel .mud-collapse-container,
    .lna-rel .mud-expand-panel-content {
        background-color: #000;
    }
    .lna-rel .mud-tabs,
    .lna-rel .mud-tabs-panels,
    .lna-rel .mud-table-container,
    .lna-rel .mud-table-root,
    .lna-rel .mud-table-row,
    .lna-rel .mud-table-cell {
        background-color: #000;
    }
</style>

<DialogSky Title="节点内容"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭">
    <ToolBarContent>
        @* 静态内容：所属线路名（ToolBarContent 不支持动态更新） *@
        <MudText Typo="Typo.subtitle1" Color="Color.Info">@LineName</MudText>
    </ToolBarContent>
    <ToolBarRightContent>
        @* 设置修改入口（工具栏右侧，文字按钮） *@
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.EditNote"
                   Size="Size.Small"
                   Color="Color.Primary"
                   OnClick="OnEdit">
            设置修改
        </MudButton>
    </ToolBarRightContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4" MaxWidth="MaxWidth.Medium">
        <MudExpansionPanel Class="lna-info mb-2" Expanded="true">
            <TitleContent>
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.subtitle2">基本信息</MudText>
                </MudStack>
            </TitleContent>
            <ChildContent>
                <MudStack Spacing="2">
                    <MudTextField T="string" Value="Node.Name"
                                  Label="名称" Variant="Variant.Outlined" ReadOnly="true" />
                    <MudTextField T="string" Value="Node.Description"
                                  Label="描述" Variant="Variant.Outlined" ReadOnly="true" Lines="3" />
                    <MudTextField T="string"
                                  Value="@(string.IsNullOrEmpty(Node.PredecessorName) ? "无（首节点）" : Node.PredecessorName)"
                                  Label="前驱节点" Variant="Variant.Outlined" ReadOnly="true" />

                    @* 属性区：仅展示本节点已关注属性定义的属性（只读） *@
                    <NodeAttributeItemsSky NodeId="@Node.Id" ReadOnly="true" />
                </MudStack>
            </ChildContent>
        </MudExpansionPanel>

            @* ===== 关系绑定（可展开，只读；始终显示，无关系时由组件内部给空态提示） ===== *@
            <MudExpansionPanel Class="lna-rel">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">关系绑定</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <NodeRelationBindingsSky NodeId="@Node.Id" NodeName="@Node.Name" AllowManage="false" />
                </ChildContent>
            </MudExpansionPanel>
        </MudContainer>
    </DialogContent>
    <DialogRightActions>
        @if (ShowLineManage && !string.IsNullOrEmpty(Node.LineId))
        {
            <MudButton OnClick="OnLineManage"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.AccountTree">
                线路节点维护
            </MudButton>
        }
    </DialogRightActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>目标线路节点（每轮由编排循环重新拉取的快照）。</summary>
    [Parameter, EditorRequired] public LineNodeDto Node { get; set; } = null!;

    /// <summary>所属线路名称（仅用于工具栏展示）。</summary>
    [Parameter] public string LineName { get; set; } = "";

    /// <summary>是否显示「线路节点维护」跳转项（在线路管理对话框内为 false）。</summary>
    [Parameter] public bool ShowLineManage { get; set; }

    private void OnEdit() => CloseWithAction(LineNodeHostAction.Edit);
    private void OnLineManage() => CloseWithAction(LineNodeHostAction.LineManage);

    private void CloseWithAction(LineNodeHostAction action)
        => MudDialog?.Close(DialogResult.Ok(action));
}
