@* LinesDialog.razor — 线路管理对话框（图空间级资源）。
   打开参数 SpaceId/SpaceName：整个维护作用于该空间，不再有空间列。
   列表 + 新建/编辑/删除 + 线路节点/线路结构/向量刷新入口。 *@
@namespace TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Services
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@inject LineManageApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="@($"线路管理：{SpaceName ?? SpaceId}")"
           SubmitButtonVisible="false">
    <DialogContent>
        @* 表格始终渲染：空态走 NoRecordsContent（EmptyStateSky），
           表头操作列的新建 + 按钮在空态时同样可用 *@
        <MudTable Items="_lines ?? (IReadOnlyList<LineDto>)[]" Hover="true" Bordered="true" Dense="true"
                  Loading="@_loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>名称</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">设置</MudTh>
                <MudTh>描述</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">同步刷新</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="OpenCreateAsync"
                                   title="新建线路" />
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd Style="white-space: nowrap; text-align: center;">
                    @* 线路节点设置：打开该线路的 LineNode 维护对话框 *@
                    <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenLineNodesAsync(context))"
                                   title="线路节点设置" />
                    @* 线路结构：有序节点 → 自动建边（线路型边类型） *@
                    <MudIconButton Icon="@Icons.Material.Filled.Timeline"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenStructureAsync(context))"
                                   title="线路结构" />
                </MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd Style="white-space: nowrap; text-align: center;">
                    @* 向量刷新：按该线路自身 + 其下线路节点范围对账（补缺 + 删孤） *@
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Info"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenVectorRefreshAsync(context))"
                                   title="向量刷新" />
                </MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenDeleteAsync(context))"
                                   title="删除线路" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(async () => await OpenEditAsync(context))"
                                   title="编辑线路" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyStateSky Icon="@Icons.Material.Filled.Timeline"
                               Title="暂无线路">
                    <Description>
                        <text>点击右上角 + 创建第一条</text>
                    </Description>
                </EmptyStateSky>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>打开参数：目标图空间 Id（整个维护作用于该空间）。</summary>
    [Parameter] public string SpaceId { get; set; } = string.Empty;

    /// <summary>打开参数：目标图空间显示名（仅标题展示用；缺省回退显示 Id）。</summary>
    [Parameter] public string? SpaceName { get; set; }

    private IReadOnlyList<LineDto>? _lines;
    private bool _loading;

    /// <summary>CRUD 子对话框选项（与 SpaceManagePanel 一致：小宽度全宽）。</summary>
    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _lines = await Api.GetAllAsync(SpaceId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
            _lines = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        // 打开参数 space 透传：新建作用于当前对话框所在空间（对话框内只读展示）
        var parameters = new DialogParameters<LineCreateDialog>
        {
            { x => x.SpaceId, SpaceId },
            { x => x.SpaceName, SpaceName }
        };
        var dialog = await DialogService.ShowAsync<LineCreateDialog>(
            string.Empty, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenEditAsync(LineDto line)
    {
        var parameters = new DialogParameters<LineEditDialog>
        {
            { x => x.Line, line }
        };

        var dialog = await DialogService.ShowAsync<LineEditDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task OpenDeleteAsync(LineDto line)
    {
        var parameters = new DialogParameters<LineDeleteDialog>
        {
            { x => x.Line, line }
        };

        var dialog = await DialogService.ShowAsync<LineDeleteDialog>(
            null, parameters, DialogOptions);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadAsync();
    }

    /// <summary>
    /// 打开该线路的节点维护对话框（线路由 LineNode 串联而成）。
    /// 节点 CRUD 在对话框内完成，不回刷本列表（线路实体本身未变更）。
    /// </summary>
    private async Task OpenLineNodesAsync(LineDto line)
    {
        var parameters = new DialogParameters<LineNodeManageDialog>
        {
            { x => x.LineId, line.Id },
            { x => x.LineName, line.Name }
        };
        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            Position = DialogPosition.TopCenter,
            MaximizeButton = true
        };

        await DialogService.ShowExAsync<LineNodeManageDialog>(
            "线路节点", parameters, options);
    }

    /// <summary>
    /// 打开线路结构图编辑器：维护段与端子（拓扑模式 Linear/Radial/Network）。
    /// </summary>
    private async Task OpenStructureAsync(LineDto line)
    {
        var parameters = new DialogParameters<LineStructureDialog>
        {
            { x => x.LineId, line.Id },
            { x => x.LineName, line.Name }
        };
        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            Position = DialogPosition.TopCenter,
            MaximizeButton = true
        };

        await DialogService.ShowExAsync<LineStructureDialog>(
            "线路结构", parameters, options);
    }

    /// <summary>
    /// 打开向量刷新对话框（无确认步骤）：可视化该线路范围（线路自身 + 其下线路节点）的向量对账进度。
    /// </summary>
    private async Task OpenVectorRefreshAsync(LineDto line)
    {
        var parameters = new DialogParameters<LineVectorRefreshDialog>
        {
            { x => x.Line, line }
        };
        var options = new DialogOptionsEx
        {
            Position = DialogPosition.TopCenter,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            MaximizeButton = true
        };
        await DialogService.ShowExAsync<LineVectorRefreshDialog>(
            "向量刷新", parameters, options);
    }
}
