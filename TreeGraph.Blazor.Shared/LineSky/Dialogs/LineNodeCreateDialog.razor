@* LineNodeCreateDialog.razor — 新建线路节点（二级弹窗，隶属某条线路）
   R7：创建时可选择「前驱」节点（同线已有节点），选后自动建立 前驱 → 新节点 的结构段边；
       不选（无）= 首节点/独立节点，不建边。
   前驱选择：线路节点可能成百上千，改用搜索对话框（同线路过滤 + 服务端分页）。 *@
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Services
@inject LineNodeManageApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<DialogSky Title="新建线路节点"
           SubmitButtonVisible="true"
           SubmitButtonText="@(_submitting ? "创建中..." : "创建")"
           SubmitButtonDisabled="@_submitting"
           OnSubmitClick="CreateAsync">
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_form.Name"
                          Label="名称"
                          Variant="Variant.Outlined"
                          Size="Size.Small" />
            <MudTextField @bind-Value="_form.Description"
                          Label="描述"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Size="Size.Small" />
            @* 前驱节点：与「设置修改」同款——尾部放大镜打开选择器；行尾显式清除图标 *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudTextField T="string"
                              Value="@_predecessorLabel"
                              Label="前驱节点（可选，选后接在该节点之后）"
                              Variant="Variant.Outlined"
                              Size="Size.Small"
                              ReadOnly="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              IconSize="Size.Small"
                              OnAdornmentClick="OpenPickerAsync"
                              Style="flex: 1;" />
                @if (!string.IsNullOrEmpty(_form.PredecessorId))
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Clear"
                                   Color="Color.Warning"
                                   Title="清除前驱"
                                   Size="Size.Small"
                                   OnClick="ClearPredecessor" />
                }
            </MudStack>
        </MudStack>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>所属线路 ID（由一级弹窗传入）。</summary>
    [Parameter] public string LineId { get; set; } = string.Empty;

    /// <summary>所属线路名称（透传给前驱选择器工具栏展示）。</summary>
    [Parameter] public string? LineName { get; set; }

    /// <summary>前驱预置（可选）：从「设置修改」点击「添加下一个」时传入当前节点。</summary>
    [Parameter] public string? PredecessorId { get; set; }

    /// <summary>前驱预置的展示名。</summary>
    [Parameter] public string? PredecessorName { get; set; }

    private readonly LineNodeDto _form = new();
    private bool _submitting;

    /// <summary>前驱节点展示名（只读文本框）。</summary>
    private string _predecessorLabel = string.Empty;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(PredecessorId)) return;
        _form.PredecessorId = PredecessorId;
        _predecessorLabel = PredecessorName ?? string.Empty;
    }

    /// <summary>打开线路节点搜索选择器（限定同线路），确认后写入前驱。</summary>
    private async Task OpenPickerAsync()
    {
        var parameters = new DialogParameters<LineNodePickerDialog>
        {
            { x => x.LineId, LineId },
            { x => x.LineName, LineName }
        };
        var dialog = await DialogService.ShowExAsync<LineNodePickerDialog>(
            "选择前驱节点", parameters,
            new DialogOptionsEx
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false,
                Position = DialogPosition.TopCenter
            });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: LineNodeDto picked })
        {
            _form.PredecessorId = picked.Id;
            _predecessorLabel = picked.Name;
        }
    }

    /// <summary>清除前驱选择（留空 = 首节点）。</summary>
    private void ClearPredecessor()
    {
        _form.PredecessorId = null;
        _predecessorLabel = string.Empty;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            Snackbar.Add("请填写名称", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            _form.LineId = LineId;
            if (string.IsNullOrWhiteSpace(_form.PredecessorId))
                _form.PredecessorId = null;
            var created = await Api.CreateAsync(_form);
            Snackbar.Add($"创建成功：{created.Name}", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"创建失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
