@* LineActionsDialog.razor — 线路只读宿主对话框（对齐 LineNodeActionsDialog 模式）：
   基本信息 + 属性 + 关系绑定（全部只读）；「AI 综合」在工具栏右侧，
   「设置修改」在底部左侧。按钮不直接执行，仅携带 LineHostAction 关窗，
   由 LineActions.OperateAsync 编排执行并循环重开。
   只读与编辑分离，便于后续按权限决定开放哪一层。 *@
@namespace TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.LineSky.Components
@using TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@using TreeGraph.Blazor.Shared.EdgeSky.Components
@using TreeGraph.Blazor.Shared.NodeEavSky.Pages

<style>
    /* 基本信息折叠面板：内容区顶部更紧凑，底色纯黑 */
    .lca-info .mud-collapse-container,
    .lca-info .mud-expand-panel-content {
        background-color: #000;
        padding-top: 4px;
    }

    /* 关系绑定折叠面板：内容区及内部 Tabs/Table 组件底色均设为纯黑 */
    .lca-rel .mud-collapse-container,
    .lca-rel .mud-expand-panel-content,
    .lca-rel .mud-tabs,
    .lca-rel .mud-tabs-panels,
    .lca-rel .mud-table-container,
    .lca-rel .mud-table-root,
    .lca-rel .mud-table-row,
    .lca-rel .mud-table-cell {
        background-color: #000;
    }
</style>

<DialogSky Title="线路内容"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭">
    <ToolBarContent>
        @* 静态内容：所属空间名（ToolBarContent 不支持动态更新） *@
        <MudText Typo="Typo.subtitle1" Color="Color.Info">@SpaceDisplay</MudText>
    </ToolBarContent>
    <ToolBarRightContent>
        @* AI 综合：线路本身为平面实体，无子项，仅综合当前线路 + 属性 + 关系 *@
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.AutoAwesome"
                   Size="Size.Small"
                   Color="Color.Warning"
                   OnClick="OnAiSummarize">
            AI 综合
        </MudButton>
    </ToolBarRightContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4" MaxWidth="MaxWidth.Medium">
            <MudExpansionPanel Class="lca-info mb-2" Expanded="true">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">基本信息</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="2">
                        <MudTextField T="string" Value="Line.Name"
                                      Label="名称" Variant="Variant.Outlined" ReadOnly="true" />
                        <MudTextField T="string" Value="Line.Description"
                                      Label="描述" Variant="Variant.Outlined" ReadOnly="true" Lines="3" />
                        <MudTextField T="string" Value="@SpaceDisplay"
                                      Label="所属空间" Variant="Variant.Outlined" ReadOnly="true" />

                        @* 属性区：只读展示 *@
                        <NodeAttributeItemsSky NodeId="@Line.Id" ReadOnly="true" />
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>

            @* ===== 关系绑定（可展开，只读；无关系时由组件内部给空态提示） ===== *@
            <MudExpansionPanel Class="lca-rel">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">关系绑定</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <NodeRelationBindingsSky NodeId="@Line.Id" NodeName="@Line.Name" AllowManage="false" />
                </ChildContent>
            </MudExpansionPanel>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @* 设置修改移至底部左侧，与「关闭」同一行水平对齐 *@
        <MudButton OnClick="OnEdit"
                   Variant="Variant.Text"
                   Color="Color.Success"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.EditNote">
            设置修改
        </MudButton>
        @* 详情（线路节点维护）：与线路列表的详情入口同一功能 *@
        <MudButton OnClick="OpenLineNodesAsync"
                   Variant="Variant.Text"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.LinearScale">
            线路节点
        </MudButton>
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Inject] private IDialogService DialogService { get; set; } = default!;

    /// <summary>目标线路（每轮由编排循环重新拉取的快照）。</summary>
    [Parameter, EditorRequired] public LineDto Line { get; set; } = null!;

    /// <summary>所属空间名称（仅用于展示；空则回退显示 SpaceId）。</summary>
    [Parameter] public string? SpaceName { get; set; }

    private string SpaceDisplay => !string.IsNullOrEmpty(SpaceName) ? SpaceName : Line.SpaceId;

    private void OnEdit() => MudDialog?.Close(DialogResult.Ok(LineHostAction.Edit));

    /// <summary>详情：打开该线路的节点维护对话框（与线路列表「详情」一致）。</summary>
    private async Task OpenLineNodesAsync()
    {
        var parameters = new DialogParameters<LineNodeManageDialog>
        {
            { x => x.LineId, Line.Id },
            { x => x.LineName, Line.Name }
        };
        var options = new DialogOptionsEx
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            Position = DialogPosition.TopCenter,
            MaximizeButton = true,
            BackdropClick = false
        };

        await DialogService.ShowExAsync<LineNodeManageDialog>(
            "线路节点", parameters, options);
    }

    /// <summary>AI 综合：线路为平面实体，仅综合当前线路（含属性与关系），无子项。</summary>
    private async Task OnAiSummarize()
    {
        var parameters = new DialogParameters<NodeExpandDialog>
        {
            { x => x.InodeId, Line.Id },
            { x => x.HostType, "Line" },
            { x => x.NodeName, Line.Name },
            { x => x.InitialDepth, 0 },
            { x => x.HasChildren, false },
        };

        var options = new DialogConfig
        {
            MaxWidth = MaxWidth.Small,
            DragMode = MudDialogDragMode.None,
        }.ToDialogOptions();

        await DialogService.ShowExAsync<NodeExpandDialog>("AI 综合", parameters, options);
    }
}
