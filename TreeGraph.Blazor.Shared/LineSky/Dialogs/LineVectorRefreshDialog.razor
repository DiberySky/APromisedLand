@* LineVectorRefreshDialog.razor — 向量刷新对话框（单线路）：薄壳，共享实现见 VectorReconcileDialog *@
@* 打开即自动执行（无确认步骤）：按该线路自身 + 其下全部线路节点范围对账（补缺 + 删孤） *@

@namespace TreeGraph.Blazor.Shared.LineSky.Dialogs
@using TreeGraph.Blazor.Shared.LineSky
@using TreeGraph.Blazor.Shared.NodeEavSky.Components.Shared
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@inject EavApiClient EavApi

<VectorReconcileDialog Title="@($"向量刷新 · {Line.Name}")"
                       RunningText="@($"正在整理「{Line.Name}」线路及其线路节点的数据，使语义搜索能立即检索到它们…")"
                       RunAsync="@((onEvent, ct) => EavApi.StreamReconcileAsync(lineId: Line.Id, onEvent: onEvent, ct: ct))" />

@code {
    /// <summary>目标线路（按该线路自身 + 其下全部线路节点范围对账）。</summary>
    [Parameter, EditorRequired] public LineDto Line { get; set; } = null!;
}
