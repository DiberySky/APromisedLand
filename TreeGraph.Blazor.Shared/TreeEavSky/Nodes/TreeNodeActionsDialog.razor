@* TreeNodeActionsDialog.razor *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@using TreeGraph.Blazor.Shared.EdgeSky.Components
@using TreeGraph.Blazor.Shared.NodeEavSky.Pages
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@implements IDisposable

<style>
    /* 折叠面板：内容区及内部 Tabs/Table 组件底色均设为纯黑 */
    .tna-expansion .mud-collapse-container,
    .tna-expansion .mud-expand-panel-content,
    .tna-expansion .mud-tabs,
    .tna-expansion .mud-tabs-panels,
    .tna-expansion .mud-table-container,
    .tna-expansion .mud-table-root,
    .tna-expansion .mud-table-row,
    .tna-expansion .mud-table-cell {
        background-color: #000;
    }
</style>

<DialogSky Title="节点内容">
    <ToolBarContent>
        @if (IsBoot)
        {
            <MudText Color="Color.Info">根结点</MudText>
        }
        else
        {
            @* 懒加载：Value.Parent 可能未装载，用编排器注入的 ParentNode 兜底 *@
            <MudText Color="Color.Info">@(NodeTemplate.Node.Value!.Parent?.Name ?? ParentNode?.Name)</MudText>
        }
    </ToolBarContent>
    <ToolBarRightContent>
        @* 工具栏右侧仅保留「子项」（IsBoot 为开窗参数，工具栏区内容保持静态） *@
        @if (!IsBoot)
        {
            @* 无子项时隐藏；懒加载树 Children 可能为 null，以后端 HasChildren 标志兜底 *@
            @if (NodeTemplate.Node.Value!.HasChildren || NodeTemplate.Node.Children?.Count > 0)
            {
                @* 子项：以当前节点为根打开树对话框页 *@
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Outlined.OpenInNew"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="OnOpenSubTree">
                    子项
                </MudButton>
            }
            @* AI 综合：复制自节点语义搜索的 ✨ 入口（框内显示进度 → 呈现综合结果） *@
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.AutoAwesome"
                       Size="Size.Small"
                       Color="Color.Warning"
                       OnClick="OnAiSummarize">
                AI 综合
            </MudButton>
        }
    </ToolBarRightContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4" MaxWidth="MaxWidth.Medium">
            @* ===== 基本信息（可展开；默认展开） ===== *@
            <MudExpansionPanel Class="tna-expansion" Expanded="true">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2">基本信息</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="2" Class="pt-1">

                        <MudTextField T="string"
                                      Value="@NodeTemplate.Node.Value!.Name"
                                      Label="名称"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"/>

                        <MudTextField T="string"
                                      Value="@NodeTemplate.Node.Value!.Description"
                                      Label="描述"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Lines="3"/>

                        @* 根节点不可修改：不展示「是否允许添加子节点」（根节点恒为允许） *@
                        @if (!IsBoot)
                        {
                            <BoolFieldSky Label="是否允许添加子节点" ReadOnly="true"
                                          @bind-Value="NodeTemplate.Node.Value!.CanHaveChildren" />
                        }

                        @* 属性区：仅展示本节点已关注属性定义的属性（只读） *@
                        <NodeAttributeItemsSky NodeId="@NodeTemplate.Node.Value!.Id"
                                               ReadOnly="true" />

                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>

            @* ===== 关系绑定（可展开；默认折叠） ===== *@
            <MudExpansionPanel Class="tna-expansion">
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2">关系绑定</MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <NodeRelationBindingsSky NodeId="@NodeTemplate.Node.Value!.Id" NodeName="@NodeTemplate.Node.Value!.Name" AllowManage="false" />
                </ChildContent>
            </MudExpansionPanel>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @* 底部动作统一靠左：根节点放创建子项/子项排序；非根节点放「设置修改」（与取消按钮同一行水平对齐） *@
        @if (IsBoot)
        {
            <MudButton OnClick="OnAddChild"
                       Variant="Variant.Text"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Outlined.Add">
                创建子项
            </MudButton>
            @* 无子项时隐藏排序；懒加载树 Children 可能为 null，以后端 HasChildren 标志兜底 *@
            @if (NodeTemplate.Node.Value!.HasChildren || NodeTemplate.Node.Children?.Count > 1)
            {
                <MudButton OnClick="OnSort"
                           Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Outlined.ImportExport">
                    子项排序
                </MudButton>
            }
        }
        else
        {
            <MudButton OnClick="OnEdit"
                       Variant="Variant.Text"
                       Color="Color.Success"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.EditNote">
                设置修改
            </MudButton>
        }
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>树客户端服务：提供树标题等展示信息。</summary>
    [Inject] private ITreeClientService<TItem> ClientService { get; set; } = default!;

    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private BlazorService BlazorService { get; set; } = default!;

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }
    [Parameter] public TItem? ParentNode { get; set; }
    [Parameter] public bool IsBoot { get; set; }

    private Task OnOpenSubTree() => ShowSubTreeDialogAsync(NodeTemplate.Node);

    /// <summary>AI 综合：打开综合对话框（复制自节点语义搜索 OpenExpandDialogAsync）。</summary>
    private async Task OnAiSummarize()
    {
        var node = NodeTemplate.Node;
        if (node.Value == null) return;

        var parameters = new DialogParameters<NodeExpandDialog>
        {
            { x => x.InodeId, node.Value.Id },
            { x => x.HostType, typeof(TItem).Name },
            { x => x.NodeName, node.Value.Name },
            // 第一步：仅当前节点 + EAV + 关系；有子项时由对话框给出「包含子项」二次提交入口
            { x => x.InitialDepth, 0 },
            { x => x.HasChildren, node.Value.HasChildren || node.Children?.Count > 0 },
        };

        var options = new DialogConfig
        {
            MaxWidth = MaxWidth.Small,
            DragMode = MudDialogDragMode.None, // 本对话框不可移动
        }.ToDialogOptions();

        await DialogService.ShowExAsync<NodeExpandDialog>("AI 综合", parameters, options);
    }

    /// <summary>以指定节点为根打开树对话框页。</summary>
    private async Task ShowSubTreeDialogAsync(TreeNodeItem<TItem> node)
    {
        if (node.Value == null) return;

        var parameters = new DialogParameters<TreeDialogPageSky<TItem>>
        {
            { x => x.Title, ClientService.Title },
            { x => x.TitleToolBar, node.Value.Parent?.Name ?? ParentNode?.Name ?? node.Value.Name },
            { x => x.RootId, node.Value.Id },
            { x => x.EditTemplate, NodeTemplate.EditTemplate },
            { x => x.ActionTemplate, NodeTemplate.ActionTemplate },
        };

        var dialog = await DialogService.ShowExAsync<TreeDialogPageSky<TItem>>(
            ClientService.Title, parameters, BlazorService.DialogOptions);

        await dialog.Result;
    }

    private void OnEdit() => CloseWithAction(NodeAction.Edit);
    private void OnAddChild() => CloseWithAction(NodeAction.AddChild);
    private void OnSort() => CloseWithAction(NodeAction.Sort);

    private void CloseWithAction(NodeAction action)
    {
        MudDialog?.Close(DialogResult.Ok(new NodeActionResult<TItem>
        {
            Action = action,
            Node = NodeTemplate.Node.Value!
        }));
    }

    private void Close() => MudDialog?.Close(DialogResult.Cancel());

    public void Dispose() { }
}
