@* TreeNodeActionsDialog.razor *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@using TreeGraph.Blazor.Shared.EdgeSky.Components
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@implements IDisposable

<style>
    /* 选项卡图标小号（MudTabPanel 无 Size 参数，用作用域 CSS 控制） */
    .tna-tabs .mud-tab .mud-icon-root {
        width: 12px;
        height: 12px;
        font-size: 12px;
    }

    /* 关系绑定折叠面板：内容区及内部 Tabs/Table 组件底色均设为纯黑 */
    .tna-expansion .mud-collapse-container,
    .tna-expansion .mud-expand-panel-content,
    .tna-expansion .mud-tabs,
    .tna-expansion .mud-tabs-panels,
    .tna-expansion .mud-table-container,
    .tna-expansion .mud-table-root,
    .tna-expansion .mud-table-row,
    .tna-expansion .mud-table-cell {
        background-color: #000;
    }
</style>

<DialogSky Title="节点操作">
    <ToolBarContent>
        @if (IsBoot)
        {
            <MudText Color="Color.Info">根结点</MudText>
        }
        else
        {
            @* 懒加载：Value.Parent 可能未装载，用编排器注入的 ParentNode 兜底 *@
            <MudText Color="Color.Info">@(NodeTemplate.Node.Value!.Parent?.Name ?? ParentNode?.Name)</MudText>
        }
        <MudSpacer/>
    </ToolBarContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4" MaxWidth="MaxWidth.Medium">
            <MudTabs Elevation="0" Rounded="true" Class="tna-tabs">

                @* ===== Tab 1: 基本信息 ===== *@
                <MudTabPanel Text="基本信息"
                             Icon="@Icons.Material.Outlined.Info">
                    <MudStack Spacing="2">

                        <MudTextField T="string"
                                      Value="@NodeTemplate.Node.Value!.Name"
                                      Label="名称"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"/>

                        <MudTextField T="string"
                                      Value="@NodeTemplate.Node.Value!.Description"
                                      Label="描述"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Lines="3"/>

                        @* 根节点不可修改：不展示「是否允许添加子节点」（根节点恒为允许） *@
                        @if (!IsBoot)
                        {
                            <BoolFieldSky Label="是否允许添加子节点" ReadOnly="true"
                                          @bind-Value="NodeTemplate.Node.Value!.CanHaveChildren" />
                        }

                        @* 属性区：仅展示本节点已关注属性定义的属性（只读） *@
                        <NodeAttributeItemsSky NodeId="@NodeTemplate.Node.Value!.Id"
                                               ReadOnly="true" />

                    </MudStack>
                </MudTabPanel>

            </MudTabs>

            @* ===== 关系绑定（可展开；无关系时隐藏） ===== *@
            @if (_hasRelations)
            {
                <MudExpansionPanel Class="tna-expansion">
                    <TitleContent>
                        <MudStack Row AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2">关系绑定</MudText>
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <NodeRelationBindingsSky NodeId="@NodeTemplate.Node.Value!.Id" AllowManage="false"
                                                 OnHasRelationsChanged="@(v => _hasRelations = v)" />
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @* 底部动作统一靠左：根节点放创建子项/子项排序；非根节点放「设置修改」 *@
        @if (IsBoot)
        {
            <MudButton OnClick="OnAddChild"
                       Variant="Variant.Text"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Outlined.Add">
                创建子项
            </MudButton>
            @* 无子项时隐藏排序；懒加载树 Children 可能为 null，以后端 HasChildren 标志兜底 *@
            @if (NodeTemplate.Node.Value!.HasChildren || NodeTemplate.Node.Children?.Count > 1)
            {
                <MudButton OnClick="OnSort"
                           Variant="Variant.Text"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Outlined.ImportExport">
                    子项排序
                </MudButton>
            }
        }
        else
        {
            @* 本对话框只读：管理功能（移动/创建子项/子项排序/删除）已迁移至「设置修改」页，便于权限控制 *@
            <MudButton OnClick="OnEdit"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Edit">
                设置修改
            </MudButton>
        }
    </DialogLeftActions>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }
    [Parameter] public TItem? ParentNode { get; set; }
    [Parameter] public bool IsBoot { get; set; }

    /// <summary>该节点是否存在关系（出/入边），由 NodeRelationBindingsSky 加载后回调；无关系则隐藏「关系绑定」面板。</summary>
    private bool _hasRelations;

    private void OnEdit() => CloseWithAction(NodeAction.Edit);
    private void OnAddChild() => CloseWithAction(NodeAction.AddChild);
    private void OnSort() => CloseWithAction(NodeAction.Sort);

    private void CloseWithAction(NodeAction action)
    {
        MudDialog?.Close(DialogResult.Ok(new NodeActionResult<TItem>
        {
            Action = action,
            Node = NodeTemplate.Node.Value!
        }));
    }

    private void Close() => MudDialog?.Close(DialogResult.Cancel());

    public void Dispose() { }
}
