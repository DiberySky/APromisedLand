@* TreeNodeEditDialog.razor — 编辑节点专用对话框。
   已重写：去掉 IsCreate 参数与所有条件分支，无条件渲染 MudTabs + 属性绑定 Tab + 属性保存逻辑。
   节点管理动作（移动/创建子项/子项排序/删除）集中在本页（宿主「节点操作」只读，便于权限控制）：
   点击关闭并返回动作，由 TreeNodeActionOrchestrator.HandleEditAsync 识别分发。
   EAV/Edge 模块挂入只在编辑阶段。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

<DialogTreeSky TItem="@TItem"
               Item="@_node"
               Title="@_title"
               SubmitButtonVisible="false"
               CancelButtonVisible="false"
               OnCanceledClick="@Close">
    <ToolBarContent>
        @* 显示父节点名（与只读宿主「节点操作」一致）；懒加载 Parent 可能未装载，用 ParentNode 兜底 *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@(_node.Parent?.Name ?? ParentNode?.Name)</MudText>
        <MudSpacer/>
        @* 节点管理动作（自只读宿主「节点操作」迁入）：点击关闭并返回动作，由编排器分发 *@
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.MoveUp"
                   Color="Color.Warning"
                   Size="Size.Small"
                   OnClick="@OnMove">
            移动
        </MudButton>
    </ToolBarContent>
    <DialogContent>
        <MudContainer Class="pt-0 pb-4">
            @* KeepPanelsAlive：非激活页也保持渲染，属性区组件引用（提交时保存属性）不因切页丢失 *@
            <MudTabs Elevation="0" Rounded="true" KeepPanelsAlive="true">
                <MudTabPanel Text="基本信息" Icon="@Icons.Material.Filled.Info">
                    <MudForm @ref="_form" Model="@_node">
                        @if (NodeTemplate.EditTemplate is null)
                        {
                            <MudStack Spacing="3">
                                <MudText Color="Color.Secondary">未提供编辑模板（EditTemplate）。</MudText>
                            </MudStack>
                        }
                        else
                        {
                            @NodeTemplate.EditTemplate(_node)
                        }
                    </MudForm>
                </MudTabPanel>

                <MudTabPanel Text="属性绑定" Icon="@Icons.Material.Filled.Link">
                    @* 编辑阶段必有 nodeId，直接渲染属性区（EAV 模块挂入点） *@
                    <NodeAttributeItemsSky @ref="_attrItems"
                                           NodeId="@_node.Id"
                                           ReadOnly="false"
                                           AllowManage="true" />
                </MudTabPanel>
            </MudTabs>
        </MudContainer>
    </DialogContent>
    <DialogLeftActions>
        @* 节点管理动作靠左：创建子项/子项排序/删除 *@
        @if (_node.CanHaveChildren)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.Add"
                       Color="Color.Success"
                       OnClick="@OnAddChild">
                创建子项
            </MudButton>
        }
        @* 无子项时隐藏排序；懒加载树 Children 可能为 null，以后端 HasChildren 标志兜底 *@
        @if (_node.HasChildren || NodeTemplate.Node.Children?.Count > 1)
        {
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Outlined.ImportExport"
                       Color="Color.Default"
                       OnClick="@OnSort">
                子项排序
            </MudButton>
        }
        @* 仍有子节点时禁止删除（后端亦拒绝）；本对话框仅非根节点可达，无需 IsBoot 判定 *@
        @if (!NodeTemplate.Node.HasChildren)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Outlined.Delete"
                       OnClick="@OnDelete">
                删除
            </MudButton>
        }
    </DialogLeftActions>
    <DialogActions>
        @* 底栏自绘：标准按钮靠右 *@
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.SaveAs"
                   OnClick="@SubmitAsync">
            提交
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Close"
                   OnClick="@Close">
            取消
        </MudButton>
    </DialogActions>
</DialogTreeSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public required NodeTemplate<TItem> NodeTemplate { get; set; }

    /// <summary>父节点（懒加载时 Value.Parent 未装载的兜底，由编排器注入）。</summary>
    [Parameter] public TItem? ParentNode { get; set; }

    private MudForm _form = null!;
    private NodeAttributeItemsSky? _attrItems;

    private TItem _node = null!;
    private string _title = null!;

    protected override void OnInitialized()
    {
        _node = NodeTemplate.Node.Value!;
        _title = "设置修改";

        base.OnInitialized();
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        // 保存属性（任一类型失败时不关闭对话框，用户可重试）
        if (_attrItems != null)
        {
            var ok = await _attrItems.SubmitUpdateNodeAttributesAsync();
            if (!ok) return;
        }

        // 关闭对话框返回节点（基础字段由调用方保存）
        MudDialog?.Close(DialogResult.Ok(_node));
    }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }

    private void OnMove() => CloseWithAction(NodeAction.Move);
    private void OnAddChild() => CloseWithAction(NodeAction.AddChild);
    private void OnSort() => CloseWithAction(NodeAction.Sort);
    private void OnDelete() => CloseWithAction(NodeAction.Delete);

    /// <summary>关闭并返回节点动作，由 TreeNodeActionOrchestrator.HandleEditAsync 识别分发。</summary>
    private void CloseWithAction(NodeAction action)
    {
        MudDialog?.Close(DialogResult.Ok(new NodeActionResult<TItem>
        {
            Action = action,
            Node = _node
        }));
    }
}
