@* AttributesManageDialog.razor — NodeEavSky 全量元数据维护入口（二级弹窗）
   一级弹窗：本对话框以 DialogSky 外壳承载 5 个维护标签页；
   二级弹窗：各列表内"新建/编辑/详情"操作通过 DialogService 打开子对话框，
            全部子对话框均使用 DialogSky，与本对话框视觉风格一致。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes

@using TreeGraph.Blazor.Shared.Common
@using TreeGraph.Blazor.Shared.NodeEavSky.Pages.Metadata

<DialogSky Title="元数据维护"
           SubmitButtonVisible="false"
           CancelButtonVisible="true"
           CancelButtonText="关闭"
           OnCanceledClick="@Close">
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" Outlined="true">
            <MudTabPanel Text="属性定义" Icon="@Icons.Material.Filled.EditAttributes">
                <Attributes OnAttributesChanged="@OnAttributesChanged" />
            </MudTabPanel>
            <MudTabPanel Text="实体类型" Icon="@Icons.Material.Filled.Category">
                <EntityTypes IsDialogMode="true" />
            </MudTabPanel>
            <MudTabPanel Text="组合类型" Icon="@Icons.Material.Filled.ViewModule">
                <CompositeTypes IsDialogMode="true" />
            </MudTabPanel>
            <MudTabPanel Text="自定义表" Icon="@Icons.Material.Filled.TableChart">
                <CustomTables IsDialogMode="true" />
            </MudTabPanel>
            <MudTabPanel Text="选项集" Icon="@Icons.Material.Filled.FormatListBulleted">
                <OptionSets IsDialogMode="true" />
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>属性变更回调。</summary>
    [Parameter] public EventCallback OnAttributesChanged { get; set; }

    private void Close()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }
}
