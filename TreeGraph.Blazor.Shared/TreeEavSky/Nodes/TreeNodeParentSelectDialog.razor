@* TreeNodeParentSelectDialog.razor — 选父节点（移动上下文）：点击任意节点即选为新父节点并返回其 Value。
   由原 TreeSelectDialogSky 拆分而来（其 OriginalNode != null 分支），并吸收旧内存树版本的前端防环：
     移动节点自身及其整棵子树禁选（TreeEavSky.ForbidNodeId），由祖先/子树判定，兼容懒加载；
     后端 move 路由仍做最终校验（防环 + 目标是否允许子节点）。
   已废弃能力：移至顶层（无父根）—— 单根树模型下会产生 UI 不可见的幽灵节点，禁止。
   叶子规则：声明为叶子（CanHaveChildren=false）的节点不可作上级 —— 不禁选，点击时明确提示原因，后端 move 硬校验兜底。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@inject ITreeClientService<TItem> ClientService
@inject ISnackbar Snackbar

<DialogSky Title="@Title"
           CancelButtonVisible="true"
           CancelButtonText="关闭">
    <ToolBarContent>
        @if (!string.IsNullOrEmpty(TitleToolBar))
        {
            <MudText Typo="Typo.subtitle1" Class="text-info">@TitleToolBar</MudText>
        }
        <MudSpacer/>
    </ToolBarContent>
    <DialogContent>
        <MudContainer MaxWidth="@MaxWidth">
            <TreeEavSky TItem="@TItem"
                        IsSelectDialog="true"
                        RootId="@RootId"
                        ClickNodeId="@ClickNodeId"
                        ForbidNodeId="@ForbidNodeId"
                        OnClickItemText="Pick"/>
        </MudContainer>
    </DialogContent>
</DialogSky>

@code {
    [CascadingParameter] public IMudDialogInstance? MudDialog { get; set; }

    /// <summary>被移动的节点：其自身及整棵子树禁选（前端防环）。为 null 时不禁选。</summary>
    [Parameter] public TreeNodeItem<TItem>? Node { get; set; }

    [Parameter] public string Title { get; set; } = "请选择上级节点";
    [Parameter] public string? TitleToolBar { get; set; }

    /// <summary>树的根节点 Id（限定选择范围；空 = 全部根）。</summary>
    [Parameter] public string? RootId { get; set; }

    /// <summary>打开时自动定位并展开到的节点 Id。</summary>
    [Parameter] public string? ClickNodeId { get; set; }

    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.Small;

    private string? ForbidNodeId => Node?.Value?.Id;

    protected override void OnInitialized()
    {
        Title = string.IsNullOrEmpty(Title) ? ClientService.Title : Title;

        base.OnInitialized();
    }

    private void Pick(TreeNodeItem<TItem>? node)
    {
        if (node?.Value is null) return;

        // 叶子节点声明为「不可含子项」，不能作为上级（后端 move 亦硬校验）。
        // 此处不禁选、不关窗，而是明确告知原因，便于用户改选其它节点。
        if (!node.Value.CanHaveChildren)
        {
            Snackbar.Add($"「{node.Text}」声明为叶子节点（不允许添加子节点），不能作为上级节点",
                Severity.Warning);
            return;
        }

        MudDialog?.Close(DialogResult.Ok(node.Value));
    }
}
