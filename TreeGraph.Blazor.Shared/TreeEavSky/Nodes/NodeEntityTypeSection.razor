@* NodeEntityTypeSection.razor
   节点已关注的单个属性定义属性区块。
   读写走 iNode 属性数据端点 /api/inode/{inodeId}/entities/{entityType}，
   EntityId 由服务端首次保存时生成并映射，组件不关心其具体值。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes

@using TreeGraph.Blazor.Shared.NodeEavSky.Components
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@using TreeGraph.Shared.NodeEavSky.Dtos
@using System.Text.Json

@inject EavApiClient EavApi
@inject MessageService Message

<MudExpansionPanel Elevation="0" Outlined="true" Class="mb-2"
                   Expanded="false" HideExpandIcon="false"
                   ExpandIcon="@Icons.Material.Filled.ExpandMore"
                   CollapseIcon="@Icons.Material.Filled.ExpandLess"
                   ExpandedChanged="OnExpandedChanged">
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Category"
                     Color="@(_hasEntity ? Color.Success : Color.Default)"
                     Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">@(string.IsNullOrWhiteSpace(DisplayName) ? EntityType : DisplayName)</MudText>
            <MudChip T="string" Size="Size.Small"
                     Color="@(_hasEntity ? Color.Success : Color.Warning)">
                @(_hasEntity ? "已填写" : "未填写")
            </MudChip>
            <MudSpacer />
            @if (AllowDetach)
            {
                <MudTooltip Text="取消关注（该类型已有数据时需先清空）">
                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   Disabled="_hasEntity"
                                   OnClick="@(() => OnDetachRequested.InvokeAsync())"
                                   OnClickStopPropagation="true" />
                </MudTooltip>
            }
        </MudStack>
    </TitleContent>
    <ChildContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_schema is null || _schema.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                该属性定义暂无属性定义，可通过「管理属性定义」创建。
            </MudText>
        }
        else
        {
            <div class="pb-3">
                <DynamicForm @ref="_form"
                             EntityType="@EntityType"
                             EntityId="@(_entity?.EntityId ?? "")"
                             Schema="@_schema"
                             CompactLayout="true"
                             ReadOnly="@ReadOnly"
                             HideSubmitButton="true"
                             OnSubmit="HandleSubmitAsync" />
            </div>
            @if (!ReadOnly)
            {
                <MudStack Row Class="pb-3" Justify="Justify.SpaceBetween">
                    <MudTooltip Text="删除该属性数据">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="!_hasEntity"
                                       OnClick="@OnDeleteEntityAsync" />
                    </MudTooltip>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="@SubmitAsync">
                        保存
                    </MudButton>
                </MudStack>
            }
        }
    </ChildContent>
</MudExpansionPanel>

@code {
    /// <summary>宿主节点 ID（iNode Id）。</summary>
    [Parameter, EditorRequired] public string InodeId { get; set; } = default!;

    /// <summary>本区块对应的属性定义名。</summary>
    [Parameter, EditorRequired] public string EntityType { get; set; } = default!;

    /// <summary>属性定义显示名。</summary>
    [Parameter] public string? DisplayName { get; set; }

    /// <summary>只读模式（节点操作对话框用）。</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>是否允许取消关注（仅属性管理对话框开启）。</summary>
    [Parameter] public bool AllowDetach { get; set; }

    /// <summary>请求取消关注（由父组件弹确认框并调 API）。</summary>
    [Parameter] public EventCallback OnDetachRequested { get; set; }

    /// <summary>属性数据删除后通知父组件（用于同步绑定表状态）。</summary>
    [Parameter] public EventCallback<string> OnDataDeleted { get; set; }

    /// <summary>首次创建属性数据后通知父组件（用于同步绑定表 HasEntity=true）。</summary>
    [Parameter] public EventCallback<string> OnDataSaved { get; set; }

    private DynamicForm? _form;
    private IReadOnlyList<AttributeSchemaDto>? _schema;
    private DynamicEntityDto? _entity;
    private DateTimeOffset? _updatedAt;
    private bool _loading;
    private bool _loaded;
    private bool _hasEntity;
    private bool _lastSubmitOk = true;

    // 已取到属性数据、等待表单渲染完成后灌入（@ref 要到渲染后才可用）
    private bool _pendingLoad;

    protected override Task OnInitializedAsync()
    {
        // 初始折叠，首次展开才加载（见 OnExpandedChanged）
        return Task.CompletedTask;
    }

    private async Task OnExpandedChanged(bool expanded)
    {
        if (expanded && !_loaded)
            await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // DynamicForm 的 @ref 在本次渲染后才可用；ReloadAsync 中直接调用时
        // _form 尚为 null（首帧在显示进度条），灌值会被静默跳过导致表单空白。
        if (_pendingLoad && _form is not null)
        {
            _pendingLoad = false;
            _form.LoadFrom(_entity!.Properties);
        }

        await Task.CompletedTask;
    }

    /// <summary>重新加载本类型的 Schema 与属性数据。</summary>
    public async Task ReloadAsync()
    {
        try
        {
            _loading = true;

            var schemaTask = EavApi.GetSchemaAsync(EntityType);
            var entityTask = EavApi.GetInodeEntityAsync(InodeId, EntityType);
            await Task.WhenAll(schemaTask, entityTask);

            _schema = schemaTask.Result ?? [];
            _entity = entityTask.Result;
            _hasEntity = _entity is not null;
            _updatedAt = _entity?.UpdatedAt;
            _pendingLoad = _entity is not null && _schema.Count > 0;
            _loaded = true;
        }
        catch (Exception ex)
        {
            Message.Details("加载属性失败", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 提交本类型的属性值。返回 false 表示表单校验失败或保存失败，
    /// 调用方应停止后续流程并保留对话框。
    /// </summary>
    public async Task<bool> SubmitAsync()
    {
        if (_form is null || _schema is null || _schema.Count == 0)
            return true;

        // 先置 false：DynamicForm 校验不通过时不会触发 OnSubmit，自然保持 false
        _lastSubmitOk = false;
        await _form.SubmitAsync();
        return _lastSubmitOk;
    }

    private async Task HandleSubmitAsync(Dictionary<string, object?> values)
    {
        var hadEntity = _hasEntity;
        try
        {
            var (ok, error, current) = await EavApi.SaveInodeEntityAsync(
                InodeId, EntityType, values, _updatedAt);

            if (ok)
            {
                _lastSubmitOk = true;
                Message.Success($"【{DisplayName ?? EntityType}】属性已保存");
                // 重新加载：首次保存后拿到真实 EntityId / UpdatedAt
                await ReloadAsync();
                // 首次创建 → 通知父组件同步绑定表 HasEntity
                if (!hadEntity && _hasEntity && OnDataSaved.HasDelegate)
                    await OnDataSaved.InvokeAsync(EntityType);
            }
            else
            {
                _updatedAt = current;
                Message.Details("属性保存失败", error ?? "未知错误");
            }
        }
        catch (Exception ex)
        {
            Message.Details("属性保存失败", ex.Message);
        }
    }

    private async Task OnDeleteEntityAsync()
    {
        var confirm = await Message.DeleteBox(
            $"确定删除【{DisplayName ?? EntityType}】的所有属性数据？此操作不可恢复。",
            "删除属性数据");
        if (!confirm) return;

        try
        {
            var (ok, error) = await EavApi.DeleteInodeEntityAsync(InodeId, EntityType);
            if (ok)
            {
                Message.Success("属性数据已删除");
                // 重置本地状态：清空表单 + 标记未填写
                _entity = null;
                _hasEntity = false;
                _updatedAt = null;
                _form?.LoadFrom(new Dictionary<string, JsonElement>());
                StateHasChanged();
                // 通知父组件同步绑定表状态（HasEntity / 已绑定计数）
                if (OnDataDeleted.HasDelegate)
                    await OnDataDeleted.InvokeAsync(EntityType);
            }
            else
            {
                Message.Details("删除失败", error ?? "未知错误");
            }
        }
        catch (Exception ex)
        {
            Message.Details("删除失败", ex.Message);
        }
    }
}
