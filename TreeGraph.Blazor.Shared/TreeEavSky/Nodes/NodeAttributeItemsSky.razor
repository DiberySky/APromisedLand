@* NodeAttributeItemsSky.razor
   节点属性宿主适配器：节点（iNode = 树节点 Id）需先「关注」某个实体类型，
   该类型的属性表单才会出现在节点上。
     - 未关注任何类型：只读模式不渲染；管理模式显示空状态与「关注实体类型」入口
     - 已关注 N 个类型：每个类型渲染一个 NodeEntityTypeSection
   数据读写走 iNode 端点 /api/inode/{nodeId}/entities/{type}。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Nodes
@typeparam TItem where TItem : class, ITreeNodeBase<TItem>, new()

@using TreeGraph.Blazor.Shared.NodeEavSky.Pages.Inodes
@using TreeGraph.Blazor.Shared.NodeEavSky.Services
@using TreeGraph.Shared.NodeEavSky.Dtos

@inject EavApiClient EavApi
@inject MessageService Message
@inject IDialogService DialogService

@if (_loading)
{
    <MudStack Class="py-4" AlignItems="AlignItems.Center">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        <MudText Typo="Typo.caption" Class="mt-1">加载属性...</MudText>
    </MudStack>
}
else if (_cards.Count == 0)
{
    @if (AllowManage)
    {
        <MudPaper Outlined="true" Class="pa-4 my-2 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Outlined.Category"
                     Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                本节点尚未关注任何实体类型，关注后才可填写属性
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAttachDialogAsync">
                关注实体类型
            </MudButton>
        </MudPaper>
    }
}
else
{
    <div class="py-2">
        @if (AllowManage)
        {
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle2">已关注的属性类型（@_cards.Count）</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAttachDialogAsync">
                    关注类型
                </MudButton>
            </MudStack>
        }

        @for (var i = 0; i < _cards.Count; i++)
        {
            var idx = i;
            var card = _cards[idx];
            <NodeEntityTypeSection InodeId="@NodeId"
                                   EntityType="@card.EntityType"
                                   DisplayName="@card.DisplayName"
                                   ReadOnly="@ReadOnly"
                                   AllowDetach="@AllowManage"
                                   @ref="_sections[idx]"
                                   OnDetachRequested="@(() => DetachAsync(card))" />
        }
    </div>
}

@code {
    /// <summary>宿主节点 ID（= iNode Id = 树节点 Id）。</summary>
    [Parameter, EditorRequired] public string NodeId { get; set; } = default!;

    /// <summary>只读模式（禁用编辑、隐藏关注/取消关注操作）。</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>是否允许管理关注关系（关注/取消关注）；仅属性管理对话框开启。</summary>
    [Parameter] public bool AllowManage { get; set; }

    private IReadOnlyList<InodeTypeCardDto> _cards = [];

    /// <summary>与 _cards 同序的区块引用槽位（Razor @ref 索引器赋值）。</summary>
    private List<NodeEntityTypeSection?> _sections = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
        => await ReloadAsync();

    /// <summary>重新加载节点已关注的类型列表及其属性区块。</summary>
    public async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(NodeId))
            return;

        try
        {
            _loading = true;

            var cards = await EavApi.ListInodeTypeCardsAsync(NodeId);
            // ListTypes 仅返回已声明卡片；兼容未来可能混入的未声明项
            _cards = cards?.Where(c => c.Declared).ToList() ?? [];
            _sections = _cards.Select(_ => (NodeEntityTypeSection?)null).ToList();
        }
        catch (Exception ex)
        {
            Message.Details("加载节点属性类型失败", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 依次提交所有已关注类型的属性。
    /// 返回 false 表示任一类型校验/保存失败，调用方应保留对话框。
    /// </summary>
    public async Task<bool> SubmitUpdateNodeAttributesAsync()
    {
        foreach (var section in _sections)
        {
            if (section is null) continue;
            if (!await section.SubmitAsync())
                return false;
        }
        return true;
    }

    /// <summary>打开「关注实体类型」对话框。</summary>
    private async Task OpenAttachDialogAsync()
    {
        var allTypes = await EavApi.ListEntityTypesAsync();
        if (allTypes is null || allTypes.Count == 0)
        {
            Message.Warning("暂无可用实体类型，请先在「管理属性定义 → 实体类型」中创建");
            return;
        }

        var declared = _cards.Select(c => c.EntityType).ToHashSet();
        var available = allTypes
            .Where(t => !declared.Contains(t.EntityType))
            .ToList();

        if (available.Count == 0)
        {
            Message.Info("所有实体类型均已关注");
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(AttachTypeDialog.AvailableTypes), available }
        };

        var dialog = await DialogService.ShowAsync<AttachTypeDialog>(
            "关注实体类型", parameters);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not string entityType)
            return;

        var (ok, error) = await EavApi.AttachInodeTypeAsync(NodeId, entityType);
        if (!ok)
        {
            Message.Details("关注失败", error ?? "未知错误");
            return;
        }

        Message.Success("关注成功");
        await ReloadAsync();
    }

    /// <summary>取消关注（后端在该类型已有实体数据时会拒绝）。</summary>
    private async Task DetachAsync(InodeTypeCardDto card)
    {
        if (card.HasEntity)
        {
            Message.Warning("该类型下已有属性数据，请先清空后再取消关注");
            return;
        }

        var ok2 = await Message.BoolBoxAsync(
            $"确定取消关注实体类型「{card.DisplayName}」吗？", "取消关注");
        if (!ok2) return;

        var (ok, error) = await EavApi.DetachInodeTypeAsync(NodeId, card.EntityType);
        if (!ok)
        {
            Message.Details("取消关注失败", error ?? "未知错误");
            return;
        }

        Message.Success("已取消关注");
        await ReloadAsync();
    }
}
