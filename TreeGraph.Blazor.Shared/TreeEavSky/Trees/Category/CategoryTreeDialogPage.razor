@* CategoryTreeDialogPage.razor
   分类树对话框页（克隆自 UnitTreeDialogPage.razor，适配 CategoryTree 字段）：
   基于 TreeDialogPageSky 包装 TreeEavSky<CategoryTree>，点击节点文本经 ShowDialogFunc 递归弹窗。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Trees.Category
@using TreeGraph.Shared.TreeEavSky.Entities

@inject BlazorService BlazorService

<TreeDialogPageSky TItem="CategoryTree"
                   Title="@(Title ?? "分类注册")"
                   TitleToolBar="@(ClickNode?.Value?.Parent?.Name ?? "分类树")"
                   RootId="@ClickNode?.Value?.Id"
                   EditTemplate="@TreeEditTemplates.CategoryEdit"
                   ShowDialogFunc="@ShowDialogAsync" />

@code {
    [Parameter] public TreeNodeItem<CategoryTree>? ClickNode { get; set; }

    /// <summary>自定义标题（可选，默认「分类注册」）。</summary>
    [Parameter] public string? Title { get; set; }

    private async Task ShowDialogAsync(TreeNodeItem<CategoryTree> node)
    {
        await BlazorService.ShowCategoryTreeDialogPageAsync(node);
    }
}
