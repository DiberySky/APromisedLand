@* SpaceTreeDialogPage.razor
   空间树对话框页（克隆自 UnitTreeDialogPage.razor）：
   基于 TreeDialogPageSky 包装 TreeEavSky<SpaceTree>，点击节点文本经 ShowDialogFunc 递归弹窗。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Trees.Space
@using TreeGraph.Shared.TreeEavSky.Entities

@inject BlazorService BlazorService

<TreeDialogPageSky TItem="SpaceTree"
                   Title="@(Title ?? "空间注册")"
                   TitleToolBar="@(ClickNode?.Value?.Parent?.Name ?? "空间")"
                   RootId="@(ClickNode?.Value?.Id ?? RootId)"
                   EditTemplate="@TreeEditTemplates.SpaceEdit"
                   ShowDialogFunc="@ShowDialogAsync" />

@code {
    [Parameter] public TreeNodeItem<SpaceTree>? ClickNode { get; set; }

    /// <summary>直接指定根节点 Id（无 ClickNode 时生效，如从空间列表打开）。</summary>
    [Parameter] public string? RootId { get; set; }

    /// <summary>自定义标题（可选，默认「空间注册」）。</summary>
    [Parameter] public string? Title { get; set; }

    private async Task ShowDialogAsync(TreeNodeItem<SpaceTree> node)
    {
        await BlazorService.ShowSpaceTreeDialogPageAsync(node);
    }
}
