@* UnitTreeEditFields.razor — 单位树节点编辑字段区（TreeNodeEditDialog 的 EditTemplate 宿主）。
   从 UnitTreeDialogPage 内联模板抽取；独立成组件使静态模板可经 <UnitTreeEditFields Model="context" />
   引用（@bind 生成的 CreateBinder 需要实例 this，不能直接放进 static 模板字段）。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Trees
@using TreeGraph.Shared.TreeEavSky.Entities

<MudStack Spacing="0">
    <MudTextField T="string"
                  @bind-Value="Model.Name"
                  Label="名称"
                  Variant="Variant.Outlined"
                  Required="true"
                  RequiredError="名称不能为空"
                  MaxLength="100"
                  Counter="100"
                  Immediate="true" />

    <MudTextField T="string"
                  @bind-Value="Model.Abbreviation"
                  Label="缩写"
                  Variant="Variant.Outlined"
                  MaxLength="20"
                  Counter="20"
                  Immediate="true" />

    <MudTextField T="string"
                  @bind-Value="Model.Description"
                  Label="描述"
                  Variant="Variant.Outlined"
                  Lines="3"
                  MaxLength="500"
                  Counter="500"
                  Immediate="true" />

    <BoolFieldSky Label="允许包含子节点"
                  @bind-Value="Model.CanHaveChildren" />
</MudStack>

@code {
    [Parameter, EditorRequired] public UnitTree Model { get; set; } = default!;
}
