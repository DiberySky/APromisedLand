@* EavTreeDialogPage.razor
   EAV 树对话框页（克隆自 SpaceTreeDialogPage.razor）：
   基于 TreeDialogPageSky 包装 TreeEavSky<EavTree>，点击节点文本经 ShowDialogFunc 递归弹窗。 *@
@namespace TreeGraph.Blazor.Shared.TreeEavSky.Trees.Eav
@using TreeGraph.Shared.TreeEavSky.Entities

@inject BlazorService BlazorService

<TreeDialogPageSky TItem="EavTree"
                   Title="@(Title ?? "EAV 注册")"
                   TitleToolBar="@(ClickNode?.Value?.Parent?.Name ?? "EAV")"
                   RootId="@(ClickNode?.Value?.Id ?? RootId)"
                   EditTemplate="@TreeEditTemplates.EavEdit"
                   ShowDialogFunc="@ShowDialogAsync" />

@code {
    [Parameter] public TreeNodeItem<EavTree>? ClickNode { get; set; }

    /// <summary>直接指定根节点 Id（无 ClickNode 时生效）。</summary>
    [Parameter] public string? RootId { get; set; }

    /// <summary>自定义标题（可选，默认「EAV 注册」）。</summary>
    [Parameter] public string? Title { get; set; }

    private async Task ShowDialogAsync(TreeNodeItem<EavTree> node)
    {
        await BlazorService.ShowEavTreeDialogPageAsync(node);
    }
}
