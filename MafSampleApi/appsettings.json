{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "Endpoint": "http://localhost:11434"
  },
  "Agent": {
    "ChatModel": "qwen3:4b",
    "EmbeddingModel": "bge-m3",
    "ChatBudgetSeconds": 120,
    "LoopBudgetSeconds": 240,
    "SystemPrompt": "你是一个乐于助人的助手，通过 Ollama 在本地运行。回答简明扼要。/no_think",
    "MaxSessions": 256,
    "SessionIdleTimeout": "00:30:00"
  }
}