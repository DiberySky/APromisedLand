# ===== NebulaGraph connection =====
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USERNAME=root
NEBULA_PASSWORD=nebula
NEBULA_DEFAULT_SPACE=

# ===== Connection pool =====
NEBULA_POOL_SIZE=20
NEBULA_TIMEOUT=10000
NEBULA_INTERVAL_IDLE=30000
NEBULA_TIME_WAIT=2000

# ===== API server =====
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_RELOAD=false

# ===== Auth (optional simple token guard for the API) =====
API_TOKEN=
